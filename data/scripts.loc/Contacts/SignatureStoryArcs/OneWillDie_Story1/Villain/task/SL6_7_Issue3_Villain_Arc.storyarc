						Text "P4060782435"
						Page "[Close]"
					}
					
				}
				
				Page TakeYourPart
				{
					Text "P609514703"
					Requires TaskOwner? ScriptTalktoWade MissionObjective? && ScriptKilledAlexis MissionObjective? ! &&
					SayOutLoudText "P3019051483"
