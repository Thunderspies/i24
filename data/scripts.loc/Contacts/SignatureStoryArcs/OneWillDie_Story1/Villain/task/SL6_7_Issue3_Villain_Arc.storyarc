	Episode // three
	{
		////////////////////////////////////////////////////////////////////////////////////
		// Task Mission3
		//
		TaskDef taskMission taskLong taskRequired
		{
			Name Mission3
			
			
			// Vars and Clues
			
			Dialog WadeDialog
			{
				PageList Intro
				{
					list TaskOwnerPage TakeYourPart KilledAlexisAlready
					flags InOrder
				}
				
				Page TaskOwnerPage
				{
					Text "P2953576664"
					Requires TaskOwner? !
					Answer
