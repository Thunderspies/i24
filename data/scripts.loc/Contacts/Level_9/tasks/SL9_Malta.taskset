				MissionPlacement Back
				MissionCount 1
				
				
				// Vars and Clues
				var VILLAIN_GROUP_ONE = <<Malta>>
				var VILLAIN_GROUP_TWO = <<Nemesis>>
				var NEGOTIATOR_ONE_INACTIVE_TEXT = <<P1578329462>>
				var NEGOTIATOR_ONE_ATTACK_TEXT = <<P856364347>>
				var NEGOTIATOR_TWO_INACTIVE_TEXT = <<P2722416055>>
				var NEGOTIATOR_TWO_ATTACK_TEXT = <<P1058915009>>
				var BOSS_ONE_DISPLAYNAME = <<P1446221669>>
				var BOSS_ONE_VILLAIN = <<Malta_Gunslinger_Boss>>
				var BOSS_TWO_DISPLAYNAME = <<P3077890394>>
				var BOSS_TWO_VILLAIN = <<Nemesis_Nemesis>>
				
				// Include the SpawnDef
				include scripts.loc/SpawnDefs/TaskIncluded/MissionMap/BossNegotiation_V0.spawninc
			}
		}
		
		// TaskComplete Reward
		TaskComplete
		{
			Dialog "P129733148"
			PrimaryReward MissionOwner
			SecondaryReward MissionHelper
			ContactPoints 10
		}
	}
	

	
	// ReturnSuccess Reward
	ReturnSuccess
	{
		Dialog "P110552163"
		RandomFameString "P2771613206"
		ContactPoints 0
	}
}




