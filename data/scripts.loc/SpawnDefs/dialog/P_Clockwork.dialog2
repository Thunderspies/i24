var IMPERIALCITY_CWKL_SWEEP_ATTACK_TEXT = "If RES.ATK(PRA) Then CWK.ATK(RES); If CWK.ATK(RES) Then RES = !ALV", "PPL.ATK(CWK); CWK.TSK[DEF(CWK)] > CWK.TSK[CLN(PRA)]; CWK.TSK = DEF(CWK)", "P746281162", "While !CWK.SAF; CWK.TSK = DEF(CWK)", "CWK.SEE[PPL.ATK(CWK)]; CWK.DEF(PRA)", "CWK.FIX(PPL.ATK())", "CWK.SEE[PPL.ATK()]; CWK.DEF(PRA)", "CIT.PRA.TSK = RUN(); !SAF", "CIT.TSK = Stop(ATK())", "CIT[ESC(BAF)]; CWK.TSK = RTN.BAF(CIT)", "If CWK.SEE[ATK(ADJ)] Then CWK.RSP(RCP)"
// Translations: ---See MAGISTERIUM_DUOGUARD_DEFENSEMODE_ALERT_TEXT---


var IMPERIAL_CITY_WELDING_INACTIVE_TEXT = "If TSK(WLD.BDG) = CMP Then TSK(FIX.IC) = CMP", "P2802194680", "WLD.TAR = MTL; WLD.TAR != PRA.CIT; WLD.TAR != CWK; CWK.TSK(WLD) = SAF"
// Translations: "If the task to weld the building is complete then fixing Imperial City is complete.", "The clockwork's current task is to weld the building.", "The welding target is metal. Welding target is not a Praetorian citizen. Welding target is not clockwork. The clockwork task to weld is safe."


var IMPERIAL_CITY_WELDING_ALERTED_TEXT = "If ENM.ATK(CWK), CWK.TSK.ATK(ENM) > CWK.TSK.WLD(BDG)", "ALT(CWK); ENM.TSK.BRK(BDG); CWK.TSK.DEF(BDG)", "If IS_PRS(ENM) Then CWK.TSK.DEF(BDG) > CWK.TSK.WLD(BDG)"
// Translations; "If the enemy attacks clockwork, then the clockwork task to attack the enemy is more important that the clockwork task to weld the building.", "Clockwork alert. The Resistance task is to break the building. The clockwork task is to defend the building.", "If an enemy is present, then the clockwork task to defend the building is more important that the task to weld the building.


var IMPERIAL_CITY_CWK_LOYALIST_OBSERVEWELDING_INACTIVE_TEXT = "While CWK.WLD(BDG); CWK.TSK = DIA(BDG)", "PRA[IC].REC[BDG][STA.TUS] == !FIX; CWK.TSK = FIX(BDG)", "While TAR[STA.TUS] == (INC or !FIX); CWK.TSK.WLD(OBJ) > CWK.TSK.CLN(IC)", "EFF.(PRA.CWK) > EFF(PRA.BER.CWK); PRA.CWK > PRA.BER.CWK"
// Translations: "While clockwork welds this building, the clockwork's task equals diagnostics on the buidling.", "Praetorian Imperial City records for this building's state equal incomplete. The clockwork task is completing the building.", "While the target's state equals incomplete, the clockwork's task to welding the building is more important that the clockwork's task to clean Imperial City."


var IMPERIAL_CITY_CWK_LOYALIST_OBSERVEWELDING_ALERTED_TEXT = "If ENM.ATK(CWK), CWK.TSK.ATK(ENM) > CWK.TSK.WLD(BDG)", "CWK.ALT; ENM.TSK.BRK(BDG); CWK.TSK.DEF(BDG)", "If ENM(PRS) Then CWK.TSK.DEF(BDG) > CWK.TSK.WLD(BDG)"
// Translations: see IMPERIAL_CITY_WELDING_ALERTED_TEXT


var IMPERIAL_CITY_WELDING_ACTIVE_TEXT = "If TSK(WLD.BDG) = CMP Then TSK(FIX.IC) = CMP", "P2802194680", "WLD.TAR = MTL; WLD.TAR != PRA.CIT; WLD.TAR != CWK; CWK.TSK(WLD) = SAF"
// Translations: see IMPERIAL_CITY_WELDING_INACTIVE_TEXT


var IMPERIAL_CITY_CWK_LOYALIST_CHATTY_GROUP_TEXT = "P1705108019", "IC != BKN; ?CWK.TSK == FIX(IC)", "P2292861781", "P2370072761", "If CWK.SRV(ATM) && ATM.SRV(EMP.MCL) Then CWK.SRV(EMP.MCL)", "While IC != BKN; CWK.TSK = FIX(IC)"
// Translations: "If enemies are dead, then Imperial City is safe.", "Imperial City is not broken. Why do the clockwork still fix Imperial City?", "Imperial City is safe and is 100% efficient", "If Praetoria is safe, then Praetoria's clockwork are safe.", "If the clockwork serve Antimatter and Antimatter serves Emperor Marcus Cole, then the clockwork serve Emperor Marcus Cole.", "While Imperial City is broken, the clockwork will fix Imperial City."


var NEUTROPOLIS_CWK_LOYALIST_DIAGNOSTICS_DIAGNOSE_CWK_RESISTANCE_INACTIVE = "If DIA(RES.CWK) == CMP And TAR(RES.CWK) == BKN Then PRA.CWK.TSK == FIX(RES.CWK)", "EFF.TAR(RES.CWK) < EFF.REQ(PRA.CWK); PRA.CWK.TSK == INC.EFF(RES.CWK); TAR(INC.EFF) == 54.PCT", "DIA(RES.CWK) == CMP; CWK.TSK.RPG(RES.CWK)"
// Translations: "If the diagnostics on the Resistance Clockwork are complete and the target Resistance Clockwork is broken then the Praetorian Clockwork's task is to fix the Resistance Clockwork.", "The efficiency of the target Resistance Clockwork is less than the efficiency requirement of Praetorian Clockwork. The Praetorian Clockwork's task is to increase the efficiency of the Resistance Clockwork. The target increased efficiency is 54 percent.", "Diagnostics on Resistance Clockwork are complete. Clockwork's task is to reprogram the Resistance Clockwork.",


var NEUTROPOLIS_CWK_LOYALIST_DIAGNOSTICS_DIAGNOSE_CWK_RESISTANCE_ALERTED = "P1229919430", "ENM.PRS.DET; PRA.CWK.TSK(DEF.NTP) > PRA.CWK.TSK(FIX.RES.CWK)", "THR.LVL == 80.PCT; If PRA.CWK(THR.LVL) == 100.PCT Then PRA.CWK.TSK == ATK.TAR.ENM"
// Translations: "An enemy's presence has been detected. The Praetorian Clockwork task is to defend Neutropolis.", "An enemy's presence has been detected. The Praetorian Clockwork task to defend Neutropolis is greater than the Praetorian Clockwork task to fix the Resistance Clockwork.", "Threat level is 80 percent. If the Praetorian Clockwork's threat level is equal to 100 percent, then the Praetorian Clockwork task is to attack the target enemy."


var NEUTROPOLIS_CWK_LOYALIST_CHATTY_GROUP_TEXT = "P36627153", "NTP != BKN; ?CWK.TSK == FIX(NTP)", "P1198779934", "P2370072761", "If CWK.SRV(ATM) && ATM.SRV(EMP.MCL) Then CWK.SRV(EMP.MCL)", "While NTP != BKN; CWK.TSK = FIX(NTP)"
// Translations: "If enemies are dead, then Neutropolis is safe.", "Neutropolis is not broken. Why do the clockwork still fix the Neutropolis?", "Neutropolis is safe and is 100% efficient", "If Praetoria is safe, then Praetoria's clockwork are safe.", "If the clockwork serve Antimatter and Antimatter serves Emperor Marcus Cole, then the clockwork serve Emperor Marcus Cole.", "While Neutropolis is broken, the clockwork will fix Neutropolis."


var NEUTROPOLIS_ALLHOODS_WASHWALL_DEFENSEMODE_ALERT_TEXT = "CWK.SRV(ATM); If ENM.ATK(ATM) Then CWK.ATK(ENM)", "CWK.TSK = DEF(ATM)", "If SEE.REC.RES Then CWK.ATK(ENM)", "If CWK.ATK(ENM) Then CWK.ATK(RES)", "If CWK.LOC == NTP Then CWK.ENM = RES + SYN + GHU && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
// Translations: "Clockwork serves Antimatter. If enemies attack Antimatter, then Clockwork attacks enemies.", "Clockwork's task is to defend Antimatter.", "If Clockwork sees enemies perform reconaissance, then Clockwork attacks enemies.", "If Resistance attacks Clockwork, then Clockwork attacks Resistance.", "If the clockwork's location is Neutropolis, then the Clockwork's enemies are the Resistance, the Syndicate and the Ghouls and the Clockwork's allies are the PPD. If the clockwork sees an enemy, the clockwork will attack the enemy."


var NEUTROPOLIS_CWK_LOYALIST_OBSERVEWELDING_INACTIVE_TEXT = "While CWK.FIX(OBJ); CWK.TSK = DIA(OBJ)", "CWK.SRH.OBJ.REC; PRA.REC.OBJ.STT == BKN; CWK.TSK = FIX(OBJ)", "While OBJ.STT == BKN; CWK.TSK.FIX(OBJ) > CWK.TSK.CLN(NTP)", "EFF(PRA.CWK) > EFF(NEU.CWK); PRA.CWK > NEU.CWK"
// Translations: "While clockwork fix this object, the clockwork's task equals diagnostics on the object.", "The clockwork is searching this object's records. Praetorian records for this object's state equal broken. The clockwork task is fixing this object.", "While the object's state equals broken, the clockwork's task to fix objects is more important that the clockwork's task to clean Neutropolis.", "The efficiency of Praetorian Clockwork is greater than the efficiency of Neuron's clockwork. Antimatter's clockwork are greater than Neuron's clockwork."


var NEUTROPOLIS_CWK_LOYALIST_OBSERVEWELDING_ALERTED_TEXT = "CWK.SRV(ATM); If ENM.ATK(ATM) Then CWK.ATK(ENM)", "CWK.TSK = DEF(ATM)", "If SEE.REC.RES Then CWK.ATK(ENM)", "If CWK.ATK(ENM) Then CWK.ATK(RES)", "If CWK.LOC == NTP Then CWK.ENM = RES + SYN + GHU && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
// Translations: ---See NEUTROPOLIS_ALLHOODS_WASHWALL_DEFENSEMODE_ALERT_TEXT


var NEUTROPOLIS_WELDING_INACTIVE_TEXT = "P1660740850", "CWK.TSK = FIX(OBJ); EST.TIM(TSK) = 32.MIN", "If CWK.FIX(OBJ) Then CWK.SRV(ATM)", "CWK.ALT; CWK.FND.HCK(CUR.OBJ); CWK.PRR.TSK = FIX(OBJ)", "CWK.TSK == FIX(OBJ); If ALV Then AVD.PLM", "RMN.TIM(TSK) == 25.MIN; CWK.EFF == 84.PCT", "If CWK.TSK == FIX(OBJ) Then NTP !== CMP"
// Translations: "The clockwork is searching object's records. Praetorian records for fixing this object equals eight. Why is the object broken?", "The clockwork's task is to fix this object. The estimated time for this task is 32 minutes.", "If the clockwork fixes this object, then the clockwork has served Antimatter.", "Clockwork alert. Clockwork has found a hack in the current object. Clockwork priority task is to fix the object.", "The clockwork task is fixing this object. If alive, then avoid the plasma." "Remaining time for this task is 25 minutes. Clockwork's efficiency is 84%.", "If the clockwork's task is to fix an object, then Neutropolis is not complete."


var NEUTROPOLIS_WELDING_ALERTED_TEXT = "CWK.SRV(ATM); If ENM.ATK(ATM) Then CWK.ATK(ENM)", "CWK.TSK = DEF(ATM)", "If SEE.REC.RES Then CWK.ATK(ENM)", "If CWK.ATK(ENM) Then CWK.ATK(RES)", "If CWK.LOC == NTP Then CWK.ENM = RES + SYN + GHU && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
