Dialog
{
// WARNING!!!
// Before editing this file, read this page: 
// http://ncncsvn01:8081/display/coh/Praetoria+-+Enemy+Groups+-+Praetorian+Clockwork+-+Dialog+Style+Guide
//
// Basic Dictionary for Standard Clockwork:
// ALG = Algorithm
// ALV = Alive. Used as a descriptor
// ALY = Ally (usually CWK.ALY)
// ATK = Attack. Generally an action, sometimes a descriptor
// ATM = Anti-Matter
// BAF = Behavioral Adjustment Facility
// BRK = Break
// CHK = Checking
// CIT = Citizen
// CLN = Clean. Used as a descriptor
// CMB = Combat
// CMP = Complete.
// CoL = Carnival of Light
// CUR = Current
// CWK = Clockwork. Used as a noun
// DEF = Defend/Defense. Generally an action, sometimes a descriptor
// DES = Destroyers.
// DIA = Diagonstics.
// EMP.MCL = Marcus Cole
// ENM = Enemy.
// EST = Estimate.
// FCL = Facility.
// FIN = Finished
// FIX = Fixing something. Generally an action, sometimes a descriptor
// FOE = Foe, the current target the Clockwork intends to obliterate.  Initialized with FOE = TGT.CUR or something similar
// GHU = Ghouls.
// GRS = Grass.
// INI = Initiate.
// INT = Initialize.
// MEM = Memory.
// MGS = Magisterium
// NEW = New.  Duh.
// OBJ = Object.
// PPL = People. Noun
// PPD = Praetoria Police Department.
// PRA = Praetoria Noun, also category of important Praetorians:
// PRA.TIL,        PRA.BER,  PRA.WHT,   PRA.DUN,     PRA.SNC
// Mother Mayhem,  Neuron,   Marauder,  Dominatrix,  Chimera
// PRC = Process.
// PRD = Procedure.
// PRT = Protocol.
// PRV = Previous.
// RCN = Reconnaisance
// RES = Resistance. Noun
// RFT = Rift.
// RPG = Reprogam.
// RPR = Repair.
// RUN = Run.
// SAF = Safe.
// SDN = Shutdown.
// SEE = See.
// SRC = Source.
// SRH = Search.
// SRV = Serve.
// SSP = Suspend.
// STS = Status
// SYN = Syndicate.
// TCH = Technology.
// TGT = Target.
// TIM = Time.
// TRF = Traffic.
// TRR = Turret.
// TSK = Task.
// UGR = Underground.
// True or False = What it says on the box. These are constants, so are CamelCased.
// Other Constants: None, Primary, Secondary,
// ++SYS.REQ; = System Interrupt - Something major is bothering this clockwork, to be identified after the ;
// = vs == - == is used to compare values. = is used to set a value.  Other comparison operators are: !=, >, <, <=, >=
// ? = Why
// ! = Not
// + = And


var MAGISTERIUM_DUOGUARD_PROPAGANDA_INACTIVE_TEXT = "P2445221007", "PRA == CLN; ?CWK.TSK == CLN(PRA)", "P3157520325", "P1289039197", "If CWK.SRV(ATM) && ATM.SRV(EMP.MCL) Then CWK.SRV(EMP.MCL)", "If PPL.TRF(GRS) Then GRS != ALV", "TRF x PPL x 2 - CWK.TSK[CLN(PRA)] == PRA.CLN", "While PRA != CLN; CWK.TSK = CLN(PRA)", "!RES.MGS == True; ?CWK.TSK = RCN(MGS)", "P1549916616"
// Translations: "If Resistance are dead, then Praetoria is safe.", "Praetoria is clean. Why do the clockwork still clean Praetoria?", "Magisterium is safe and clean", "Emporer Marcus Cole is alive, then Praetoria is safe.", "If the clockwork serve Antimatter and Antimatter serves Emporer Marcus Cole, then the clockwork serve Emporer Marcus Cole.", "If people walk on the grass, then the grass will die.", "Traffic of people multiplied by thier feet minus the clockwork cleaning Praetoria equals a clean Praetoria.", "While Praetoria isn't clean, the clockwork will clean Praetoria.", "There are no Resistance in the Magisterium, why are the clockwork doing recon in the Magisterium?", "Emporer Marcus Cole is greater than all Praetoria."


var MAGISTERIUM_DUOGUARD_DEFENSEMODE_ALERT_TEXT = "If RES.ATK(PRA) Then CWK.ATK(RES); If CWK.ATK(RES) Then RES = !ALV", "PPL.ATK(CWK); CWK.TSK[DEF(CWK)] > CWK.TSK[CLN(PRA)]; CWK.TSK = DEF(CWK)", "P746281162", "While !CWK.SAF; CWK.TSK = DEF(CWK)", "CWK.SEE[PPL.ATK(CWK)]; CWK.DEF(PRA)", "CWK.FIX(PPL.ATK())", "CWK.SEE[PPL.ATK()]; CWK.DEF(PRA)", "CIT.PRA.TSK = RUN(); !SAF", "CIT.TSK = Stop(ATK())", "CIT[ESC(BAF)]; CWK.TSK = RTN.BAF(CIT)", "If CWK.SEE[ATK(ADJ)] Then CWK.RSP(RCP)"
// Translations: "If the Resistance attack Praetoria, then clockwork attack Resistance. If clockwork attack Resistance, then the Resistanc will die.", "People attack the clockwork. Defending clockwork is more imporant than cleaning Praetoria. Clockwork task is now defend clockwork.", "Don't attack clockwork!", "While clockwork are not safe, the clockwork task is defend clockwork.", "Clockwork see people attacking clockwork, clockwork defend Praetoria.", "Clockwork fix the people who are attacking", "Clockwork see people attacking, clockwork defend Praetoria.", "Citizens of Praetoria: Run! It is not safe here.", "Citizen task is to stop attacking.", "Citizen has escaped the Behavioral Adjustment Facility, the clockwork must take back to the BAF this citizen.", "If clockwork see a nearby attack, then clockwork will respond reciprocally."


var MAGISTERIUM_BERZERK_MALFUNCTIONING_INACTIVE_TEXT = "P1205286720", "P2472185284", "If !PPL.ALV Then !TRF; If !TRF Then CWK.TSK != CLN(PRA)", "CWK == !FIX; CWK.TSK = FIX(CWK)", "If CWK == !FIX Then CWK.FIX(CWK) == !FIX.CWK", "P1690270453", "!EMP.MCL.SRV(PRA); EMP.MCL.SRV(EMP.MCL)"
// Translations: "Emporer Marcus Cole does not make Praetoria safe.", "If you want to fix Praetoria, then Emporer Marcus Cole must die.", "If there are no people alive, then there is no traffic. If there is no traffic, then the clockwork no longer have to clean Praetoria.", "Clockwork are broken. The clockwork need to fix the clockwork.", "If the clockwork are broken, then clockwork fixing clockwork will result in broken clockwork.", "Clockwork are not broken. Clockwork are safe. Clockwork are not dead.", "Emporer Marcus Cole does not serve Praetoria. Emporer Marcus Cole serves Emporer Marcus Cole."


var MAGISTERIUM_BERZERK_MALFUNCTIONING_ALERT_TEXT = "CWK.SEE[GRS.CLR == GRN; SKY.CLR == BLU]; CWK.TSK = PPL.BBQ", "CWK == !ALV; PPL.TSK = FIX(CWK)", "If CWK.TSK == DEF(CWK) Then CWK.TSK = ATK(CIT.PRA)", "CWK.SEE[CIT.PRA]; CWK.ATK(CIT.PRA)", "CIT.PRA.TSK = CLN(PRA)", "!CWK.SRV(PRA); CIT.PRA.SRV(CWK)"
// Translations: "I see grass that's green, sky that's blue, my task today is a people barbeque!", "The clockwork are not alive. People need to fix the clockwork.", "If the clockwork need to defend the clockwork, then the clockwork need to attack citizens of Praetoria.", "Clockwork see Praetorian citizen. Clockwork attack Praetorian citizen.", "Praetorian citizens must clean Praetoria.", "Clockwork don't serve Praetoria, citizens of Praetoria serve clockwork."


