var UNDERGROUND_CWK_LOYALIST_DIAGNOSTICS_DIAGNOSE_CWK_NEURON_INACTIVE = "DIA(PRA.BER.CWK) == CMP; CWK.TSK.RPG(PRA.BER.CWK)", "EFF.TAR(PRA.BER.CWK) < EFF.REQ(PRA.CWK); SDN(PRA.BER.CWK) && RPG(PRA.BER.CWK) && RPR(PRA.BER.CWK)", "?PRA.BER.CWK.ATK(CWK); If !PRA.BER.CWK.ATK.CWK Then !CWK.RPR.PRA.BER.CWK", "DIA(PRA.BER.CWK) == CMP; RPR(PRA.BER.CWK) == CMP; RPG(PRA.BER.CWK) == CMP; PRA.BER.CWK = PRA.CWK; CWK.TSK.INT(PRA.CWK)"
// Translations: "Diagnostics on Resistance Clockwork are complete. Clockwork's task is to reprogram the Resistance Clockwork.", "The efficiency of the target Neuron's Clockwork is less than that required of Praetoria's Clockwork. Shutdown the Neuron's Clockwork, reprogram the Neuron's Clockwork and repair the Neuron's Clockwork.", "Why do Neuron's Clockwork attack Clockwork? If Neuron's Clockwork did not attack Clockwork, then Clockwork would not need to repair Neuron's Clockwork.", "Diagnostics on the Neuron's Clockwork are complete. Repairs on the Neuron's Clockwork are complete. Reprogramming of the Neuron's Clockwork is complete. Neuron's Clockwork is now Praetoria's Clockwork. Clockwork task is to initialize the Praetoria's Clockwork."

var UNDERGROUND_CWK_LOYALIST_DIAGNOSTICS_DIAGNOSE_CWK_NEURON_ALERTED = "TAR(PRA.BER.CWK) != SDN; CWK.TSK.ATK(PRA.BER.CWK)", "If TAR(PRA.BER.CWK) != SDN Then CWK.TSK.ATK(PRA.BER.CWK) > CWK.TSK.RPR(PRA.BER.CWK); CWK.INT(CMB)", "If RES.STL(PRA.BER.CWK) Then RES.RPR(PRA.BER.CWK) && !RES.RPG(PRA.BER.CWK); !RES.STL(PRA.BER.CWK)"
// Translations: "The target Neuron's Clockwork is not shutdown. Clockwork's task is to attack the Neuron's Clockwork.", "If target Neuron's Clockwork is not shutdown then the clockwork task to attack the Neuron's Clockwork is more important than the task to repair the Neuron's Clockwork.", "If Neuron's Clockwork steals the Neuron's Clockwork, then Neuron's Clockwork will repair the Neuron's Clockwork but not reprogram the Neuron's Clockwork. Neuron's Clockwork will not steal the Neuron's Clockwork."

