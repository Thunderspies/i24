var UNDERGROUND_NT_SOLOPATROL_DEFENSEMODE_ALERT_TEXT = "CWK.SRV(PRA); If RES.ATK(PRA) Then CWK.ATK(RES)", "CWK.TSK = DEF(PRA)", "If SEE.REC.RES Then CWK.ATK(RES)", "If RES.ATK(CWK) Then CWK.ATK(RES)", "If CWK.LOC == UGR Then CWK.ENM = RES + SYN + GHU + DES && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
// Translations: ---See UNDERGROUND_SOLOPATROL_DEFENSEMODE_ALERT_TEXT---

var UNDERGROUND_NT_PATROL_HUNTNKILL_INACTIVE_TEXT = "If CWK.SEE.RES.ALV Then CWK.ATK(RES)", "If RES == ALV Then CWK.ATK.(RES)", "If RES.ATK(CIT) Then CWK.DEF(CIT)", "CUR.TSK == RCN + SRH.RES; If SEE.RES.PPL Then CWK.ATK(RES); If SEE.RES.CWK Then CWK.SDN(RES.CWK)", "If CWK.LOC == UGR Then CWK.ENM = RES + SYN + GHU + DES && CWK.ALY = PPD"
//Translations: "If Clockwork sees a living Resistance fighter, then Clockwork attacks the Resistance fighter.", "If Resistance are alive, Clockwork attacks Resistance.", "If Resistance attacks citizens, then Clockwork defends citizens.", "The current task is to perform reconaissance and search for Resistance. If Clockwork sees Resistance people, then Clockwork attacks Resistance. If Clockwork sees Resistance Clockwork, then Clockwork shuts down Resistance Clockwork.", "If the clockwork's location is the Underground, then the Clockwork's enemies are the Resistance, the Syndicate, the Ghouls and the Destroyers and the clockwork's allies are the PPD."

var UNDERGROUND_NT_PATROL_DEFENSEMODE_ALERT_TEXT = "CWK.SRV(PRA); If RES.ATK(PRA) Then CWK.ATK(RES)", "CWK.TSK = DEF(PRA)", "If SEE.REC.RES Then CWK.ATK(RES)", "If RES.ATK(CWK) Then CWK.ATK(RES)", "If CWK.LOC == UGR Then CWK.ENM = RES + SYN + GHU + DES && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
// Translations: ---See UNDERGROUND_SOLOPATROL_DEFENSEMODE_ALERT_TEXT---

var UNDERGROUND_NT_DUOGUARD_INACTIVE_TEXT = "CWK.CUR.TSK == SRV(PRA) + DEF(UGR.FCL)", "If RES.ATK(CWK) Then CWK.ATK(RES); If RES.CWK.ATK(CWK) Then CWK.DSB(RES.CWK) + RPR(RES.CWK)", "P1232922256", "If TAR == PPD Then CWK.DEF(TAR) = True; If TAR != PPD Then CWK.DEF(TAR) != True"
// Translations: "The Clockwork's current task is serving Antimatter and defending the Underground facility.", "If Resistance attacks the clockwork, then the clockwork attacks the Resistance. If Resistance clockwork attack the clockwork, then the clockwork disables Resistance clockwork and repairs Resistance clockwork.", "The Underground condition is not safe. If target is alive, then target is not safe.", "If clockwork's target is PPD, then the clockwork defending the target is true. If clockwork's target is not PPD, then the clockwork defending the target is not true."

var UNDERGROUND_NT_DUOGUARD_DEFENSEMODE_ALERT_TEXT = "CWK.SRV(PRA); If RES.ATK(PRA) Then CWK.ATK(RES)", "CWK.TSK = DEF(PRA)", "If SEE.REC.RES Then CWK.ATK(RES)", "If RES.ATK(CWK) Then CWK.ATK(RES)", "If CWK.LOC == UGR Then CWK.ENM = RES + SYN + GHU + DES && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
// Translations: ---See UNDERGROUND_SOLOPATROL_DEFENSEMODE_ALERT_TEXT---

var UNDERGROUND_NT_WELDING_INACTIVE_TEXT = "P2842145138", "CWK.TSK = FIX(OBJ); EST.TIM(TSK) = 25.MIN", "If CWK.FIX(OBJ) Then CWK.SRV(PRA)", "CWK.ALT; CWK.FND.HCK(CUR.OBJ); CWK.PRR.TSK = FIX(OBJ)", "CWK.TSK == FIX(OBJ); If ALV Then AVD.PLM", "RMN.TIM(TSK) == 15.MIN; CWK.EFF == 92.PCT", "If CWK.TSK == FIX(OBJ) Then UGR != CMP"
// Translations: "The clockwork is searching object's records. Praetorian records for fixing this object equals six. Why is the object broken?", "The clockwork's task is to fix this object. The estimated time for this task is 25 minutes.", "If the clockwork fixes this object, then the clockwork has served Antimatter.", "Clockwork alert. Clockwork has found a hack in the current object. Clockwork priority task is to fix the object.", "The clockwork task is fixing this object. If alive, then avoid the plasma." "Remaining time for this task is 15 minutes. Clockwork's efficiency is 92%.", "If the clockwork's task is to fix an object, then the Underground is not complete."

