Dialog
{
// WARNING!!!
// Before editing this file, read this page: 
// http://ncncsvn01:8081/display/coh/Praetoria+-+Enemy+Groups+-+Praetorian+Clockwork+-+Dialog+Style+Guide
//
// Basic Dictionary for Standard Clockwork:
// ALG = Algorithm
// ALV = Alive. Used as a descriptor
// ATK = Attack. Generally an action, sometimes a descriptor
// ATM = Anti-Matter
// BAF = Behavioral Adjustment Facility
// BRK = Break
// CIT = Citizen
// CLN = Clean. Used as a descriptor
// CMB = Combat
// CMP = Complete.
// CUR = Current
// CWK = Clockwork. Used as a noun
// DEF = Defend/Defense. Generally an action, sometimes a descriptor
// DES = Destroyers.
// DIA = Diagonstics.
// EMP.MCL = Marcus Cole
// ENM = Enemy.
// EST = Estimate.
// FCL = Facility.
// FIX = Fixing something. Generally an action, sometimes a descriptor
// GHU = Ghouls.
// GRS = Grass.
// INI = Initiate.
// INT = Initialize.
// MEM = Memory.
// MGS = Magisterium
// OBJ = Object.
// PPL = People. Noun
// PPD = Praetoria Police Department.
// PRA = Praetoria Noun, also category of important Praetorians:
// PRA.TIL,        PRA.BER,  PRA.WHT,   PRA.DUN,     PRA.SNC
// Mother Mayhem,  Neuron,   Marauder,  Dominatrix,  Chimera
// PRC = Process.
// PRD = Procedure.
// PRT = Protocol.
// RCN = Reconnaisance
// RES = Resistance. Noun
// RFT = Rift.
// RPG = Reprogam.
// RPR = Repair.
// RUN = Run.
// SAF = Safe.
// SDN = Shutdown.
// SEE = See.
// SRC = Source.
// SRH = Search.
// SRV = Serve.
// SSP = Suspend.
// SYN = Syndicate.
// TIM = Time.
// TRF = Traffic.
// TRR = Turret.
// TSK = Task.
// UGR = Underground.
// True or False = What it says on the box. These are constants, so are CamelCased.
// = vs == - == is used to compare values. = is used to set a value.
// ? = Why
// ! = Not
// + = And

var UNDERGROUND_SOLOPATROL_DEFENSEMODE_ALERT_TEXT = "CWK.SRV(ATM); If RES.ATK(ATM) Then CWK.ATK(RES)", "CWK.TSK = DEF(ATM)", "If SEE.REC.RES Then CWK.ATK(RES)", "If RES.ATK(CWK) Then CWK.ATK(RES)", "If CWK.LOC == UGR Then CWK.ENM = RES + SYN + GHU + DES && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
// Translations: "Clockwork serves Antimatter. If Resistance attacks Antimatter, then Clockwork attacks Resistance.", "Clockwork's task is to defend Antimatter.", "If Clockwork sees Resistance perform reconaissance, then Clockwork attacks Resistance.", "If Resistance attacks Clockwork, then Clockwork attacks Resistance.", "If the clockwork's location is the Underground, then the Clockwork's enemies are the Resistance, the Syndicate, the Ghouls and the Destroyers and the clockwork's allies are the PPD. If the clockwork sees an enemy, the clockwork will attack the enemy."

var UNDERGROUND_PATROL_HUNTNKILL_INACTIVE_TEXT = "If CWK.SEE.RES.ALV Then CWK.ATK(RES)", "If RES == ALV Then CWK.ATK.(RES)", "If RES.ATK(CIT) Then CWK.DEF(CIT)", "CUR.TSK == RCN + SRH.RES; If SEE.RES.PPL Then CWK.ATK(RES); If SEE.RES.CWK Then CWK.SDN(RES.CWK)", "If CWK.LOC == UGR Then CWK.ENM = RES + SYN + GHU + DES && CWK.ALY = PPD"
//Translations: "If Clockwork sees a living Resistance fighter, then Clockwork attacks the Resistance fighter.", "If Resistance are alive, Clockwork attacks Resistance.", "If Resistance attacks citizens, then Clockwork defends citizens.", "The current task is to perform reconaissance and search for Resistance. If Clockwork sees Resistance people, then Clockwork attacks Resistance. If Clockwork sees Resistance Clockwork, then Clockwork shuts down Resistance Clockwork.", "If the clockwork's location is the Underground, then the Clockwork's enemies are the Resistance, the Syndicate, the Ghouls and the Destroyers and the clockwork's allies are the PPD."

var UNDERGROUND_PATROL_DEFENSEMODE_ALERT_TEXT = "CWK.SRV(ATM); If RES.ATK(ATM) Then CWK.ATK(RES)", "CWK.TSK = DEF(ATM)", "If SEE.REC.RES Then CWK.ATK(RES)", "If RES.ATK(CWK) Then CWK.ATK(RES)", "If CWK.LOC == UGR Then CWK.ENM = RES + SYN + GHU + DES && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
// Translations: ---See UNDERGROUND_SOLOPATROL_DEFENSEMODE_ALERT_TEXT---

var UNDERGROUND_DUOGUARD_INACTIVE_TEXT = "CWK.CUR.TSK == SRV(ATM) + DEF(UGR.FCL)", "If RES.ATK(CWK) Then CWK.ATK(RES); If RES.CWK.ATK(CWK) Then CWK.DSB(RES.CWK) + RPR(RES.CWK)", "P1232922256", "If TAR == PPD Then CWK.DEF(TAR) = True; If TAR != PPD Then CWK.DEF(TAR) != True"
// Translations: "The Clockwork's current task is serving Antimatter and defending the Underground facility.", "If Resistance attacks the clockwork, then the clockwork attacks the Resistance. If Resistance clockwork attack the clockwork, then the clockwork disables Resistance clockwork and repairs Resistance clockwork.", "The Underground condition is not safe. If target is alive, then target is not safe.", "If clockwork's target is PPD, then the clockwork defending the target is true. If clockwork's target is not PPD, then the clockwork defending the target is not true."

var UNDERGROUND_DUOGUARD_DEFENSEMODE_ALERT_TEXT = "CWK.SRV(ATM); If RES.ATK(ATM) Then CWK.ATK(RES)", "CWK.TSK = DEF(ATM)", "If SEE.REC.RES Then CWK.ATK(RES)", "If RES.ATK(CWK) Then CWK.ATK(RES)", "If CWK.LOC == UGR Then CWK.ENM = RES + SYN + GHU + DES && CWK.ALY = PPD; If CWK.SEE.ENM Then CWK.ATK(ENM)"
// Translations: ---See UNDERGROUND_SOLOPATROL_DEFENSEMODE_ALERT_TEXT---

var UNDERGROUND_WELDING_INACTIVE_TEXT = "P2842145138", "CWK.TSK = FIX(OBJ); EST.TIM(TSK) = 25.MIN", "If CWK.FIX(OBJ) Then CWK.SRV(ATM)", "CWK.ALT; CWK.FND.HCK(CUR.OBJ); CWK.PRR.TSK = FIX(OBJ)", "CWK.TSK == FIX(OBJ); If ALV Then AVD.PLM", "RMN.TIM(TSK) == 15.MIN; CWK.EFF == 92.PCT", "If CWK.TSK == FIX(OBJ) Then UGR != CMP"
// Translations: "The clockwork is searching object's records. Praetorian records for fixing this object equals six. Why is the object broken?", "The clockwork's task is to fix this object. The estimated time for this task is 25 minutes.", "If the clockwork fixes this object, then the clockwork has served Antimatter.", "Clockwork alert. Clockwork has found a hack in the current object. Clockwork priority task is to fix the object.", "The clockwork task is fixing this object. If alive, then avoid the plasma." "Remaining time for this task is 15 minutes. Clockwork's efficiency is 92%.", "If the clockwork's task is to fix an object, then the Underground is not complete."

var UNDERGROUND_WELDING_ALERTED_TEXT = "?RES.TSK == BRK(OBJ)", "CWK.TSK.FIX(OBJ); ?ENT.ATK(CWK)", "SSP.CWK.TSK.FIX(OBJ); INI.CWK.TSK.CMB(ENT)", "If CWK.TAR != ALV Then CWK.TSK.FIX(UGR)"
// Translations: "Why is the Resistance task to break objects?", "The clockwork's task is to fix the object. Why is the entity attacking the clockwork?", "Suspending the clockwork's task to fix the object. Initiating the clockwork's task to combat the entity.", "If the clockwork's target is dead, then the clockwork's task is to fix the Underground."

var UNDERGROUND_CWK_ANTIMATTER_OBSERVEWELDING_INACTIVE_TEXT = "While CWK.FIX(OBJ); CWK.TSK = DIA(OBJ)", "CWK.SRH.OBJ.REC; PRA.REC.OBJ.STT == BKN; CWK.TSK = FIX(OBJ)", "While OBJ.STT == BKN; CWK.TSK.FIX(OBJ) > CWK.TSK.CLN(UGR)", "EFF.(ATM.CWK) > EFF(PRA.BER.CWK); ATM.CWK > PRA.BER.CWK"
// Translations: "While clockwork fix this object, the clockwork's task equals diagnostics on the object.", "The clockwork is searching this object's records. Praetorian records for this object's state equal broken. The clockwork task is fixing this object.", "While the object's state equals broken, the clockwork's task to fix objects is more important that the clockwork's task to clean the Underground.", "The efficiency of Antimatter clockwork is greater than the efficiency of Neuron's clockwork. Antimatter's clockwork are greater than Neuron's clockwork."

var UNDERGROUND_CWK_ANTIMATTER_OBSERVEWELDING_ALERTED_TEXT = "If RES.ATK(CWK), CWK.TSK.ATK(RES) > CWK.TSK.FIX(OBJ)", "CWK.ALT; RES.TSK.BRK(OBJ); CWK.TSK.DEF(OBJ)"
// Translations; "If Resistance attack clockwork, then the clockwork task to attack Resistance is more important that the clockwork task to fix the object.", "Clockwork alert. The Resistance task is to break the object. The clockwork task is to defend the object."

var UNDERGROUND_WELDING_ACTIVE_TEXT = "CWK.FIX(OBJ); If CWK.STP(TSK) Then !OBJ(FIX)", "While !FIX(OBJ); CWK.TSK = FIX(OBJ)", "If ENM.ATK(CWK), Then CWK.TSK.DEF(CWK) > CWK.TSK.FIX(OBJ)"
// Translations: "Clockwork is fixing an object. If Clockwork stops task, then the object is not fixed.", "While the object is not fixed, the Clockwork task is fixing the object.", "If an enemy attacks Clockwork, then the Clockwork's task to defend Clockwork is more important than the Clockwork's task to fix objects."

var UNDERGROUND_DIGGING_ATTACKED_TEXT = "CWK.TSK.DIG = SSP; CWK.ATK.(ENM)", "SET.CWK(TAR) = ENM.ATK(CWK)", "P1289837610", "P765636916"
// Translations: "The Clockwork's task to dig is suspended. Clockwork attacks Enemy.", "Setting Clockwork's target to the Enemy attacking Clockwork.", "Searching algorithms for combat; Searching algorithms complete. Running attack protocols.", "The clockwork task to dig is not complete. The clockwork attacks the enemy."

var UNDERGROUND_CWK_ANTIMATTER_CHATTY_GROUP_TEXT = "P3108364508", "UGR != BKN; ?CWK.TSK == FIX(UGR)", "P1920718882", "P2914019733", "If CWK.SRV(ATM) && ATM.SRV(EMP.MCL) Then CWK.SRV(EMP.MCL)", "While UGR != BKN; CWK.TSK = FIX(UGR)"
// Translations: "If Resistance are dead, then the Underground is safe.", "The Underground is not broken. Why do the clockwork still fix the Underground?", "The Underground is safe and is 100% efficient", "If Antimatter is alive, then Antimatter's clockwork are safe.", "If the clockwork serve Antimatter and Antimatter serves Emperor Marcus Cole, then the clockwork serve Emperor Marcus Cole.", "While the Underground is broken, the clockwork will fix the Underground."

