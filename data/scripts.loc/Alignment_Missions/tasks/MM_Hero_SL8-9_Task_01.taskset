			LogicalName Ambush4
			MissionPlacement ScriptControlled
			MissionCount 1
			
			
			// Vars and Clues
			var VILLAIN_GROUP = Arachnos
			var BOSS_DISPLAYNAME = "P4260422440"
			var BOSS_DISPLAYINFO = "P856364347"
			var BOSS_VILLAIN = RoguesGallery_Silent_Blade_SL8-9
			var BOSS_INACTIVE_DIALOG = "P1482013419"
			var BOSS_ATTACK_DIALOG = "P856364347"
			var BOSS_AI_INACTIVE = Menace
			var BOSS_AI_ACTIVE = Combat
			var BOSS_TEAM = Monster
			var OVERRIDE_GANG = 0
			
			// Include the SpawnDef
			include scripts.loc/SpawnDefs/TaskIncluded/MissionMap/BBoss_Critter_Display_AI_Team_V0.spawninc
		}
	}
	
	// TaskSuccess Reward
	TaskSuccess
	{
		Dialog "P2899442253"
		PrimaryReward MissionOwner, HeroSwitch
		SecondaryReward MissionHelper, HeroSwitch
		ContactPoints 10
	}
	
	// ReturnSuccess Reward
	ReturnSuccess
	{
		Dialog "P856364347"
		RandomFameString "P3677733788"
	}
}




