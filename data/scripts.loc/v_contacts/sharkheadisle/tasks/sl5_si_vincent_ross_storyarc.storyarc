	Episode // five
	{
		////////////////////////////////////////////////////////////////////////////////////
		// Task Mission5
		//
		TaskDef taskMission taskLong taskRequired
		{
			Name Mission5
			
			
			// Vars and Clues
			
			Dialog Lorenz
			{
				QualifyRequires LorenzTask4 HasClue? ! VinceTask4 HasClue? ! && MarosTask4 HasClue? ! &&
				PageList Intro
				{
					list NotTaskOwner Intro2
					flags InOrder
				}
				
				Page NotTaskOwner
				{
					Text "P3447822136"
					Requires TaskOwner? !
					Answer
					{
						Text "P2385719541"
						Page "[Close]"
					}
					
				}
				
				Page Intro2
				{
					Text "P615227217"
