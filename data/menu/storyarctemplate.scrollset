	Region
	{
		Name StoryArcTemplate
		DisplayName "StoryArc"
		outer_ht 50
		inner_ht 50
		inner_wd 350
		ToolTip "StoryArcSettingsToolTip"
		PageName StoryArcSummary
		
		RegionSet
		{
			Name AddMission
			Button
			{
				Name "TitleSettings"
				ToolTip "TitleSettingsToolTip"

				ElementList
				{
					Name "StoryArcTitle"
					TextBlock "DefaultStoryArcTitle"
					ToolTip "StoryArcTitleToolTip"
					CharLimit 128

					Field Title
				}
				ElementList
				{
					Name "StoryArcDesc"
					ToolTip "StoryArcDescToolTip"
					CharLimit 128

					Field Description
				}
			}
			Button
			{
				Name "StoryArcContact"
				ToolTip "StoryArcContactToolTip"

				ElementList
				{
					Name "BuildContactList"
					ToolTip "ContactSelectToolTip"

					Field ContactCategory
				}
			}
			Button
			{
				Name "MoralityString"
				ToolTip "MoralityStringToolTip"

				ElementList
				{
					Name "EnumMorality"
					ToolTip "MoralitySelectToolTip"

					Field Morality
				}
			}
		}
	}

	Region
