				{
					Name "MissionSuccessDialog"
					ToolTip "MissionSuccessDialogToolTip"
					
					Field MissionSuccessDialog
				}
				ElementList
				{
					Name "MissionFailDialog"
					ToolTip "MissionFailDialogToolTip"
					
					Field MissionFailDialog
				}
			}
			Button 
			{
				Name "MissionSettings"
				ToolTip "MissionSettingsToolTip"

				ElementList
				{
					Name "BuildMissionRequirements"
					ToolTip "MissionRequirementsToolTip"

					Field MissionRequirements
					CheckBoxList 1

					Element
					{
						DisplayName "DefeatAllVillains"
						Text "DefeatAllVillains"
					}
					Element
					{
						DisplayName "DefeatAllVillainsInEndRoom"
						Text "DefeatAllVillainsInEndRoom"
					}
				}
				ElementList
				{
					Name "BuildVillainGroupList"
					ToolTip "VillainGroupListToolTip"

					Field VillainGroup
				}
				ElementList
				{
					Name "EnumPacing"
					ToolTip "PacingListToolTip"

					Field Pacing
				}
				ElementList
				{
					Name "TimeToComplete"
					ToolTip "TimeToCompleteToolTip"
					Field "CompletionTime"
					ValMin 0
					ValMax 240 // 4 hours

					Field CompletionTime
				}
			}
			Button 
			{
				Name "MissionMap"
				ToolTip "MissionMapToolTip"

				ElementList
				{
					Name "MapSetString"
					ToolTip "MapSetToolTip"
					
					Field MapSet
					Element
					{
						DisplayName "RandomString"
						Text "Random"
					}
				}
			}
			Button 
			{
				Name "MissionContactDialog"
				ToolTip "MissionContactDialogToolTip"

				ElementList
				{
					Name "ContactIntroduction"
					ToolTip "ContactIntroductionToolTip"
					
					Field ContactIntro
				}
				ElementList
				{
					Name "ContactSendOff"
					ToolTip "ContactSendOffToolTip"
					
					Field ContactSendOff
				}
				ElementList
				{
					Name "ContactAcceptMission"
					ToolTip "ContactAcceptMissionAcceptToolTip"
					
					Field MissionAccept
				}
				ElementList
				{
					Name "ContactStillBusy"
					ToolTip "ContactStillBusyToolTip"
					
					Field ContactStillBusy
				}
				ElementList
				{
					Name "ContactReturnSuccess"
					ToolTip "ContactReturnSuccessToolTip"
					
					Field ContactReturnSuccess
				}
				ElementList
				{
					Name "ContactReturnFail"
					ToolTip "ContactReturnFailToolTip"
					
					Field ContactMissionFail
				}
			}
		}
	}

