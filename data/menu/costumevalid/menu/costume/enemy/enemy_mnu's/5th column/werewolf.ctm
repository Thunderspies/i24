Origin
	Name "All"

	// COLORS
	//------------------------------------------------
	Include Menu/Costume/ColorPalettes/defaultSkin.ctm
	Include Menu/Costume/ColorPalettes/Villain_Palletes/Werewolfskin.ctm

//------------------------------------------------------------------------------------------------------------
// HEAD //////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Head"
		DisplayName "Head"

		BoneSet
			Name "Standard"
			DisplayName "Standard"

					
			// Head
			//------------------------------------------------------------
			GeoSet
				DisplayName "Head"
				BodyPart "Head"
				Info
					DisplayName "Head"
					Geo  "Nightwolf"
					Tex1 "Skin_Nightwolf_01a"
					Tex2 "Skin_Nightwolf_01b"
				End
			End
			GeoSet
				DisplayName "Hair"
				BodyPart "Hair"
				
				//--------------------------------
				Info				//\
					DisplayName "Hair"	// \
					Geo  "None"		//  \  Inside this block is what you want to copy,
					Tex1 "None"		//  /  each of these is a geometry and texture
					Tex2 "None"		// /
				End				///
				//--------------------------------
				Info				//\
					DisplayName "None"	// \
					Geo  "None"		//  \  Inside this block is what you want to copy,
					Tex1 "None"		//  /  each of these is a geometry and texture
					Tex2 "None"		// /
				End	
			End
		End
	End

//------------------------------------------------------------------------------------------------------------
// UPPER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Upper"
		DisplayName "Upper"

		BoneSet
			Name "Standard"
			DisplayName "Standard"

			// CHEST
			//------------------------------------------------------------
			GeoSet
				DisplayName "Chest"
				BodyPart "Chest"
				Info
					DisplayName "Chest"
					Geo  "Nightwolf"
					Tex1 "Skin_Nightwolf_01a"
					Tex2 "Skin_Nightwolf_01b"
				End
				
			End

			// CHEST DETAIL
			//------------------------------------------------------------
			GeoSet
				DisplayName "Chest Detail"
				BodyPart "ChestDetail"
				Info
					DisplayName "None"
					Geo  "Nightwolf"
					Tex1 "Skin_Nightwolf_01a"
					Tex2 "Skin_Nightwolf_01b"
				End
				Info
					DisplayName "None"
					Geo  "None"
					Tex1 "None"
					Tex2 "None"
				End
			End
			
			// GLOVES
			//------------------------------------------------------------
			GeoSet
				DisplayName "Gloves"
				BodyPart "Gloves"
				Info
					DisplayName "Hand"
					Geo  "Nightwolf"
					Tex1 "Skin_Nightwolf_01a"
					Tex2 "Skin_Nightwolf_01b"
				End
			End
		End
	End

//------------------------------------------------------------------------------------------------------------
// LOWER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------
	
	Region
		Name "Lower"
		DisplayName "Lower"

		BoneSet
			Name "Standard"
			DisplayName "Standard"

			// PANTS
			//------------------------------------------------------------
			GeoSet
				DisplayName "Pants"
				BodyPart "Pants"
				Info
					DisplayName "Hips"
					Geo  "Nightwolf"
					Tex1 "Skin_Nightwolf_01a"
					Tex2 "Skin_Nightwolf_01b"
				End
			End

			// BOOTS
			//------------------------------------------------------------
			GeoSet
				DisplayName "Boots"
				BodyPart "Boots"
				Info
					DisplayName "Feet"
					Geo  "Nightwolf"
					Tex1 "Skin_Nightwolf_01a"
					Tex2 "Skin_Nightwolf_01b"
				End
			End
		End 
	End
End