Origin
	Name "All"

	// COLORS
	//------------------------------------------------
	Include Menu/Costume/ColorPalettes/defaultSkin.ctm
	Include Menu/Costume/ColorPalettes/defaultBody.ctm

//------------------------------------------------------------------------------------------------------------
// HEAD //////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Head"

		BoneSet
			Name "Standard"

					
			// Head
			//------------------------------------------------------------
			GeoSet
				Name "Head"
				BodyPart "Head"
				Info
					Name "Head"
					Geo  "Rock_Beast"
					Tex1 "Rock_Beast"
					Tex2 "None"
				End
			End
		End
	End

//------------------------------------------------------------------------------------------------------------
// UPPER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Upper"

		BoneSet
			Name "Standard"

			// CHEST
			//------------------------------------------------------------
			GeoSet
				Name "Chest"
				BodyPart "Chest"
				Info
					Name "Chest"
					Geo  "Rock_Beast"
					Tex1 "Rock_Beast"
					Tex2 "None"
				End
				
			End

			// CHEST DETAIL
			//------------------------------------------------------------
			GeoSet
				Name "Chest Detail"
				BodyPart "ChestDetail"
				Info
					Name "Rocks1"
					Geo  "Rock_Beast_01"
					Tex1 "Rock_Beast"
					Tex2 "None"
				End
				Info
					Name "Rocks2"
					Geo  "Rock_Beast_02"
					Tex1 "Rock_Beast"
					Tex2 "None"
				End
			End
			
			// GLOVES
			//------------------------------------------------------------
			GeoSet
				Name "Gloves"
				BodyPart "Gloves"
				Info
					Name "Hand"
					Geo  "Rock_Beast"
					Tex1 "Rock_Beast"
					Tex2 "None"
				End
			End
		End
	End

//------------------------------------------------------------------------------------------------------------
// LOWER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------
	
	Region
		Name "Lower"

		BoneSet
			Name "Standard"

			// PANTS
			//------------------------------------------------------------
			GeoSet
				Name "Pants"
				BodyPart "Pants"
				Info
					Name "Hips"
					Geo  "Rock_Beast"
					Tex1 "Rock_Beast"
					Tex2 "None"
				End
			End

			// BOOTS
			//------------------------------------------------------------
			GeoSet
				Name "Boots"
				BodyPart "Boots"
				Info
					Name "Feet"
					Geo  "Rock_Beast"
