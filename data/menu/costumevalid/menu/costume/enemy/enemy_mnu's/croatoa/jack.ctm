		BoneSet
			Name "Standard"
			DisplayName "Standard"	

	// HAIR
	//------------------------------------------------------------
			GeoSet
				DisplayName "Hair"
				BodyPart "Hair"

				Info
					DisplayName "Hair"
					Geo  "Jack"
					Tex1 "Jack"
					Tex2 "Jack_Mask"
				End
			End

	// HEAD
