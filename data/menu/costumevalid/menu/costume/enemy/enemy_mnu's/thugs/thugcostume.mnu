//
// Uses VAR_META_COSTUME_CATEGORY to determine which meta group head/upper/lower to be in.
//
Button
	Code			CodeCostumeCategory
	Value			COSTUME_HEAD
	String			"Head"
	Var				VAR_HEAD_CATEGORY
	StringTable
					"Standard"
	EndStringTable
End




	Default	Value			GEO_HEAD 
	Default	String		"Head"

	Button
		Code		CodeMutuallyExclusiveCategory
	End

	
	Button
		Code			CodeAllAtOnceAdjustor
		Var				VAR_HEAD_SELECTOR
		StringTable		"Ski_Mask"
						"Face"
						"Skin_Thug_Ski_Mask_01a"
						"Skin_Thug_Ski_Mask_01b"
					"Bandanna"
						"Bandanna"
						"Skin_Thug_Bandanna_01a"
						"Skin_Thug_Bandanna_01b"
					"Thug_01"
						"Face"
						"Skin_Thug_Face01"
						"None"
					"Thug_02"
						"Face"
						"Skin_Thug_Face02"
						"None"
					"Bald"
						"Head"
						"Skin_Thug_Face01"
						"None"


					
						
		EndStringTable
	End

