Origin
	Name "All"

	// COLORS
	//------------------------------------------------
	Include Menu/Costume/ColorPalettes/defaultSkin.ctm
	Include Menu/Costume/ColorPalettes/defaultBody.ctm

//------------------------------------------------------------------------------------------------------------
// HEAD //////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Head"
		DisplayName "Standard"	

		BoneSet
			Name "Standard"
			DisplayName "Standard"	

			// HAIR
			//------------------------------------------------------------
				GeoSet
				DisplayName "Hair"
				BodyPart "Hair"
				
				Info
					DisplayName "Mohawk Short"
					Geo  "Mohawk_02"
					Tex1 "skin_01a"
					Tex2 "skin_01b"
				End

				Info
					DisplayName "Mohawk Tall"
					Geo  "Mohawk_01"
					Tex1 "skin_01a"
					Tex2 "skin_01b"
				End

				Info
					DisplayName "Topknot"
					Geo  "Top_knot"
					Tex1 "skin_01a"
					Tex2 "skin_01b"
				End

				Info
					DisplayName "Tall Spikey"
					Geo  "Spiky1"
					Tex1 "Style_01a"
					Tex2 "Style_01b"
				End



			End

			// HEAD
			//------------------------------------------------------------
			GeoSet
				DisplayName "Face"
				BodyPart "Head"
				
				Info
					DisplayName "Face 1"
					Geo  "Male_Dominatrix_Minion"
					Tex1 "Dominatrix_Minions_Male"
					Tex2 "mask"
				End
			End
		End
	End

//------------------------------------------------------------------------------------------------------------
// UPPER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Upper"
		DisplayName "Upper"

		BoneSet
			Name "Standard"
			DisplayName "Standard"

			// CHEST
			//------------------------------------------------------------
			GeoSet
				DisplayName "Chest"
				BodyPart "Chest"
				Info
					DisplayName "Chest 1"
					Geo  "Male_Dominatrix_Minion"
					Tex1 "Dominatrix_Minions_Male"
					Tex2 "None"
				End
			End

			// GLOVES
			//------------------------------------------------------------
			GeoSet
				DisplayName "Gloves"
				BodyPart "Gloves"
				Info
					DisplayName "Long Sleeve"
					Geo "Male_Dominatrix_Minion"
					Tex1 "Dominatrix_Minions"
					Tex2 "None"
				End
			End
		End
	End

//------------------------------------------------------------------------------------------------------------
// LOWER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------
	
	Region
		Name "Lower"
		DisplayName "Lower"

		BoneSet
			Name "Standard"
			DisplayName "Standard"

			// PANTS
			//------------------------------------------------------------
			GeoSet
				DisplayName "Pants"
				BodyPart "Pants"
				Info
					DisplayName "Pants 1"
					Geo  "Male_Dominatrix_Minion"
					Tex1 "Dominatrix_Minions"
					Tex2 "None"
				End
			End

			// BOOTS
			//------------------------------------------------------------
			GeoSet
				DisplayName "Boots"
				BodyPart "Boots"
				Info
					DisplayName "Combat Boots"
					Geo  "Male_Dominatrix_Minion"
					Tex1 "Dominatrix_Minions"
					Tex2 "None"
				End
			End
		End 
	End
End