Origin
	Name "All"

	// COLORS
	//------------------------------------------------
	Include Menu/Costume/ColorPalettes/defaultSkin.ctm
	Include Menu/Costume/ColorPalettes/defaultBody.ctm

//------------------------------------------------------------------------------------------------------------
// HEAD //////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Head"
		DisplayName "Standard"	

		BoneSet
			Name "Standard"
			DisplayName "Standard"	

	// HAIR
	//------------------------------------------------------------
			GeoSet
				DisplayName "Hair"
				BodyPart "Hair"

				Info
					DisplayName "Wolf Helmet"
					Geo  "MuMystic"
					Tex1 "!x_wolfarmor_hair"
					Tex2 "None"
				End	
			End

	// HEAD
	//------------------------------------------------------------
	GeoSet
		DisplayName "Face"
		BodyPart "Head"

		Info
			DisplayName "Wolf Head"
			Geo  "MuMystic"
			Tex1 "skin_wolf_01"
			Tex2 "None"
		End				
	End


	// EYE DETAIL
	//------------------------------------------------------------
	GeoSet
		DisplayName "Eye Detail"
		BodyPart "EyeDetail"

		Info
			DisplayName "None"
			Geo  "None"
			Tex1 "None"
			Tex2 "None"
		End	
	End

	// NECK
	//------------------------------------------------------------
	GeoSet
		DisplayName "Neck"
		BodyPart "Neck"
		Info
			DisplayName "Wolf Armor 01"
			Geo  "MuMystic"
			Tex1 "!x_wolfarmor_neck"
			Tex2 "None"
		End

		Info
			DisplayName "Wolf Armor 02"
			Geo  "Wolf_02"
			Tex1 "!x_wolfarmor_neck"
			Tex2 "None"
		End
	End
	End
End

