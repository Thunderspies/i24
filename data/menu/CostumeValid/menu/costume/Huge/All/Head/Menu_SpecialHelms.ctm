BoneSet
	Name "Special Helmets" // dont' change
	DisplayName "Special Helmets"

	//Face Scale
	Include Menu/Costume/Common/Face_Scale/Huge_faces_01.ctm

	//Face
	//------------------------------------------------------------

	GeoSet
		DisplayName "Face"
		BodyPart "Head"

		Include Menu/Costume/Huge/All/Head/Inc_Heads_PreOrder.ctm

	//Masks//------------------------------------------------------------

		Mask
			DisplayName "None"
			Name "none"
		End

		Include Menu/Costume/Huge/All/Head/Inc_Heads_Masked_Patterns.ctm
		Include Menu/Costume/Huge/All/Head/Inc_Heads_Standard_Patterns.ctm
	End

	//Helmet
	//------------------------------------------------------------

	GeoSet
		DisplayName "Helmet"
		BodyPart "Hair"
		Info
			COV 1
			DisplayName "Wolf Spider Helm"
			Geo  "V_Huge_HAIR.GEO/GEO_HAIR_V_LongFang"
			Tex1 "!x_wolfarmor_hair_nocolor"
			Tex2 "None"
			FX   "ENEMYFX\V_Wolf_Spiders\villain_wolf_spiders.fx"
			Key "PreOrder_WolfSpider_Helm"
		End

		Info
			COV 1
			DisplayName "Wolf Spider Red Helm"
			Geo  "V_Huge_HAIR.GEO/GEO_HAIR_V_LongFang"
			Tex1 "!x_mumystic_hair_nocolor"
			Tex2 "None"
			FX   "ENEMYFX\V_Wolf_Spiders\villain_wolf_spiders.fx"
			Key "PreOrder_WolfSpiderRed_Helm"
		End

		Info
			COV 1
			DisplayName "Mystic Helm"
			Geo  "V_Huge_HAIR.GEO/GEO_HAIR_V_MuMystic"
			Tex1 "!x_mumystic_hair_nocolor"
			Tex2 "None"
			FX   "ENEMYFX\V_MuMystics\villain_mumystics_preorder.fx"
			Key "PreOrder_Mystic_Helm"
		End

		Info
			COV 1
			DisplayName "Crab Spider Helm"
			Geo  "V_Huge_HAIR.GEO/GEO_HAIR_V_CrabSpider"
			Tex1 "!X_Arachnos_Crab_Spider_Face"
			Tex2 "None"
			FX  "ENEMYFX\V_Arachnos\crab_spiders\PreOrder_Helm\Arachnos_Crab_Eyes_Preorder.fx"
			Key "PreOrder_CrabSpider_Helm"
		End
	End
End