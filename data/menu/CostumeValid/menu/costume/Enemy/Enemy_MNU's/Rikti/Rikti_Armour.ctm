Origin
	Name "All"

	// COLORS
	//------------------------------------------------
	Include Menu/Costume/ColorPalettes/defaultSkin.ctm
	Include Menu/Costume/ColorPalettes/defaultBody.ctm

//------------------------------------------------------------------------------------------------------------
// HEAD //////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Head"
		DisplayName "Head"

		BoneSet
			Name "Standard"
			DisplayName "Standard"		

			// HEAD
			//------------------------------------------------------------
			GeoSet
				DisplayName "Head"
				BodyPart "Head"
				
				//--------------------------------
				Info				//\
					DisplayName "Flesh"		// \
					Geo  "Flesh"		//  \  Inside this block is what you want to copy,
					Tex1 "Skin_Rikti_Flesh_01a"		//  /  each of these is a geometry and texture
					Tex2 "None"		// /
				End				///
				//--------------------------------
								
				Info				
					DisplayName "Armoured"		
					Geo  "Armour"		
					Tex1 "Rikti_Armour_01a"	
					Tex2 "Rikti_Armour_01b"		
				End
				Info				
					DisplayName "Lone_Gunman"		
					Geo  "Lone_Gunman"		
					Tex1 "Rikti_Lone_Gunman_01a"
					Tex2 "Rikti_Armour_01b"	
				End
			End
			GeoSet
				DisplayName "Hair"
				BodyPart "Hair"
				Info
					DisplayName "None"
					Geo  "None"
					Tex1 "None"
					Tex2 "None"
				End
				Info
					DisplayName "Hair"
					Geo  "Armour"
					Tex1 "Rikti_Armour_01a"
					Tex2 "None"
				End
			End

			GeoSet
				DisplayName "Lone_Gunman"
				BodyPart "Neck"
				Info
					DisplayName	"None"
					Geo	"None"
					Tex1	"None"
					Tex2	"None"
				End

				Info
					DisplayName	"Lone_Gunman"
					Geo	"Lone_Gunman"
					Tex1	"Rikti_Lone_Gunman_01a"
					Tex2	"None"
				End
			End
		End
	End

//------------------------------------------------------------------------------------------------------------
// UPPER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Upper"
		DisplayName "Upper"

		BoneSet
			Name "Standard"
			DisplayName "Standard"

			// CHEST
			//------------------------------------------------------------
			GeoSet
				DisplayName "Chest"
				BodyPart "Chest"
				Info
					DisplayName "Armoured"
					Geo  "Armour"
					Tex1 "Rikti_Armour_01a"
					Tex2 "Rikti_Armour_Paint"
				End
				Info
					DisplayName "Lone_Gunman"
					Geo  "Lone_Gunman"
					Tex1 "Rikti_Lone_Gunman_01a"
					Tex2 "Rikti_Lone_Gunman_01b"
				End
				Mask
					Name	"Rikti_Armour_Paint"
				End
			End

			// GLOVES
			//------------------------------------------------------------
			GeoSet
				DisplayName "Gloves"
				BodyPart "Gloves"
				Info
					DisplayName "Armour"
					Geo  "Armour"
					Tex1 "Rikti_Armour_01a"
					Tex2 "Rikti_Armour_01b"
				End
				Info
					DisplayName "Lone_Gunman"
					Geo  "Lone_Gunman"
					Tex1 "Rikti_Armour_01a"
					Tex2 "Rikti_Armour_01b"
				End
			End
		End
	End

//------------------------------------------------------------------------------------------------------------
// LOWER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------
	
	Region
		Name "Lower"
		DisplayName "Lower"

		BoneSet
			Name "Standard"
			DisplayName "Standard"

			// PANTS
			//------------------------------------------------------------
			GeoSet
				DisplayName "Pants"
				BodyPart "Pants"
				Info
					DisplayName "Armour"
					Geo  "Armour"
					Tex1 "Rikti_Armour_01a"
					Tex2 "None"
				End
			End

			// BOOTS
			//------------------------------------------------------------
			GeoSet
				DisplayName "Boots"
				BodyPart "Boots"
				Info
					DisplayName "Armour"
					Geo  "Armour"
					Tex1 "Rikti_Armour_01a"
					Tex2 "Rikti_Armour_Paint"
				End
			End
		End 
	End
End