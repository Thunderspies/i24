Origin
	Name "All"

	// COLORS
	//------------------------------------------------
	Include Menu/Costume/ColorPalettes/defaultSkin.ctm
	Include Menu/Costume/ColorPalettes/defaultBody.ctm

//------------------------------------------------------------------------------------------------------------
// HEAD //////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Head"
		DisplayName "Standard"	

		BoneSet
			Name "Standard"
			DisplayName "Standard"	

			// HAIR
			//------------------------------------------------------------
			GeoSet
				DisplayName "Hair"
				BodyPart "Hair"

				Info
					DisplayName "None"
					Geo  "None"
					Tex1 "None"
					Tex2 "None"
				End
				Info
					DisplayName "Widow"
					Geo  "Widow"
					Tex1 "Widow_Long"
					Tex2 "None"
				End
			End

			// HEAD
			//------------------------------------------------------------
			GeoSet
				DisplayName "Face"
				BodyPart "Head"

				Info
					DisplayName "Widow Helm Round"
					Geo  "Widow_Helm_Round"
					Tex1 "!Widow_Shader_Helm"
					Tex2 "None"
				End	
				Info
					DisplayName "Widow Helm Flat"
					Geo  "Widow_Helm_Flat"
					Tex1 "!Widow_Shader_Helm"
					Tex2 "None"
				End	
				Info
					DisplayName "Widow 01"
					Geo  "Widow_Full"
					Tex1 "Skin_Widow"
					Tex2 "None"
				End			
			End


			// EYE DETAIL
			//------------------------------------------------------------
			GeoSet
				DisplayName "Eye Detail"
				BodyPart "EyeDetail"

				Info
					DisplayName "None"
					Geo  "None"
					Tex1 "None"
					Tex2 "None"
				End	
			End

			// NECK
			//------------------------------------------------------------
			GeoSet
				DisplayName "Neck"
				BodyPart "Neck"
				Info
					DisplayName "None"
					Geo  "None"
					Tex1 "None"
					Tex2 "None"
				End
				Info
					DisplayName "Widow"
					Geo  "Widow"
					Tex1 "!Widow_Shader_Neck"
					Tex2 "None"
				End
			End
		End
	End

