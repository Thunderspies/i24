Origin
	Name "All"

	// COLORS
	//------------------------------------------------
	Include Menu/Costume/ColorPalettes/defaultSkin.ctm
	Include Menu/Costume/ColorPalettes/boats.ctm

//------------------------------------------------------------------------------------------------------------
// HEAD //////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Head"
		BoneSet
			Name "Standard"

			// HAIR
			//------------------------------------------------------------
			GeoSet
				Name "Hair"
				BodyPart "Hair"
				
				//--------------------------------
				Info				//\
					Name "None"		// \
					Geo  "None"		//  \  Inside this block is what you want to copy,
					Tex1 "None"		//  /  each of these is a geometry and texture
					Tex2 "None"		// /
				End				///
				//--------------------------------
			End
		End
	End
//------------------------------------------------------------------------------------------------------------
// UPPER /////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Upper"

		BoneSet
			Name "Standard"

			// CHEST
			//------------------------------------------------------------
			GeoSet
				Name "Chest"
				BodyPart "Chest"
				Info
					Name "None"
					Geo  "Boat"
					Tex1 "Boat_2"
					Tex2 "None"
				End
				
			End

		End
	End

	Region
		Name "Lower"
		BoneSet
			Name "Standard"

			// PANTS
			//------------------------------------------------------------
			GeoSet
				Name "Pants"
				BodyPart "Pants"
				Info
					Name "None"
					Geo  "None"
					Tex1 "None"
					Tex2 "None"
				End
			End
		End
	End
End