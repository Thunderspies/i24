Origin
	Name "All"

	// COLORS
	//------------------------------------------------
	Include Menu/Costume/ColorPalettes/defaultSkin.ctm
	Include Menu/Costume/ColorPalettes/defaultBody.ctm

//------------------------------------------------------------------------------------------------------------
// HEAD //////////////////////////////////////////////////////////////////////////////////////////////////////
//------------------------------------------------------------------------------------------------------------

	Region
		Name "Head"
		DisplayName "Standard"	

		BoneSet
			Name "Standard"
			DisplayName "Standard"	

			// HAIR
			//------------------------------------------------------------
			GeoSet
				DisplayName "Helmet"
				BodyPart "Hair"

				Info
					DisplayName "Hat"
					Geo  "Hat"
					Tex1 "5C_Fog_Helmet_01"
					Tex2 "5C_Fog_Helmet_01b"
				End

				Info
					DisplayName "Facemask_01"
					Geo  "Facemask_01"
					Tex1 "5C_Night_Helmet_01"
					Tex2 "5C_Night_Helmet_01b"
				End

				Info
					DisplayName "Facemask_02"
					Geo  "Facemask_02"
					Tex1 "5C_Night_Helmet_01"
					Tex2 "5C_Night_Helmet_01b"
				End

				Info
					DisplayName "Facemask_03"
					Geo  "Facemask_03"
					Tex1 "5C_Night_Helmet_01"
					Tex2 "5C_Night_Helmet_01b"
				End
			End

			// HEAD
			//------------------------------------------------------------
			GeoSet
				DisplayName "Face"
				BodyPart "Head"
				
				Info
					DisplayName "Face 1"
					Geo  "Plain"
					Tex1 "Skin_5C_Trooper_01"
					Tex2 "None"
				End
			End

	// EYE DETAIL
	//------------------------------------------------------------
	GeoSet
		DisplayName "Eye Detail"
		BodyPart "EyeDetail"

		Info
			DisplayName "None"
			Geo  "None"
			Tex1 "None"
			Tex2 "None"
		End	
		Info
			DisplayName "Goggles"
			Geo  "Goggles"
			Tex1 "Lens_01a"
			Tex2 "Lens_01b"
		End	
	End

	// NECK
	//------------------------------------------------------------
	GeoSet
		DisplayName "Neck"
		BodyPart "Neck"
		Info
			DisplayName "None"
			Geo  "None"
			Tex1 "None"
			Tex2 "None"
		End

	End
	End
End

