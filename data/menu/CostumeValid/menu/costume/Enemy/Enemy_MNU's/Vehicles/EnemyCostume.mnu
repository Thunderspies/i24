//
// Uses VAR_META_COSTUME_CATEGORY to determine which meta group head/upper/lower to be in.
//
Button
	Code			CodeCostumeCategory
	Value			COSTUME_HEAD
	String			"Head"
	Var				VAR_HEAD_CATEGORY
	StringTable
					"Standard"
	EndStringTable
End




	Default	Value			GEO_HEAD 
	Default	String		"Head"

	Button
		Code		CodeMutuallyExclusiveCategory
	End

	
	Button
		Code			CodeAllAtOnceAdjustor
		Var				VAR_HEAD_SELECTOR
		StringTable		"Head1"
						"Head_Armour"
						"Rikti_Armour_01a"
						"None"

					"Head2"
						"Flesh"
						"Rikti_Flesh_01a"
						"None"


					
					
						
		EndStringTable
	End



			

Button
	Code			CodeCostumeCategory
	Value			COSTUME_UPPER_BODY
	String			"Upper Body"
	Var				VAR_UPPER_BODY_CATEGORY
	StringTable
					"Standard"
	EndStringTable
End



	


	Default	Value		GEO_SHIRT
	Default	String		"Chest"

	Button
		Code		CodeMutuallyExclusiveCategory
	End


	Button
		Code			CodeAllAtOnceAdjustor
		Var				VAR_SHIRT_SELECTOR
		StringTable		"Chest1"
						"Armour"
						"Rikti_Armour_01a"
						"None"

					
						
		EndStringTable
	End



	Default		Value	GEO_GLOVE
	Default		String		"Gloves"

Button
	Code		CodeMutuallyExclusiveCategory
End


	Button
		Code			CodeAllAtOnceAdjustor
		Var				VAR_GLOVE_SELECTOR

		StringTable		"Hand"
						"Armour"
						"Rikti_Armour_01a"
						"None"


		EndStringTable
	End



Button
	Code			CodeCostumeCategory
	Value			COSTUME_LOWER_BODY
	String			"Lower Body"
	Var				VAR_LOWER_BODY_CATEGORY
	StringTable
					"Standard"
	EndStringTable
End
 
	Default		Value	GEO_PANTS
	Default		String		"Pants"

	Button
		Code		CodeMutuallyExclusiveCategory
	End



	Button
		Code			CodeAllAtOnceAdjustor
		Var				VAR_PANT_SELECTOR
		StringTable		"Hips"
						"Armour"
						"Rikti_Armour_01a"
						"None"
						
		EndStringTable
	End



	Default		Value	GEO_BOOT
	Default		String		"Boots"

Button
	Code		CodeMutuallyExclusiveCategory
End


	Button
		Code			CodeAllAtOnceAdjustor
		Var				VAR_BOOT_SELECTOR

		StringTable		"Feet"
						"Armour"
						"Rikti_Armour_01a"
						"None"
		
					"None"
						"None"
						"None"
						"None"

	
		EndStringTable
	End

