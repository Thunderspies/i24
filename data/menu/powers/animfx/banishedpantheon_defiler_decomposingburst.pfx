// -------------------------  ANIMATION RELATED FIELDS --------------------------------//
	ModeBits			ANIM_COMBAT
	AttackBits			ANIM_COMBAT, ANIM_BALLCAST //ANIM_COMBAT, ANIM_2HAND, ANIM_CAST
	HitBits				ANIM_HIT, ANIM_QUICK
	FramesBeforeHit			90
	AttackFrames			50

// -------------------------  FX RELATED FIELDS  --------------------------------------//
	AttackFx			"ENEMYFX\BanishedPantheon\BanishedPantheon_Revamped\Defiler_FrigidBurst_Attack.fx"
	DelayedHit			1
	ProjectileSpeed			42
	HitFX				"ENEMYFX\BanishedPantheon\BanishedPantheon_Revamped\FrigidBurst_Hit.fx"

	PrimaryTint			100 200 255
	SecondaryTint			50 75 100


