// -------------------------  ANIMATION RELATED FIELDS --------------------------------//
	ModeBits			ANIM_COMBAT
	AttackBits			ANIM_COMBAT, ANIM_MARTIALASSAULT, ANIM_STAB
	HitBits				ANIM_HIT, ANIM_QUICK
	BlockBits			ANIM_BLOCK
	FramesBeforeHit			8
	AttackFrames			30

//// -------------------------  FX RELATED FIELDS  --------------------------------------//
	AttackFX			"CustomizeablePowers\MartialAssault\MasterfulThrow.fx"
	HitFX				"CustomizeablePowers\Brawling\AssassinsStrike_Hit.fx"
	DelayedHit    			1
	ProjectileSpeed			45

	PrimaryTint			255 175 0
	SecondaryTint			75 0 255


