	FramesBeforeHit			6
	AttackFrames			24

//// -------------------------  FX RELATED FIELDS  --------------------------------------//
	PrimaryTint			255 126 48
	SecondaryTint			89 0 0

	AttackFX			"CustomizeablePowers\Brawling\InitialStrike_Attack.fx"
	HitFX				"CustomizeablePowers\Brawling\InitialStrike_Hit.fx"

