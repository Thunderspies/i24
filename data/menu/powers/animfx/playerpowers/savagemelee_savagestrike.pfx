// -------------------------  ANIMATION RELATED FIELDS --------------------------------//
	ModeBits			ANIM_COMBAT
	AttackBits			ANIM_COMBAT, ANIM_WIDOWSLASH, ANIM_ANGRY, ANIM_QUICK
	HitBits				ANIM_BRAWLING, ANIM_HIT, ANIM_QUICK
