//		BRIAN_ANIMATIONS "RANGED BURST"						// name given to power
		BlockBits			ANIM_BLOCK				// bit to set the action for receiving character
//		WindupBits			ANIM_WINDUP				// mainly for a long "fill" or "charge" power that has a pre state before exectution	
		ModeBits			ANIM_COMBAT				// mode set for pilot character... can be others but for the most part its combat
		AttackBits			ANIM_COMBAT, ANIM_CRABPACKRANGEDBURST	// bits set in ...\game\data\sequencer\statebits.statebits
		HitBits				ANIM_HIT, ANIM_QUICK			// bits set for receiver of power after hit frame
		FramesBeforeHit			35					// hit frame, or frame at which the receivers animation set by HitBits are played
		AttackFrames			90					// frame at which the anim is now interuptable

// -------------------------  FX RELATED FIELDS  --------------------------------------//
		InitialAttackFX			"V_COV\EnemyPowers\Arachnos\Crab_Attack_RangedBurst.fx"
		AttackFX			"V_COV\EnemyPowers\Arachnos\Crab_Attack_RangedBurst.fx"
		HitFX				"WEAPONFX\MachineGunHit.fx"

