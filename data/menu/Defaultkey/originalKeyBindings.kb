
KeyProfile

	DisplayName	OptionOriginal
	Name		Original

// MOVEMENT ----------------------------------------------------------------

	KeyBind
		key	w
		command	+forward
	End

	KeyBind
		key	uparrow
		command	+forward
	End

	KeyBind
		key	v
		command	+ctm_invert
	End

	KeyBind
		key	a
		command	+left
	End

	KeyBind
		key	s
		command	+backward
	End

	KeyBind
		key	downarrow
		command	+backward
	End

	KeyBind
		key	 d
		command  +right
	End

	KeyBind
		key	 q
		command  +turnleft
	End

	KeyBind
		key	 e
		command  +turnright
	End

	KeyBind
		key	 leftarrow
		command  +turnleft
	End

	KeyBind
		key	 rightarrow
		command  +turnright
	End

	KeyBind
		key	 r
		command  ++autorun
	End

	KeyBind
		key	 f
		command  follow
	End

	KeyBind
		key	 space
		command  +up
	End

	KeyBind
		key	 x
		command  +down
	End

// VIEW -------------------------------------------------------------------------

	KeyBind
		key	 rbutton
		command  +mouse_look
	End


	KeyBind
		key	 PAGEUP
		command  +camrotate
	End

	KeyBind
		key	 mbutton
		command	 +camrotate
	End

	KeyBind
		key	 PAGEDOWN
		command  camreset
	End

	KeyBind
		key	 b
		command  ++first
	End

	KeyBind
		key	mousewheel
		command +camdistadjust
	End

	Keybind
		key home
		command "+zoomin"
	End

	Keybind
		key end
		command "+zoomout"
	End

	Keybind
		key insert
		command "+lookup"
	End

	Keybind
		key delete
		command "+lookdown"
	End

// CHAT -------------------------------------------------------------------------

	KeyBind
		key	enter
		command "show chat$$startchat"
	End

	KeyBind
		key	"/"
		command "show chat$$slashchat"
	End

	KeyBind
		key	";"
		command "show chat$$beginchat ;"
	End

	KeyBind
		key Backspace
		command autoreply
	End

	KeyBind
		key comma
		command "show chat$$beginchat /tell $target, "
	End

	KeyBind
		key '
		command quickchat
	End

// POWERS -------------------------------------------------------------------------

	KeyBind
		key z
		command powexec_abort
	End

	// Power exec on main tray /////////////////////////////////////////
	KeyBind
		key 1
		command "powexec_slot 1"
	End
	KeyBind
		key 2
		command "powexec_slot 2"
	End
	KeyBind
		key 3
		command "powexec_slot 3"
	End
	KeyBind
		key 4
		command "powexec_slot 4"
	End
	KeyBind
		key 5
		command "powexec_slot 5"
	End
	KeyBind
		key 6
		command "powexec_slot 6"
	End
	KeyBind
		key 7
		command "powexec_slot 7"
	End
	KeyBind
		key 8
		command "powexec_slot 8"
	End
	KeyBind
		key 9
		command "powexec_slot 9"
	End
	KeyBind
		key 0
		command "powexec_slot 10"
	End

	// Power exec on alt tray /////////////////////////////////////////
	KeyBind
		key lalt+1
		command "powexec_altslot 1"
	End
	KeyBind
		key lalt+2
		command "powexec_altslot 2"
	End
	KeyBind
		key lalt+3
		command "powexec_altslot 3"
	End
	KeyBind
		key lalt+4
		command "powexec_altslot 4"
	End
	KeyBind
		key lalt+5
		command "powexec_altslot 5"
	End
	KeyBind
		key lalt+6
		command "powexec_altslot 6"
	End
	KeyBind
		key lalt+7
		command "powexec_altslot 7"
	End
	KeyBind
		key lalt+8
		command "powexec_altslot 8"
	End
	KeyBind
		key lalt+9
		command "powexec_altslot 9"
	End
	KeyBind
		key lalt+0
		command "powexec_altslot 10"
	End

	// Inspiration exec  ////////////////////////////////////////////
	KeyBind
		key f1
		command "inspexec_slot 1"
	End
	KeyBind
		key f2
		command "inspexec_slot 2"
	End
	KeyBind
		key f3
		command "inspexec_slot 3"
	End
	KeyBind
		key f4
		command "inspexec_slot 4"
	End
	KeyBind
		key f5
		command "inspexec_slot 5"
	End

// TRAY -------------------------------------------------------------------------

	KeyBind
		key lalt
		command +alttray
	End

	KeyBind
		key ralt
		command alttraysticky
	End

	KeyBind
		key equals
		command next_tray
	End

	KeyBind
		key -
		command prev_tray
	End

	KeyBind
		key lalt+equals
		command next_tray_alt
	End

	KeyBind
		key lalt+-
		command prev_tray_alt
	End

	KeyBind
		key lcontrol+1
		command "goto_tray 1"
	End
	KeyBind
		key lcontrol+2
		command "goto_tray 2"
	End
	KeyBind
		key lcontrol+3
		command "goto_tray 3"
	End
	KeyBind
		key lcontrol+4
		command "goto_tray 4"
	End
	KeyBind
		key lcontrol+5
		command "goto_tray 5"
	End
	KeyBind
		key lcontrol+6
		command "goto_tray 6"
	End
	KeyBind
		key lcontrol+7
		command "goto_tray 7"
	End
	KeyBind
		key lcontrol+8
		command "goto_tray 8"
	End
	KeyBind
		key lcontrol+9
		command "goto_tray 9"
	End
	KeyBind
		key lcontrol+0
		command "goto_tray 10"
	End

// TEAM -------------------------------------------------------------------------

	KeyBind
		key lshift+1
		command "team_select 1"
	End
	KeyBind
		key lshift+2
		command "team_select 2"
	End
	KeyBind
		key lshift+3
		command "team_select 3"
	End
	KeyBind
		key lshift+4
		command "team_select 4"
	End
	KeyBind
		key lshift+5
		command "team_select 5"
	End
	KeyBind
		key lshift+6
		command "team_select 6"
	End
	KeyBind
		key lshift+7
		command "team_select 7"
	End
	KeyBind
		key lshift+8
		command "team_select 8"
	End


// WINDOWS -------------------------------------------------------------------------

	KeyBind
		key m
		command "map"
	End

	KeyBind
		key n
		command "nav"
	End

	KeyBind
		key p
		command "powers"
	End

	KeyBind
		key "\"
		command "menu"
	End

	KeyBind
		key t
		command "target"
	End

	KeyBind
		key c
		command "chat"
	End

	KeyBind
		key h
		command "helpwindow"
	End

// MISC -----------------------------------------------------------------------------------------

	KeyBind
		key	 tab
		command  target_enemy_next
	End

	KeyBind
		key	 lctrl+tab
		command  target_enemy_near
	End

	KeyBind
		key	 rctrl+tab
		command  target_enemy_near
	End

	KeyBind
		key	 lshift+tab
		command  target_enemy_prev
	End

	KeyBind
		key	 rshift+tab
		command  target_enemy_prev
	End

	KeyBind
		key	 esc
		command  unselect
	End

	KeyBind
		key sysrq
		command screenshot
	End

	KeyBind
		key f6
		command "local <color white><bgcolor red>RUN!"
	End

	KeyBind
		key f7
		command "say <color black><bgcolor #22aa22>Ready! $$ emote thumbsup"
	End

	KeyBind
		key f8
		command "local <color black><bgcolor #aaaa22>HELP! $$ emote whistle"
	End

	KeyBind
		key f9
		command "local <color white><bgcolor #2222aa><scale .75>level $level $archetype$$local <color white><bgcolor #2222aa>Looking for team"
	End

	KeyBind
		key f10
		command "say $battlecry $$ emote attack"
	End
End
