// -------------------------  ANIMATION RELATED FIELDS --------------------------------//
	ModeBits			ANIM_COMBAT
	AttackBits			ANIM_COMBAT, ANIM_WIDOWSLASH, ANIM_ANGRY, ANIM_TERRIFY
	HitBits				ANIM_HIT, ANIM_WIDOWSLASH, ANIM_ANGRY, ANIM_TERRIFY
	BlockBits			ANIM_BLOCK
	FramesBeforeHit			16
	AttackFrames			50

//// -------------------------  FX RELATED FIELDS  --------------------------------------//
	PrimaryTint			255 126 48
	SecondaryTint			89 0 0

	AttackFX			"CustomizeablePowers\Brawling\SpinningStrike_Attack.fx"
	HitFX					"CustomizeablePowers\Brawling\SpinningStrike_Hit.fx"

