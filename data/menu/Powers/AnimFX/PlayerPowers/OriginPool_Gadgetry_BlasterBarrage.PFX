// -------------------------  ANIMATION RELATED FIELDS --------------------------------//
	ModeBits			ANIM_COMBAT
	AttackBits			ANIM_COMBAT, ANIM_ORIGINPOOL, ANIM_DRONE, ANIM_SIX
	HitBits				ANIM_HIT, ANIM_QUICK
	FramesBeforeHit			21
	AttackFrames			90

// -------------------------  FX RELATED FIELDS  --------------------------------------//
	AttackFx			"POWERS\psionics\TelekineticBlast.fx"
	HitFx				"POWERS\Psionics\TelekineticHit.fx"
	DelayedHit			1
	ProjectileSpeed			120

