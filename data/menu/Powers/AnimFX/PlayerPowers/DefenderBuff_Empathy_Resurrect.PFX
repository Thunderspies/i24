// -------------------------  ANIMATION RELATED FIELDS --------------------------------//
	WindupBits			ANIM_WINDUP
	ModeBits			ANIM_COMBAT
	AttackBits			ANIM_COMBAT, ANIM_LEVITATE
	FramesBeforeHit			15
	AttackFrames			96

// -------------------------  FX RELATED FIELDS  --------------------------------------//
	WindupFx			"POWERS\Healing\ResurectionHands.fx"
	AttackFx			"POWERS\Healing\Resurection.fx"

CustomFX "Color Tintable"
// -------------------------  ANIMATION RELATED FIELDS --------------------------------//
	WindupBits			ANIM_WINDUP
	ModeBits			ANIM_COMBAT
	AttackBits			ANIM_COMBAT, ANIM_LEVITATE
	FramesBeforeHit			15
	AttackFrames			96

// -------------------------  FX RELATED FIELDS  --------------------------------------//
        Palette                         "Additive"
	WindupFx			"CustomizeablePowers\Empathy\ResurectionHands.fx"
	AttackFx			"CustomizeablePowers\Empathy\Resurection.fx"
End

