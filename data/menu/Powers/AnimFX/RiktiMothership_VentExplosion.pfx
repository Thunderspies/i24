// -------------------------  ANIMATION RELATED FIELDS --------------------------------//
// ModeBits                    // mode set for pilot character... can be others but for the most part its combat                                                  
// ModeBits                     // obs data 
// AttackBits                  // bits set in ...\game\data\sequencer\statebits.statebits
// BlockBits                   // bit to set the action for receiving character
// WindUpBits                  // "build up" mainly for a long "fill" or "charge" power that has a pre state before exectution
// HitBits                     // bits set for receiver of power after hit frame
// DeathBits                   // bits for receipient to call his death from seq
// ActivationBits              // onetime powerups or toggles
// DeactivationBits            // onetime powerdown or toggle deactivated                    
// InitialFramesBeforeHit      // frames before hit on initial attack
// FramesBeforeHit             // hit frame, or frame at which the receivers animation set by HitBits are played
// AttackFrames                // frame at which the anim is now interuptable
// InitialAttackBits           // ?????
// InitialFramesBeforeBlock    // delay on block fx **not implemented yet**
// FramesBeforeBlock           // obvious
// InitialAttackFXFrameDelay   10

// -------------------------  FX RELATED FIELDS  --------------------------------------//
AttackFX                    "Explosions\RiktiMothershipVent\RiktiMothershipVent_Explosion.fx"