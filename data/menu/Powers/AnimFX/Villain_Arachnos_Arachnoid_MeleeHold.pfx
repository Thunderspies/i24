//		BRIAN_ANIMATIONS "SLASH"						// name given to power
		BlockBits			ANIM_BLOCK				// bit to set the action for receiving character
		AttackBits			ANIM_COMBAT, ANIM_SPINCOCOON		// bits set in ...\game\data\sequencer\statebits.statebits
		HitBits				ANIM_HIT, ANIM_QUICK			// bits set for receiver of power after hit frame
		FramesBeforeHit			18					// hit frame, or frame at which the receivers animation set by HitBits are played
		AttackFrames			26					// frame at which the anim is now interuptable

