//		BRIAN_ANIMATIONS "Cone"						// name given to power
		BlockBits			ANIM_BLOCK				// bit to set the action for receiving character
//		WindupBits			ANIM_WINDUP				// mainly for a long "fill" or "charge" power that has a pre state before exectution	
		ModeBits			ANIM_COMBAT				// mode set for pilot character... can be others but for the most part its combat
		AttackBits			ANIM_COMBAT, ANIM_CRABPACKMELEBURST	// bits set in ...\game\data\sequencer\statebits.statebits
		HitBits				ANIM_HIT, ANIM_QUICK			// bits set for receiver of power after hit frame
		FramesBeforeHit			21					// hit frame, or frame at which the receivers animation set by HitBits are played
		AttackFrames			50					// frame at which the anim is now interuptable

// -------------------------  FX RELATED FIELDS  --------------------------------------//

		AttackFX			"V_COV\EnemyPowers\ArchVillains\Lord_Recluse\F_Streak_MeleCone.fx"
		HitFX				"V_COV\EnemyPowers\Arachnos\Crab_MeleHit.fx"