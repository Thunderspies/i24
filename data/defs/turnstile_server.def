// Turnstile server config

// Mission defs
// Mission name.  This is really an internal identifier.  There will be a corresponding localization
// entry, the name of which is generated procedurally.
//Mission         ITF
//{
// Category is Trial, IncarnateTrial, or HolidayTrial
//    Category		Trial

// MinimumPlayers is the minimum needed to start this
//    MinimumPlayers	1

// PickupMinPlayers is the minimum used by the turnstile when it auto groups
// If not specified, it will use the minimum number of players
// If a group owns the mission, it will not use this minimum
    
// Maximum players is the maximum this content can handle
//    MaximumPlayers	8
    
// Delay after reaching MinimumPlayers at which the event get started, in seconds
//  StartDelay          60
    
// Requires is a requires statement that determines if the player is eligible
// TODO remove the quotes, use TOK_STRINGARRAY instead of TOK_STRING, and simply the code that actually evaluates these.
//    Requires		"InTaskforce char> ! level char> 35 >= &&"

// Type says what do do with the group when it's assembled
//  Type		Instance
    
// Zone means port the party to a given location in a given zone
// Instance means port everyone into an instance

// For a Zone type mission, MapName specifies the map to send players to
// For an Instance type mission, MapName specifies the mission map to use
//  MapName             maps/Missions/David/David_Test_30/David_Test_30.txt
    
// For in Instance mission Location states the name of the door spawnin property.  Usually "MissionStart", except that breaks
// if the map uses doors that have baked in MissionStart beacons.
// For contact type events, the script is the contact name
//  Location		EndGameStart

// For a Zone type mission, Pos gives the x,y,z location
//  Pos			0 0 0
    
// For a Zone type mission, Contact gives contact to teleport to
// What is the syntax for this?  Check the Ouroboros cose that does the current "teleport to contact" trickery.  That *MIGHT* also
// remove the need for the map.
//  Contact		Statesman

// For a Zone type mission, Radius specifies a random radius around pos
// to spread players out, so they don't all arrive at exactly the same
// place
//  Radius             8

// Script specifies thae name of the scriptdef to use to kick off the end game raid script.  If not given, nothing is started - this might
// prove useful if we ever see our way to running hami raids in instances.  Just kick start the map,
// For contact type events, the script is the contact name
// Script		50plusLambdaSector
//}

//Mission         TestContact
//{
//    Category		TaskforceContact
//    MinimumPlayers	4    
//    PickupMinPlayers	6
//    MaximumPlayers	8
//    StartDelay          90
//    LevelShift          0
//    Type		Contact
//    Script		Valkyrie
//    Location		Valkyrie
//}
Mission         LambdaSectorLua
{
    Category		IncarnateTrial
    MinimumPlayers	1
    MaximumPlayers	16
    StartDelay          0
    LevelShift          4
    Requires		"accesslevel char> 0 >"
    HideIf		"accesslevel char> 0 <="
    Type		Instance
    MapName             maps/Missions/P_Endgame/LambdaSector/P_LambdaSector.txt
    Location		MissionStart
    Script		Lua/LuaLambda
}
Mission         Magisterium
{
    Category		IncarnateTrial
    MinimumPlayers	12
    MaximumPlayers	24
    StartDelay          90
    LevelShift          4
    Requires		"isVIP? level char> 50 >= && IncarnateLoreSlot owned? && IncarnateDestinySlot owned? &&"
    HideIf		"isVIP? level char> 50 >= && ! IncarnateLoreSlot owned? ! || IncarnateDestinySlot owned? ! ||"
    Type		Instance
    MapName             maps/Missions/P_Endgame/Magisterium/P_Magisterium.txt
    Location		MissionStart
    Script		50plusMagisterium
}
