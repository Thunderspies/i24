//
// This file specifies the effectiveness of a boost when it's better than
// the character.
//
// The character combat level is subtracted from the boosts's level (plus
// the number of times it's been combined). If the value is positive, then
// the boost is better than than the combat level and the table below is
// used.
//
// Otherwise, the the table in boost_effect_below is used.
//

{
	// Boost level is above the character's combat level
	//              Same,   +1,   +2,   +3,  beyond this is 0.0
	Effectiveness   1.00, 1.05, 1.10, 1.15
}
