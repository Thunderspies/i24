//
// This file is for Villains combat mods. It is used when a player is the
// caster.
//

CombatMods
{
	//
	// These tables specify the change in ToHit for a power, and Magnitude and
	// Duration of attribmods depending on the difference in level between the
	// two combatants.
	//
	// The change is represented as a percentage from "normal". Numbers less than
	// 1.0 reduce, numbers large than one enhance.
	//
	// If the target of an attack is higher level than the attacker, then the
	// HigherLevel set is used. Otherwise, the LowerLevel set is used.
	//

