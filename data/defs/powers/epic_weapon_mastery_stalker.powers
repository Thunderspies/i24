		DisplayVictimHit     "P3994348305"
		StackType            kStack
		Requires             enttype target> critter eq  kMeter source> .9 < && arch source> class_stalker eq &&
		MagnitudeExpr        30 source.TeamSize> 0.03 * 0.07 + rand >= @StdResult *
		// Additional Power Attribs
		DisplayOnlyIfNotZero true
		DisplayFloat         "P2440464263"
	}

	AttribMod
	{
		Name                 "Damage"                      
		Table                "Melee_Damage"                
		Aspect               kAbs
		Attrib               kLethal
		Target               kTarget
		Scale                1
		Type                 kMagnitude
		AllowStrength        kTrue
		AllowResistance      kTrue
		Delay                0
		Duration             0
		Magnitude            1
		Period               0
		Chance               0.500
		NearGround           kFalse
		CancelOnMiss         kFalse
		DisplayAttackerHit   "P3728178801"
		DisplayVictimHit     "P3994348305"
		StackType            kStack
		Requires             kMeter source> 0 > enttype target> critter eq && arch source> class_stalker eq &&
		DisplayFloat         "P2440464263"
	}
}
