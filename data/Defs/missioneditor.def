MissionList
{
	// All StoryTask Fields will be listed under here
	Properties
	{
		Name	"Main"
		Type	Category

		Properties
		{
			Name	"Name"
			Type	TextBox
		}
		Properties
		{
			Name	"VillainGroup"
			Type	ComboBox
			ForceAutoSave
		}
		Properties
		{
			Name	"MinPlayerLevel"
			Type	IntegerSlider
			Min	1
			Max	50
		}
		Properties
		{
			Name	"MaxPlayerLevel"
			Type	IntegerSlider
			Min	1
			Max	50
		}
		Properties
		{
			Name	"ForceTaskLevel"
			Type	IntegerSlider
			Min	0
			Max	50
		}
		Properties
		{
			Name	"TimeToComplete"
			Type	TextBox
		}
		Properties
		{
			Name	"RandomNPCs"
			Type	TextBox
		}
		Properties
		{
			Name	"CityZone"
			Type	ComboTextBox
			Strings "", "WhereIssued", "City_00_01", "City_01_01", "City_01_02", "City_01_03", "City_02_01", "City_02_02", "City_02_03", "City_02_04", "City_03_01", "City_03_02", "City_03_03", "City_04_01", "City_04_02", "City_05_01", "Hazard_01_01", "Hazard_01_02", "Hazard_01_03", "Hazard_01_02c", "Hazard_02_01", "Hazard_03_01", "Hazard_03_02", "Hazard_04_01", "Hazard_05_01", "Hazard_06_01", "Hazard_06_02", "Hazard_06_03", "Hazard_06_03_chantry", "Trial_01_01", "Trial_01_02", "Trial_02_01", "Trial_03_01", "Trial_04_01", "Trial_04_02", "Trial_05_01", "Trial_06_01", "V_City_00_01", "V_City_01_01", "V_City_01_02", "V_City_02_01", "V_City_03_01", "V_City_03_02", "V_City_04_01", "V_City_05_01", "V_PvP_02_01", "V_PvP_03_01", "V_PvP_04_01", "V_PvP_05_01"
		}
		Properties
		{
			Name	"DoorType"
			Type	TextBox
		}
		Properties
		{
			Name	"LocationName"
			Type	TextBox
		}
		Properties
		{
			Name	"DayNightCycle"
			Type	ComboBox
			Strings "Normal", "AlwaysNight", "AlwaysDay", "FastCycle"
		}
		Properties
		{
			Name	"ClueDef"
			Type	Button
			Strings	"Edit Clues"
			Callback "meditClueList"
		}
	}

	// All strings for the task/mission are located here
	Properties
	{
		Name	"Strings"
		Type	Category

		Properties
		{
			Name	"IntroString"
			Type	TextBox
		}
		Properties
		{
			Name	"AcceptString"
			Type	TextBox
		}
		Properties
		{
			Name	"SendoffString"
			Type	TextBox
		}
		Properties
		{
			Name	"YoureStillBusyString"
			Type	TextBox
		}
		Properties
		{
			Name	"ActiveTaskString"
			Type	TextBox
		}
		Properties
		{
			Name	"TaskCompleteDescription"
			Type	TextBox
		}
		Properties
		{
			Name	"TaskFailedDescription"
			Type	TextBox
		}
		Properties
		{
			Name	"EntryString"
			Type	TextBox
		}
		Properties
		{
			Name	"ExitStringFail"
			Type	TextBox
		}
		Properties
		{
			Name	"ExitStringSuccess"
			Type	TextBox
		}
	}

	// All task/mission flags are in this dropdown menu
	Properties
	{
		Name	"Mission Flags"
		Type	Category

		Properties
		{
			Name	"Flags"
			Type	CheckBoxList
			Strings "NoTeleportOnComplete", "NoBaseHospital"
		}
		Properties
		{
			Name	"TaskFlags"
			Type	CheckBoxList
			Strings "taskLong", "taskShort", "taskRequired", "taskRepeatOnFailure", "taskRepeatOnSuccess", "taskUrgent", "taskUnique", "taskDontReturnToContact", "taskHeist", "taskNoTeamComplete", "taskSupergroup", "taskEnforceTimeLimit"
		}
	}

	// All task related reward are in this dropdown menu
	Properties
	{
		Name	"Rewards"
		Type	Category

		Properties
		{
			Name	"CanCompleteWith"
			Type	TextBox
		}
		Properties
		{
			Name	"CanFailWith"
			Type	TextBox
		}
		Properties
		{
			Name	"TaskBegin"
			Type	Button
			Strings	"Edit Reward"
			Callback "meditReward"
		}
		Properties
		{
			Name	"TaskSuccess"
			Type	Button
			Strings	"Edit Reward"
			Callback "meditReward"
		}
		Properties
		{
			Name	"TaskFailure"
			Type	Button
			Strings	"Edit Reward"
			Callback "meditReward"
		}
		Properties
		{
			Name	"ReturnSuccess"
			Type	Button
			Strings	"Edit Reward"
			Callback "meditReward"
		}
		Properties
		{
			Name	"ReturnFailure"
			Type	Button
			Strings	"Edit Reward"
			Callback "meditReward"
		}
	}
}

