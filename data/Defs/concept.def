Concept Brimstone
{
    AttribModGroup Var_Damage 10 10 
    AttribModGroup Var_Accuracy -5 -1   
    AttribModGroup Var_Recharge -1 1
    PowerupSlotCost Salvage Salvage_Common1
    PowerupSlotCost Proficiency Magic_Ubiquitous
    PowerupSlotCost Proficiency Magic_Common
    Sellback 100
    Endurance 10  // mod %
    RewardTable Lieutenant
    SlotUsage 2
}
