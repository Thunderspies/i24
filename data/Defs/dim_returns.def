		Return          1.2           .90
		Return          1.5           .70
		Return          1.8           .15
	}
}

ReturnSet
{
	Default 1

	AttribReturnSet
	{
		Default 1

		// Starting at X.XX, you get Y.YY of the the original bonus
		Return          .70           .90
		Return          .90           .70
		Return         1.00           .15
	}
}

