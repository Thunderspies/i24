//
// This file defines the diminishing returns given for a particular
// power attribute when used in a certain kind of enhancement.
//
// Each ReturnSet represents the diminishing returns for a given set of
// Enhancement types. 
// 
// Each power is marked with these same enhancement types. For each 
// enhancement type a power supports, a ReturnSet is looked up. Then, for
// each attribute listed in each AttribReturnSet, the given Returns are used.
//
// After going over all the enhancement types a power supports, attributes
// which don't have diminishing return information get it from the ReturnSet
// marked as Default. Only on ReturnSet can be marked as Default.
//
// If you don't wish to apply diminishing returns to some attributes, make
// a AttribReturnSet which lists that attribute but has no Return lines in it.
//

ReturnSet
{
	Boost kRange_Boost

	AttribReturnSet
	{
		// The set of attributes which will use the diminishing returns below.
		// These names are the same as the ones used in Power definitions.
		//
		// Attributes can be comma separated, or appear on multiple lines.
		//
		Attrib kRange

		// The diminishing returns table for the above attributes.
		//
		// There may be an arbitrary of Returns.
		//
		// Starting at X.XX, you get Y.YY of the the original bonus
		Return          .40           .90
		Return          .50           .70
		Return          .60           .15
	}
}

ReturnSet
{
	Boost kBuff_Defense_Boost

	AttribReturnSet
	{
		// The set of attributes which will use the diminishing returns below.
		// These names are the same as the ones used in Power definitions.
		//
		// Attributes can be comma separated, or appear on multiple lines.
		//
		Attrib kDefense
		Attrib kRanged_Attack, kMelee_Attack, kAOE_Attack, kSmashing_Attack, kLethal_Attack, kFire_Attack, kCold_Attack, kEnergy_Attack, kNegative_Energy_Attack, kPsionic_Attack

		// The diminishing returns table for the above attributes.
		//
		// There may be an arbitrary of Returns.
		//
		// Starting at X.XX, you get Y.YY of the the original bonus
		Return          .40           .90
		Return          .50           .70
		Return          .60           .15
	}
}

