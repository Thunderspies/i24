//
// This file specifies the effectiveness of a boost when it's worse than
// the character.
//
// The character combat level is subtracted from the boosts's level (plus
// the number of times it's been combined). If the value is negative, then
// the boost is worse than than the combat level and the table below is
// used.
//
// Otherwise, the the table in boost_effect_above is used.
//

{
	// Boost level is below the character's combat level
	//              Same,  -1,   -2,   -3, beyond this is 0.0
	Effectiveness   1.00, 0.9, 0.80, 0.70
}
