//
// This file specifies the chances of two specializations being successfully
// combined.
//
// The level of the two specializations is subtracted (and made positive)
// and the result looked up in this table. Combining two specializations with 
// the same level would use the first entry.
//
// If the difference between the two specializations is larger than the number
// of items in this list, then the chance of combining them is the same as
// the last item in the list.
//

{
	CombineChances 1.00, 0.90, 0.85, 0.80, 0.75, 0.70, 0.65, 0.60, 0.55, 0.50, 0.45, 0.40, 0.35, 0.30, 0.25, 0.20, 0.15, 0.10, 0.05, 0.00, 0.00
}
