Power Incarnate.Destiny.Barrier_Core_Invocation
{
	Name                 "Barrier_Core_Invocation"     
	DisplayName          "P3666517004"
	ActivateRequires     isVIP? isAccountInventoryLoaded? ! ||
	ModesDisallowed      kDisable_All, kDisable_Epic
	Type                 kClick
	Accuracy             1
	EntsAffected         kFriend, kCaster
	EntsAutoHit          kFriend, kCaster
	Target               kCaster
	Range                0
	EnduranceCost        20
	IdeaCost             0
	TravelSuppression    3
	InterruptTime        0
	TimeToActivate       3
	RechargeTime         120
	ActivatePeriod       0
	EffectArea           kSphere
	Radius               30
	Arc                  0
	BoostsAllowed        kBuff_Defense_Boost, kRes_Damage_Boost, kIncarnate_Destiny_Boost
	IgnoreStrength       True
	// Additional Power Factors
	StrengthsDisallowed  kRechargeTime
	ForceLevelBought     49
	VisualFX             "menu\Powers\AnimFX\PlayerPowers\Incarnate_Destiny_Barrier.PFX"
	include              menu\Powers\AnimFX\PlayerPowers\Incarnate_Destiny_Barrier.PFX
	DisplayShortHelp     "P901288497"
	DisplayHelp          "P3964036447"
	IconName             "Incarnate_Destiny_Barrier_Uncommon.tga"
	TimeToConfirm        0
	MaxTargetsHit        255
	Cancelable           kTrue
	Free                 kTrue
	MaxBoosts            0

	AttribMod
	{
