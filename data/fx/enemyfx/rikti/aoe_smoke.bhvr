#################################
##	Sample of Behavior file

Behavior

PyrRotate		0 360 0
PyrRotateJitter		0 360 0
StartJitter		40 0 40

SpinJitter			0 .005 0

InitialVelocityJitter	0.01 0.01 0.01

FadeInLength		40
FadeOutLength		80

Scale			5.0  20  5.0		### Y= Height of Cylinder from center
ScaleRate		1.14 2 1.14
 EndScale		20 40 20 		

SplatFlags			ADDITIVE ROUNDTEXTURE
SplatSetBack		0.5     #0 -> 1.0 splatSetBack = what percent of the splat should be behind the node, and what in front

SplatFalloffType	BOTH			# UP DOWN NONE BOTH	
SplatFadeCenter		0.5				# only for UP and DOWN falloff


#Wish list: fade the intensity of the shadow with the angle of the collision
#SplatNormalFade	0.9	
#SplatFlags ADDBASE # is broken
#SplatFalloffType

		
Alpha			55

StartColor		115 255 155

End


