System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 2

	NewPerFrame 0.500000

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	#EmissionStartJitter 0 0 0

	#MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0.2500 0

	#InitialVelocityJitter 0.010 0.005 0.010

	#VelocityJitter 0 0 0

	#Magnetism 0

	#Gravity -0.0005

	#Drag 0

	#Spin 0

	#SpinJitter 90



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0.2

	TightenUp 2

	#StreakType 3 # (ORIGIN)

	#StreakScale 20

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	#SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 3

	StartSizeJitter 1

	ExpandRate 2

	#ExpandType 0 # (Expand Forever)

	#EndSize 0.8

	OrientationJitter 128



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName flashGlow.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 9

	#AnimPace1 1.5

	#AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 1

	#AnimType2 0 # (loop)

	Alpha 60

	FadeInBy 1

	FadeOutStart 3

	FadeOutBy 8

	StartColor 197 159 255

	ColorChangeType 1 # (LoopBackToBeginning)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 1

	BeColor1 197 159 255

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 3

	BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

