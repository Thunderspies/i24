#################################
##	Sample of Behavior file

Behavior

Spin			0.0 3.4 0.0              # Be very careful spinning splats, that causes them to be updated every frame. Only use if the splat is small and will be moving anyway
SpinJitter		0.000 3.5 0.0000

FadeInLength		10
FadeOutLength		40

########################  SPLAT  #########################################

Scale			.4  5  .4		### Y= Height of Cylinder from center
ScaleRate		1.6 1.5 1.6
 EndScale		30 30 30
 Stretch		0  ## 0 = No Stretch, 1 = Stretch to Lookat, 2 = Stretch to lookat and tile   		

Rgb0			255 255 255

########################  SPLAT ONLY #########################################

SplatFlags			ADDITIVE
SplatSetBack		0.5     #0 -> 1.0 splatSetBack = what percent of the splat should be behind the node, and what in front

SplatFalloffType	BOTH			# UP DOWN NONE BOTH	
SplatFadeCenter		1.0				# only for UP and DOWN falloff

#StAnim			0.05000 0.050000 aqua		
#StAnim			0.600000 1.000000 light_pulse2 FRAMESNAP
#StAnim			1.0 0.1 spin_counter  #just like other fx


#Wish list: fade the intensity of the shadow with the angle of the collision
#SplatNormalFade	0.9	
#SplatFlags ADDBASE # is broken
#SplatFalloffType

#Alpha			155

#StartColor		170 155 0
#
#BeColor1		170 155 10
#ByTime1			65
#
#BeColor2		110 155 90
#ByTime2			95
	
Alpha			145

StartColor		70 255 0

BeColor1		110 155 10
ByTime1			65

BeColor2		110 155 90
ByTime2			95

End


