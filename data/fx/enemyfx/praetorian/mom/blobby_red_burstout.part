	InitialVelocityJitter 2.5 0.5 2.5

	#VelocityJitter 0 0 0

	#Magnetism 0

	Gravity 0.06

	Drag 0.08

	#Spin 0

	SpinJitter 55



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	#TightenUp 0

