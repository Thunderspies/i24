###########################################################

	#Burst 1

	NewPerFrame 0.2

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

