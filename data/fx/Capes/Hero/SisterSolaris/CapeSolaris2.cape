Cape
	
	GeoName		GEO_Cape_Sybil_02
	GeoFile		Fem_Cape.geo
	HarnessName	GEO_CapeHarness_Sybil_02
	HarnessFile	Fem_Cape.geo

	Tex1	!Cape_Roman_Sybil_01
	Tex2	!Cape_Roman_Sybil_01_Mask


# If this cape is a costume piece, these colors will be ignored
	Color1	190,  150,  40
	Color2	255,  255,  255

	Tex3	!Cape_Roman_Sybil_01
	Tex4	!Cape_Roman_Sybil_01_Mask
	Color3	190,  150,  40
	Color4	255,  255,  255
	InnerTex1	!Cape_Roman_Sybil_01
	InnerTex2	!Cape_Roman_Sybil_01_Mask

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.9
	Stiffness	0.9
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.1

	##Collision Labeaux_Front // cloth\ColInfo.txt

