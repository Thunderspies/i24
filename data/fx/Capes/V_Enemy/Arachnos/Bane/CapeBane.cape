Cape

	GeoName		Geo_Cape_Bane
	GeoFile		V_arachnos_bane_spider_Cape.geo
	HarnessName	geo_capeharness_tight // Geo_CapeHarness_Wolf
	HarnessFile	V_arachnos_bane_spider_Cape.geo // v_wolf_spiders_Cape.geo

	Tex1	bane_cape // this is pointing to a shader
	Tex2	White 

# If this cape is a costume piece, these colors will be ignored
	Color1	10 10 10
	Color2	10 10 10

	Tex3	Bane_cape_inner // this is pointing to a shader
	Tex4	White
	#Color3	160 10 10
	#Color4	20 10 10

# If this cape is a costume piece, these colors will be ignored
	InnerColor1	10 10 10
	InnerColor2	20 10 10

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.9
	Stiffness	0.9
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.1

	Collision male

End
