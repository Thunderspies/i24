Cape

	GeoName		Cape
	
	GeoName		GEO_Cape_Wedding_Veil_01
	GeoFile		Fem_Cape.geo
	HarnessName	GEO_CapeHarness_Wedding_Veil_02
	HarnessFile	Fem_Cape.geo

	Tex1	Cape_Wedding_Veil_01
	Tex2	Cape_Wedding_Veil_01_Mask 

# If this cape is a costume piece, these colors will be ignored
	Color1	10 10 10
	Color2	255 10 10

	Tex3	Cape_Wedding_Veil_01
	Tex4	Cape_Wedding_Veil_01_Mask

# If this cape is a costume piece, these colors will be ignored
	InnerColor1	160 10 10
	InnerColor2	20 10 10

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.9
	Stiffness	0.9
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.1

	Collision Wedding_Veil

End