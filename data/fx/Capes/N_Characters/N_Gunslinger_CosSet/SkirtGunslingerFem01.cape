Cape

	GeoName		GEO_N_Cloth_Gunslinger_01
	GeoFile		N_Female_Gunslinger_01.geo
	HarnessName	GEO_N_ClothHarness_Gunslinger_01
	HarnessFile	N_Female_Gunslinger_01.geo

	Tex1	!X_Fem_Skirt_Gunslinger_01
	Tex2	none
	#Tex1	none
	#Tex2	none

# If this cape is a costume piece, these colors will be ignored
	Color1	255 255 255
	Color2	255 255 255

	Tex3	!X_Fem_Skirt_Gunslinger_01
	Tex4	none
	Color3	255 255 255
	#Color4	255 255 255
	#InnerTex1	none
	#InnerTex2	none

# If this cape is a costume piece, these colors will be ignored
	InnerColor1	255 255 255
	InnerColor2	255 255 255

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.7
	Stiffness	0.7
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.10

	Collision Villain_Widow

End
