Cape

	GeoName		GEO_Cape_Cyberpunk_01
	GeoFile		N_Male_Cyberpunk_01.geo
	HarnessName	GEO_CapeHarness_Cyberpunk_01
	HarnessFile	N_Male_Cyberpunk_01.geo

	Tex1	!X_Jacket_Cyberpunk_01
	Tex2	None

# If this cape is a costume piece, these colors will be ignored
	Color1	255 10 10
	Color2	255 10 10

	Tex3	!X_Jacket_Cyberpunk_01
	Tex4	None
	Color3	255 255 255
	#Color4	20 10 10
	#InnerTex1	none
	#InnerTex2	none

# If this cape is a costume piece, these colors will be ignored
	InnerColor1	255 10 10
	InnerColor2	255 10 10

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.9
	Stiffness	0.85
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.1

	Collision TuxedoMale

End
