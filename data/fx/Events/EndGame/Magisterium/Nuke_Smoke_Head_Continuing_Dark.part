	InitialVelocity 0 1 0

	InitialVelocityJitter 0.5 0.2 0.5

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0.015

	Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

