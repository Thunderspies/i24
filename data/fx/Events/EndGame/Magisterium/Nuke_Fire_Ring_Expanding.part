System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 10

	NewPerFrame 0

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 2 # (Cylinder)

	EmissionRadius 35

	EmissionHeight 5

	EmissionStartJitter 0.1 0.2 0.1

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0 0 0

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity -0.0001

	Drag 0

	Spin 0

	SpinJitter 20



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 1.1

	StreakType 0 # (NOSTREAK)

	StreakScale 5

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 50

	StartSizeJitter 0.5

	ExpandRate 8

	ExpandType 0 # (Expand Forever)

	EndSize 0

	OrientationJitter 60



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName SmokeNewB_BW.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 0

	AnimType1 0 # (loop)

	TextureName2 SmokeNewA.TGA

	TexScroll2 0 0.01 0

	TexScrollJitter2 0 0.0005 0

	AnimFrames2 0

	AnimPace2 0

	AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 5

	FadeOutStart 10

	FadeOutBy 40

	StartColor 255 230 215

	ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 2

	BeColor1 255 230 215

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 15

	BeColor2 255 200 100

	#PrimaryTint2 0

	#SecondaryTint2 0

	ByTime3 40

	BeColor3 100 10 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	ByTime4 0

	BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	ColorOffset 0 0 0

	ColorOffsetJitter 0 0 0


