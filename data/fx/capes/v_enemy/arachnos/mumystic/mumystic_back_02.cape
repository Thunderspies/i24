Cape

	GeoName		GEO_Cape_MuMystic_Back
	GeoFile		V_Arachnos_MuMystics_Cape.geo
	HarnessName	GEO_CapeHarness_Back
	HarnessFile	V_Arachnos_MuMystics_Cape.geo

	Tex1	mumystic_cape_02 
	Tex2	mumystic_cape_02 

# If this cape is a costume piece, these colors will be ignored
	Color1	10 10 10
	Color2	10 10 10

	Tex3	mumystic_cape_02
	Tex4	mumystic_cape_02
	
# If this cape is a costume piece, these colors will be ignored
	InnerColor1	10 10 10
	InnerColor2	20 10 10

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.9
	Stiffness	1.0
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.1

	Collision MuMystic
	
End