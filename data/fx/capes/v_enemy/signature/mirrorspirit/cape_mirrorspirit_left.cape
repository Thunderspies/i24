Cape

	GeoName		GEO_Cape_Left
	GeoFile		V_Signature_MirrorSpirit.geo
	HarnessName	geo_cape_harness_left
	HarnessFile	V_Signature_MirrorSpirit.geo

	Tex1	X_Top_MirrorSpirit // this is pointing to a shader
	Tex2	White 

# If this cape is a costume piece, these colors will be ignored
	Color1	10 10 10
	Color2	10 10 10

	Tex3	X_Top_MirrorSpirit // this is pointing to a shader
	Tex4	White
	#Color3	160 10 10
	#Color4	20 10 10

# If this cape is a costume piece, these colors will be ignored
	InnerColor1	10 10 10
	InnerColor2	20 10 10

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.9
	Stiffness	0.99
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.1

	Collision MirrorSpirit
	Wind MirrorSpirit

End
