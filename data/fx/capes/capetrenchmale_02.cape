Cape

	GeoName		Geo_Cape_Trenchcoat_03
	GeoFile		V_MALE_CAPE_TRENCH.geo # V_MALE_CAPE.geo
	HarnessName	GEO_CapeHarness_Player_Trenchcoat_01
	HarnessFile	V_MALE_CAPE_TRENCH.geo # V_MALE_CAPE.geo

	Tex1	Cape_Trenchcoat_Leather_01

# If this cape is a costume piece, these colors will be ignored
	Color1	255 10 10
	Color2	255 10 10

	InnerTex1	Cape_Trenchcoat_Leather_01

# If this cape is a costume piece, these colors will be ignored
	InnerColor1	255 10 10
	InnerColor2	255 10 10

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.9
	Stiffness	0.8
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.25

	Collision Trenchcoat
End
