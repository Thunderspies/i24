#Particle System 
#
System

Name 			pump_smoke.part

NewPerFrame		1.0
Burst			10
EmissionType		0 			#Tokened: 0 = Point  1 = Line
EmissionStartJitter	0.2 0.2 0.2

Spin			15
SpinJitter		0

Magnetism		0.00
Gravity		        -0.006

KillOnZero		1 			#Tokened 0 = False  1 = True

InitialVelocity		0.02 0.02 0.02
InitialVelocityJitter	0.2 0.2 0.2	
VelocityJitter		0.002 0.002 0.002 #Per Frame change in Velocity
TightenUp		.5

FadeInBy 		0
FadeOutStart		50
FadeOutBy   		70

StartSize		.5
ExpandRate		0.001
 EndSize		2

StreakType		7			#1 Velocty  3 Origin
 StreakScale		20
 StreakOrient		1 			#1 Orient   0 No Orient
 StreakDirection	0 			#0 Pull     1 Push 

Blend_mode		1 			#Tokened: 0 = Normal 1 = Additive  		
TextureName		smoke.tga

StartColor		255 255 255
End
