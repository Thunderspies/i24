	Burst 6

	NewPerFrame 0

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 2 0 2

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.60 1.8

	InitialVelocityJitter 0.2 0.40 0.2

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0.030

	Drag 0.06

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 0.15

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	StartSizeJitter 0.2

	ExpandRate 0.20

	ExpandType 0 # (Expand Forever)

	#EndSize 5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName SmokeNewC.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

