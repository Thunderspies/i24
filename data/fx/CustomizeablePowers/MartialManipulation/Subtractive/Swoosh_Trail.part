System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 1

	NewPerFrame 0.5

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0.1

	#EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0.5 -1

	#InitialVelocityJitter 0.5 0.5 0.5

	#VelocityJitter 0.008 0.008 0.008

	#Magnetism -0.01

	#Gravity 0.005

	#Drag 0.15

	#Spin 0

	#SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 1 # (Local)

	#Stickiness 0.1

	#TightenUp 0

	#StreakType 7 # (CHAIN)

	#StreakScale 8

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	SortBias 0.509

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 6

	#StartSizeJitter 0.1

	#ExpandRate -0.08

	#ExpandType 1 # (Expand to EndSize)

	#EndSize 0.1

	#OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName blue_blur.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 3

	FadeOutStart 3

	FadeOutBy 25

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 15

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	#ByTime2 25

	#BeColor2 230 128 10

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 30

	#BeColor3 250 250 250

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

