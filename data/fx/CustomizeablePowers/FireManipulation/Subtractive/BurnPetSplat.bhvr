#################################
##	Sample of Behavior file

Behavior

StartJitter		4 0 4
PyrRotate		0 360 0

FadeInLength		10
FadeOutLength		40

Spin			0 10 0
SpinJitter		0 5 0

Scale			2.0 2 2.0		### Y= Height of Cylinder from center
ScaleRate		1.2 1.5 1.2
 EndScale		8 4 8 		

SplatFlags		ADDITIVE ROUNDTEXTURE
SplatSetBack		0.5     #0 -> 1.0 splatSetBack = what percent of the splat should be behind the node, and what in front

SplatFalloffType	BOTH			# UP DOWN NONE BOTH	
SplatFadeCenter		0.5				# only for UP and DOWN falloff

#InitialVelocity		0.0 0.03 0.0
#InitialVelocityJitter	0.0 0.03 0.0
#
#Gravity				-0.3 

StartColor		90 124 235
Alpha			125

ByTime1			6
BeColor1		255 176 19

ByTime2			25
BeColor2		230 128 10

ByTime3			30  
BeColor3		150 150 150

ByTime4			45  
BeColor4		255 124 235

End


