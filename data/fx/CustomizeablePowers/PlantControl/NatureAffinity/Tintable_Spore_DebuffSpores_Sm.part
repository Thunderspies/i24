System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 3

	NewPerFrame 0.5

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	#EmissionStartJitter 1 1 0.5

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity -0.1 0 0

	InitialVelocityJitter 0 0.05 0.05

	#VelocityJitter 0.001 0.001 0.001

	#Magnetism 0.00300

	#Gravity 0.0050000

	#Drag 0

	#Spin 75

	#SpinJitter 20



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	#FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	TightenUp 1.1

	#StreakType 0 # (NOSTREAK)

	#StreakScale 2

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.2

	StartSizeJitter 0.05

	ExpandRate 0.200

	ExpandType 1 # (Expand to EndSize)

	EndSize 1.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName HamiSplatter.tga

	TexScroll1 0 -0.0150000 0

	#TexScrollJitter1 0 0 0

