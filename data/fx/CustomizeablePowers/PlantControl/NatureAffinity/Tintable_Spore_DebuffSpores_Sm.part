	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 10

	FadeOutStart 10

	FadeOutBy 20

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 100

	ByTime1 8

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 100

	#ByTime2 25

	#BeColor2 192 192 192

	#PrimaryTint2 75

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

