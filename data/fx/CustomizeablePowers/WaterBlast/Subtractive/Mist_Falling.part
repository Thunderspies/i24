	KickStart 1

	#TimeToFull 3

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 1 # (reset age)

	StartSize 1

	StartSizeJitter 0.5

	ExpandRate 0.2

	ExpandType 0 # (Expand Forever)

	EndSize 0

	#OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

