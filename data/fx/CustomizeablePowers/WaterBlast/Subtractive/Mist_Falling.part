###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 -0.25 0

	InitialVelocityJitter 0.05 0.1 0.05

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0

	Drag 0.01

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 1

	StreakType 3 # (ORIGIN)

	StreakScale 1

	StreakOrient 1 # (Orient)

