	FadeOutBy 15

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 50

	ByTime1 1

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 50

	ByTime2 3

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 80

