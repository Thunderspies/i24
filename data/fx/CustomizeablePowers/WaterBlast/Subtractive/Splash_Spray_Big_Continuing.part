System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 8

	NewPerFrame 1.3

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0.5 0.5 0.5

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.45 0

	InitialVelocityJitter 0.3 0.3 0.3

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0.05

	Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 1

	#StreakType 1 # (VELOCITY)

	#StreakScale 1

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.85

	StartSizeJitter 0.5

	ExpandRate 0.3

	ExpandType 0 # (Expand Forever)

	EndSize 15

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName WaterSplash4.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 1

	AnimType1 0 # (loop)

	#TextureName2

	TexScroll2 0 0.001 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 15

	FadeOutStart 15

	FadeOutBy 35

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 100

	SecondaryTint 0

	ByTime1 3

	BeColor1 255 255 255

	PrimaryTint1 100

	SecondaryTint1 0

	ByTime2 18

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 100

	ByTime3 0

	BeColor3 0 0 0

	PrimaryTint3 0

	SecondaryTint3 0

	ByTime4 0

	BeColor4 0 0 0

