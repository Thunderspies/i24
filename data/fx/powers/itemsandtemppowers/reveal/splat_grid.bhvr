#################################
## Splat - Foot Stomp
#################################

Behavior

#################################

PyrRotate		0 0 0
PyrRotateJitter		0 0 0
StartJitter		0 0 0

FadeInLength		50
FadeOutLength		120

Scale			10 50 10		### Y= Height of Cylinder from center
ScaleRate		3 3.5 3
EndScale		80 60 80

#SplatFlags		ADDITIVE ROUNDTEXTURE
SplatSetBack		.5  #0 -> 1.0 splatSetBack = what percent of the splat should be behind the node, and what in front

SplatFalloffType	NONE	# UP DOWN NONE BOTH
SplatFadeCenter		.5	# only for UP and DOWN falloff

Alpha			255

StartColor		1 1 255

#################################

End