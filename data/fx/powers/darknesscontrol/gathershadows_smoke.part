System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 1

	NewPerFrame 0.5

	#BurbleAmplitude 0.3

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0.5

	EmissionHeight 0

	#EmissionStartJitter 0.3 0.3 0.3

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.01 0.01 0.01

	#VelocityJitter 0.001 0.001 0.001

	#Magnetism -0.005

	#Gravity 0

	#Drag 0

	#Spin 1

	#SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0.3

	TightenUp 1.35

	StreakType 0 # (NOSTREAK)

	StreakScale 10

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 2.5

	StartSizeJitter 0.3

	ExpandRate -0.05

	ExpandType 0 # (Expand Forever)

	EndSize 1

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName smoke.tga

	TexScroll1 0 0.001 0

	TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 90

	FadeInBy 10

	FadeOutStart 30

	FadeOutBy 50

	StartColor 50 50 50

	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 20

	BeColor1 33 26 66

	#PrimaryTint1 0

	#SecondaryTint1 0

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

