Condition
	On 	cycle
	Time 	1

	Repeat	6

	Event	
		Type	posit
		At	root

		BhvrOverride
			PositionOffset		0 20 0
			StartJitter		100.0 20.0 100.0
		End


		ChildFx	WORLD\Weather\Rain\RainDropBrightNoPhysics.fx

		
		LifeSpan	85 
	End

End

