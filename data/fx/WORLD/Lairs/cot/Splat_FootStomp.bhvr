#################################
## Splat - Foot Stomp
#################################

Behavior

#################################

PyrRotate		0 0 0
PyrRotateJitter		0 360 0
StartJitter		0 0 0

FadeInLength		30
FadeOutLength		90

Scale			40 8 40		### Y= Height of Cylinder from center
#ScaleRate		1 1 1
#EndScale		12 8 12

#SplatFlags		ADDITIVE ROUNDTEXTURE
SplatSetBack		0.5     #0 -> 1.0 splatSetBack = what percent of the splat should be behind the node, and what in front

SplatFalloffType	BOTH			# UP DOWN NONE BOTH
SplatFadeCenter		.1	# only for UP and DOWN falloff

Alpha			255

StartColor		1 1 1

#################################

End