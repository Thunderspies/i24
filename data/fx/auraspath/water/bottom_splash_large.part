System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 8

	NewPerFrame 0.8

	#BurbleAmplitude 0.7

	#BurbleType 1 # (Random Curve)

	#BurbleFrequency 0.2

	#BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0 0 0

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.300 0

	InitialVelocityJitter 0.4 0.15 0.4

	#VelocityJitter 0.003 0 0.003

	Magnetism 0

	Gravity 0.0300

	Drag 0.03

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 0.7

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	SortBias -0.1

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 1

	StartSizeJitter 0.5

	ExpandRate 0.2

	ExpandType 0 # (Expand Forever)

	EndSize 1.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName WaterSplash3.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

