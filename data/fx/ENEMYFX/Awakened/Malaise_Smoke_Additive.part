System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 3

	NewPerFrame 0.1

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 100

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0.1

	EmissionStartJitter 0 0 0

	MoveScale 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 0

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	KickStart 0

	TimeToFull 0

	SortBias 0.1

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.25

	StartSizeJitter 0.1

	ExpandRate 0.5

	ExpandType 0 # (Expand Forever)

	EndSize 0

	OrientationJitter 60



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.2 0

	InitialVelocityJitter 0.2 0.2 0.2

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0

	Drag 0.2

	Spin 0

	SpinJitter 0



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName SmokeNewA.TGA

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 0

	AnimType1 1 # (playOnce)

	#TextureName2 SmokeNewA.TGA

	TexScroll2 0 0.002 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 150

	FadeInBy 1

	FadeOutStart 5

	FadeOutBy 20

	StartColor 150 50 255

	ColorChangeType 1 # (LoopBackToBeginning)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 5

	BeColor1 150 50 255

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 15

	BeColor2 255 255 255

	#PrimaryTint2 0

	#SecondaryTint2 0

	ByTime3 60

	BeColor3 200 200 200

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	ColorOffset 0 0 0

	ColorOffsetJitter 0 0 0


End
