System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 2

	NewPerFrame 0.5

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 100

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0.1

	EmissionStartJitter 2 2 2

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0 0 0

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0

	Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	TightenUp 1

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 0

	SortBias 0.1

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 1

	StartSizeJitter 1

	ExpandRate 1

	ExpandType 0 # (Expand Forever)

	EndSize 0

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Electricity_Ring.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 0

	AnimType1 1 # (playOnce)

	TextureName2 Electricity_Ring.tga

	TexScroll2 0 0.1 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 0

	FadeOutStart 5

	FadeOutBy 10

	StartColor 230 200 255

	ColorChangeType 1 # (LoopBackToBeginning)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 2

	BeColor1 230 200 255

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 7

	BeColor2 200 100 255

	#PrimaryTint2 0

	#SecondaryTint2 0

	ByTime3 40

	BeColor3 50 50 50

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	ColorOffset 0 0 0

	ColorOffsetJitter 0 0 0


