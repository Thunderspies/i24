System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 3

	#NewPerFrame 0.1

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	#EmissionStartJitter 0 0 0

	#MoveScale 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 1 # (Local)

	#Stickiness 0

	TightenUp 0.5

	#StreakType 0 # (NOSTREAK)

	#StreakScale 10

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	#SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 2

	StartSizeJitter 0.5

	ExpandRate 0.2

	ExpandType 0 # (Expand Forever)

	#EndSize 3

	OrientationJitter 180



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0 0

	#InitialVelocityJitter 0.01 0.01 0.01

	#VelocityJitter 0 0 0

	#Magnetism 0

	#Gravity 0

	#Drag 0

	#Spin 0

	SpinJitter 40



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName FadeBorder.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 1

	#AnimType1 0 # (loop)

	TextureName2 Caustic_tile_LG_01.tga

	TexScroll2 0 0.020 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 1

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 10

	FadeOutStart 45

	FadeOutBy 50

	StartColor 217 220 255

	ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 10

	BeColor1 128 128 255

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 50

	BeColor2 255 210 17

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 255 255 255

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 255 255 255

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
