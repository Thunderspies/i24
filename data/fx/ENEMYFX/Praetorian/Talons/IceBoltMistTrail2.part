System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 20

	NewPerFrame 1.5

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 1

	#EmissionHeight 0

	EmissionStartJitter 0.3 0.3 0.3

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.04 0.04 0.04

	VelocityJitter 0.01 0.01 0.01

	Magnetism 0

	Gravity 0.005

	#Drag 0

	#Spin 0

	#SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.2

	StreakType 7 # (CHAIN)

	StreakScale 10

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 2.3

	StartSizeJitter 0.7

	ExpandRate -0.03

	#ExpandType 0 # (Expand Forever)

	EndSize 1

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName smoke.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 15

	FadeInBy 10

	FadeOutStart 10

	FadeOutBy 40

	StartColor 140 205 255

	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 60

	BeColor1 150 160 255

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 70

	BeColor2 150 160 255

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 10

	#BeColor3 0 128 255

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
