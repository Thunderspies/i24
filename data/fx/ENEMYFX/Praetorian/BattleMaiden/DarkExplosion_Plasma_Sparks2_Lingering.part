System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 15

	NewPerFrame 5

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 4 # (Sphere)

	EmissionRadius 10

	EmissionHeight 0

	EmissionStartJitter 1 1 1

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 2 0

	InitialVelocityJitter 1 1.05 1

	VelocityJitter 0.15 0.15 0.15

	Magnetism 0

	Gravity 0.05

	Drag 0.05

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 0

	StreakType 1 # (VELOCITY)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 0

	#TimeToFull 10

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.4

	StartSizeJitter 0.1

	ExpandRate -0.0035

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.025

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 2

	TextureName Car_headlight_flare_BW.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 1

	AnimType1 0 # (loop)

	#TextureName2

	TexScroll2 0 0.015 0.01

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 1

	FadeOutStart 5

	FadeOutBy 10

	StartColor 155 135 0

	ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 1

	BeColor1 155 135 0

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 10

	BeColor2 255 205 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	ByTime3 0

	BeColor3 255 205 55

	#PrimaryTint3 0

	#SecondaryTint3 0

	ByTime4 0

	BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	ColorOffset 0 50 0

