System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 5

	NewPerFrame 0.2

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0.5

	#EmissionHeight 0

	EmissionStartJitter 0.5 0.5 0.5

	#MoveScale 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	TightenUp 1

	#StreakType 0 # (NOSTREAK)

	#StreakScale 20

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	StartSizeJitter 0.4

	ExpandRate 0.7

	ExpandType 0 # (Expand Forever)

	EndSize 2

	OrientationJitter 180



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0 0

	#InitialVelocityJitter 0 0 0

	#VelocityJitter 0 0 0

	#Magnetism 0

	#Gravity 1

	#Drag 0

	#Spin 0

	SpinJitter 120



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Electricity_Ring.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2 CosmicEnergy_Scroller2.tga

	TexScroll2 0 0.01 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 0

	FadeOutStart 1

	FadeOutBy 3

	StartColor 254 255 203

	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	#ByTime1 14

	#BeColor1 255 200 100

	#PrimaryTint1 0

	#SecondaryTint1 0

	#ByTime2 20

	#BeColor2 255 100 50

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
