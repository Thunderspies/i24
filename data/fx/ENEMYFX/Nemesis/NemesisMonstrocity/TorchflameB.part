System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 0

	NewPerFrame 0.7

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 0.4

	#EmissionHeight 0

	#EmissionStartJitter 0.13 0 0.13

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0.50 0 0

	InitialVelocityJitter 0.4 0.007 0.007

	VelocityJitter 0.01 0.001 0.001

	#Magnetism 0.0008

	#Gravity 0.003

	#Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0

	StreakType 7 # (CHAIN)

	StreakScale 10

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 3

	StartSizeJitter 1

	ExpandRate -0.600

	#ExpandType 0 # (Expand Forever)

	EndSize 0.05

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName smoke.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

