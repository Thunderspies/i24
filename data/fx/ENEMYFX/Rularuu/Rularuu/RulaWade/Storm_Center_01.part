System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 10

	NewPerFrame 0.05

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 4 # (Sphere)

	EmissionRadius 0.5

	EmissionHeight 0

	EmissionStartJitter 0 0 0

	#MoveScale 3.5



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0 0 0

	VelocityJitter 0 0 0

	Magnetism 0.00003

	Gravity 0

	#Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	TightenUp -1

	StreakType 0 # (NOSTREAK)

	StreakScale 10

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	TimeToFull 0

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 2

	StartSizeJitter 1

	ExpandRate 0.005

	ExpandType 0 # (Expand Forever)

	EndSize 5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Rularuu_Storm_Center_01.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 0

	AnimType1 0 # (loop)

	TextureName2 Rularuu_Storm_Center_02.tga

	TexScroll2 0.001 -0.003 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 0

	AnimType2 0 # (loop)

	Alpha 90

	FadeInBy 80

	FadeOutStart 80

	FadeOutBy 160

	StartColor 180 0 255

	ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 120

	BeColor1 255 0 180

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 0

	BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	ByTime3 0

	BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	ByTime4 0

	BeColor4 0 0 0

