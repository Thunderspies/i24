Cape

	IsFlag

	GeoFile		object_library/FX/Flags/Flag_01.geo
	GeoName		GEO_Flag_03
	HarnessFile	object_library/FX/Flags/Flag_01.geo
	HarnessName	GEO_Flag_Harness_03

# If this cape is a costume piece, these values will be ignored
	#Tex1	Cape_01 
	#Tex2	Cape_Atom_Short
	Tex1	crnout_flag01.tga
	Tex2	crnout_flag01_c.tga
	Color1	10 10 10
	Color2	255 10 10

	Tex3	crnout_flag01.tga
	Tex4	crnout_flag01_c.tga
	Color3	10 10 10
	Color4	255 10 10
#	Tex3	Cape_01
#	Tex4	Cape_Liner_02 #Atom_Short
#	Color3	160 10 10
#	Color4	20 10 10

		//  'stiffness' determines the amount of 'fold' allowed.
		//     1.0 would attempt to keep the cloth completely flat
		//     0.7 would allow the cloth to fold to angles of about 90 degrees.
		//  Default: 0.9
	Stiffness	0.8
		//  'drag' is the wind resistance, and should remain in the range [0.10, 0.30]
		//  Default: 0.10
	Drag		0.1
		// Scale probably only works well with Flags
	Scale .5
	LODBias  3

	Wind	FLAG_HORIZONTAL_LARGE
End
