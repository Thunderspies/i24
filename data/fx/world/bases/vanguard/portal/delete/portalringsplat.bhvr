#################################
##	Sample of Behavior file

Behavior

Spin			0.0 -0.025 0.0              # Be very careful spinning splats, that causes them to be updated every frame. Only use if the splat is small and will be moving anyway
SpinJitter		0.000 0 0.0000

pyrRotateJitter		0 180 0

FadeInLength		60
FadeOutLength		30

########################  SPLAT  #########################################

Scale			30.0  30  30.0		### Y= Height of Cylinder from center
ScaleRate		1.4 1.4 1.4
 EndScale		10 10 10
 Stretch		0  ## 0 = No Stretch, 1 = Stretch to Lookat, 2 = Stretch to lookat and tile   		

Rgb0			200 255 255

########################  SPLAT ONLY #########################################

SplatFlags		ADDITIVE
SplatSetBack		0.5     #0 -> 1.0 splatSetBack = what percent of the splat should be behind the node, and what in front

SplatFalloffType	BOTH			# UP DOWN NONE BOTH	
SplatFadeCenter		0.5				# only for UP and DOWN falloff

#StAnim			0.05000 0.050000 aqua		
#StAnim			0.600000 1.000000 light_pulse2 FRAMESNAP
#StAnim			1.0 0.1 spin_counter  #just like other fx


#Wish list: fade the intensity of the shadow with the angle of the collision
SplatNormalFade	0.9	
#SplatFlags ADDBASE # is broken
#SplatFalloffType

Alpha			120

StartColor		25 1 25
#ColorChangeType		0 
#
ByTime1			60 
BeColor1		20 100 255 
#
#
#ByTime2			134 
#BeColor2		230 230 30

End


