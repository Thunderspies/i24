	Alpha 255

	FadeInBy 12

	FadeOutStart 15

	FadeOutBy 25

	StartColor 255 248 50

	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

