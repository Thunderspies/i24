	#EmissionRadius 0

	#EmissionHeight 0

	#EmissionStartJitter 0 0 0

	#MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.3 0.3 0.3

	#VelocityJitter 0 0 0

	#Magnetism 0

	#Gravity 0

	Drag 0.030000

	#Spin 0

	SpinJitter 15



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	#TightenUp 1.5

	#StreakType 0 # (NOSTREAK)

	#StreakScale 20

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.30

	StartSizeJitter 0.10

	ExpandRate 0.060

	#ExpandType 0 # (Expand Forever)

	#EndSize 6

	#OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName RuneCircle_Rune3.TGA

	TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

