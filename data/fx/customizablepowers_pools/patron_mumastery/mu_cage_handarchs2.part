System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 10

	NewPerFrame 0.5

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 1

	EmissionHeight 0

	EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0 0

	InitialVelocityJitter 0.7 0.7 0.7

	VelocityJitter 0 0 0

	Magnetism 0.1

	Gravity -0.005

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	#TightenUp 0.1

	StreakType 5 # (OTHER)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.3

	StartSizeJitter 0.1

	ExpandRate 0.05

	ExpandType 0 # (Expand Forever)

	EndSize 1

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName MuLightning_ColorLess.tga

	TexScroll1 0 0.10 0

	TexScrollJitter1 0 0.0010 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	TextureName2 TillingSource.tga

	TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 1

	FadeOutStart 3

	FadeOutBy 7

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 13

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	#ByTime2 16

	#BeColor2 255 60 60

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 25

	#BeColor3 255 10 10

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
