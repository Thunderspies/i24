System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 10

	NewPerFrame 0.5

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 3 # (Even Trail)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0.5 0.5 0.5

	MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.01 0.01 0.01

	VelocityJitter 0.005 0.005 0.005

	#Magnetism -0.005

	Gravity -0.003

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	#TightenUp 0.1

	StreakType 7 # (CHAIN)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.25

	StartSizeJitter 0.1

	ExpandRate 0.2

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.7

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5


	TextureName MuLightningThick.tga

	TexScroll1 0 0.3 0

	TexScrollJitter1 0 1 0

	TextureName2 TillingSource.tga

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 0

	FadeOutStart 3

	FadeOutBy 5

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 2

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	ByTime2 4

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 90

	#ByTime3 13

	#BeColor3 1 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 10

	#BeColor4 1 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
