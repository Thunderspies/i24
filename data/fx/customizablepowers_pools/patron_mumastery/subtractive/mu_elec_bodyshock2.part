System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 7

	#NewPerFrame 12

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 5 # (Line Even)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0.1 0.1 0.1

	MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0.01

	#InitialVelocityJitter 0.0051 0.0051 0.0051

	VelocityJitter 0.01 0.0051 0.01

	Magnetism 0.001

	Gravity -0.002

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0

	StreakType 7 # (CHAIN)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0

	StartSizeJitter 0.1

	ExpandRate 0.2

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.25

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5


	TextureName MuLightningThick_Colorless.tga

	TexScroll1 0 0.1 0

	TexScrollJitter1 0 0 0

	TextureName2 TillingSource.tga

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 180

	FadeInBy 0

	FadeOutStart 2

	FadeOutBy 30

	StartColor 255 255 255

	ColorChangeType 1 # (LoopBackToBeginning)

	PrimaryTint 60

	SecondaryTint 30

	ByTime1 2

	BeColor1 255 255 255

	PrimaryTint1 50

	SecondaryTint1 40

	#ByTime2 4

	#BeColor2 255 255 255

	#PrimaryTint2 0

	#SecondaryTint2 90

	ByTime3 3

	BeColor3 255 10 10

	#PrimaryTint3 0

	#SecondaryTint3 0

