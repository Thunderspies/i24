System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 10

	#NewPerFrame 1

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 5 # (Line Even)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0 0 0

	#MoveScale 0.5



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.12 0.12 0.12

	VelocityJitter 0 0 0

	#Magnetism 0.001

	Gravity -0.005

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	#TightenUp 0.1

	StreakType 7 # (CHAIN)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.2

	StartSizeJitter 0.1

	ExpandRate 0.03

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName MuLightning_ColorLess.tga

	TexScroll1 0 -0.11 0

	TexScrollJitter1 0 0.001 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2 TillingSource.tga

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 150

	FadeInBy 0

	FadeOutStart 1

	FadeOutBy 40

	StartColor 255 255 255

	ColorChangeType 1 # (LoopBackToBeginning)

	PrimaryTint 50

	SecondaryTint 40

	ByTime1 2

	BeColor1 50 50 50

	PrimaryTint1 0

	SecondaryTint1 90

	ByTime2 5

	BeColor2 50 50 50

	PrimaryTint2 50

	SecondaryTint2 40

	#ByTime3 13

	#BeColor3 1 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 10

	#BeColor4 1 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
