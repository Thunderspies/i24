System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 20

	NewPerFrame 1

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 2

	EmissionHeight 4

	EmissionStartJitter 2 3 2

	MoveScale 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	TightenUp 0

	StreakType 0 # (NOSTREAK)

	StreakScale 2

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 0

	#TimeToFull 10

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.3

	StartSizeJitter 0.1

	#ExpandRate 0.1

	#ExpandType 1 # (Expand to EndSize)

	#EndSize 0.5

	OrientationJitter 180



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	#InitialVelocityJitter 0.3 0.3 0.3

	#VelocityJitter 0.025 0.025 0.025

	Magnetism 0

	Gravity 0.002

	Drag 0.05

	Spin 0

	SpinJitter 75



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName Star_8pt.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	#AnimFrames1 0

	AnimPace1 1

	AnimType1 0 # (loop)

	#TextureName2

	TexScroll2 0 0.015 0.01

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 1

	FadeOutStart 3

	FadeOutBy 10

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 50

	SecondaryTint 0

	ByTime1 1

	BeColor1 192 192 192

	PrimaryTint1 80

	SecondaryTint1 0

	ByTime2 14

	BeColor2 255 255 255

	PrimaryTint2 50

	SecondaryTint2 0

	ByTime3 28

	BeColor3 192 192 192

	PrimaryTint3 0

	SecondaryTint3 80

	ByTime4 0

	BeColor4 255 255 255

	PrimaryTint4 0

	SecondaryTint4 0

	ColorOffset 0 0 0

	ColorOffsetJitter 0 0 0


End
