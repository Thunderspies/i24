System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 70

	NewPerFrame 0

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	#EmissionStartJitter 0.02 0.02 0.02

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.47 0

	InitialVelocityJitter 0.2 0.2 0.2

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0.03

	#Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0

	StreakType 1 # (VELOCITY)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.04

	StartSizeJitter 0.02

	ExpandRate 0

	#ExpandType 0 # (Expand Forever)

	EndSize 20

	#OrientationJitter 0



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName spark.tga

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 125

	FadeInBy 4

	FadeOutStart 30

	FadeOutBy 50

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 30

	BeColor1 10 0 10

	PrimaryTint1 0

	SecondaryTint1 90

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
