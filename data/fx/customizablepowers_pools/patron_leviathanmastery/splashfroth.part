System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 15

	#NewPerFrame 0.02

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 2 # (Cylinder)

	EmissionRadius 0.7

	#EmissionHeight 0

	EmissionStartJitter 0.01 0.01 0.01

	#MoveScale 3



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.01 0 0

	VelocityJitter 0.003 0 0.003

	Magnetism -0.0013

	Gravity 0.0011

	#Drag 0

	#Spin 1

	#SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.1

	StreakType 1 # (VELOCITY)

	StreakScale 5

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 0

	#TimeToFull 0

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.3

	StartSizeJitter 0.1

	ExpandRate 0.08

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName smoke.tga

	#TextureName2

	#TexScroll2 0.005 0.01 0

	#TexScrollJitter2 0.002 0.002 0

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 30

	FadeInBy 0

	FadeOutStart 17

	FadeOutBy 30

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 15

	BeColor1 150 150 150

	PrimaryTint1 90

	SecondaryTint1 0

	ByTime2 35

	BeColor2 55 55 55

	PrimaryTint2 0

	SecondaryTint2 90

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
