###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.43 0

	InitialVelocityJitter 0.06 0.023 0.06

	VelocityJitter 0.001 0 0.001

	Magnetism -0.001

	Gravity 0.03

	#Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0

