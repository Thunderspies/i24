	#EmissionRadius 1

	#EmissionHeight 0

	#EmissionStartJitter 1 1 1

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0.1 0 0

	InitialVelocityJitter 0.15 0.15 0.15

	VelocityJitter 0.01 0.01 0.01

	Magnetism 0

	#Gravity 0.005

	#Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.2

