System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 8

	#NewPerFrame 2.3

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 1

	#EmissionHeight 0

	EmissionStartJitter 0.05 0.05 0.1

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0.15

	InitialVelocityJitter 0.05 0.03 0.08

	VelocityJitter 0.003 0.003 0.01

	Magnetism -0.0001

	Gravity 0.002

	#Drag 0

	Spin 0

	SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.2

	StreakType 0 # (NOSTREAK)

	StreakScale 20

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.05

	StartSizeJitter 0.03

	ExpandRate 0.06

	ExpandType 0 # (Expand Forever)

	EndSize 3

	#OrientationJitter 0



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Glow_03_funkycloud.tga

	TextureName2 cot_dust_Scroller.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

