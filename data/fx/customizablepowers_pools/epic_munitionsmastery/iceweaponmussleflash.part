	#AnimPace1 0

	#AnimType1 0 # (loop)

	TexScroll2 0 -0.013 0

	TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 100

	FadeInBy 0

	FadeOutStart 20

	FadeOutBy 50

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 30

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	ByTime2 80

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 90

	#ByTime3 0

	#BeColor3 0 0 0

