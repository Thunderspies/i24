System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 2

	NewPerFrame 1.5

	#BurbleAmplitude 0.01

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0.02

	#BurbleThreshold 0.005

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 0.3

	#EmissionHeight 0

	EmissionStartJitter 0.1 0.1 0.1

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity -0.45 0 0

	InitialVelocityJitter 0.03 0.03 0.03

	VelocityJitter 0.004 0.004 0.004

	Magnetism 0

	Gravity -0.0007

	#Drag 0.1

	Spin 0

	SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0

	StreakType 0 # (NOSTREAK)

	StreakScale 10

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 0

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.3

	StartSizeJitter 0.1

	ExpandRate 0.1

	#ExpandType 0 # (Expand Forever)

	EndSize 3

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName Tintable_COT_Dust_Part1.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 200

	FadeInBy 0

	FadeOutStart 1

	FadeOutBy 15

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 50

	SecondaryTint 0

	ByTime1 1

	BeColor1 255 255 255

	PrimaryTint1 50

	SecondaryTint1 0

	ByTime2 10

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 50

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

