System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 0

	NewPerFrame 0.3

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 4 # (Sphere)

	EmissionRadius 0.3

	EmissionHeight 0

	#EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0 0

	#InitialVelocityJitter 0 0 0

	#VelocityJitter 0 0 0

	#Magnetism 0

	#Gravity 0

	#Drag 0

	#Spin 1

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 1 # (Local)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 0

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 2

	StartSizeJitter 1

	ExpandRate -0.06

	#ExpandType 0 # (Expand Forever)

	EndSize 0.7

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName Ember01.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#TexScroll2 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 30

	FadeInBy 0

	FadeOutStart 3

	FadeOutBy 7

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 90

	ByTime1 3

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 90

	ByTime2 7

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 90

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
