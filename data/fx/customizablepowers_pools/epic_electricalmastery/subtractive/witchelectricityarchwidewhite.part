System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 6

	NewPerFrame 0.5

	#BurbleAmplitude 0.01

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0.0001

	#BurbleThreshold 0.01

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0.5

	#EmissionHeight 0

	#EmissionStartJitter 0.3 0.3 0.3

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.13 0

	InitialVelocityJitter 0.13 0.13 0.13

	#VelocityJitter 0.001 0.001 0.001

	Magnetism 0

	Gravity 0.013

	#Drag 0

	#Spin 1

	#SpinJitter 6



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0.45

	#TightenUp 0.2

	StreakType 1 # (VELOCITY)

	StreakScale -1

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.07

	StartSizeJitter 0.04

	#ExpandRate -0.003

	#ExpandType 0 # (Expand Forever)

	#EndSize 0.07

	#OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName Generic_Spark.tga

	#TexScroll1 0 0.003 0

	#TexScrollJitter1 0 0.008 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 0

	FadeOutStart 30

	FadeOutBy 40

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 40

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	#ByTime2 2

	#BeColor2 255 255 255

	#PrimaryTint2 0

	#SecondaryTint2 90

	#ByTime3 3

	#BeColor3 255 255 255

