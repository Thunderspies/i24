System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 3

	NewPerFrame 0.02

	#BurbleAmplitude 0.3

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0.3

	EmissionHeight 0

	#EmissionStartJitter 0.5 0 0.5

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0 0

	#InitialVelocityJitter 0.001 0.001 0.001

	#VelocityJitter 0.001 0.001 0.001

	#Magnetism -0.005

	Gravity 0

	#Drag 0

	#Spin 1

	#SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 1 # (Local)

	#Stickiness 0

	TightenUp 0.2

	#StreakType 0 # (NOSTREAK)

	#StreakScale 5

	#StreakOrient 1 # (Orient)

	#StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 12

	StartSizeJitter 1

	ExpandRate -0.1

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.1

	OrientationJitter 50



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName ThinRing.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 75

	FadeInBy 10

	FadeOutStart 80

	FadeOutBy 100

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 40

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 90

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

