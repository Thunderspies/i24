###########################################################

	#Burst 20

	NewPerFrame 0.025

	BurbleAmplitude 0.3

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 1

	BurbleThreshold 0

	#EmissionLifeSpan 1

