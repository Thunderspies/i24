	Gravity -0.001

	#Drag 0.1

	#Spin 100

	#SpinJitter 30



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0.5

	TightenUp 0.5

	StreakType 7 # (CHAIN)

	StreakScale 5

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 1

	#SortBias 1

