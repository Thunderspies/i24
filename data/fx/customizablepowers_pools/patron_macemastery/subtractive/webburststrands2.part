System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 15

	NewPerFrame 2

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 1 # (Line)

	EmissionRadius 2.5

	#EmissionHeight 0

	EmissionStartJitter 2.01 1.01 2.01

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.5 0

	InitialVelocityJitter 0.8 0.25 0.8

	VelocityJitter 0.1 0.1 0.1

	Magnetism 0.002

	Gravity 0.03

	Drag 0.01

	Spin 20

	SpinJitter 15



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 1

	StreakType 1 # (VELOCITY)

	StreakScale 15

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	#StartSizeJitter 0.05

	#ExpandRate 0

	#ExpandType 1 # (Expand to EndSize)

	#EndSize 0.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName tech_lightningInverted.tga

	TexScroll1 0 0 0.2

	TexScrollJitter1 0 0 0

	#AnimFrames1 0

	AnimPace1 0

	AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 5

	FadeOutStart 10

	FadeOutBy 25

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	#ByTime1 20

	#BeColor1 80 90 73

	#PrimaryTint1 0

	#SecondaryTint1 0

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
