###########################################################

	Burst 2

	NewPerFrame 1

	#BurbleAmplitude 0.7

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0.2

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 3 # (Even Trail)

	EmissionRadius 0.5

	EmissionHeight 0

	EmissionStartJitter 0.01 0.01 0.01

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 -0.07

	InitialVelocityJitter 0.7 0.7 0.7

	VelocityJitter 0.001 0.001 0.001

	#Magnetism -0.0004

	Gravity 0

	Drag 0.15

	#Spin 1

	#SpinJitter 2



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0.8

	TightenUp 0

	StreakType 1 # (VELOCITY)

	StreakScale 4

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.06

	StartSizeJitter 0.01

	ExpandRate -0.006

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.03

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
