	Alpha 255

	FadeInBy 0

	FadeOutStart 7

	FadeOutBy 20

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 20

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 90

	#ByTime2 24

