	InitialVelocityJitter 0 0 0

	#VelocityJitter 0.007 0.007 0.007

	#Magnetism 0.04

	Gravity 0

	#Drag 0.2

	#Spin 1

	#SpinJitter 2



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 1

	TightenUp 0

