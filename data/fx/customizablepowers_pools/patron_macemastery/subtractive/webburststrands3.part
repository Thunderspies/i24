System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 20

	NewPerFrame 3

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 1 # (Line)

	EmissionRadius 2.5

	#EmissionHeight 0

	EmissionStartJitter 2.01 1.01 2.01

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.4 0

	InitialVelocityJitter 0.65 0.25 0.65

	VelocityJitter 0.1 0.1 0.1

	Magnetism 0.002

	Gravity 0.02

	Drag 0.025

	Spin 0

	SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 1

	StreakType 0 # (NOSTREAK)

	StreakScale 10

	StreakOrient 0 # (No Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.65

	StartSizeJitter 0.15

	#ExpandRate 0

	#ExpandType 1 # (Expand to EndSize)

	#EndSize 0.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName tech_lightningInverted.tga

	TexScroll1 0 0 0.2

	TexScrollJitter1 0 0 0

	#AnimFrames1 0

	AnimPace1 0

	AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 155

	FadeInBy 5

	FadeOutStart 20

	FadeOutBy 45

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 90

	#ByTime1 20

	#BeColor1 80 90 73

	#PrimaryTint1 0

	#SecondaryTint1 0

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
