System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 55

	#NewPerFrame 1

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

