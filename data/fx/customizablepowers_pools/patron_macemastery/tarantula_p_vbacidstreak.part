###########################################################

	#Burst 20

	NewPerFrame 0.05

	BurbleAmplitude 0.3

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 1

	BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 1 # (Line)

	EmissionRadius 0.5

	EmissionHeight 0

	EmissionStartJitter 0.2 0.1 0.2

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.02 0

	InitialVelocityJitter 0.001 0.001 0.001

	VelocityJitter 0 0 0

	#Magnetism -0.001

	Gravity -0.00075

	#Drag 0.1

	Spin 100

	SpinJitter 30



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0.5

	TightenUp 0.2

	StreakType 7 # (CHAIN)

	StreakScale 5

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 1

	#SortBias 1

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	StartSizeJitter 0.2

	ExpandRate 0.05

	ExpandType 0 # (Expand Forever)

	EndSize 1

	OrientationJitter 180



