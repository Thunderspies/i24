	Alpha 180

	FadeInBy 10

	FadeOutStart 25

	FadeOutBy 50

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 15

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	ByTime2 20

	BeColor2 255 255 255

	PrimaryTint2 90

	SecondaryTint2 0

