System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 5

	NewPerFrame 5

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 100

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 3 3 3

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.20 0

	InitialVelocityJitter 0.250 0.150 0.250

	VelocityJitter 0.04 0 0.04

	Magnetism 0

	Gravity 0.004

	Drag 0.05

	Spin 0

	SpinJitter 30



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 1

	StreakType 1 # (VELOCITY)

	StreakScale 1

	StreakOrient 0 # (No Orient)

	StreakDirection 1 # (destination)

	#KickStart 0

	#TimeToFull 0

	SortBias 2

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.1

	StartSizeJitter 0.05

	ExpandRate -0.0025

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.05

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName OilSplat.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 0

	AnimType1 0 # (loop)

	#TextureName2

	TexScroll2 0 0 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 20

	FadeOutStart 50

	FadeOutBy 100

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 60

	#ByTime1 1

	#BeColor1 255 100 50

	#PrimaryTint1 0

	#SecondaryTint1 0

	#ByTime2 30

	#BeColor2 255 100 50

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 100

	#BeColor3 250 100 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 150

	#BeColor4 255 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	ColorOffset 6 0 0

	ColorOffsetJitter 30 0 0


End
