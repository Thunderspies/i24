	InitialVelocity 0 0.3 0

	#InitialVelocityJitter 0 0 0

	#VelocityJitter 0.002 0.002 0.002

	#Magnetism 1

	#Gravity 1

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	#TightenUp 3

	StreakType 1 # (VELOCITY)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

