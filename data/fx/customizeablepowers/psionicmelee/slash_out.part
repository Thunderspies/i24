	Alpha 180

	FadeInBy 1

	FadeOutStart 3

	FadeOutBy 12

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 40

	ByTime1 1

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 100

	ByTime2 2

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 100

