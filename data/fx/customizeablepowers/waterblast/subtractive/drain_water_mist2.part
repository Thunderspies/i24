System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 10

	NewPerFrame 0.1300

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 30

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 1

	#EmissionHeight 0

	EmissionStartJitter 1 1 0

	#MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0.2 0

	#InitialVelocityJitter 0 0.1 0

	#VelocityJitter 0 0 0

	Magnetism 0.040000

	#Gravity 0.0003

	#Drag 0.15

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 1

	TightenUp 0.4

	StreakType 4 # (MAGNET)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	KickStart 1

	TimeToFull 10

	#SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 2

	StartSizeJitter 1

	ExpandRate 0.050

	ExpandType 2 # (Ping Pong)

	EndSize 5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName SmokeNewC.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	TextureName2 Fire_Scroller02.tga

	TexScroll2 0 0.010 0

	TexScrollJitter2 0 0.01 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 30

	FadeInBy 15

	FadeOutStart 15

	FadeOutBy 30

	StartColor 255 255 255

	#ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 60

	SecondaryTint 0

	ByTime1 10

	BeColor1 255 255 255

	PrimaryTint1 60

	SecondaryTint1 0

	ByTime2 20

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 60

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
