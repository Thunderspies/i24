System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 2

	NewPerFrame 0.2

	#BurbleAmplitude 0.7

	#BurbleType 1 # (Random Curve)

	#BurbleFrequency 0.2

	#BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0 0 0

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.1 0 0.1

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0

	Drag 0.035

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 1 # (Local)

	Stickiness 0

	TightenUp 0.3

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 1.5

	StartSizeJitter 0.2

	ExpandRate 0.5

	ExpandType 0 # (Expand Forever)

	EndSize 1.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName cot_dust.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 1

	AnimType1 0 # (loop)

	#TextureName2

	TexScroll2 0 0 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 100

	FadeInBy 5

	FadeOutStart 10

	FadeOutBy 30

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 40

	SecondaryTint 0

	ByTime1 1

	BeColor1 255 255 255

	PrimaryTint1 40

	SecondaryTint1 0

	ByTime2 10

	BeColor2 255 255 255

	PrimaryTint2 70

	SecondaryTint2 0

	ByTime3 20

	BeColor3 255 255 255

	PrimaryTint3 0

	SecondaryTint3 70

	ByTime4 0

	BeColor4 0 0 0

