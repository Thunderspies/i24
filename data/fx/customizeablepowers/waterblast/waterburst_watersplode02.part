System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 10

	NewPerFrame 3

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 30

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	#EmissionStartJitter 0 0 0

	#MoveScale 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 1.2

	#StreakType 0 # (NOSTREAK)

	#StreakScale 3

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	StartSizeJitter 0.3

	ExpandRate 0.35

	ExpandType 0 # (Expand Forever)

	EndSize 0

	OrientationJitter 180



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 1.2 0

	InitialVelocityJitter 1 1 1

	#VelocityJitter 0 0 0

	#Magnetism 0

	Gravity 0.08

	Drag 0.08

	#Spin 0

	#SpinJitter 0



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName WaterSplash6.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	TextureName2 CoS_Death_Cloud.tga

	#TexScroll2 0 0.005 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 1

	FadeOutStart 16

	FadeOutBy 27

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 40

	SecondaryTint 0

	ByTime1 3

	BeColor1 255 255 255

	PrimaryTint1 40

	SecondaryTint1 0

	ByTime2 20

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 100

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


