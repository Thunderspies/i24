System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 20

	NewPerFrame 0

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 2 # (Cylinder)

	EmissionRadius 1

	EmissionHeight 0

	EmissionStartJitter 0 0.1 0

	MoveScale 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 0.1

	StreakType 1 # (VELOCITY)

	StreakScale 5

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 0

	#TimeToFull 10

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	StartSizeJitter 0.25

	ExpandRate 0.1

	ExpandType 0 # (Expand Forever)

	EndSize 0

	OrientationJitter 180



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.005 0

	InitialVelocityJitter 0.01 0.005 0.01

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0

	Drag 0

	Spin 0

	SpinJitter 5



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName smoke.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 1

	AnimType1 0 # (loop)

	TextureName2 Snow_Scroller.tga

	TexScroll2 0 0 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 200

	FadeInBy 8

	FadeOutStart 30

	FadeOutBy 65

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	SecondaryTint 80

	ByTime1 1

	BeColor1 255 255 255

	#PrimaryTint1 100

	SecondaryTint1 80

	ByTime2 10

	BeColor2 255 255 255

	#PrimaryTint2 100

	SecondaryTint2 80

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	ColorOffset 0 0 0

	ColorOffsetJitter 0 0 0


End
