###########################################################

	#InitialVelocity 0 0 0.10000

	#InitialVelocityJitter 0.1 0.1 0.05000

	#VelocityJitter 0 0 0

	#Magnetism 0.030000

	#Gravity 0.02

	#Drag 0

	#Spin 0

	#SpinJitter 45



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 1

	#TightenUp 1

	StreakType 3 # (ORIGIN)

	StreakScale 8

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0.5

