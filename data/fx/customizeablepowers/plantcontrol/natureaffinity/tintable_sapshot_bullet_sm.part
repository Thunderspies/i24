	#DeathAgeToZero 0 # (keep age)

	StartSize 0.75

	StartSizeJitter 0.10

	#ExpandRate 0.12500

	#ExpandType 0 # (Expand Forever)

	#EndSize 0

	#OrientationJitter 128



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Blast_BrokenTrail.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

