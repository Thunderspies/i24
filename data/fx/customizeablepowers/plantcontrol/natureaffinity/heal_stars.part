System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 0

	NewPerFrame 1

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	EmissionStartJitter 1.200000 1 0.8

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0 0

	#InitialVelocityJitter 0 0 0

	VelocityJitter 0.0100000 0 0.0100000

	#Magnetism 0

	Gravity -0.007000

	Drag 0.030000

	Spin 60

	SpinJitter 45



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	Stickiness 0.9

	#TightenUp -1

	#StreakType 0 # (NOSTREAK)

	#StreakScale 1

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	StartSizeJitter 0.2

	ExpandRate 0.05

	ExpandType 2 # (Ping Pong)

	EndSize 0.1

	OrientationJitter 128



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Star_8pt_Horizontal_128x128.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

