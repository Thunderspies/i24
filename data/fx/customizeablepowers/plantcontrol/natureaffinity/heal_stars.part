	Alpha 200

	FadeInBy 5

	FadeOutStart 15

	FadeOutBy 30

	StartColor 102 209 122

	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 1

	BeColor1 102 209 122

	#PrimaryTint1 0

	#SecondaryTint1 0

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

