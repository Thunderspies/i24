System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 1

	NewPerFrame 8

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	#EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	#TightenUp 0

	#StreakType 0 # (NOSTREAK)

	#StreakScale 1

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	#SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.1

	StartSizeJitter 0.05

	ExpandRate 0.5

	ExpandType 0 # (Expand Forever)

	#EndSize 0

	OrientationJitter 128



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0.50

	InitialVelocityJitter 0.5 0 0.5

	#VelocityJitter 0 0 0

	#Magnetism 0

	#Gravity 0

	#Drag 0

	#Spin 0

	SpinJitter 15



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName smoke.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 1

	#AnimType1 0 # (loop)

	TextureName2 SSClouds02.tga

	TexScroll2 0 -0.01 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 1

	#AnimType2 0 # (loop)

	Alpha 100

	FadeInBy 1

	FadeOutStart 2

	FadeOutBy 15

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 80

	SecondaryTint 80

	#ByTime1 1

	#BeColor1 255 255 255

	#PrimaryTint1 80

	#SecondaryTint1 0

	#ByTime2 6

	#BeColor2 100 100 100

	#PrimaryTint2 80

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


