System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 10

	NewPerFrame 0.5

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 2 0 2

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.1 0.8

	InitialVelocityJitter 0 0.1 0.5

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity -0.01

	Drag 0.05

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 0.15

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 5

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 1

	StartSizeJitter 0.5

	ExpandRate 0.2

	ExpandType 1 # (Expand to EndSize)

	EndSize 5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName SmokeNewC.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 1

	AnimType1 0 # (loop)

	TextureName2 CoS_Death_Cloud.tga

	TexScroll2 0 0.01 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 150

	FadeInBy 5

	FadeOutStart 6

	FadeOutBy 25

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 80

	ByTime1 1

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 80

	ByTime2 15

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 60

	ByTime3 0

	BeColor3 255 255 255

	PrimaryTint3 0

	SecondaryTint3 0

	ByTime4 0

	BeColor4 255 255 255

