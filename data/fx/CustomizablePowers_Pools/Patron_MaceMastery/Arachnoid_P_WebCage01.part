### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0 0 0.01

	#VelocityJitter 0 0 0.04

	#Magnetism 1

	#Gravity -0.02

	#Drag 0

	#Spin 1

	#SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.1

	StreakType 5 # (OTHER)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.8

	StartSizeJitter 0.2

	#ExpandRate -0.06

	#ExpandType 0 # (Expand Forever)

	#EndSize 1

	#OrientationJitter 180



###########################################################
### Texture/Color #########################################
