System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 30

	#NewPerFrame 0.5

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0.5

	EmissionHeight 0

	#EmissionStartJitter 0.4 0 0.4

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 -0.007 0

	InitialVelocityJitter 0.6 0.6 0.6

	#VelocityJitter 0.002 0.002 0.002

	Magnetism -0.01

	#Gravity 0.07

	#Drag 0

	#Spin 1

	#SpinJitter 30



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0

	StreakType 3 # (ORIGIN)

	StreakScale 40

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.1

	StartSizeJitter 0.1

	#ExpandRate 1.3

	#ExpandType 0 # (Expand Forever)

	#EndSize 0.3

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName glow.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 155

	FadeInBy 0

	FadeOutStart 3

	FadeOutBy 10

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 80

	SecondaryTint 0

	ByTime1 15

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 90

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
