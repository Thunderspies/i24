	InitialVelocity 0 0.02 0

	InitialVelocityJitter 0.006 0 0.006

	#VelocityJitter 0.01 0.02 0.01

	Magnetism 0

	#Gravity 0.03

	#Drag 0

	Spin 5

	SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp -0.3

