System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 0

	NewPerFrame 0.6

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0.5 0.5 0.5

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 -0.03

	#InitialVelocityJitter 0.005 0 0.005

	#VelocityJitter 0.003 0 0.003

	Magnetism 0.0035

	#Gravity 0.002

	#Drag 0

	#Spin 1

	#SpinJitter 2



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0

	StreakType 7 # (CHAIN)

	StreakScale 2

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	StartSizeJitter 0.2

	#ExpandRate 0.01

	#ExpandType 1 # (Expand to EndSize)

	#EndSize 0.6

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName DarknessHandTenticle.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 75

	FadeInBy 0

	FadeOutStart 20

	FadeOutBy 40

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 2

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	ByTime2 5

	BeColor2 255 255 255

	PrimaryTint2 50

	SecondaryTint2 40

	ByTime3 10

	BeColor3 255 255 255

	PrimaryTint3 0

	SecondaryTint3 90

	ByTime4 30

	BeColor4 255 255 255

