System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 3

	#NewPerFrame 2.4

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 0.2

	#EmissionHeight 0

	#EmissionStartJitter 0.3 0.3 0.3

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0.3 0

	#InitialVelocityJitter 0.45 0.05 0.45

	#VelocityJitter 0.01 0.02 0.01

	Magnetism 0

	#Gravity 0.04

	#Drag 0

	#Spin 5

	#SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.5

	StreakType 0 # (NOSTREAK)

	StreakScale 20

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.2

	StartSizeJitter 0.7

	ExpandRate 1

	ExpandType 1 # (Expand to EndSize)

	EndSize 6

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5


	TextureName SharpStar.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 0

	FadeOutStart 6

	FadeOutBy 8

	StartColor 25 25 25

	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 70

	#SecondaryTint 0

	ByTime1 8

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	ByTime2 20

	BeColor2 255 255 255

	PrimaryTint2 50

	SecondaryTint2 40

	#ByTime3 30

	#BeColor3 50 50 50

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


