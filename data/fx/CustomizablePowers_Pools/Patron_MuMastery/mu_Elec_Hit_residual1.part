System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 20

	#NewPerFrame 1

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 2 # (Cylinder)

	EmissionRadius 1

	EmissionHeight 7

	EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.12 0.12 0.12

	VelocityJitter 0 0 0

	Magnetism -0.01

	Gravity 0.0066

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	#TightenUp 0.1

	StreakType 5 # (OTHER)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0

	StartSizeJitter 0.1

	ExpandRate 0.2

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName MuLightningThick_Colorless.tga

	TexScroll1 0 -0.3 0

	TexScrollJitter1 0 0.001 0

	TextureName2 TillingSource.tga

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 180

	FadeInBy 0

	FadeOutStart 5

	FadeOutBy 20

	StartColor 255 255 255

	ColorChangeType 1 # (LoopBackToBeginning)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 2

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 90

	ByTime2 4

	BeColor2 255 255 255

	PrimaryTint2 90

	SecondaryTint2 0

	#ByTime3 3

	#BeColor3 255 255 255

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
