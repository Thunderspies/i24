System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 3

	#NewPerFrame 0.1

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 4.5

	EmissionHeight 0

	EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	#InitialVelocityJitter 0.025 0.025 0.025

	#VelocityJitter 0.001 0.001 0.001

	#Magnetism -0.001

	Gravity 0

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.1

	StreakType 0 # (NOSTREAK)

	StreakScale 10

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.2

	StartSizeJitter 1

	ExpandRate 0.5

	ExpandType 1 # (Expand to EndSize)

	EndSize 10

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName electricring1copy.tga

	#TexScroll1 0 -0.3 0

	#TexScrollJitter1 0 0.001 0

	#TextureName2

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 155

	FadeInBy 0

	FadeOutStart 4

	FadeOutBy 10

	StartColor 50 0 0

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 80

	SecondaryTint 0

	ByTime1 1

	BeColor1 255 255 255

	PrimaryTint1 80

	SecondaryTint1 0

	ByTime2 10

	BeColor2 255 255 255

	PrimaryTint2 90

	SecondaryTint2 0

	#ByTime3 3

	#BeColor3 255 255 255

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


