	Alpha 220

	FadeInBy 1

	FadeOutStart 2

	FadeOutBy 5

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 90

	ByTime1 2

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 90

