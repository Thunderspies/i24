###########################################################

	#Burst 10

	NewPerFrame 0.5

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 3 # (Even Trail)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0.25 0.25 0.25

	MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.01 0.01 0.01

	VelocityJitter 0.008 0.008 0.008

	#Magnetism -0.005

	Gravity -0.003

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	#TightenUp 0.1

	StreakType 7 # (CHAIN)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.1

	StartSizeJitter 0.08

	ExpandRate 0.2

	ExpandType 0 # (Expand Forever)

	EndSize 0.7

	OrientationJitter 180



