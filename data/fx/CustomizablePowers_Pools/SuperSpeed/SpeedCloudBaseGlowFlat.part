### Particle ##############################################
###########################################################

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 1 # (Local)

	#Stickiness 0

	TightenUp 0.1

	StreakType 0 # (NOSTREAK)

	StreakScale 20

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	TimeToFull 0

	#SortBias 0

	DieLikeThis BlueFlame01.part

	DeathAgeToZero 1 # (reset age)

	StartSize 2

	StartSizeJitter 0.15

	#ExpandRate 1

	EndSize 0.01

	#ExpandType 0 # (Expand Forever)

	#OrientationJitter 180



