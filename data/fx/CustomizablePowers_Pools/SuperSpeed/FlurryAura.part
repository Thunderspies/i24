### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0 0 0

	#VelocityJitter 0.001 0.001 0.001

	#Magnetism 0.0004

	Gravity 0

	#Drag 0

	#Spin 1

	#SpinJitter 2



###########################################################
### Particle ##############################################
###########################################################

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.2

	StreakType 1 # (VELOCITY)

	StreakScale 10

	StreakOrient 0 # (No Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 4

	StartSizeJitter 0.5

	#ExpandRate -0.08

	#ExpandType 0 # (Expand Forever)

	EndSize 2

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName smoke.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

