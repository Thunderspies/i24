	Alpha 30

	FadeInBy 20

	FadeOutStart 20

	FadeOutBy 40

	StartColor 255 255 255

	#ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 10

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

