System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 3

	#NewPerFrame 0.5

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 0.2

	#EmissionHeight 0

	#EmissionStartJitter 0.3 0.3 0.3

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0 0

	#InitialVelocityJitter 0 0 0

	#VelocityJitter 0 0 0

	Magnetism 0

	#Gravity 1

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.3

	StreakType 0 # (NOSTREAK)

	StreakScale 20

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 2

	#StartSizeJitter 0.5

	ExpandRate 0.5

	#ExpandType 0 # (Expand Forever)

	EndSize 25

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName Generic_HitFlash_old.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 70

	FadeInBy 0

	FadeOutStart 2

	FadeOutBy 4

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 3

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 90

	#ByTime2 4

	#BeColor2 255 255 255

	#PrimaryTint2 0

	#SecondaryTint2 90

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

