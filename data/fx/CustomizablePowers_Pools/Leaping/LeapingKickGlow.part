System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 5

	#NewPerFrame 1

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0

	#BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	EmissionStartJitter 0.5 0.5 0.5



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 0 0

	#InitialVelocityJitter 0 0 0

	#VelocityJitter 0 0 0

	Magnetism 0

	#Gravity 0

	#Drag 0



###########################################################
### Partical ##############################################
###########################################################

	WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	#MoveScale 0

	TightenUp 0.5

	StreakType 0 # (NOSTREAK)

	StreakScale 20

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 0

	#TimeToFull 10

	#SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 1

	StartSizeJitter 0.4

	ExpandRate 0.04

	#ExpandType 0 # (Expand Forever)

	EndSize 2

	OrientationJitter 180

	#Spin 0

	#SpinJitter 0



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Generic_flame.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 1

	#AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 1

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 0

	FadeOutStart 8

	FadeOutBy 10

	StartColor 255 255 255


	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 90

	#SecondaryTint 0

	ByTime1 1

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	ByTime2 15

	BeColor2 255 255 255

	PrimaryTint2 30

	SecondaryTint2 60

	#ByTime3 0

	#BeColor3 255 255 255

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 255 255 255

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
