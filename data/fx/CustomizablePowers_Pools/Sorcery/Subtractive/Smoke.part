System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 5

	#NewPerFrame 0.5

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 100

	#EmissionLifeSpanJitter 50

	EmissionType 0 # (Point)

	#EmissionRadius 10

	#EmissionHeight 0.01

	EmissionStartJitter 1 1 1

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.2 0

	InitialVelocityJitter 0.5 0.3 0.5

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity -0.005

	Drag 0.1

	Spin 0

	SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp -1

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 0

	#TimeToFull 0

	SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 2

	StartSizeJitter 1

	ExpandRate 1

	ExpandType 1 # (Expand to EndSize)

	EndSize 6

	OrientationJitter 100



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName SmokeNewC.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 0

	AnimPace1 0

	AnimType1 0 # (loop)

	TextureName2 CoS_Death_Cloud.tga

	TexScroll2 0 0.008 0

	TexScrollJitter2 0 0 0

	AnimFrames2 0

	AnimPace2 1

	AnimType2 0 # (loop)

	Alpha 180

	FadeInBy 20

	FadeOutStart 20

	FadeOutBy 45

	StartColor 1 1 1

	ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 3

	BeColor1 1 1 1

	#PrimaryTint1 0

	#SecondaryTint1 0

	ByTime2 25

	BeColor2 100 100 100

	#PrimaryTint2 0

	#SecondaryTint2 0

	ByTime3 40

	BeColor3 192 192 192

	#PrimaryTint3 0

	#SecondaryTint3 0

	ByTime4 0

	BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	ColorOffset 0 0 0

	ColorOffsetJitter 0 0 0


