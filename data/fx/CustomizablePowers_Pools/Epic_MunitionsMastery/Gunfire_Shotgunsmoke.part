System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 5

	NewPerFrame 2

	#BurbleAmplitude 0.01

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0.02

	#BurbleThreshold 0.005

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0.3

	#EmissionHeight 0

	EmissionStartJitter 0.5 1 0.5

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.0025 0.0025 0.0025

	VelocityJitter 0.0025 0.0025 0.0025

	#Magnetism 0

	Gravity -0.0015

	#Drag 0.1

	Spin 0

	SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	#FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	TightenUp 0.125

	#StreakType 0 # (NOSTREAK)

	#StreakScale 20

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 0

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.75

	StartSizeJitter 0.25

	ExpandRate 0.0125

	#ExpandType 0 # (Expand Forever)

	#EndSize 3.1

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName smoke.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 12

	FadeInBy 5

	FadeOutStart 5

	FadeOutBy 45

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 50

	SecondaryTint 0

	ByTime1 3

	BeColor1 255 255 255

	PrimaryTint1 50

	SecondaryTint1 0

	ByTime2 20

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 80

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
