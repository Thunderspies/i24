	InitialVelocity 0 0.02 0

	InitialVelocityJitter 0.03 0.03 0.03

	#VelocityJitter 0.008 0.008 0.008

	#Magnetism -0.001

	Gravity 0.0015

	#Drag 0

	Spin 0

	SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0.9

	TightenUp 0.1

	StreakType 0 # (NOSTREAK)

	StreakScale 3

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.1

	StartSizeJitter 1

	ExpandRate 0.05

	ExpandType 0 # (Expand Forever)

	EndSize 1.5

	OrientationJitter 180



