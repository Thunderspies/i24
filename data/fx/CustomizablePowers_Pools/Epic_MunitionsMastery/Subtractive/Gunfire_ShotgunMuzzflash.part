	Alpha 255

	FadeInBy 0

	FadeOutStart 1

	FadeOutBy 7

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 50

	SecondaryTint 0

	ByTime1 3

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

