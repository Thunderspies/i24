System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 30

	NewPerFrame 2

	#BurbleAmplitude 0.01

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0.02

	#BurbleThreshold 0.005

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.9 0

	InitialVelocityJitter 1.6 1 1.6

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0.025

	Drag 0.1

	Spin 0

	SpinJitter 2



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 0.4

	#StreakType 7 # (CHAIN)

	#StreakScale 10

	#StreakOrient 1 # (Orient)

	#StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 0

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.3

	StartSizeJitter 0.05

	ExpandRate -0.005

	ExpandType 0 # (Expand Forever)

	EndSize 0.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName flashGlow.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 200

	FadeInBy 1

	FadeOutStart 45

	FadeOutBy 60

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 50

	SecondaryTint 0

	ByTime1 5

	BeColor1 255 255 255

	PrimaryTint1 50

	SecondaryTint1 0

	ByTime2 20

	BeColor2 255 255 255

	PrimaryTint2 90

	SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
