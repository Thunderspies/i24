	Alpha 20

	FadeInBy 0

	FadeOutStart 10

	FadeOutBy 25

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 20

	BeColor1 155 155 155

	PrimaryTint1 90

	SecondaryTint1 0

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

