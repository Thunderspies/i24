###########################################################

	Burst 3

	NewPerFrame 0.8

	BurbleAmplitude 0.8

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 1

	BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 2 # (Cylinder)

	EmissionRadius 8

	EmissionHeight 0

	EmissionStartJitter 4 0 4

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.05 0 0.05

	VelocityJitter 0.02 0 0.02

	Magnetism 0.05

	#Gravity -0.005

	#Drag 0

	Spin 1

	SpinJitter 2



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 1 # (Local)

	Stickiness 0.5

	TightenUp 0.5

	StreakType 1 # (VELOCITY)

	StreakScale 2

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

