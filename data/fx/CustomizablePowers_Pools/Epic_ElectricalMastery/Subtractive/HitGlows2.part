System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 40

	#NewPerFrame 6

	#BurbleAmplitude 0.1

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0.03

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 3

	EmissionHeight 0

	#EmissionStartJitter 0.6 0.6 0.6

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.8 0.8 0.8

	VelocityJitter 0.1 0.1 0.1

	Magnetism -0.007

	Gravity 0

	#Drag 0

	#Spin 1

	SpinJitter 1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0.6

	TightenUp 0.55

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.5

	StartSizeJitter 0.3

	#ExpandRate -0.02

	#ExpandType 0 # (Expand Forever)

	#EndSize 0.1

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5


	TextureName glow.tga

	#TextureName2

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 0

	FadeOutStart 2

	FadeOutBy 20

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 80

	SecondaryTint 0

	ByTime1 5

	BeColor1 255 255 255

	PrimaryTint1 80

	SecondaryTint1 0

	ByTime2 15

	BeColor2 255 255 255

	PrimaryTint2 0

	SecondaryTint2 90

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
