System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 2

	NewPerFrame 0.5

	BurbleAmplitude 0.25

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 1

	BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 4 # (Sphere)

	EmissionRadius 0.5

	EmissionHeight 0

	EmissionStartJitter 0.7 0.7 0.7

	MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 -0.01 0

	InitialVelocityJitter 0.01 0.01 0.01

	VelocityJitter 0.01 0.01 0.01

	#Magnetism 0.001

	Gravity -0.001

	#Drag 0

	#Spin 1

	#SpinJitter 2



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0.45

	TightenUp 0.2

	StreakType 7 # (CHAIN)

	StreakScale 1

	StreakOrient 1 # (Orient)

	StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 3

	StartSizeJitter 0.2

	ExpandRate 0.1

	ExpandType 0 # (Expand Forever)

	EndSize 18

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Ember.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	TextureName2 Cosmic_Scroller.tga

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	TexScroll2 0.01 0.01 0.01

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 150

	FadeInBy 0

	FadeOutStart 7

	FadeOutBy 40

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 2

	BeColor1 255 255 255

	PrimaryTint1 80

	SecondaryTint1 0

	ByTime2 4

	BeColor2 255 255 255

	PrimaryTint2 90

	SecondaryTint2 0

	ByTime3 10

	BeColor3 255 255 255

	PrimaryTint3 90

	SecondaryTint3 0

	ByTime4 20

	BeColor4 0 0 0

