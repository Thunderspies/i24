System


###########################################################
### Emitter ###############################################
###########################################################

	#Burst 4

	NewPerFrame 0.5

	#BurbleAmplitude 0.1

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0.03

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0 0 0

	#VelocityJitter 0.001 0.001 0.001

	#Magnetism -0.001

	#Gravity 0.002

	#Drag 0

	Spin 1

	SpinJitter 4



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0.99

	TightenUp 1

	#StreakType 0 # (NOSTREAK)

	#StreakScale 20

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 1

	StartSizeJitter 1.5

	ExpandRate 0.4

	ExpandType 0 # (Expand Forever)

	EndSize 1.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName Generic_Ring.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2 RainbowGlow.tga

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 55

	FadeInBy 10

	FadeOutStart 13

	FadeOutBy 20

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 90

	ByTime1 1

	BeColor1 255 255 255

	PrimaryTint1 0

	SecondaryTint1 90

	#ByTime2 20

	#BeColor2 110 110 255

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 30

	#BeColor3 110 255 110

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 40

	#BeColor4 255 110 255

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 0 0 0


End
