System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 4

	#NewPerFrame 0.2

	#BurbleAmplitude 0.1

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 0.03

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 0 # (Point)

	EmissionRadius 2

	EmissionHeight 0

	#EmissionStartJitter 0.7 2 0.7

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0 0 0

	#VelocityJitter 0.001 0.001 0.001

	#Magnetism 0.005

	#Gravity 0.001

	#Drag 0

	#Spin -1

	#SpinJitter 4



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0.99

	TightenUp -0.1

	StreakType 0 # (NOSTREAK)

	StreakScale 20

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 1

	StartSizeJitter 1.5

	ExpandRate 0.1

	ExpandType 2 # (Ping Pong)

	EndSize 1.5

	OrientationJitter 180



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 5

	TextureName Tintable_CouldRing01.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2 RainbowGlow.tga

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 105

	FadeInBy 3

	FadeOutStart 5

	FadeOutBy 10

	StartColor 255 255 255

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 90

	SecondaryTint 0

	ByTime1 40

	BeColor1 255 255 255

	PrimaryTint1 90

	SecondaryTint1 0

	#ByTime2 20

	#BeColor2 110 110 255

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 30

