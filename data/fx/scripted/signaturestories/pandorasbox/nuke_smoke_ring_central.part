System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 3

	NewPerFrame 0.5

	BurbleAmplitude 0

	BurbleType 0 # (Sine Wave)

	BurbleFrequency 0

	BurbleThreshold 0

	#EmissionLifeSpan 0

	#EmissionLifeSpanJitter 0

	EmissionType 2 # (Cylinder)

	EmissionRadius 8.5

	EmissionHeight 0

	EmissionStartJitter 0.1 0.2 0.1

	MoveScale 0



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.05 0 0.05

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity -0.0001

	Drag 0

	Spin 0

	SpinJitter 10



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 1.1

	StreakType 0 # (NOSTREAK)

	StreakScale 5

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	SortBias 0.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 1.6

	StartSizeJitter 0.5

	ExpandRate 0.2

	ExpandType 0 # (Expand Forever)

	EndSize 0

	OrientationJitter 180



