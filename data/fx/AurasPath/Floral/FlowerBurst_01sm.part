System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 8

	#NewPerFrame 0.05000

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	EmissionStartJitter 5 0 5

	#MoveScale -1



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 0 # (World)

	FrontOrLocalFacing 1 # (Local)

	#Stickiness 0

	TightenUp 0.5

	#StreakType 0 # (NOSTREAK)

	#StreakScale 1

	#StreakOrient 0 # (No Orient)

	#StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.05

	StartSizeJitter 0.02

	ExpandRate 0.01000

	ExpandType 1 # (Expand to EndSize)

	EndSize 0.350

	OrientationJitter 128



###########################################################
### Motion ################################################
###########################################################

	#InitialVelocity 0 -0.001000 0

	#InitialVelocityJitter 0 0 0

	#VelocityJitter 0 0 0

	#Magnetism 0

	#Gravity 1

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 0

	TextureName FlowerHead_01.tga

	#TexScroll1 0 0 0

	#TexScrollJitter1 0 0 0

	#AnimFrames1 0

	#AnimPace1 0

	#AnimType1 0 # (loop)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 5

	FadeOutStart 15

	FadeOutBy 90

	StartColor 255 255 0

	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	#ByTime1 0

	#BeColor1 0 0 0

	#PrimaryTint1 0

	#SecondaryTint1 0

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	ColorOffset 100 100 100

	ColorOffsetJitter 100 100 100


End
