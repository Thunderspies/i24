System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 60

	#NewPerFrame 0.1

	#BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	#EmissionType 0 # (Point)

	#EmissionRadius 0

	#EmissionHeight 0

	EmissionStartJitter 0 0 0

	#MoveScale 2



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.2 0

	InitialVelocityJitter 0.5 0.5 0.5

	#VelocityJitter 0 0 0

	#Magnetism 0

	Gravity 0.0400

	Drag 0.01

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	#WorldOrLocalPosition 1 # (Local)

	#FrontOrLocalFacing 1 # (Local)

	Stickiness 0.5

	TightenUp 1

	#StreakType 1 # (VELOCITY)

	#StreakScale 1

	#StreakOrient 0 # (No Orient)

	#StreakDirection 1 # (destination)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 0.2

	StartSizeJitter 0.15

	ExpandRate 0.0050000

	ExpandType 0 # (Expand Forever)

	#EndSize 0.01

	OrientationJitter 128



###########################################################
### Texture/Color #########################################
###########################################################

	#Blend_mode 0

	TextureName Roach_4x4.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

	AnimFrames1 16

	AnimPace1 1

	AnimType1 2 # (ping pong)

	#TextureName2

	#TexScroll2 0 0 0

	#TexScrollJitter2 0 0 0

	#AnimFrames2 0

	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 1

	FadeOutStart 20

	FadeOutBy 25

	StartColor 255 0 0

	#ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	#ByTime1 0

	#BeColor1 120 104 66

	#PrimaryTint1 0

	#SecondaryTint1 0

	#ByTime2 0

	#BeColor2 0 0 0

	#PrimaryTint2 0

	#SecondaryTint2 0

	#ByTime3 0

	#BeColor3 0 0 0

	#PrimaryTint3 0

	#SecondaryTint3 0

	#ByTime4 0

	#BeColor4 0 0 0

	#PrimaryTint4 0

	#SecondaryTint4 0

	#ColorOffset 0 0 0

	#ColorOffsetJitter 20 20 20


End
