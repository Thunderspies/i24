	#DeathAgeToZero 0 # (keep age)

	StartSize 1.50

	StartSizeJitter 0.50

	ExpandRate 0.5

	ExpandType 1 # (Expand to EndSize)

	EndSize 15

	OrientationJitter 180



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 2.5 0

	InitialVelocityJitter 0.8 0.5 0.8

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0.004

	Drag 0.04

	Spin 0

	SpinJitter 7



