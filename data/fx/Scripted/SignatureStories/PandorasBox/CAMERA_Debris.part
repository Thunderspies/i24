### Motion ################################################
###########################################################

	InitialVelocity 0 0.0045 4

	InitialVelocityJitter 0.2 0.2 1.05

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0.004

	Drag 0

	Spin 0

	SpinJitter 65



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 0

