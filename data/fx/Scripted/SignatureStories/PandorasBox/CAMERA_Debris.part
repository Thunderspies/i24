	FadeOutStart 50

	FadeOutBy 60

	StartColor 180 130 150

	ColorChangeType 0 # (Stop@LastColor)

	#PrimaryTint 0

	#SecondaryTint 0

	ByTime1 2

	BeColor1 180 150 100

	#PrimaryTint1 0

	#SecondaryTint1 0

