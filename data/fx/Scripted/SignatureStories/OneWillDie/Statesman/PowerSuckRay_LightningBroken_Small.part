	#AnimPace2 0

	#AnimType2 0 # (loop)

	Alpha 255

	FadeInBy 1

	FadeOutStart 4

	FadeOutBy 8

	StartColor 251 255 127

	ColorChangeType 0 # (Stop@LastColor)

	PrimaryTint 0

	SecondaryTint 0

	ByTime1 4

	BeColor1 255 205 99

	PrimaryTint1 0

	SecondaryTint1 0

	ByTime2 8

	BeColor2 214 255 97

