System


###########################################################
### Emitter ###############################################
###########################################################

	Burst 1

	NewPerFrame 0.5

	BurbleAmplitude 0

	#BurbleType 0 # (Sine Wave)

	#BurbleFrequency 1

	#BurbleThreshold 0

	#EmissionLifeSpan 1

	#EmissionLifeSpanJitter 0

	EmissionType 1 # (Line)

	EmissionRadius 0

	EmissionHeight 0

	EmissionStartJitter 0 0 0

	#MoveScale 1



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0 0

	InitialVelocityJitter 0.25 0.500000 0.25

	VelocityJitter 0 0 0

	#Magnetism 0

	#Gravity 1

	#Drag 0

	#Spin 0

	#SpinJitter 0



###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	#Stickiness 0

	#TightenUp 0

	StreakType 1 # (VELOCITY)

	StreakScale 10

	StreakOrient 1 # (Orient)

	StreakDirection 0 # (source)

	#KickStart 1

	#TimeToFull 10

	#SortBias 0

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 0 # (keep age)

	StartSize 3.500000

	StartSizeJitter 1.500000

	ExpandRate 2

	ExpandType 0 # (Expand Forever)

	EndSize 0

	OrientationJitter 128



###########################################################
### Texture/Color #########################################
###########################################################

	Blend_mode 1

	TextureName Electricity_Ring.tga

	TexScroll1 0 0 0

	TexScrollJitter1 0 0 0

