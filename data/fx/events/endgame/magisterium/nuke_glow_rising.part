###########################################################
### Particle ##############################################
###########################################################

	#Flags IgnoreFxTint AlwaysDraw

	WorldOrLocalPosition 1 # (Local)

	FrontOrLocalFacing 0 # (Front)

	Stickiness 0

	TightenUp 1

	StreakType 0 # (NOSTREAK)

	StreakScale 0

	StreakOrient 0 # (No Orient)

	StreakDirection 0 # (source)

	#KickStart 0

	#TimeToFull 10

	SortBias 1.5

	#DieLikeThis BlueFlame01.part

	#DeathAgeToZero 1 # (reset age)

	StartSize 1

	StartSizeJitter 0.05

	ExpandRate 50

	ExpandType 0 # (Expand Forever)

	EndSize 1

	OrientationJitter 180



###########################################################
### Motion ################################################
###########################################################

	InitialVelocity 0 0.1 0

	InitialVelocityJitter 0 0 0

	VelocityJitter 0 0 0

	Magnetism 0

	Gravity 0.015

	Drag 0

	Spin 0

	SpinJitter 0



###########################################################
### Texture/Color #########################################
