#################################
## Splat - Foot Stomp
#################################

Behavior

#################################

PyrRotate		0 15 0
PyrRotateJitter		0 5 0
StartJitter		0 0 0

FadeInLength		60
FadeOutLength		90

Scale			5.0 5.0 5.0		### Y= Height of Cylinder from center
ScaleRate		1.01 1.01 1.01
EndScale		6.0 6.0 6.0

#SplatFlags		ADDITIVE ROUNDTEXTURE
SplatSetBack		0.5     #0 -> 1.0 splatSetBack = what percent of the splat should be behind the node, and what in front

SplatFalloffType	BOTH			# UP DOWN NONE BOTH
SplatFadeCenter		0.5			# only for UP and DOWN falloff

Alpha			255

StartColor		255 255 0

#################################

End