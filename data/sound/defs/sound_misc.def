
// Metadata for sounds.  So far we only define "instance groups" here.
//  Each instance group has the following:
//      * a name (only really used for debug console output)
//      * maxInstances (0-255)
//      * list of sounds belonging to the group.  Comma separated and all on
//          a single line (ok to have alot, just set your text editor to wrap so you
//          can see them all).

Group hasten
{
	maxInstances 1
	Sounds hasten, hasten2
}

