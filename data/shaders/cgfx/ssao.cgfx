#if !USE_TEX_RECT
#define samplerNPOT sampler2D
#else
#define samplerNPOT samplerRECT
#endif

float4 texNPOT(samplerNPOT s, float2 npotScale, float2 uv)
{
#if !USE_TEX_RECT
	return tex2D(s, uv);
#else
	return texRECT(s, uv * npotScale);
#endif
}

inline float luminance(float3 rgb)
{
	return dot(rgb, float3(0.299, 0.587, 0.114));
}

struct vattr {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

struct fattr {
	float4 pos : POSITION;
	float4 wpos : WPOS;
	float2 uv : TEXCOORD0;
};

float4x4 ModelViewProj : WorldViewProjection;

float4 screenstep;

samplerNPOT colorTex;
float2 colorTexNPOT;
samplerNPOT color2Tex;
float2 color2TexNPOT;
samplerNPOT depthTex;
float2 depthTexNPOT;
float4 newFeature;

fattr quad_vmain(vattr vin)
{
	fattr fout;
	fout.pos = mul(vin.pos, ModelViewProj);
	fout.uv = vin.uv;
	return fout;
}

float4 color2d_fmain(fattr fin) : COLOR
{
	return texNPOT(colorTex, colorTexNPOT, fin.uv);
}

float depth2d_fmain(fattr fin) : DEPTH
{
	return texNPOT(depthTex, depthTexNPOT, fin.uv).r;
}

struct pattr {
	float4 color : COLOR;
	float depth : DEPTH;
};

pattr colorDepth2d_fmain(fattr fin)
{
	pattr pout;
	pout.color = texNPOT(colorTex, colorTexNPOT, fin.uv);
	pout.depth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	return pout;
}

float4 sampleDepthSquare(samplerNPOT tex, float2 npotScale, float2 uv)
{
	float4 samples;
	samples.z = texNPOT(tex, npotScale, uv + float2(+0.5, -0.5) * screenstep.xy + screenstep.zw).r;
	samples.w = texNPOT(tex, npotScale, uv + float2(+0.5, +0.5) * screenstep.xy + screenstep.zw).r;
	samples.x = texNPOT(tex, npotScale, uv + float2(-0.5, -0.5) * screenstep.xy + screenstep.zw).r;
	samples.y = texNPOT(tex, npotScale, uv + float2(-0.5, +0.5) * screenstep.xy + screenstep.zw).r;
	return samples;
}

pattr colorDepthAverage2d_fmain(fattr fin)
{
	pattr pout;
	pout.color = texNPOT(colorTex, colorTexNPOT, fin.uv);

	float4 samples = sampleDepthSquare(depthTex, depthTexNPOT, fin.uv);

	float4 sorted;
	sorted.xy = min(samples.xy, samples.zw);
	sorted.zw = max(samples.xy, samples.zw);

	float4 final;
	final.xz = min(sorted.xz, sorted.yw);
	final.yw = max(sorted.xz, sorted.yw);

	pout.depth = (final.y + final.z) / 2.0f;
	return pout;
}

pattr colorDepthMin2d_fmain(fattr fin)
{
	pattr pout;
	pout.color = texNPOT(colorTex, colorTexNPOT, fin.uv);
	float4 samples = sampleDepthSquare(depthTex, depthTexNPOT, fin.uv);
	pout.depth = min(min(samples.x, samples.y), min(samples.z, samples.w));
	return pout;
}

pattr colorDepthMax2d_fmain(fattr fin)
{
	pattr pout;
	pout.color = texNPOT(colorTex, colorTexNPOT, fin.uv);
	float4 samples = sampleDepthSquare(depthTex, depthTexNPOT, fin.uv);
	pout.depth = max(max(samples.x, samples.y), max(samples.z, samples.w));
	return pout;
}

float4x4 depthInvMatrix;
float4 fogColor;
float4 fogParam;
#define fogStart fogParam.x
#define fogEnd fogParam.y
#define fogOneOverEndMinusStart fogParam.z
#define fogRadial fogParam.w

float4 computeFog(float fog, float4 color)
{
	return lerp(fogColor, color, saturate((fogEnd - fog) * fogOneOverEndMinusStart));
}

float4 computeFogFromDepth(float2 screenPos, float depth, float4 color)
{
	float4 pos = float4(screenPos * 2.0f - 1.0f, depth, 1.0f);
	pos = mul(depthInvMatrix, pos);
	pos.xyz /= pos.w;
	float fog = length(pos.xyz * float3(fogRadial, fogRadial, 1.0f));
	return computeFog(fog * 0.5f, color);
}

float4 colorFog2d_fmain(fattr fin) : COLOR
{
	float depth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	float4 color = texNPOT(colorTex, colorTexNPOT, fin.uv);
	return computeFogFromDepth(fin.uv, depth, color);
}

float4 colorBlendFog2d_fmain(fattr fin) : COLOR
{
	float depth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	float4 color = texNPOT(colorTex, colorTexNPOT, fin.uv);
	float4 color2 = texNPOT(color2Tex, color2TexNPOT, fin.uv);
	return computeFogFromDepth(fin.uv, depth, color * color2);
}

// blurs

#ifndef M_E
	#define M_E 2.7182818284590452354
#endif
#ifndef M_PI
	#define M_PI 3.14159265358979323846
#endif

const float4 sigma;
const float depthLimit;

float4 blurFast2d_fmain(fattr fin) : COLOR
{
	float4 samples = 0;
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(+1, -1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(+1, +1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(-1, -1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(-1, +1) * screenstep.xy + screenstep.zw);
	return samples * (1.0f/4.0f);
}

float4 gaussian2d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float k = 1.0f/(2*M_PI*sigma.x*sigma.x);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		for (int j=0; j<(sampleRadius*2+1); j++) {
			const float y = sampleRadius-j;
			float w = k * pow(M_E, -(x*x+y*y)/(2*sigma.x*sigma.x));
			float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv + float2(x, y) * screenstep.xy + screenstep.zw);
			samples += sample * w;
			sampleScale += w;
		}
	}
	return samples / sampleScale;
}

float4 gaussian1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float k = 1.0f/(sqrt(2*M_PI)*sigma.x);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float w = k * pow(M_E, -(x*x)/(2*sigma.x*sigma.x));
		float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv + float2(x, x) * screenstep.xy + screenstep.zw);
		samples += sample * w;
		sampleScale += w;
	}
	return samples / sampleScale;
}

float4 gaussianDepth1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	const float k = 1.0f/(sqrt(2*M_PI)*sigma.x);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float2 uv = fin.uv + float2(x, x) * screenstep.xy + screenstep.zw;
		float4 sample = texNPOT(colorTex, colorTexNPOT, uv);
		float depth = texNPOT(depthTex, depthTexNPOT, uv).r;
		float passed = abs(centerDepth - depth) <= sigma.z;
		float w = passed * k * pow(M_E, -(x*x)/(2*sigma.x*sigma.x));
		samples += sample * w;
		sampleScale += w;
	}
	return samples / sampleScale;
}

float4 bilateral2d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float ka = 1.0f/(2*M_PI*sigma.x*sigma.x);
	const float kb = 1.0f/(sqrt(2*M_PI)*sigma.y);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		for (int j=0; j<(sampleRadius*2+1); j++) {
			const float y = sampleRadius-j;
			float wa = ka * pow(M_E, -(x*x+y*y)/(2*sigma.x*sigma.x));
			float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv + float2(x, y) * screenstep.xy + screenstep.zw);
			float src = luminance(sample.rgb);
			float wb = kb * pow(M_E, -(src*src)/(2*sigma.y*sigma.y));
			samples += sample * wa * wb;
			sampleScale += wa * wb;
		}
	}
	return samples / sampleScale;
}

float4 bilateral1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float2 k = 1.0f/(sqrt(2*M_PI)*sigma.xy);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv + float2(x, x) * screenstep.xy + screenstep.zw);
		float2 src = float2(x, luminance(sample.rgb));
		float2 w = -(src*src)/(2*sigma.xy*sigma.xy);
		w.x = pow(M_E, w.x);
		w.y = pow(M_E, w.y);
		w *= k;
		float scale = w.x * w.y;
		samples += sample * scale;
		sampleScale += scale;
	}
	return samples / sampleScale;
}

float4 bilateralDepth1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	const float2 k = 1.0f/(sqrt(2*M_PI)*sigma.xz);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float2 uv = fin.uv + float2(x, x) * screenstep.xy + screenstep.zw;
		float4 sample = texNPOT(colorTex, colorTexNPOT, uv);
		float depth = texNPOT(depthTex, depthTexNPOT, uv).r;
		float2 src = float2(x, abs(centerDepth - depth));
		float2 w = -(src*src)/(2*sigma.xz*sigma.xz);
		w.x = pow(M_E, w.x);
		w.y = pow(M_E, w.y);
		w *= k;
		float scale = w.x * w.y;
		samples += sample * scale;
		sampleScale += scale;
	}
	return samples / sampleScale;
}

float4 trilateral1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	const float3 k = 1.0f/(sqrt(2*M_PI)*sigma.xyz);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float2 uv = fin.uv + float2(x, x) * screenstep.xy + screenstep.zw;
		float4 sample = texNPOT(colorTex, colorTexNPOT, uv);
		float depth = texNPOT(depthTex, depthTexNPOT, uv).r;
		float3 src = float3(x, luminance(sample.rgb), abs(centerDepth - depth));
		float3 w = -(src*src)/(2*sigma.xyz*sigma.xyz);
		w.x = pow(M_E, w.x);
		w.y = pow(M_E, w.y);
		w.z = pow(M_E, w.z);
		w *= k;
		float scale = w.x * w.y * w.z;
		samples += sample * scale;
		sampleScale += scale;
	}
	return samples / sampleScale;
}

// ssao

struct ssao_vattr {
	float4 pos : POSITION;
	float4 uv : TEXCOORD0;
};

struct ssao_fattr {
	float4 pos : POSITION;
	float4 uv : TEXCOORD0;
};

float2 ssaoSize;

samplerNPOT reducedColorTex;
float2 reducedColorTexNPOT;
samplerNPOT reducedDepthTex;
float2 reducedDepthTexNPOT;

sampler2D randomVectors;
const float randomVectorSize;

const float3 sampleVectors[64];
const float sampleCount;
const float2 nearFar;
const float2 pixelDepthSpread;
const float2 nearFarLimit;
const float4 preWeight;
const float4 postWeight;

ssao_fattr ssao_vmain(ssao_vattr vin)
{
	ssao_fattr fout;
	fout.pos = mul(vin.pos, ModelViewProj);
	fout.uv.xy = vin.uv.xy;
	fout.uv.zw = vin.uv.xy * ssaoSize / randomVectorSize;
	return fout;
}

float4 ssao_fmain(ssao_fattr fin, uniform int numSamples, uniform float sampleWeight) : COLOR
{
	float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv.xy).r;
	float3 randVec = tex2D(randomVectors, fin.uv.zw).rgb * 2.0 - 1.0;

	float centerDepthWS = centerDepth * nearFar.y;
	float depthScale = saturate(centerDepthWS / nearFarLimit.x) * (1.0 + centerDepthWS / nearFarLimit.y);
	float3 spread;
	spread.xy = pixelDepthSpread.xx * depthScale * 1.0 / (centerDepth * nearFar.y);
	spread.z = pixelDepthSpread.y * depthScale * 2.0 / nearFar.y;

	float4 accum = 0;
	for (int i=0; i<numSamples; i++) {
		float3 vec = reflect(sampleVectors[i], randVec) * spread;
		float depth = texNPOT(reducedDepthTex, reducedDepthTexNPOT, fin.uv.xy + vec.xy).r + vec.z;
		float dist = centerDepth - depth;
		float d = dist*nearFar.y*preWeight.x;
		float dd = d*d*d + preWeight.w/(d*d*d);
		float v = ((dd == 0.0f) ? 0.0f : 1/dd) + preWeight.y;
		accum += 1.0f - saturate(v * preWeight.z);
	}
	accum *= (1/(float)numSamples) * sampleWeight;
	return pow(accum * postWeight.x, postWeight.y);
}

float4 ssaoUltra_fmain(ssao_fattr fin, uniform int numSamples, uniform float sampleWeight) : COLOR
{
	float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv.xy).r;
	float3 randVec = tex2D(randomVectors, fin.uv.zw).rgb * 2.0 - 1.0;

	float centerDepthWS = centerDepth * nearFar.y;
	float depthScale = saturate(centerDepthWS / nearFarLimit.x) * (1.0 + centerDepthWS / nearFarLimit.y);
	float3 spread;
	spread.xy = pixelDepthSpread.xx * depthScale * 1.0 / (centerDepth * nearFar.y);
	spread.z = pixelDepthSpread.y * depthScale * 2.0 / nearFar.y;

	float4 accum = 0;
	for (int i=0; i<numSamples; i++) {
		float3 vec = reflect(sampleVectors[i], randVec) * spread;
		float depth = texNPOT(reducedDepthTex, reducedDepthTexNPOT, fin.uv.xy + vec.xy).r + vec.z;
		float4 color = texNPOT(reducedColorTex, reducedColorTexNPOT, fin.uv.xy + vec.xy);
		float dist = centerDepth - depth;
		float d = dist*nearFar.y*preWeight.x;
		float dd = d*d*d + preWeight.w/(d*d*d);
		float v = ((dd == 0.0f) ? 0.0f : 1/dd) + preWeight.y;
		accum += lerp(color * postWeight.w, 1.0f, 1.0f - saturate(v * preWeight.z));
	}
	accum *= (1/(float)numSamples) * sampleWeight;
	return pow(accum * postWeight.x, postWeight.y + 1.0f);
}

float4 ssaoTunable_fmain(ssao_fattr fin) : COLOR
{
	float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv.xy).r;

#if 0
	float3 p1 = float3(fin.uv.xy, centerDepth * nearFar.y);
	float3 p2, p3;
	p2.xy = fin.uv.xy + float2(1.0/1920.0,1.0/1141.0);
	p2.z = texNPOT(depthTex, depthTexNPOT, p2.xy).r * nearFar.y;
	p3.xy = fin.uv.xy + float2(-1.0/1920.0,1.0/1141.0);
	p3.z = texNPOT(depthTex, depthTexNPOT, p3.xy).r * nearFar.y;
	float3 normal = normalize(cross((p3-p1), (p2-p1)));
	//return float4((normal + 1.0) * 0.5, 1);
#else
	float3 normal = float3(0.0, 0.0, -1.0);
#endif

	float3 randVec = tex2D(randomVectors, fin.uv.zw).rgb * 2.0 - 1.0;

	float centerDepthWS = centerDepth * nearFar.y;
	float depthScale = saturate(centerDepthWS / nearFarLimit.x) * (1.0 + centerDepthWS / nearFarLimit.y);
	float3 spread;
	spread.xy = pixelDepthSpread.xx * depthScale * 1.0 / (centerDepth * nearFar.y);
	spread.z = pixelDepthSpread.y * depthScale * 2.0 / nearFar.y;

	float4 accum = 0;
	for (int i=0; i<64; i++) {
		if (i > sampleCount) {
			continue;
		}

		float3 vec = reflect(sampleVectors[i], randVec) * spread;
#if 0
		vec = sign(dot(vec,normal))*vec;
#endif

		float depth = texNPOT(reducedDepthTex, reducedDepthTexNPOT, fin.uv.xy + vec.xy).r + vec.z;
		float4 color = texNPOT(reducedColorTex, reducedColorTexNPOT, fin.uv.xy + vec.xy);

#if 0
		color.xyzw = luminance(color.rgb);
#endif

#if 1
		float dist = centerDepth - depth;
		float d = dist*nearFar.y*preWeight.x;
		float dd = d*d*d + preWeight.w/(d*d*d);
		float v = ((dd == 0.0f) ? 0.0f : 1/dd) + preWeight.y;
		accum += lerp(color * postWeight.w, 1.0f, 1.0f - saturate(v * preWeight.z));
#elif 1
		float dist = centerDepth - depth;
		float d = dist*nearFar.y*preWeight.x;
		float dd = d*d*d;
		float v = ((dd == 0.0f) ? 0.0f : 1/dd) + preWeight.y;
		accum += lerp(color * postWeight.w, 1.0f, 1.0f - saturate(v * preWeight.z));
#else
		float dist = max(centerDepth - depth, 0);
		float d = dist*nearFar.y*preWeight.x;
		float v = 1/(1+d*d) + preWeight.y;
		accum += lerp(color * postWeight.w, 1.0f, saturate(v * preWeight.z));
#endif
	}
	return pow(accum * (1/(float)sampleCount) * postWeight.x, postWeight.y);
}

technique color2d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 color2d_fmain();
	}
}

technique depth2d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 depth2d_fmain();
	}
}

technique colorDepth2d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 colorDepth2d_fmain();
	}
}

