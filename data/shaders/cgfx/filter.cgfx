
#if !USE_TEX_RECT
#define samplerNPOT sampler2D
#else
#define samplerNPOT samplerRECT
#endif

float4 texNPOT(samplerNPOT s, float2 npotScale, float2 uv)
{
#if !USE_TEX_RECT
	return tex2D(s, uv);
#else
	return texRECT(s, uv * npotScale);
#endif
}


inline float luminance(float3 rgb)
{
	return dot(rgb, float3(0.299, 0.587, 0.114));
}

struct vattr {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};
 
struct fattr {
	float4 pos : POSITION;
	float4 wpos : WPOS;
	float2 uv : TEXCOORD0;
};

float4x4 ModelViewProj : WorldViewProjection;


fattr quad_vmain(vattr vin)
{
	fattr fout;
	fout.pos = mul(vin.pos, ModelViewProj);
	fout.uv = vin.uv;
	return fout;
}

// blurs

#ifndef M_E
	#define M_E 2.7182818284590452354
#endif
#ifndef M_PI
	#define M_PI 3.14159265358979323846
#endif

const float4 sigma;
float4 screenstep;

samplerNPOT colorTex;
float2 colorTexNPOT;
samplerNPOT color2Tex;
float2 color2TexNPOT;
samplerNPOT depthTex;
float2 depthTexNPOT;

float4 blurFast2d_fmain(fattr fin) : COLOR
{
	float4 samples = 0;
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(+1, -1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(+1, +1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(-1, -1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(-1, +1) * screenstep.xy + screenstep.zw);
	return samples * (1.0f/4.0f);
}

float4 blurAlphaFast2d_fmain(fattr fin) : COLOR
{
	float4 samples = 0;
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(+1, -1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(+1, +1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(-1, -1) * screenstep.xy + screenstep.zw);
	samples += texNPOT(colorTex, colorTexNPOT, fin.uv + float2(-1, +1) * screenstep.xy + screenstep.zw);
	float4 filtered = samples * (1.0f/4.0f);
	float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv);
	sample.a = filtered.a;
	return sample;
}

float4 blurFast2d_fmain_dbg(fattr fin) : COLOR
{
	float4 samples = 0;
  samples.g = 1.0f;
	return samples;
}


float4 gaussian2d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float k = 1.0f/(2*M_PI*sigma.x*sigma.x);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		for (int j=0; j<(sampleRadius*2+1); j++) {
			const float y = sampleRadius-j;
			float w = k * pow(M_E, -(x*x+y*y)/(2*sigma.x*sigma.x));
			float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv + float2(x, y) * screenstep.xy + screenstep.zw);
			samples += sample * w;
			sampleScale += w;
		}
	}
	return samples / sampleScale;
}

float4 gaussian1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float k = 1.0f/(sqrt(2*M_PI)*sigma.x);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float w = k * pow(M_E, -(x*x)/(2*sigma.x*sigma.x));
		float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv + float2(x, x) * screenstep.xy + screenstep.zw);
		samples += sample * w;
		sampleScale += w;
	}
	return samples / sampleScale;
}

float4 gaussianDepth1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	const float k = 1.0f/(sqrt(2*M_PI)*sigma.x);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float2 uv = fin.uv + float2(x, x) * screenstep.xy + screenstep.zw;
		float4 sample = texNPOT(colorTex, colorTexNPOT, uv);
		float depth = texNPOT(depthTex, depthTexNPOT, uv).r;
		float passed = abs(centerDepth - depth) <= sigma.z;
		float w = passed * k * pow(M_E, -(x*x)/(2*sigma.x*sigma.x));
		samples += sample * w;
		sampleScale += w;
	}
	return samples / sampleScale;
}

float4 bilateral2d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float ka = 1.0f/(2*M_PI*sigma.x*sigma.x);
	const float kb = 1.0f/(sqrt(2*M_PI)*sigma.y);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		for (int j=0; j<(sampleRadius*2+1); j++) {
			const float y = sampleRadius-j;
			float wa = ka * pow(M_E, -(x*x+y*y)/(2*sigma.x*sigma.x));
			float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv + float2(x, y) * screenstep.xy + screenstep.zw);
			float src = luminance(sample.rgb);
			float wb = kb * pow(M_E, -(src*src)/(2*sigma.y*sigma.y));
			samples += sample * wa * wb;
			sampleScale += wa * wb;
		}
	}
	return samples / sampleScale;
}

float4 bilateral1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float2 k = 1.0f/(sqrt(2*M_PI)*sigma.xy);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float4 sample = texNPOT(colorTex, colorTexNPOT, fin.uv + float2(x, x) * screenstep.xy + screenstep.zw);
		float2 src = float2(x, luminance(sample.rgb));
		float2 w = -(src*src)/(2*sigma.xy*sigma.xy);
		w.x = pow(M_E, w.x);
		w.y = pow(M_E, w.y);
		w *= k;
		float scale = w.x * w.y;
		samples += sample * scale;
		sampleScale += scale;
	}
	return samples / sampleScale;
}

float4 bilateralDepth1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	const float2 k = 1.0f/(sqrt(2*M_PI)*sigma.xz);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float2 uv = fin.uv + float2(x, x) * screenstep.xy + screenstep.zw;
		float4 sample = texNPOT(colorTex, colorTexNPOT, uv);
		float depth = texNPOT(depthTex, depthTexNPOT, uv).r;
		float2 src = float2(x, abs(centerDepth - depth));
		float2 w = -(src*src)/(2*sigma.xz*sigma.xz);
		w.x = pow(M_E, w.x);
		w.y = pow(M_E, w.y);
		w *= k;
		float scale = w.x * w.y;
		samples += sample * scale;
		sampleScale += scale;
	}
	return samples / sampleScale;
}

float4 trilateral1d_fmain(fattr fin, uniform int sampleRadius) : COLOR
{
	const float centerDepth = texNPOT(depthTex, depthTexNPOT, fin.uv).r;
	const float3 k = 1.0f/(sqrt(2*M_PI)*sigma.xyz);

	float4 samples = 0;
	float sampleScale = 0;
	for (int i=0; i<(sampleRadius*2+1); i++) {
		const float x = sampleRadius-i;
		float2 uv = fin.uv + float2(x, x) * screenstep.xy + screenstep.zw;
		float4 sample = texNPOT(colorTex, colorTexNPOT, uv);
		float depth = texNPOT(depthTex, depthTexNPOT, uv).r;
		float3 src = float3(x, luminance(sample.rgb), abs(centerDepth - depth));
		float3 w = -(src*src)/(2*sigma.xyz*sigma.xyz);
		w.x = pow(M_E, w.x);
		w.y = pow(M_E, w.y);
		w.z = pow(M_E, w.z);
		w *= k;
		float scale = w.x * w.y * w.z;
		samples += sample * scale;
		sampleScale += scale;
	}
	return samples / sampleScale;
}



technique blurFast2d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 blurFast2d_fmain();
	}
}

technique blurAlphaFast2d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 blurAlphaFast2d_fmain();
	}
}

#define highBlurRadius 4

technique gaussian2d {
	pass Pass0 {
		VertexProgram   = compile gp4vp quad_vmain();
		FragmentProgram = compile gp4fp gaussian2d_fmain(highBlurRadius);
	}
}

technique gaussian1d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 gaussian1d_fmain(highBlurRadius);
	}
}

technique gaussianDepth1d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 gaussianDepth1d_fmain(highBlurRadius);
	}
}

technique bilateral2d {
	pass Pass0 {
		VertexProgram   = compile gp4vp quad_vmain();
		FragmentProgram = compile gp4fp bilateral2d_fmain(highBlurRadius);
	}
}

technique bilateral1d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 bilateral1d_fmain(highBlurRadius);
	}
}

technique bilateralDepth1d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 bilateralDepth1d_fmain(highBlurRadius);
	}
}

technique trilateral1d {
	pass Pass0 {
		VertexProgram   = compile arbvp1 quad_vmain();
		FragmentProgram = compile arbfp1 trilateral1d_fmain(highBlurRadius);
	}
}


