// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Terrence_Dobbs 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Terrence Dobbs 
// -------------------------------------------------------------------------------- 
// Name :
"P2859785034" "Terrence Dobbs"
// ProfessionString :
"P2130766835" "Professional Exterminator"
// DescriptionString :
"P3001115738" "Terrence Dobbs is a professional exterminator specializing in Arachnoids. He's always looking for new recruits to help him keep the Arachnoid population down in Grandville."
// HelloString :
"P618816102" "Hey, how ya doin'?"
// HelloString :
"P2034446474" "Yo, {VillainName}! Got some work for ya."
// HelloString :
"P1342682282" "Hey {VillainName}! Good to see ya!"
// IDontKnowYouString :
"P2277008112" "Do I know you? I don't think so, pal!"
// FirstVisitString :
"P2743437520" "They call me Dobbs, 'cause that's my name. I'm a professional exterminator. Yah, I know it don't sound too glamorous, but I provide a vital service here in Grandville. I guess you can call me a 'big game hunter' amongst exterminators, 'cause I hunt one of the nastiest pests around: Arachnoids.<br><br>You heard of 'em? You might have seen 'em around Grandville, crawling around, occasionally nabbin' some unsuspectin' citizen. There's a whole mess of 'em here in the Gutter, which is why I made this place my regular stompin' grounds. These 'Rachnoids been called men, mutants, monsters - whatever. I calls 'em as I sees 'em, and I call 'em pests!<br><br>I'm lookin' for a few hearty souls to help me put those critters in their place, so if you're looking for a good ol' fashioned bug hunt, stick around!"
// NoTasksRemainingString :
"P1392029319" "I got nothin' else for ya, {VillainName}! See ya around!"
// PlayerBusyString :
"P83125574" "Come back to me when you finish up some of your other work, {VillainName}!"
// ComeBackLaterString :
"P1916697452" "Hrm? Yah, I can use some help squishin' bugs. But you ain't tough enough! Come back when you're at least Threat Level {Level}!"
// RelationshipChangeString_ToFriend :
"P1513923443" "Youse is a great spider-stomper, buddy! Why don't you check these <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</a>"
// RelationshipChangeString_ToConfidant :
"P2533568550" "Keep this up and you're gonna put me out of business, {VillainName}!  Check out these <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</a>."
// FailsafeLevelString :
"P1100389424" "Thanks for all your help, {VillainName}, but you should check out some of the other fellas around Grandville."
// LocationString :
// IntroString :
"P3336902704" "There's a professional exterminator called Terrence Dobbs who deals with the Arachnoid problem in Grandville. He's looking for some help with his work."
// IntroAcceptString :
"P2789105709" "Choose Terrence Dobbs"
// IntroSendoffString :
"P790328903" "Dobbs is a bit rough around the edges, but he's good at his job."
// IntroduceOneContact :
"P1180541150" "I've got <A HREF=CONTACTLINK_INTRODUCE>someone</a> you should meet."
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


