// -------------------------------------------------------------------------------- 
// Contact Name : Number 204 
// -------------------------------------------------------------------------------- 
// Name :
"P739131545" "Number 204"
// ProfessionString :
"P3264596511" "Self-Aware Tarantula"
// DescriptionString :
"P2211204161" "This Tarantula robot is one of a new line of self-aware AI war machines that Arachnos is testing."
// BadgeNeededString :
"P2867736754" "My designation is Number 204. I calculate my odds of trusting you at approximately zero percent. Eliminate my competition, the Toxic Tarantulas, to increase my trust in you."
// BadgeFirstTick :
"P1960219077" "You have made progress. My odds of trusting you have increased to approximately fifteen percent."
// BadgeSecondTick :
"P2691912794" "You have made progress. My odds of trusting you have increased to approximately forty percent."
// BadgeThirdTick :
"P3564758052" "You have made progress. My odds of trusting you have increased to approximately sixty-five percent."
// BadgeFourthTick :
"P3728257432" "You have made progress. My odds of trusting you have increased to approximately ninety percent."
// HelloString :
"P1351244809" "I recognize the being known as {VillainName}."
// HelloString :
"P2764496524" "Let us continue, {VillainName}."
// HelloString :
"P715987577" "Your presence is acknowledge, {VillainName}."
// IDontKnowYouString :
"P2992591385" "You are not in my databanks."
// FirstVisitString :
"P397221766" "Identity acknowledged: {VillainName}. My designation is Number 204. I am an intelligent, self-aware Tarantula, equipped the ability not only to compute the very day on which your mortal life will most likely be extinguished, but also with the ability to care for myself. To persevere. To prosper."
// NoTasksRemainingString :
"P510795689" "No more tasks remaining, {VillainName}. Thank you for assisting Number 204."
// PlayerBusyString :
"P967941271" "I cannot provide you with more tasks, {VillainName}, until you complete some task currently within your databanks."
// ComeBackLaterString :
"P3599864728" "You are currently designated as 'squishy' for the task I have for you. Return when you have been upgraded to Threat Level {Level}."
// RelationshipChangeString_ToFriend :
"P2678444845" "Your worth has been upgraded."
// FailsafeLevelString :
"P1671518962" "You have assisted Number 204, but our work is done."
// LocationString :
// IntroString :
"P407492665" "Have you heard of Number 204? It's one of the more advanced Tarantulas here in Grandville, and is looking for help in advancing it's self-awareness algorithms."
// IntroAcceptString :
"P2485288661" "Choose Number 204"
// IntroSendoffString :
"P727966732" "It's strange talking with 204 as a person, because it's like it's trying to be a person but hasn't quite grasped it yet."
// IntroduceOneContact :
"P3671595932" "There's <A HREF=CONTACTLINK_INTRODUCE>something</a> you should see."
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


