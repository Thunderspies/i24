// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Regent Korol 
// -------------------------------------------------------------------------------- 
// Name :
"P3359754443" "Regent Korol"
// ProfessionString :
"P1626389299" "Tarantula Queen"
// DescriptionString :
"P1990138101" "Regent Korol is one of the few Fortunatas chosen to devote themselves fully to Arachnos by becoming one of the powerful Tarantula Queens. Through the process she has gained immense psychic abilities that she uses to protect Arachnos from infiltration."
// HelloString :
"P929249" "Hello, {VillainName}."
// HelloString :
"P1682332575" "Come closer, {VillainName}."
// HelloString :
"P3478905949" "Welcome to my web, {VillainName}."
// IDontKnowYouString :
"P2739109253" "You have wandered into the wrong part of the web, little fly. Run now before you become trapped!"
// FirstVisitString :
"P1255246478" "Ah, aren't you a tasty morsel? I am Regent Korol, Queen of the Tarantulas in Arachnos, and you have come to serve me. Do not worry, my pet, service is always rewarded."
// NoTasksRemainingString :
"P2540774830" "It is time for you to leave this little web I have woven, my pet."
// PlayerBusyString :
"P995377880" "You are too busy right now, {VillainName}. I require your undivided attention, my pet!"
// ComeBackLaterString :
"P4212035560" "Soon, my pet, soon.  Come back when you are Threat Level {Level}."
// RelationshipChangeString_ToFriend :
"P2159844895" "You amuse me, {VillainName}. Treat yourself to my <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</a>"
// RelationshipChangeString_ToConfidant :
"P63278707" "Aren't you a precocious one, {VillainName}! Try some of these <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</a>."
// FailsafeLevelString :
"P420875475" "I must bid you farewell, my pet. This is one spider web you didn't get trapped in!"
// LocationString :
// IntroString :
"P1907461231" "There is this woman - if you can call her that - known as Regent Korol. She is a Tarantula Queen, one of the transformed Fortunatas. She has need of some people to do her bidding."
// IntroAcceptString :
"P549238248" "Choose Regent Korol"
// IntroSendoffString :
"P2031996334" "Regent Korol doesn't think the way most people do. That's not surprising, considering what she has become."
// IntroduceOneContact :
"P2329881107" "I'd like you to meet <A HREF=CONTACTLINK_INTRODUCE>someone.</a>"
// IntroduceTwoContacts :
"P2818147590" "I know some <A HREF=CONTACTLINK_INTRODUCE>people</a> who would like to meet you."
// -------------------------------------------------------------------------------- 


