// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Arbiter_Daos 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Arbiter Daos 
// -------------------------------------------------------------------------------- 
// Name :
"P1396339461" "Arbiter Daos"
// ProfessionString :
"P1376822437" "Arachnos Arbiter"
// DescriptionString :
"P3221086873" "Arbiter Daos is perhaps the most humorless man to ever walk the Rogue Isles. A devout servant of Arachnos, Daos is not loathe to take advantage of the impunity his position provides him. He often investigates groups and activities that, strictly speaking, lie outside his purview, but he does so in the knowledge that, whatever his reasons, Arachnos will stand beside him."
// HelloString :
"P2397876575" "<A HREF=CONTACTLINK_MISSIONS>We have work to do.</a>"
// HelloString :
"P3369475242" "<A HREF=CONTACTLINK_MISSIONS>There is much to be done.</a>"
// HelloString :
"P4013932343" "<A HREF=CONTACTLINK_MISSIONS>Do as I ask, and you will be rewarded.</a>"
// IDontKnowYouString :
"P1797409090" "You have no authorization to approach me. Speak to Terrence Dobbs if you wish to advance within Arachnos."
// FirstVisitString :
"P952378082" "{VillainName}, is it? Ah, yes. A most colorful career. You, like me, seem to know the value of bending the rules to suit your own purpose. But you must understand one thing: while you are working with me, my word must be law. If you can live within such restrictions, you will reap the great benefits of being above all other Arachnos authority."
// NoTasksRemainingString :
"P3297378763" "We have nothing more to discuss, {VillainName}. There are other roads for you to pursue."
// PlayerBusyString :
"P2005450593" "You're far too busy to be handling official Arachnos business."
// ComeBackLaterString :
"P116054559" "I have a task for you, but I can't trust it to anyone below Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P1399698017" "We work well together, {VillainName}. But if you are interested in taking on my next task, you will need better <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</a>"
// RelationshipChangeString_ToConfidant :
"P2925716899" "You are doing wonderfully, {VillainName}. Perhaps a few new <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</a> could speed your efforts. Take my private communication codes; I want us to remain in contact."
// FailsafeLevelString :
"P3851035839" "There's nothing more you can do for me, {VillainName}. Farewell."
// LocationString :
// IntroString :
"P3103731942" "Have you heard of Arbiter Daos? He's one of the highest ranking Arbiters of the Rogue Isles. He's cold, humorless, and efficient, and likely one of the most feared men in Grandville."
// IntroAcceptString :
"P1559962084" "Choose Arbiter Daos"
// IntroSendoffString :
"P604491239" "Whatever you do, don't get on Arbiter Daos' bad side. His word is law in Grandville, and he has the backing of Lord Recluse to enforce it."
// IntroduceOneContact :
"P3934139479" "I know of <A HREF=CONTACTLINK_INTRODUCE>someone</a> you should meet."
// IntroduceTwoContacts :
"P2992244229" "There are some <A HREF=CONTACTLINK_INTRODUCE>people</a> who would like to meet you."
// -------------------------------------------------------------------------------- 


