// Script Variable ATTACK_DIALOG_MINION1 :
"P2058780786" "{HeroName}? Here?!"
// Script Variable INACTIVE_DIALOG_MINION2 :
"P236349737" "Not now...! Call in LeoKnight, anyone! We need some back up!"

// -------------------------------------------------------------------------------- 
// Objective - PPDGroup1 
// -------------------------------------------------------------------------------- 
// Description :
"P1904712984" "Groups of PPD to defeat in the precinct!"
// SingularDescription :
"P244970727" "One group of PPD remain in the precinct!"

// -------------------------------------------------------------------------------- 
// Reward - Objective 
