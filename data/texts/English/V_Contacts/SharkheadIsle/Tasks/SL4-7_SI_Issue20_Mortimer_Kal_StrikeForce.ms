// Reward - Objective 
// -------------------------------------------------------------------------------- 
// Script Variable BOSS_1_DISPLAYNAME :
"P1397220390" "Assault Bot"
// Script Variable BOSS_1_INACTIVE_DIALOG :
"P2099250952" "<shout>PERSONNEL UNRECOGNIZED.<em t=6>ATTACK!"
// Script Variable BOSS_2_DISPLAYNAME :
"P1917120498" "Protector Bot"
// Script Variable BOSS_2_INACTIVE_DIALOG :
"P1164604357" "<em t=3><shout>STOP {Hero.gender=male HIM|HER}"
// Script Variable BOSS_3_DISPLAYNAME :
"P873596153" "Battle Drone"
// Script Variable BOSS_3_INACTIVE_DIALOG :
"P3117564445" "<em t=5><shout>ATTACK!"
// Script Variable BOSS_7_INACTIVE_DIALOG :
"P472395884" "<em t=5><shout>PROTECT!"
// Script Variable BOSS_1_INACTIVE_DIALOG :
"P756810225" "<shout>TARGET SIGHTED."
// Script Variable ACTOR1_INACTIVE_DIALOG :
"P2036183171" "<shout>INTRUDER ALERT!"
// Script Variable ACTOR10_INACTIVE_DIALOG :
"P1155954660" "<shout>WARNING: SECURITY IS BREACHED."
// Script Variable BOSS_1_ATTACK_DIALOG :
"P1027141016" "<shout>TARGET IDENTIFIED: {HeroName}."
// Script Variable BOSS_2_ATTACK_DIALOG :
"P2284052061" "<em t=3><shout>{HeroName}?<em>RUN FOR YOUR LIVES!"
// Script Variable BOSS_3_ATTACK_DIALOG :
"P4179258726" "<em t=6><shout>NONSENSE, {hero.gender=male HE|SHE} DOES NOT LOOK SO TOUGH."
// Script Variable BOSS_4_ATTACK_DIALOG :
"P303405586" "<em t=9><shout>YEAH, GET {hero.gender=male HIM|HER}!"
// Script Variable BOSS_1_INACTIVE_DIALOG :
"P2961861644" "<shout>LOOK OUT, WE HAVE COMPANY.<em t=6> <3 <3 <3"
// Script Variable BOSS_2_INACTIVE_DIALOG :
"P3456001671" "<em t=3><shout>DO NOT WORRY. I WILL PROTECT YOU."
// Script Variable BOSS_1_DISPLAYNAME :
"P1903464035" "Security Terminal Alpha"
// Script Variable BOSS1_DISPLAYINFO :
"P1937884947" "When accessed this security terminal will give you partial access to disable the force fields in Positron's lab. After the security terminal is activated there is a short window of time before the force fields are reactivated. Both the Alpha security terminal and the Beta security terminal must be accessed before the Force Fields will come down."
// Script Variable BOSS_2_INACTIVE_DIALOG :
"P3384450358" "<shout>DEFEND SECURITY TERMINAL ALPHA."
// Script Variable BOSS_1_DISPLAYNAME :
"P3386354853" "Security Terminal Beta"
// Script Variable BOSS_2_INACTIVE_DIALOG :
"P1496532787" "<shout>DEFEND SECURITY TERMINAL BETA."
// Script Variable BOSS_1_DISPLAYNAME :
"P3559362858" "Force Field"
// Script Variable ACTOR1_INACTIVE_DIALOG :
"P2075172151" "<shout>WE HAVE A SECURITY BREACH."
// Script Variable ACTOR1_INACTIVE_DIALOG :
"P1044767308" "<shout>HOLD THIS POSITION, THEY HAVE TO COME THROUGH HERE.<em t=7>..."
// Script Variable ACTOR2_INACTIVE_DIALOG :
"P3593733056" "<em t=8><shout>WATCH THE AIR DUCTS!"
// Script Variable ACTOR3_INACTIVE_DIALOG :
"P2125102703" "<em t=4><shout>WHAT ABOUT THE AIR DUCTS?"
// Script Variable ACTOR1_INACTIVE_DIALOG :
"P4028081094" "<shout>THE FORCE FIELDS WILL HOLD THEM FOR AWHILE.<em t=7>NO. KEEP THE FORCE FIELDS UP. WE MUST DEFEND.<em t=12>DEFEND!<em t=16>DEFEND!<em t=20>AGREED."
// Script Variable ACTOR2_INACTIVE_DIALOG :
"P3611102975" "<em t=3>LOWER THE FORCE FIELDS. I WANT TO ATTACK.<em t=10>ATTACK!<em t=14>ATTACK!<em t=18>FINE, DEFEND THEN ATTACK."
// Script Variable ACTOR1_INACTIVE_DIALOG :
"P3174236368" "<shout>THEY WILL BE SORRY IF THEY TRY TO BREACH THE FORCE FIELDS."
// Script Variable ACTOR2_INACTIVE_DIALOG :
"P3219694609" "<em t=4><shout>I AM PROGRAMMED TO LIKE MAKING INTRUDERS SORRY."
// Script Variable ACTOR3_INACTIVE_DIALOG :
"P4160308591" "<em t=9><shout>I AM PROGRAMMED TO LIKE PIE.<em>WHY?<em>THIS QUESTION HAUNTS MY EVERY ACTIVE MEMORY CYCLE.<em>I DO NOT EVEN HAVE A MOUTH TO EAT PIE.<em>WHY ME?"
// Script Variable BOSS_DISPLAYNAME :
"P3651834249" "B.O.T.L.E.R."
// Script Variable BOSS_INACTIVE_DIALOG :
"P506108074" "Please. I implore you to cease your aggressive actions at once."
// Script Variable BOSS_ATTACK_DIALOG :
"P1058423668" "Oh! Have at you, brigand!"
// Script Variable ACTOR1_INACTIVE_DIALOG :
"P4290689855" "<shout>I do say, en garde, villain!"
// Script Variable ACTOR1_ACTIVE_DIALOG :
"P1526957990" "I'll have you know that I am well versed in all forms of fisticuffs!<em>Now prepare to defend your honor!"
// Script Variable ACTOR5_ACTIVE_DIALOG :
"P1559036146" "<shout>{hero.gender=male I am prepared to strike you, sir!|Normally I would never strike a lady, but in this case you are simply not acting as one!}"
// Script Variable ACTOR10_INACTIVE_DIALOG :
"P1072671446" "<shout>To arms my brothers, our master's domicile is under siege by a terrible foe!"
// Script Variable ACTOR15_ACTIVE_DIALOG :
"P2536516703" "<shout>If you will not leave of your own accord then I shall be forced to throw you out."
// Script Variable ACTOR20_INACTIVE_DIALOG :
"P1263333773" "<shout>We shall never surrender!<em>Long live the queen!"

// -------------------------------------------------------------------------------- 
// Objective - ScriptDefeatAllTheBotlers 
// -------------------------------------------------------------------------------- 
// Description :
"P3254950195" "Defeat all B.O.T.L.E.R.s"

// -------------------------------------------------------------------------------- 
// Reward - Objective 
// -------------------------------------------------------------------------------- 
// Script Variable NPC_DIALOG_NAME :
"P3434481647" "Flames of Prometheus Containment Control"

// -------------------------------------------------------------------------------- 
// CutScene 
// -------------------------------------------------------------------------------- 
// 6 Actor1 :
"P1400747997" "<color White><bgcolor Blue>{HeroName}! Return Numina to me and I will let you go."
// 6 Caption :
"P2859505752" "<x=0.2 y=0.2 t=6 d=5><scale 1.75><color White><bgcolor Red>Are you kidding me? The Flames of Prometheus are mine, Positron. I can take as much as I want! Why would I ever give you anything?"
// 6 Actor1 :
"P1399924289" "<color White><bgcolor Blue>Yours? The Flames do not belong to any one person. If you will not relinquish your hold on Numina..."
// 6 Caption :
"P1249907005" "<x=0.2 y=0.2 t=6 d=5><scale 1.75><color White><bgcolor Blue>...then you shall face the consequences!"
// 0 Caption :
"P3872251109" "<x=0.2 y=0.2 t=6 d=5><scale 1.75><color White><bgcolor Blue>Have you forgotten that I was chosen by Prometheus to be the Keeper of the Flames?"
// 5 Actor2 :
"P1097611008" "<color White><bgcolor Blue>I've had years to harness the power of the Flames. You've had that power for less than a minute. Now. Let. Numina. GO!"
// Script Variable Actor1_Name :
"P2167503126" "Positron"
// Script Variable Actor3_Name :
"P3769741362" "Flames of Prometheus"
// Script Variable Actor4_Name :
"P3366424795" "Doppelganger"
// Script Variable BOSS_75HEALTH_DIALOG :
"P628395863" "All this destruction, all this devastation, for what?"
// Script Variable BOSS_50HEALTH_DIALOG :
"P1722392122" "The power of the Flames belongs to us all, {HeroName}, it cannot be stolen."
// Script Variable BOSS_25HEALTH_DIALOG :
"P1645995872" "I see that you've... grown accustomed to... the power of the Flames... quite... quickly."
// Script Variable BOSS_DEAD_DIALOG :
"P2606387774" "No... Numina... I'm sorry... my... love..."
// Script Variable BOSS_KILLEDHERO_DIALOG :
"P3623600705" "<em victory>Was it worth it, {HeroName}? All this effort just to sit in the Zig?"

