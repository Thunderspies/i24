// Script Variable SaysList :
"P3793214176" "I'm dead!"
// Script Variable HOSTAGE_NAME :
"P2511871970" "Dr. Higgins"
// Script Variable HOSTAGE_DISPLAYINFO :
"P765444904" "Dr. Higgins is one of the top Crey Scientists within this office."
// Script Variable HOSTAGE_INACTIVE_DIALOG :
"P1614534581" "I was just following orders, I swear!"
// Script Variable HOSTAGE_ACTIVE_DIALOG :
"P3723828205" "{HeroName}?!"
// Script Variable CAPTOR_INACTIVE_DIALOG :
"P1409780212" "We know what Crey is up to, we're putting you away for a long time!"
// Script Variable CAPTOR_ACTIVE_DIALOG :
"P872521661" "Stay right there while we handle {HeroName}!"
