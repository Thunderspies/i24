// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Crash_Cage 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Crash Cage 
// -------------------------------------------------------------------------------- 
// Name :
"P2066073941" "Crash Cage"
// ProfessionString :
"P1214614690" "Circle of Thorns acolyte"
// DescriptionString :
"P107886549" "Crash is the daughter of Kirk Cage, the leader of the Cage Consortium. But don't even think about using her to get to the big guy himself. The two haven't spoken since she ran away and joined up with some crazy young mystics who thought they could make good with the Circle of Thorns. Most of Crash's youthful companions are dead, but the Circle seems to be impressed with her spirit. She might just have a bright future ahead of her, if she can stay on the Circle's good side. Crash took a small fortune with her when she left home, and she uses that to finance the Circle's work, along with her own petty acts of revenge against her father."
// HelloString :
"P1061242580" "<A HREF=CONTACTLINK_MISSIONS>Hey, there, {VillainName}. Ready for action?</a>"
// HelloString :
"P2707250122" "<A HREF=CONTACTLINK_MISSIONS>Let's make some mischief.</a>"
// HelloString :
"P4018009783" "<A HREF=CONTACTLINK_MISSIONS>It's time for some danger.</a>"
// IDontKnowYouString :
"P1602355770" "If you want to pull a job for me, maybe you should be talking to Vince Dubrowski. If he sends you my way, we'll do business."
// FirstVisitString :
"P4132793398" "As long as you're not working for my dad, we'll get along great, {VillainName}. You got that?"
// NoTasksRemainingString :
"P679093750" "I've got nothing more for you. You need to ask someone else."
// PlayerBusyString :
"P418019588" "Maybe I'll have something for you later. For now, you're way too busy to take on the Circle's work."
// ComeBackLaterString :
"P3467997389" "I've got something, but it's not for you. Not until you hit Threat Level {Level}, anyway."
// RelationshipChangeString_ToFriend :
"P2446437833" "I think we're starting to see eye to eye on a few things. You need <A HREF=CONTACTLINK_GOTOSTORE>Enhancements,</a> pal? I'm your girl. Just don't forget to call me, ok?"
// RelationshipChangeString_ToConfidant :
"P1409572959" "You may be almost as ruthless as my dad, {VillainName}. But I like you. I think we can be friends. It's a tough world; you should have the best <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</a> if you're going to be a survivor."
// FailsafeLevelString :
"P4107389363" "I don't think I'm ready to tangle with you, {VillainName}. You'd better move along."
// LocationString :
// IntroString :
"P3473247213" "Have you met Crash Cage? She's one pretty girl. Kirk Cage's daughter, you know. She used to work for her old man, but they had a falling out, and now she's working for the Circle. 'Course, I don't believe she'd really turn her back on the Consortium forever. Crash carries plenty of Natural and Magic Enhancements."
// IntroAcceptString :
"P111664071" "Choose Crash Cage"
// IntroSendoffString :
"P1568846345" "Crash knows how to hold a grudge. Try to stay  on her good side, {VillainName}."
// IntroduceOneContact :
"P738295740" "I know <A HREF=CONTACTLINK_INTRODUCE>someone</a> who could help you out."
// IntroduceTwoContacts :
"P3485137895" "There are some <A HREF=CONTACTLINK_INTRODUCE>people</a> I know who could help you out."
// -------------------------------------------------------------------------------- 


