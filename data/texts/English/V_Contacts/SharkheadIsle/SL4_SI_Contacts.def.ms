// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Lorenz_Ansaldo 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Lorenz Ansaldo 
// -------------------------------------------------------------------------------- 
// Name :
"P1500041231" "Lorenz Ansaldo"
// ProfessionString :
"P2246188368" "Family Associate"
// DescriptionString :
"P459303048" "Lorenz Ansaldo is an associate for the Family. He's a troubleshooter for their problems, outsourcing to freelance villains when necessary.<br><br>Some say Lorenz got where he did by taking care of certain unsavory tasks for the Family. Others say he'd be much more highly placed if it wasn't for his mouth getting him into trouble all the time. In any case, he gets the job with an easy smile, a nudge and a wink."
// HelloString :
"P4291571584" "<A HREF=CONTACTLINK_MISSIONS>Ay yo, oh ay!</a>"
// HelloString :
"P1704741498" "<A HREF=CONTACTLINK_MISSIONS>What up, my friend?</a>"
// HelloString :
"P2828240208" "<A HREF=CONTACTLINK_MISSIONS>What's goin' on?</a>"
// IDontKnowYouString :
"P1326321489" "Do I know you? I didn't think so. You're going to have to do some jobs for Sharkhead's brokers if you want me to trust you. They're marked on the map."
// FirstVisitString :
"P2184043440" "Hey, I'm Lorenz Ansaldo. That's right THE Lorenz Ansaldo. I'm what you call a troubleshooter for the Family. The Family has a problem that they need solvin', they come to me, and I get what you'd call outside help. That'd be you. Capische?"
// NoTasksRemainingString :
"P969695940" "I got nothin' for you no more! Capische? Go bug someone else!"
// PlayerBusyString :
"P1374376992" "Listen {VillainName}, you got too much happenin' right now. Come back to me after you take care of some business. Capische?"
// ComeBackLaterString :
"P599486293" "You kiddin' me? You gotta be kiddin' me. You're not ready for the big league yet, {VillainName}. Come back when you're at least Threat Level {Level}. Capische?"
// RelationshipChangeString_ToFriend :
"P1716175130" "I like you! You got moxie, kid! You need something to keep you going? Check out my <A HREF=CONTACTLINK_GOTOSTORE>store.</a> And listen, you can call me any time."
// RelationshipChangeString_ToConfidant :
"P581005037" "You, my friend, I will treat like one of my own Family. You need any <A HREF=CONTACTLINK_GOTOSTORE>Enhancements,</a> I got your back. Do not disappoint me!"
// FailsafeLevelString :
"P2767854033" "I'm proud of ya, kid! You got through this mess without too many bullet holes through ya! Now scram! I got other business to take care of."
// LocationString :
// IntroString :
"P3908598065" "If you don't mind doing some work for the Family, I've got someone you should meet. His name is Lorenz Ansaldo, a troubleshooter for the Family in Sharkhead Isle. The Family supplies him with Natural and Technology Enhancements."
// IntroAcceptString :
"P2692467001" "Choose Lorenz Ansaldo"
// IntroSendoffString :
"P2437315177" "Lorenz is a bit of a character, but he can set you up with some good work."
// IntroduceOneContact :
"P4183485370" "I know <A HREF=CONTACTLINK_INTRODUCE>someone</a> who might have some work for you."
// IntroduceTwoContacts :
"P2546254854" "I know some <A HREF=CONTACTLINK_INTRODUCE>people</a> you might want to meet."
// -------------------------------------------------------------------------------- 


