// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Dmitri_Krylov 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Dmitri Krylov 
// -------------------------------------------------------------------------------- 
// Name :
"P616432490" "Dmitri Krylov"
// ProfessionString :
"P923560432" "Metahuman Researcher"
// DescriptionString :
"P1041139567" "Dr. Dmitri Krylov is rumored to be once part of a Soviet super-program to develop metahuman soldiers. After the fall of the Soviet Union, Dmitri came to the Rogue Islands to continue his experiments and to profit from the results."
// HelloString :
"P2836730273" "<A HREF=CONTACTLINK_MISSIONS>Zdrastochye, {VillainName}.</A>"
// HelloString :
"P3405283" "<A HREF=CONTACTLINK_MISSIONS>Let us get to work, da?</A>"
// HelloString :
"P1354834840" "<A HREF=CONTACTLINK_MISSIONS>I have interesting problem to solve, {VillainName}.</A>"
// IDontKnowYouString :
"P3698791608" "What you want with Krylov? I do not know you! You want Krylov, you start with brokers! On your map!"
// FirstVisitString :
"P1629996192" "Zdrastochye, {VillainName}. I am Doctor Dmitri Krylov, a researcher once part of former Soviet Union. I come to Rogue Islands to take advantage of wonderful capitalist society. Big money, no questions asked. Wonderful!"
// NoTasksRemainingString :
"P1867082188" "This concludes our research together. Dosvidanya, {VillainName}!"
// PlayerBusyString :
"P1817697357" "You are too busy to help Krylov."
// ComeBackLaterString :
"P732154734" "You think you are big tough villain, {VillainName}? Nyet! You come talk to Krylov when you are at least Threat Level {Level}!"
// RelationshipChangeString_ToFriend :
"P3325321475" "You are big help to Krylov, tovarisch! You need <A HREF=CONTACTLINK_GOTOSTORE>Enhancements?</A> Here! You must take my number!"
// RelationshipChangeString_ToConfidant :
"P1987211083" "Haha! Together we can make fat capitalist loot! Speaking of loot, you need <A HREF=CONTACTLINK_GOTOSTORE>Enhancements?</A> Best prices for {VillainName}!"
// FailsafeLevelString :
"P3005532070" "You have been very much help to Krylov, {VillainName}."
// LocationString :
// IntroString :
"P608788118" "I'd like to introduce you to Dr. Dmitri Krylov. He was a metahuman researcher in the Soviet Union before it collapsed. He came to the Rogue Isles in order to continue his work. Some of his connections can still get him Technology and Science Enhancements."
// IntroAcceptString :
"P3930468882" "Choose Dr. Dmitri Krylov"
// IntroSendoffString :
"P1174055405" "He's a brilliant researcher with flexible morals. All in all, a valuable contact."
// IntroduceOneContact :
"P2893887353" "I have <A HREF=CONTACTLINK_INTRODUCE>someone</A> you should meet."
// IntroduceTwoContacts :
"P3753281245" "There are some <A HREF=CONTACTLINK_INTRODUCE>people</A> that you meet."
// -------------------------------------------------------------------------------- 


