// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Slot_Machine 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Slot Machine 
// -------------------------------------------------------------------------------- 
// Name :
"P1509940344" "Slot Machine"
// ProfessionString :
"P1014728002" "An older-style slot machine with a pull-arm and an orange video screen."
// DescriptionString :
"P2681710335" "You don't know why exactly, but something seems slightly wrong with this gambling device. Maybe it's the fact that no one else ever goes near the machine, or how the glowing orange light of it's screen sometimes turns blood-red, or that the cigarette burns on the front of the machine almost seem to spell something out, but something definitely feels like it isn't right. As you look at the machine, the dials begin to spin on their own, and as it's lights flash and it's bells ring, you could swear you hear something that sounds like a voice buried amid the cacophony."
// HelloString :
"P239015437" "<A HREF=CONTACTLINK_MISSIONS>Insert coin to play.</a>"
// HelloString :
"P2748340708" "<A HREF=CONTACTLINK_MISSIONS>2 of a kind opens bonus round!</a>"
// HelloString :
"P2305438218" "<A HREF=CONTACTLINK_MISSIONS>KILL</a>"
// HelloString :
"P1847567458" "<A HREF=CONTACTLINK_MISSIONS>6 different bonus games!</a>"
// HelloString :
"P2306036419" "<A HREF=CONTACTLINK_MISSIONS>Any Line Wins!</a>"
// HelloString :
"P3568707486" "<A HREF=CONTACTLINK_MISSIONS>BLOOD</a>"
// IDontKnowYouString :
"P1379640221" "Out of Order <br><br>For you."
// FirstVisitString :
"P2120985647" "A quick guide on how to play rolls across the orange screen: <br><br>Insert coin, then wait for instructions on how to play! Win the round and return for payout!"
// NoTasksRemainingString :
"P1000038785" "You put in your money and pull the lever, but nothing happens. The wheels remain still, and the screen remains locked in a description of the bets. When you try to pull the lever again, the only thing that appears on the slot machine's screen is:<br> 'Unit out of order. <br>Operator has been alerted. <br>Please wait for assistance' <br><br> But no one ever comes by to fix it."
// PlayerBusyString :
"P2099971915" "A maximum of two games can be played at once. No side bets."
// ComeBackLaterString :
"P3305334604" "Minimum to play is level {level}."
// BadgeNeededString :
"P1485003345" "Machine Out of Order <br><br>THE FAMILY ARE TO BLAME <br><br>KILL"
// BadgeFirstTick :
// RelationshipChangeString_ToFriend :
"P723511923" "NEW!!! You can now play ONLINE, and even by CELLPHONE! Call anytime for our handy mobile interface! New <A HREF=CONTACTLINK_GOTOSTORE>products</a> daily!"
// RelationshipChangeString_ToConfidant :
"P3443960661" "You've joined the frequent players club! Congratulations! Would you like to see the <A HREF=CONTACTLINK_GOTOSTORE>store?</a>"
// FailsafeLevelString :
"P2141008759" "You put in your money and pull the lever, but nothing happens. The wheels remain still, and the screen remains locked in a description of the bets. When you try to pull the lever again, the only thing that appears on the slot machine's screen is:<br> 'Coin Box is empty. <br>Operator has been alerted.' <br><br> No one ever comes by to fix it. You have to assume that it has nothing left."
// LocationString :
// IntroString :
"P3061451256" "There's a rumor about an old slot machine that sometimes gives out opportunities instead of jackpots. Maybe you should check it out. I hear it's a good way to win Technology and Science Enhancements."
// IntroAcceptString :
"P3009719701" "Check out the strange slot machine"
// IntroSendoffString :
"P4152501683" "It's an older machine, so remember to take some coins with you. Give it a try. You might get lucky."
// IntroduceOneContact :
"P3427930399" "Would you like to play a game with a new dealer?"
// -------------------------------------------------------------------------------- 


