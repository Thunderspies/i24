// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Hardcase 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Hardcase 
// -------------------------------------------------------------------------------- 
// Name :
"P3247405631" "Hardcase"
// ProfessionString :
"P2385417189" "Demon Hunter"
// DescriptionString :
"P896235317" "Hardcase is professional demon hunter. Demon hunters as a general rule don't live very long, so the fact that he is veteran is a testament to his skill… or luck. Hardcase has come to St. Martial to deal with the demons who plague the area, and is looking for freelancers who aren't afraid to tussle with the monsters."
// HelloString :
"P1555141856" "<A HREF=CONTACTLINK_MISSIONS>What you want?</a>"
// HelloString :
"P106054928" "<A HREF=CONTACTLINK_MISSIONS>Let's talk.</a>"
// HelloString :
"P2135838403" "<A HREF=CONTACTLINK_MISSIONS>Got a problem to deal with.</a>"
// IDontKnowYouString :
"P1815098694" "You want my help? See a broker first. I don't have time to deal with amateurs."
// FirstVisitString :
"P2771074187" "Demons. St. Martial is full of 'em. That's why I'm here. They call me Hardcase, and I'm a demon hunter. I don't care where you're from or what your story is. All I want to know is if you're tough enough to deal. If you are, then maybe we can do some business. If you're not, then I suggest you slink back to whatever hole you crawled out of."
// NoTasksRemainingString :
"P712881297" "The demons are dealt with. For now."
// PlayerBusyString :
"P3887529225" "What are you talking to me for? I heard you got a mess of trouble to deal with already. Aren't you working for {LastContactName}?"
// ComeBackLaterString :
"P2797952768" "You're in over your head, {VillainName}. Talk to me when you're at least Threat Level {Level}."
// RelationshipChangeString_ToFriend :
"P1425398862" "You might survive this work yet, {VillainName}. If only for a little while longer. You should call me, you know? I can get you all the best <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</a>"
// RelationshipChangeString_ToConfidant :
"P2343946953" "You're a tough one, {VillainName}. Maybe you'll put me out of a job... I wish. Any way you slice it, you'll need better <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</a> to survive."
// FailsafeLevelString :
"P2899752697" "We're done, {VillainName}. I'm going to train some new demon hunter."
// LocationString :
// IntroString :
"P544182723" "I know a guy by the name of Hardcase. Have you heard the rumors of demons plaguing St. Martial? Well, Hardcase supposedly hunts these monsters and is looking for freelancers to help him with his work. He can get you Magic and Natural Enhancements."
// IntroAcceptString :
"P545119862" "Choose Hardcase"
// IntroSendoffString :
"P1288940941" "Hardcase is a fairly serious man, but considering his profession, it's understandable."
// IntroduceOneContact :
"P2436018317" "Let me hook you up with <A HREF=CONTACTLINK_INTRODUCE>someone.</A>"
// IntroduceTwoContacts :
"P4099651117" "There's some <A HREF=CONTACTLINK_INTRODUCE>people</a> you might want to meet."
// -------------------------------------------------------------------------------- 


