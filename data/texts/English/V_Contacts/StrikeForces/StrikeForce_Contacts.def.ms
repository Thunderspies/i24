// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Operative_Renault 
//
// Script      : Xlstocontactdef.bat 
// Version     : 32 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Strike Force Operative Renault 
// -------------------------------------------------------------------------------- 
// Name :
"P2843509060" "Strike Force Operative Renault"
// ProfessionString :
"P399695635" "Arachnos Strike Force Operative"
// DescriptionString :
"P3154744065" "Strike Force Operative Renault coordinates operations on behalf of Barracuda."
// WrongAllianceString :
// TaskForceInvite :
"P1411817066" "If you're interested in gaining power and prestige by service to Arachnos, you've come to the right place. I am Strike Force Operative Renault, the right hand of Barracuda just as Barracuda is the right hand of the infamous Captain Mako.  <A HREF={ACCEPT}>Captain Mako seeks the Eye of the Leviathan from the legendary Temple of the Waters. Steal it for Captain Mako and share in the power it brings!</A> "
// PlayerLevelTooLow :
"P1357820827" "Captain Mako and Barracuda would eat you for lunch. Don't bother me until you're at least Threat Level 25. <br><br><color deepskyblue>You need at least 4 members on your team, all of them at least Level 25. If they are over Level 30, they will be automatically exemplared to Level 30 for the duration of the Task Force.</color>"
// PlayerLevelTooHigh :
"P2995404488" "You are greatly feared, and rightly so. My task is far beneath your abilities. <br><br><color deepskyblue>You need at least 4 members on your team, all of them at least Level 25. If they are over Level 30, they will be automatically exemplared to Level 30 for the duration of the Task Force.</color>"
// NeedLargeTeam :
"P4167286875" "The task I have before you requires a Strike Force team of at least four people. <br><br><color deepskyblue>You need at least 4 members on your team, all of them at least Level 25. If they are over Level 30, they will be automatically exemplared to Level 30 for the duration of the Task Force.</color>"
// NeedTeamLeader :
"P91394286" "Who is the greatest amongst your cadre? I need to speak with your leader. <br><br><color deepskyblue>You need at least 4 members on your team, all of them at least Level 25. If they are over Level 30, they will be automatically exemplared to Level 30 for the duration of the Task Force.</color>"
// NeedTeamOnMap :
"P1205902203" "I need to speak with your leader. Now. <br><br><color deepskyblue>You need at least 4 members on your team, all of them at least Level 25. If they are over Level 30, they will be automatically exemplared to Level 30 for the duration of the Task Force.</color>"
// BadTeamLevel :
"P1197606325" "Gather your team. I need to address all of you at once. Remember everyone in your Strike Force team needs to be at least Threat Level 25 to participate in this task. <br><br><color deepskyblue>You need at least 4 members on your team, all of them at least Level 25. If they are over Level 30, they will be automatically exemplared to Level 30 for the duration of the Task Force.</color>"
// TaskForceName :
"P2529153004" "Strike Force Marauder"
// TaskForceName :
"P306008990" "Strike Force Ravager"
// TaskForceName :
"P1037193008" "Strike Force Raider"
// TaskForceName :
"P441869504" "Strike Force Prowler"
// TaskForceName :
"P3608256996" "Strike Force Invader"
// TaskForceName :
"P2260013232" "Strike Force Despoiler"
// HelloString :
"P1432460957" "Arachnos welcomes you, {TaskForceName}."
// HelloString :
"P2840620893" "Let's get to work."
// HelloString :
"P1911693479" "Shall we continue?"
// IDontKnowYouString :
"P1081416828" "You are not recorded in my files. Go away."
// FirstVisitString :
"P1696910434" "The official Arachnos designation of your team will be {TaskForceName}."
// NoTasksRemainingString :
"P2407089617" "I have nothing more for you. Move along."
// RelationshipChangeString_ToFriend :
"P4215333060" "Your efficiency impresses me. Excellent Work!"
// RelationshipChangeString_ToConfidant :
"P1146963464" "I've informed Captain Mako of your progress, and he is pleased."
// FailsafeLevelString :
"P2672143646" "Perhaps you'll be of service to Arachnos elsewhere."
// LocationString :
"P607884113" "Sharkhead Isle"
// IntroString :
// -------------------------------------------------------------------------------- 


