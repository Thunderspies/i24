// MissionDef 
// -------------------------------------------------------------------------------- 
// EntryString :
"P4073213404" "The stench of the sewer threatens to overpower you."
// ExitStringFail :
"P418183399" "You hear the laughter of Romulus as you flee the sewers!"
// ExitStringSuccess :
"P3181746201" "Before you can finish him off, Romulus teleports to safety!"

