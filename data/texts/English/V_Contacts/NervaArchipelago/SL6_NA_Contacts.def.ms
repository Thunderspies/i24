// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Operative_Rutger 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Operative Rutger 
// -------------------------------------------------------------------------------- 
// Name :
"P3815016669" "Operative Rutger"
// ProfessionString :
"P871174980" "Arachnos Operative"
// DescriptionString :
"P4172927932" "Operative Rutger is charged with dealing with vigilante threats on Nerva Archipelago. The last three operatives to occupy his position disappeared under mysterious circumstances; consequently, Operative Rutger is determined to do a good job. His network of information gatherers is without peer, and he's dedicated to working with only the smartest, most bloodthirsty villains the Rogue Isles have to offer."
// HelloString :
"P2111571574" "<A HREF=CONTACTLINK_MISSIONS>Are you ready to work?</A>"
// HelloString :
"P1596742676" "<A HREF=CONTACTLINK_MISSIONS>I have a job for you.</A>"
// HelloString :
"P3723346414" "<A HREF=CONTACTLINK_MISSIONS>We've got a threat to deal with.</A>"
// IDontKnowYouString :
"P2916479966" "You can't just walk right up to an Arachnos operative without going through the proper channels. Talk to Lt. Demitrovich. If he trusts you, I'll know I can, too."
// FirstVisitString :
"P3963210135" "If you're going to work with me, you're going to have to get used to only getting part of the story. I'm privy to a lot of sensitive information, and it's not my habit to spread it around to my subordinates. If you can accept that, I can guarantee that by the time we're done here, all the higher ups in Arachnos will know your name. You'll be a rising star. Think you can handle that?"
// NoTasksRemainingString :
"P3389733581" "We've got nothing more to say to one another."
// PlayerBusyString :
"P4294443089" "You're going to have to clear your plate before we talk about another assignment."
// ComeBackLaterString :
"P1075786911" "Get yourself to Threat Level {Level}, and I may have something for you."
// RelationshipChangeString_ToFriend :
"P990094901" "You've proven that I can trust you a little farther, {VillainName}. I can also give you access to a few more <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</a> Take my communicator codes. And don't screw up. "
// RelationshipChangeString_ToConfidant :
"P441983913" "{VillainName}, you're a person I can respect. From here on in, you're in my inner circle. My entire <A HREF=CONTACTLINK_GOTOSTORE>store</a> is open to you."
// FailsafeLevelString :
"P3169004578" "You've got bigger fish to fry."
// LocationString :
// IntroString :
"P944286369" "You should talk to Operative Rutger over in Hero Heights. He deals with a lot of the vigilantes who come through the Rogue Isles, and he can certainly put you on Arachnos' map. Rutger can get you Natural and Technology Enhancements."
// IntroAcceptString :
"P1602421039" "Choose Operative Rutger"
// IntroSendoffString :
"P3963825275" "Rutger's a tough old bird. Don't mess with him."
// IntroduceOneContact :
"P837953334" "<A HREF=CONTACTLINK_INTRODUCE>Someone</a> I know might be of interest to you."
// IntroduceTwoContacts :
"P1382128211" "I know some <A HREF=CONTACTLINK_INTRODUCE>people</a> you should meet."
// -------------------------------------------------------------------------------- 


