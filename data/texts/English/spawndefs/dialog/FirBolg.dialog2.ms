// CROATOA_FIRBOLG_FROM_ABOVE_ALERTED_TEXT :
"P37428701" "I have you now!"
// CROATOA_FIRBOLG_FROM_ABOVE_ALERTED_TEXT :
"P3806508216" "Fear the Fir Bolg!"

// CROATOA_FIRBOLG_SNEAKING_INACTIVE_TEXT :
"P2603081974" "We must move silently."
// CROATOA_FIRBOLG_SNEAKING_INACTIVE_TEXT :
"P248343508" "We must take this territory quickly."
// CROATOA_FIRBOLG_SNEAKING_INACTIVE_TEXT :
"P1814245986" "Kill any Tuatha who approaches."
// CROATOA_FIRBOLG_SNEAKING_INACTIVE_TEXT :
"P4113417197" "We must take the village before the Tuatha can respond."
// CROATOA_FIRBOLG_SNEAKING_INACTIVE_TEXT :
"P1453273452" "Keep your footsteps silent."

// CROATOA_FIRBOLG_SNEAKING_ALERTED_TEXT :
"P1051682658" "Who's there?"
// CROATOA_FIRBOLG_SNEAKING_ALERTED_TEXT :
"P3077607150" "Quickly!  Silence the human!"
// CROATOA_FIRBOLG_SNEAKING_ALERTED_TEXT :
"P1733161449" "We must maintain secrecy!"
// CROATOA_FIRBOLG_SNEAKING_ALERTED_TEXT :
"P1189266234" "You will have to die now!"

// CROATOA_FIRBOLG_VANDALIZE_CRATETHROW_INACTIVE_TEXT :
"P1035964394" "These people should leave us in peace!"
// CROATOA_FIRBOLG_VANDALIZE_CRATETHROW_INACTIVE_TEXT :
"P2774325624" "For the Fir Bolg!"
// CROATOA_FIRBOLG_VANDALIZE_CRATETHROW_INACTIVE_TEXT :
"P2490659579" "Vile farmers should keep away!"
// CROATOA_FIRBOLG_VANDALIZE_CRATETHROW_INACTIVE_TEXT :
"P1419164702" "This is our territory now!"

// CROATOA_FIRBOLG_VANDALIZE_CRATETHROW_ALERTED_TEXT :
"P1665322552" "We'll destroy you, too!"
// CROATOA_FIRBOLG_VANDALIZE_CRATETHROW_ALERTED_TEXT :
"P664445332" "Don't interfere with us!"
// CROATOA_FIRBOLG_VANDALIZE_CRATETHROW_ALERTED_TEXT :
"P250610864" "We need this place!"
// CROATOA_FIRBOLG_VANDALIZE_CRATETHROW_ALERTED_TEXT :
"P285890401" "This is ours!"

// CROATOA_FIRBOLG_VANDALIZE_CHEERING_INACTIVE_TEXT :
"P1275698776" "Tear it up!"
// CROATOA_FIRBOLG_VANDALIZE_CHEERING_INACTIVE_TEXT :
"P1365031577" "Show them!"
// CROATOA_FIRBOLG_VANDALIZE_CHEERING_INACTIVE_TEXT :
"P1338996288" "Make them leave!"
// CROATOA_FIRBOLG_VANDALIZE_CHEERING_INACTIVE_TEXT :
"P616816174" "Destroy the farm!"

// CROATOA_FIRBOLG_VANDALIZE_CHEERING_ALERTED_TEXT :
"P1656917209" "Intruders!"
// CROATOA_FIRBOLG_VANDALIZE_CHEERING_ALERTED_TEXT :
"P2836576695" "Who disturbs us?"
// CROATOA_FIRBOLG_VANDALIZE_CHEERING_ALERTED_TEXT :
"P2654016326" "Can't you leave us be?"

// CROATOA_FIRBOLG_INSANEROAR_INACTIVE_TEXT :
"P4289780177" "Destroy!  Destroy!"
// CROATOA_FIRBOLG_INSANEROAR_INACTIVE_TEXT :
"P334410519" "I must kill all humans!"
// CROATOA_FIRBOLG_INSANEROAR_INACTIVE_TEXT :
"P848893352" "I will tear the village apart!"
// CROATOA_FIRBOLG_INSANEROAR_INACTIVE_TEXT :
"P1547776039" "All must suffer as I do!"
// CROATOA_FIRBOLG_INSANEROAR_INACTIVE_TEXT :
"P3853646161" "I long to kill!"

// CROATOA_FIRBOLG_VANDALIZE_JUMPINGONBOX_INACTIVE_TEXT :
"P3748330956" "I'll tear this to splinters!"
// CROATOA_FIRBOLG_VANDALIZE_JUMPINGONBOX_INACTIVE_TEXT :
"P3275568623" "The Fir Bolg must dominate!"
// CROATOA_FIRBOLG_VANDALIZE_JUMPINGONBOX_INACTIVE_TEXT :
"P3732801726" "All others must leave!"
// CROATOA_FIRBOLG_VANDALIZE_JUMPINGONBOX_INACTIVE_TEXT :
"P1953440975" "This is our world!"

// CROATOA_FIRBOLG_INSANEROAR_ALERTED_TEXT :
"P352073940" "You will be first to die!"
// CROATOA_FIRBOLG_INSANEROAR_ALERTED_TEXT :
"P2805620960" "Fear me!"
// CROATOA_FIRBOLG_INSANEROAR_ALERTED_TEXT :
"P4279185191" "Say good-bye to your beautiful world!"
// CROATOA_FIRBOLG_INSANEROAR_ALERTED_TEXT :
"P3699072918" "Your suffering will soothe me!"

// CROATOA_FIRBOLG_VANDALIZE_JUMPINGONBOX_ALERTED_TEXT :
"P108472514" "Get away from here!"
// CROATOA_FIRBOLG_VANDALIZE_JUMPINGONBOX_ALERTED_TEXT :
"P3889899311" "Leave us in peace!"
// CROATOA_FIRBOLG_VANDALIZE_JUMPINGONBOX_ALERTED_TEXT :
"P1072186942" "Don't interfere!"
// CROATOA_FIRBOLG_VANDALIZE_JUMPINGONBOX_ALERTED_TEXT :
"P2836756757" "This is not your battle!"

// CROATOA_FIRBOLG_VANDALIZE_OBSERVER_INACTIVE_TEXT :
"P1017084096" "All this junk should rot!"
// CROATOA_FIRBOLG_VANDALIZE_OBSERVER_INACTIVE_TEXT :
"P1110566805" "Show them your courage!"

// CROATOA_FIRBOLG_CALMDOWN_INACTIVE_TEXT :
"P2328131263" "Calm down, I beg you."
// CROATOA_FIRBOLG_CALMDOWN_INACTIVE_TEXT :
"P981752612" "Remember, we were human once."
// CROATOA_FIRBOLG_CALMDOWN_INACTIVE_TEXT :
"P2354713833" "Please, don't lose yourself in hate."
// CROATOA_FIRBOLG_CALMDOWN_INACTIVE_TEXT :
"P1047993351" "You're becoming a true monster."
// CROATOA_FIRBOLG_CALMDOWN_INACTIVE_TEXT :
"P1999371048" "Hang on to your true self.  Please, try."

// CROATOA_FIRBOLG_VANDALIZE_OBSERVER_ALERTED_TEXT :
"P1850104369" "What do you want?"
// CROATOA_FIRBOLG_VANDALIZE_OBSERVER_ALERTED_TEXT :
"P613950817" "Go!"
// CROATOA_FIRBOLG_VANDALIZE_OBSERVER_ALERTED_TEXT :
"P1277932880" "Run, human!"
// CROATOA_FIRBOLG_VANDALIZE_OBSERVER_ALERTED_TEXT :
"P4002082704" "You are not of the Fir Bolg!"

// CROATOA_FIRBOLG_TALKINGWITHCABALINACTIVE_TEXT :
"P1366107109" "We share the same goals."
// CROATOA_FIRBOLG_TALKINGWITHCABALINACTIVE_TEXT :
"P1400334946" "We will do anything if you can rid Croatoa of the enemy."
// CROATOA_FIRBOLG_TALKINGWITHCABALINACTIVE_TEXT :
"P1085528035" "We can work together."

// CROATOA_FIRBOLG_CALMDOWN_ALERTED_TEXT :
"P2158656477" "This is a private matter!"
// CROATOA_FIRBOLG_CALMDOWN_ALERTED_TEXT :
"P1572807740" "Leave us!"
// CROATOA_FIRBOLG_CALMDOWN_ALERTED_TEXT :
"P2161025067" "We are tired of your interference!"
// CROATOA_FIRBOLG_CALMDOWN_ALERTED_TEXT :
"P2612842330" "Leave us alone!"
// CROATOA_FIRBOLG_CALMDOWN_ALERTED_TEXT :
"P2333855183" "Leave us to our misery!"

// CROATOA_FIRBOLG_TALKINGWITHCABALALERTED_TEXT :
"P1693124485" "Stay out of this!"
// CROATOA_FIRBOLG_TALKINGWITHCABALALERTED_TEXT :
"P2370729569" "You cannot stop our united strength!"
// CROATOA_FIRBOLG_TALKINGWITHCABALALERTED_TEXT :
"P2757963509" "We will not tolerate spies in our lands!"
// CROATOA_FIRBOLG_TALKINGWITHCABALALERTED_TEXT :
"P4201304622" "Keep away from us!"

// CROATOA_CABAL_TALKINGWITHFIRBOLGINACTIVE_TEXT :
"P2039977318" "You must make sacrifices to help us against the Red Caps."
// CROATOA_CABAL_TALKINGWITHFIRBOLGINACTIVE_TEXT :
"P1528481005" "Our magic is strong.  We will triumph over the foul creatures."
// CROATOA_CABAL_TALKINGWITHFIRBOLGINACTIVE_TEXT :
"P2454223843" "We have a plan.  But first, we need some information."

// CROATOA_CABAL_TALKINGWITHFIRBOLGALERTED_TEXT :
"P3250227687" "Stop the trespasser!"
// CROATOA_CABAL_TALKINGWITHFIRBOLGALERTED_TEXT :
"P3330664813" "No one must learn of our intent."
// CROATOA_CABAL_TALKINGWITHFIRBOLGALERTED_TEXT :
"P2758118708" "Is this a Red Cap spy?"
// CROATOA_CABAL_TALKINGWITHFIRBOLGALERTED_TEXT :
"P3267958408" "We cannot trust this one."
// CROATOA_CABAL_TALKINGWITHFIRBOLGALERTED_TEXT :
"P1368341995" "We must eliminate the interloper!"

// CROATOA_NPC_FIRBOLGCOERSION_INACTIVE_TEXT :
"P1873013088" "I just want to feed my family!"
// CROATOA_NPC_FIRBOLGCOERSION_INACTIVE_TEXT :
"P4025775284" "I'll go!  Just let me pass!"
// CROATOA_NPC_FIRBOLGCOERSION_INACTIVE_TEXT :
"P2038621852" "I never meant to offend!"
// CROATOA_NPC_FIRBOLGCOERSION_INACTIVE_TEXT :
"P2908650239" "Please!  Leave me alone?"

// CROATOA_NPC_FIRBOLGCOERSION_THANKHERO_TEXT :
"P178558253" "They said I was trespassing!"
// CROATOA_NPC_FIRBOLGCOERSION_THANKHERO_TEXT :
"P999505761" "I think they hate all people!"
// CROATOA_NPC_FIRBOLGCOERSION_THANKHERO_TEXT :
"P1773901015" "Do you really believe they used to be human?"
// CROATOA_NPC_FIRBOLGCOERSION_THANKHERO_TEXT :
"P731679566" "Those creatures are dangerous!"
// CROATOA_NPC_FIRBOLGCOERSION_THANKHERO_TEXT :
"P2547608529" "Thanks, pal. I owe you my life."

// CROATOA_FIRBOLG_TOTEMTUGGING_INACTIVE_TEXT :
"P2321800060" "We must break the Red Caps' power!"
// CROATOA_FIRBOLG_TOTEMTUGGING_INACTIVE_TEXT :
"P2733830851" "The demons taint the whole land with these rocks."
// CROATOA_FIRBOLG_TOTEMTUGGING_INACTIVE_TEXT :
"P1499528712" "We must erase the Red Caps from this earth."
// CROATOA_FIRBOLG_TOTEMTUGGING_INACTIVE_TEXT :
"P386229431" "The stone burns."
// CROATOA_FIRBOLG_TOTEMTUGGING_INACTIVE_TEXT :
"P230541719" "I can feel the hatred of the creatures."
// CROATOA_FIRBOLG_TOTEMTUGGING_INACTIVE_TEXT :
"P933866653" "I cannot unearth this foul rock."

// CROATOA_FIRBOLG_TOTEMTUGGING_ALERTED_TEXT :
"P3722537459" "A servant of the Red Caps, no doubt!"
// CROATOA_FIRBOLG_TOTEMTUGGING_ALERTED_TEXT :
"P4096020269" "You would stop this noble work?"
// CROATOA_FIRBOLG_TOTEMTUGGING_ALERTED_TEXT :
"P2780160196" "I must finish my task!"
// CROATOA_FIRBOLG_TOTEMTUGGING_ALERTED_TEXT :
"P293828559" "Do not interfere in the work of the Fir Bolg!"

// CROATOA_FIRBOLG_TOTEMPULLCHEERING_INACTIVE_TEXT :
"P3630407003" "Pull harder! Harder!"
// CROATOA_FIRBOLG_TOTEMPULLCHEERING_INACTIVE_TEXT :
"P1624108986" "Break it in two!"
// CROATOA_FIRBOLG_TOTEMPULLCHEERING_INACTIVE_TEXT :
"P2918374463" "Break the Red Caps' strength!"
// CROATOA_FIRBOLG_TOTEMPULLCHEERING_INACTIVE_TEXT :
"P1299544513" "Destroy it!"

// CROATOA_FIRBOLG_TOTEMPULLCHEERING_ALERTED_TEXT :
"P3874858321" "Get out of here!"
// CROATOA_FIRBOLG_TOTEMPULLCHEERING_ALERTED_TEXT :
"P101351531" "Vile creature!"
// CROATOA_FIRBOLG_TOTEMPULLCHEERING_ALERTED_TEXT :
"P225863955" "We have business here!"

// CROATOA_FIRBOLG_EOCHAI_TREEDISGUISE_ALERTED_TEXT :
"P3079731383" "Who disturbs my land?"
// CROATOA_FIRBOLG_EOCHAI_TREEDISGUISE_ALERTED_TEXT :
"P1070569497" "I will protect my people!"
// CROATOA_FIRBOLG_EOCHAI_TREEDISGUISE_ALERTED_TEXT :
"P4030124178" "You threaten the Fir Bolg?"
// CROATOA_FIRBOLG_EOCHAI_TREEDISGUISE_ALERTED_TEXT :
"P1001810689" "Trespassers must perish!"
// CROATOA_FIRBOLG_EOCHAI_TREEDISGUISE_ALERTED_TEXT :
"P3353632193" "I will crush you underfoot!"
// CROATOA_FIRBOLG_EOCHAI_TREEDISGUISE_ALERTED_TEXT :
"P1380580506" "Leave my people be!"

// CROATOA_FIRBOLG_TOTEMHAMMERING_INACTIVE_TEXT :
"P3570152226" "Break in two!"
// CROATOA_FIRBOLG_TOTEMHAMMERING_INACTIVE_TEXT :
"P1161241917" "Bust to pieces!"
// CROATOA_FIRBOLG_TOTEMHAMMERING_INACTIVE_TEXT :
"P3527768635" "I will shatter it!"
// CROATOA_FIRBOLG_TOTEMHAMMERING_INACTIVE_TEXT :
"P3344168618" "I will cleave this loathsome stone!"

// CROATOA_FIRBOLG_TOTEMHAMMERING_ALERTED_TEXT :
"P254365824" "Do not stop me!"
// CROATOA_FIRBOLG_TOTEMHAMMERING_ALERTED_TEXT :
"P3345589608" "I will continue!"
// CROATOA_FIRBOLG_TOTEMHAMMERING_ALERTED_TEXT :
"P2759592728" "This task will not be halted!"
// CROATOA_FIRBOLG_TOTEMHAMMERING_ALERTED_TEXT :
"P1318256353" "Do you serve the Red Caps?"

// CROATOA_FIRBOLG_EOCHAI_PATROL_ALERTED_TEXT :
"P578314378" "Who goes there?"
// CROATOA_FIRBOLG_EOCHAI_PATROL_ALERTED_TEXT :
"P4205353117" "Stand before the King of the Fir Bolg!"
// CROATOA_FIRBOLG_EOCHAI_PATROL_ALERTED_TEXT :
"P549807480" "You will perish for your trespasses!"
// CROATOA_FIRBOLG_EOCHAI_PATROL_ALERTED_TEXT :
"P2794749148" "I will brook no interference with my people!"
// CROATOA_FIRBOLG_EOCHAI_PATROL_ALERTED_TEXT :
"P1200393828" "These lands belong to my children!"

// CROATOA_FIRBOLG_NEWCONNAUGHTPATROL_INACTIVE_TEXT :
"P3005313426" "Patrol our borders!"
// CROATOA_FIRBOLG_NEWCONNAUGHTPATROL_INACTIVE_TEXT :
"P584764789" "Keep the Tuatha out!"
// CROATOA_FIRBOLG_NEWCONNAUGHTPATROL_INACTIVE_TEXT :
"P3542842924" "We must reign here!"
// CROATOA_FIRBOLG_NEWCONNAUGHTPATROL_INACTIVE_TEXT :
"P3973332919" "Keep our lands free of rabble!"

// CROATOA_FIRBOLG_TOTEMPULLER_INACTIVE_TEXT :
"P2986365675" "The stone!  It pains me!"
// CROATOA_FIRBOLG_TOTEMPULLER_INACTIVE_TEXT :
"P3821634465" "This thing is wedged tight!"
// CROATOA_FIRBOLG_TOTEMPULLER_INACTIVE_TEXT :
"P3537989548" "It won't come out!"
// CROATOA_FIRBOLG_TOTEMPULLER_INACTIVE_TEXT :
"P902937665" "Magic roots the stone here."
// CROATOA_FIRBOLG_TOTEMPULLER_INACTIVE_TEXT :
"P994094346" "I am trying!  It won't move!"

// CROATOA_FIRBOLG_NEWCONNAUGHTPATROL_ALERTED_TEXT :
"P2098303096" "Stop!"
// CROATOA_FIRBOLG_NEWCONNAUGHTPATROL_ALERTED_TEXT :
"P2047872797" "You offend the Fir Bolg!"
// CROATOA_FIRBOLG_NEWCONNAUGHTPATROL_ALERTED_TEXT :
"P3229213062" "Get out of New Connaught!"
// CROATOA_FIRBOLG_NEWCONNAUGHTPATROL_ALERTED_TEXT :
"P750637939" "New Connaught is ours!"

// CROATOA_FIRBOLG_TOTEMPULLER_ALERTED_TEXT :
"P1436242859" "You defend the Red Caps?"
// CROATOA_FIRBOLG_TOTEMPULLER_ALERTED_TEXT :
"P2099730529" "You mustn't stop me!"
// CROATOA_FIRBOLG_TOTEMPULLER_ALERTED_TEXT :
"P1721900353" "This is serious business!"

// CROATOA_FIRBOLG_TOTEMPULLSUPERVISE_INACTIVE_TEXT :
"P2202371132" "Pull harder."
// CROATOA_FIRBOLG_TOTEMPULLSUPERVISE_INACTIVE_TEXT :
"P1701083436" "We must undermine the Red Caps' strength."
// CROATOA_FIRBOLG_TOTEMPULLSUPERVISE_INACTIVE_TEXT :
"P2801037438" "Don't stop now."

// CROATOA_FIRBOLG_TOTEMPULLSUPERVISE_ALERTED_TEXT :
"P4289143248" "Keep pulling! I'll dispatch this interloper."
// CROATOA_FIRBOLG_TOTEMPULLSUPERVISE_ALERTED_TEXT :
"P2956724163" "Who dares interrupt our work?"
// CROATOA_FIRBOLG_TOTEMPULLSUPERVISE_ALERTED_TEXT :
"P3159502658" "We cannot afford an interruption!"

// CROATOA_FIRBOLG_TREEDISGUISEAMBUSH_ALERTED_TEXT :
"P804830421" "I have you!"
// CROATOA_FIRBOLG_TREEDISGUISEAMBUSH_ALERTED_TEXT :
"P142297095" "You thought you could invade Fir Bolg territory?"
// CROATOA_FIRBOLG_TREEDISGUISEAMBUSH_ALERTED_TEXT :
"P1275916997" "You are mine now!"
// CROATOA_FIRBOLG_TREEDISGUISEAMBUSH_ALERTED_TEXT :
"P4197918195" "You will perish for this invasion!"

// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P1949474261" "And so Eochai led us against the Tuatha."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P3667110762" "In due time we came to these Western shores.  But the Red Caps came, too."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P2853705938" "The Tuatha ravaged our beautiful land."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P2906263054" "We must never forget the cruelty of the Tuatha de Dannan."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P1076040378" "The Red Caps wove a spell about us, and about those poor souls whose help we found."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P1788723885" "Croatoa belongs to the Red Caps and their loathsome servants.  We must find a way to make it ours."

// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_ALERTED_TEXT :
"P3302978856" "Avenge our history!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_ALERTED_TEXT :
"P1944450367" "We will be victims no longer!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_EOCHAISTORYTELLER_ALERTED_TEXT :
"P1125870830" "Rise up against the oppressors!"

// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_INACTIVE_TEXT :
"P4098304916" "Tell us!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_INACTIVE_TEXT :
"P1529956107" "Speak, brother!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_INACTIVE_TEXT :
"P2125581891" "What must we do?"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_INACTIVE_TEXT :
"P3678683090" "How can we triumph?"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_INACTIVE_TEXT :
"P1639919214" "Listen! Listen to our story!"

// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_ALERTED_TEXT :
"P2470013562" "You will suffer for our past!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_ALERTED_TEXT :
"P582776145" "You will pay!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_ALERTED_TEXT :
"P3404869126" "We will have our revenge!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_CHEERING_ALERTED_TEXT :
"P4153732637" "Die, invader!"

// CROATOA_FIRBOLG_EOCHAIWORSHIP_SITTING_INACTIVE_TEXT :
"P2756512157" "I need to hear this."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_SITTING_INACTIVE_TEXT :
"P211540679" "Tell us what to do."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_SITTING_INACTIVE_TEXT :
"P3185787894" "I want to learn."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_SITTING_INACTIVE_TEXT :
"P1559349975" "This story pains me."

// CROATOA_FIRBOLG_EOCHAIWORSHIP_SITTING_ALERTED_TEXT :
"P2402435360" "You interrupt our tale?"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_SITTING_ALERTED_TEXT :
"P2940056708" "Show some respect for our sorrow!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_SITTING_ALERTED_TEXT :
"P1271558035" "Silence!"

// CROATOA_FIRBOLG_EOCHAIWORSHIP_PRAYER_INACTIVE_TEXT :
"P1443253204" "Glorious words!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_PRAYER_INACTIVE_TEXT :
"P2451074185" "Listen!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_PRAYER_INACTIVE_TEXT :
"P387457612" "I hear you!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_PRAYER_INACTIVE_TEXT :
"P18908683" "I will do what I must!"

// CROATOA_FIRBOLG_EOCHAIWORSHIP_PRAYER_ALERTED_TEXT :
"P1734051155" "You mock us!"

// CROATOA_FIRBOLG_EOCHAIWORSHIP_BOWING_INACTIVE_TEXT :
"P3728376842" "I serve Eochai faithfully."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_BOWING_INACTIVE_TEXT :
"P2656231995" "I will obey."
// CROATOA_FIRBOLG_EOCHAIWORSHIP_BOWING_INACTIVE_TEXT :
"P2086425612" "Eochai, save us!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_BOWING_INACTIVE_TEXT :
"P3447226774" "Make us strong with your words!"

// CROATOA_FIRBOLG_EOCHAIWORSHIP_BOWING_ALERTED_TEXT :
"P1560781674" "This time is precious to us!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_BOWING_ALERTED_TEXT :
"P2250958716" "How dare you intrude!"
// CROATOA_FIRBOLG_EOCHAIWORSHIP_BOWING_ALERTED_TEXT :
"P630891185" "All interlopers must die!"

// CROATOA_FIRBOLG_PORTALOPENING_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P4215882829" "The magics of the enemy have been studied."
// CROATOA_FIRBOLG_PORTALOPENING_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P1472639335" "We will expel the Tuatha from this land!"
// CROATOA_FIRBOLG_PORTALOPENING_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P1686676363" "We have learned, and we must now act."
// CROATOA_FIRBOLG_PORTALOPENING_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P738941886" "The magic is strong at this place."
// CROATOA_FIRBOLG_PORTALOPENING_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P2864052801" "Peace will come only when the Tuatha are gone!"

// CROATOA_FIRBOLG_PORTALOPENING_EOCHAISTORYTELLER_ALERTED_TEXT :
"P2710888931" "You know not what you disturb!"
// CROATOA_FIRBOLG_PORTALOPENING_EOCHAISTORYTELLER_ALERTED_TEXT :
"P1521405805" "This magic is too great to be contained!"
// CROATOA_FIRBOLG_PORTALOPENING_EOCHAISTORYTELLER_ALERTED_TEXT :
"P1192262480" "You will not stay my hand!"

// CROATOA_FIRBOLG_PORTALOPENING_CHEERING_INACTIVE_TEXT :
"P1943098113" "Open the portal!"
// CROATOA_FIRBOLG_PORTALOPENING_CHEERING_INACTIVE_TEXT :
"P2697186832" "Do it!  Do it!"
// CROATOA_FIRBOLG_PORTALOPENING_CHEERING_INACTIVE_TEXT :
"P4172184545" "Work your magic!"
// CROATOA_FIRBOLG_PORTALOPENING_CHEERING_INACTIVE_TEXT :
"P1593646088" "We can do it!"

// CROATOA_FIRBOLG_PORTALOPENING_CHEERING_ALERTED_TEXT :
"P4175293018" "Protect the mage!"
// CROATOA_FIRBOLG_PORTALOPENING_CHEERING_ALERTED_TEXT :
"P732843886" "Keep the human away!"
// CROATOA_FIRBOLG_PORTALOPENING_CHEERING_ALERTED_TEXT :
"P2920932955" "We must finish the spell!"

// CROATOA_FIRBOLG_PORTALOPENING_SITTING_INACTIVE_TEXT :
"P116041739" "I can feel the power."
// CROATOA_FIRBOLG_PORTALOPENING_SITTING_INACTIVE_TEXT :
"P3338316740" "It's happening."
// CROATOA_FIRBOLG_PORTALOPENING_SITTING_INACTIVE_TEXT :
"P15295416" "We will soon see the fruits of our long struggle."

// CROATOA_FIRBOLG_PORTALOPENING_SITTING_ALERTED_TEXT :
"P3643971147" "Leave here!"
// CROATOA_FIRBOLG_PORTALOPENING_SITTING_ALERTED_TEXT :
"P3494903474" "You'll ruin everything!"

// CROATOA_FIRBOLG_PORTALOPENING_PRAYER_INACTIVE_TEXT :
"P416525281" "Let the portal be opened."
// CROATOA_FIRBOLG_PORTALOPENING_PRAYER_INACTIVE_TEXT :
"P2870927636" "Let the enemy be sent forth."
// CROATOA_FIRBOLG_PORTALOPENING_PRAYER_INACTIVE_TEXT :
"P2327798817" "Let the magic heal our wounds."

// CROATOA_FIRBOLG_PORTALOPENING_PRAYER_ALERTED_TEXT :
"P726212334" "No!"
// CROATOA_FIRBOLG_PORTALOPENING_PRAYER_ALERTED_TEXT :
"P3252461611" "Not now!"
// CROATOA_FIRBOLG_PORTALOPENING_PRAYER_ALERTED_TEXT :
"P1800105094" "The magic mustn't stop!"
// CROATOA_FIRBOLG_PORTALOPENING_PRAYER_ALERTED_TEXT :
"P1420992668" "Please, go away!"
// CROATOA_FIRBOLG_PORTALOPENING_PRAYER_ALERTED_TEXT :
"P3657140229" "You'll destroy all our work!"

// CROATOA_FIRBOLG_PORTALOPENING_BOWING_INACTIVE_TEXT :
"P2913428051" "The power wells."
// CROATOA_FIRBOLG_PORTALOPENING_BOWING_INACTIVE_TEXT :
"P3217286234" "I am ready."
// CROATOA_FIRBOLG_PORTALOPENING_BOWING_INACTIVE_TEXT :
"P4043439946" "This is the moment of our liberation."

// CROATOA_FIRBOLG_PORTALOPENING_BOWING_ALERTED_TEXT :
"P3360643545" "Protect the portal!"
// CROATOA_FIRBOLG_PORTALOPENING_BOWING_ALERTED_TEXT :
"P203523947" "Don't let the portal come to harm!"
// CROATOA_FIRBOLG_PORTALOPENING_BOWING_ALERTED_TEXT :
"P1364504315" "Keep the humans back!"

// CROATOA_FIRBOLG_CABALSTANDOFF_MENACE_INACTIVE_TEXT :
"P2581529849" "Keep back, sorceress!"
// CROATOA_FIRBOLG_CABALSTANDOFF_MENACE_INACTIVE_TEXT :
"P2674629461" "We are not afraid of you!"
// CROATOA_FIRBOLG_CABALSTANDOFF_MENACE_INACTIVE_TEXT :
"P4066463690" "You have no power over the Fir Bolg!"

// CROATOA_FIRBOLG_CABALSTANDOFF_HURLINGROCKS_INACTIVE_TEXT :
"P2865823337" "You have angered us!"
// CROATOA_FIRBOLG_CABALSTANDOFF_HURLINGROCKS_INACTIVE_TEXT :
"P2390709338" "You trespass here!"
// CROATOA_FIRBOLG_CABALSTANDOFF_HURLINGROCKS_INACTIVE_TEXT :
"P70069350" "This is the land of the Fir Bolg! None may enter!"

// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALL_INACTIVE_TEXT :
"P2472081340" "Silly creatures."
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALL_INACTIVE_TEXT :
"P2877171619" "You cannot beat us."
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALL_INACTIVE_TEXT :
"P2213702471" "If we choose to press this fight, we will win."
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALL_INACTIVE_TEXT :
"P1063439979" "Foolish beast."
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALL_INACTIVE_TEXT :
"P847567846" "Hah!  Don't make me laugh!"
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALL_INACTIVE_TEXT :
"P172485869" "We'll shred you to pieces if we want to."
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALL_INACTIVE_TEXT :
"P3515092148" "The Cabal's magic is more than mighty enough to deal with you."
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALL_INACTIVE_TEXT :
"P2261715707" "Don't push us, animal."

// CROATOA_FIRBOLG_CABALSTANDOFF_CRAZYMENACE_INACTIVE_TEXT :
"P2026905472" "Shred you!"
// CROATOA_FIRBOLG_CABALSTANDOFF_CRAZYMENACE_INACTIVE_TEXT :
"P233048606" "Tear you apart!"
// CROATOA_FIRBOLG_CABALSTANDOFF_CRAZYMENACE_INACTIVE_TEXT :
"P4237853993" "Rip you limb from limb!"
// CROATOA_FIRBOLG_CABALSTANDOFF_CRAZYMENACE_INACTIVE_TEXT :
"P1253308411" "Cabal leaves now!"

// CROATOA_CABAL_CABALSTANDOFF_COWERING_INACTIVE_TEXT :
"P3452118742" "Calm yourselves.  There is business we can do."
// CROATOA_CABAL_CABALSTANDOFF_COWERING_INACTIVE_TEXT :
"P2800503289" "We don't want a battle.  We want to talk."
// CROATOA_CABAL_CABALSTANDOFF_COWERING_INACTIVE_TEXT :
"P397797547" "Harm me, and you will regret it."

// CROATOA_FIRBOLG_CABALSTANDOFF_CHEERING_INACTIVE_TEXT :
"P3798900027" "Work your will, sister!"
// CROATOA_FIRBOLG_CABALSTANDOFF_CHEERING_INACTIVE_TEXT :
"P4193541602" "Give them a taste of our power!"
// CROATOA_FIRBOLG_CABALSTANDOFF_CHEERING_INACTIVE_TEXT :
"P3824884131" "Show them they can't defeat us!"
// CROATOA_FIRBOLG_CABALSTANDOFF_CHEERING_INACTIVE_TEXT :
"P2411769719" "Summon the winds!"

// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALLBUTNOTWORKING_INACTIVE_TEXT :
"P2788263106" "It's not working!"
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALLBUTNOTWORKING_INACTIVE_TEXT :
"P4158972763" "I'm trying!"
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALLBUTNOTWORKING_INACTIVE_TEXT :
"P3606990139" "The magic won't come!"
// CROATOA_CABAL_CABALSTANDOFF_CASTINGWALLBUTNOTWORKING_INACTIVE_TEXT :
"P620347552" "Something's wrong with my spell!"

// CROATOA_OUTDOORMISSION4_CHIPPINGTHRONE_INACTIVE_TEXT :
"P1667499798" "Destroy the work of the Red Caps!"
// CROATOA_OUTDOORMISSION4_CHIPPINGTHRONE_INACTIVE_TEXT :
"P64168369" "Tear the thing apart!"
// CROATOA_OUTDOORMISSION4_CHIPPINGTHRONE_INACTIVE_TEXT :
"P464549825" "Crumble Jack's throne!"

// CROATOA_OUTDOORMISSION4_CHIPPINGTHRONE_ALERTED_TEXT :
"P726111342" "Why do you oppose us?"
// CROATOA_OUTDOORMISSION4_CHIPPINGTHRONE_ALERTED_TEXT :
"P3858063022" "We must finish this work!"

// CROATOA_OUTDOORMISSION4_THROWINGROCKATTHRONE_INACTIVE_TEXT :
"P2696314807" "Destroy!"
// CROATOA_OUTDOORMISSION4_THROWINGROCKATTHRONE_INACTIVE_TEXT :
"P2315989773" "Take it down!"
// CROATOA_OUTDOORMISSION4_THROWINGROCKATTHRONE_INACTIVE_TEXT :
"P1196229931" "Wreck it!"

// CROATOA_OUTDOORMISSION4_THROWINGROCKATTHRONE_ALERTED_TEXT :
"P302471075" "Who is it?"
// CROATOA_OUTDOORMISSION4_THROWINGROCKATTHRONE_ALERTED_TEXT :
"P2557583070" "Another enemy!"
// CROATOA_OUTDOORMISSION4_THROWINGROCKATTHRONE_ALERTED_TEXT :
"P345269499" "You are the enemy of the Fir Bolg!"

// CROATOA_OUTDOORMISSION4_SLEDGEHAMMERINGTHRONE_INACTIVE_TEXT :
"P1558058635" "This thing won't go down!"
// CROATOA_OUTDOORMISSION4_SLEDGEHAMMERINGTHRONE_INACTIVE_TEXT :
"P1695386449" "It is too massive!"
// CROATOA_OUTDOORMISSION4_SLEDGEHAMMERINGTHRONE_INACTIVE_TEXT :
"P1203607695" "It will not break!"

// CROATOA_OUTDOORMISSION4_SLEDGEHAMMERINGTHRONE_ALERTED_TEXT :
"P1663510670" "Get away from us!"
// CROATOA_OUTDOORMISSION4_SLEDGEHAMMERINGTHRONE_ALERTED_TEXT :
"P732716289" "Do not try to stop us!"
// CROATOA_OUTDOORMISSION4_SLEDGEHAMMERINGTHRONE_ALERTED_TEXT :
"P3816691322" "Stand back, or suffer our wrath!"

// CROATOA_OUTDOORMISSION4_PICKAXEINGTHRONE_INACTIVE_TEXT :
"P565746327" "We will manage it!"
// CROATOA_OUTDOORMISSION4_PICKAXEINGTHRONE_INACTIVE_TEXT :
"P211009345" "We will perservere!"
// CROATOA_OUTDOORMISSION4_PICKAXEINGTHRONE_INACTIVE_TEXT :
"P202982326" "I won't stop until it's rubble!"

// CROATOA_OUTDOORMISSION4_PICKAXEINGTHRONE_ALERTED_TEXT :
"P3080794428" "You won't prevent us!"
// CROATOA_OUTDOORMISSION4_PICKAXEINGTHRONE_ALERTED_TEXT :
"P2190130178" "You are not one of us!"

// CROATOA_OUTDOORMISSION4_JUMPINGONTHRONE_INACTIVE_TEXT :
"P894936020" "Make it crumble!"
// CROATOA_OUTDOORMISSION4_JUMPINGONTHRONE_INACTIVE_TEXT :
"P402944015" "Let it fall apart!"
// CROATOA_OUTDOORMISSION4_JUMPINGONTHRONE_INACTIVE_TEXT :
"P4101696791" "I want it destroyed!"

// CROATOA_OUTDOORMISSION4_JUMPINGONTHRONE_ALERTED_TEXT :
"P3148569652" "Defend yourselves!"
// CROATOA_OUTDOORMISSION4_JUMPINGONTHRONE_ALERTED_TEXT :
"P1817408908" "Don't let them stop you!"
// CROATOA_OUTDOORMISSION4_JUMPINGONTHRONE_ALERTED_TEXT :
"P3450106102" "Dispatch this rabble!"

// CROATOA_OUTDOORMISSION4_WALKINGTREE_INACTIVE_TEXT :
"P0" ""

// CROATOA_OUTDOORMISSION4_WALKINGTREE_ALERTED_TEXT :
"P1196568842" "I've got you!"

// CROATOA_FIRBOLG_OUTDOORMISSION4_FIELDAMBUSH_ALERTED_TEXT :
"P1316755686" "Hah! You have fallen to the Fir Bolg!"

// CROATOA_FIRBOLG_OUTDOORMISSION4_ObservingCHEERING_INACTIVE_TEXT :
"P1601849679" "Kill the Tuatha!"

// CROATOA_FIRBOLG_OUTDOORMISSION4_ObservingCHEERING_ALERTED_TEXT :
"P1872363732" "You will not rob us of our victory!"

// CROATOA_FIRBOLG_RelicTug2CHEERING_INACTIVE_TEXT :
"P1196906830" "We need it!"
// CROATOA_FIRBOLG_RelicTug2CHEERING_INACTIVE_TEXT :
"P3356179968" "We must have it!"
// CROATOA_FIRBOLG_RelicTug2CHEERING_INACTIVE_TEXT :
"P3132573174" "Take it, take it!"

// CROATOA_FIRBOLG_RelicTug2CHEERING_ALERTED_TEXT :
"P2689953014" "You are an enemy of the Fir Bolg!"
// CROATOA_FIRBOLG_RelicTug2CHEERING_ALERTED_TEXT :
"P3343763568" "This power must be ours!"

// CROATOA_FIRBOLG_RelicTug2ER_INACTIVE_TEXT :
"P3758017430" "Give it up!"
// CROATOA_FIRBOLG_RelicTug2ER_INACTIVE_TEXT :
"P1232099808" "This power will be ours!"
// CROATOA_FIRBOLG_RelicTug2ER_INACTIVE_TEXT :
"P3954126358" "The Fir Bolg have need of this power!"

// CROATOA_FIRBOLG_RelicTug2ER_ALERTED_TEXT :
"P589227101" "You can't stop us!"
// CROATOA_FIRBOLG_RelicTug2ER_ALERTED_TEXT :
"P1041428064" "The item is rightly ours!"
// CROATOA_FIRBOLG_RelicTug2ER_ALERTED_TEXT :
"P1891770687" "All that is here belongs to the Fir Bolg!"

// CROATOA_FIRBOLG_RelicTug2SUPERVISE_INACTIVE_TEXT :
"P2316777164" "Careful.  The crystal is most powerful."
// CROATOA_FIRBOLG_RelicTug2SUPERVISE_INACTIVE_TEXT :
"P2059804730" "Do not break it."
// CROATOA_FIRBOLG_RelicTug2SUPERVISE_INACTIVE_TEXT :
"P1975911717" "The crystal must remain intact."

// CROATOA_FIRBOLG_RelicTug2SUPERVISE_ALERTED_TEXT :
"P2657260559" "Stay back!"
// CROATOA_FIRBOLG_RelicTug2SUPERVISE_ALERTED_TEXT :
"P1412107134" "Fool!  You'll break our crystal!"
// CROATOA_FIRBOLG_RelicTug2SUPERVISE_ALERTED_TEXT :
"P4255732543" "This relic is too mighty for the likes of you."

// CROATOA_FIRBOLG_PurseTug2ER_INACTIVE_TEXT :
"P478043413" "Vapid woman!  Release it!"
// CROATOA_FIRBOLG_PurseTug2ER_INACTIVE_TEXT :
"P1321436469" "Give up your gold!"
// CROATOA_FIRBOLG_PurseTug2ER_INACTIVE_TEXT :
"P666756819" "I will not be thwarted by you, wench."

// CROATOA_FIRBOLG_PurseTug2ER_ALERTED_TEXT :
"P1604013005" "Are you the protector of these people?"
// CROATOA_FIRBOLG_PurseTug2ER_ALERTED_TEXT :
"P3182455821" "I will take everything in this land for the Fir Bolg!"
// CROATOA_FIRBOLG_PurseTug2ER_ALERTED_TEXT :
"P628574485" "You cannot stop the mighty Fir Bolg!"

// CROATOA_FIRBOLG_BLOCKINGPATH_INACTIVE_TEXT :
"P767782602" "None will pass us."
// CROATOA_FIRBOLG_BLOCKINGPATH_INACTIVE_TEXT :
"P3946720839" "We must defend our territory."
// CROATOA_FIRBOLG_BLOCKINGPATH_INACTIVE_TEXT :
"P2303637977" "We must keep our borders safe."

// CROATOA_FIRBOLG_BLOCKINGPATH_ALERTED_TEXT :
"P1270982115" "You will not pass!"
// CROATOA_FIRBOLG_BLOCKINGPATH_ALERTED_TEXT :
"P1061441628" "You are not welcome here!"
// CROATOA_FIRBOLG_BLOCKINGPATH_ALERTED_TEXT :
"P1862994772" "We have the might to stop you!"

// CROATOA_FIRBOLG_BLOCKEDBYBUILDING_INACTIVE_TEXT :
"P31711866" "This edifice is strange."
// CROATOA_FIRBOLG_BLOCKEDBYBUILDING_INACTIVE_TEXT :
"P919609422" "What happened to the open plains?"
// CROATOA_FIRBOLG_BLOCKEDBYBUILDING_INACTIVE_TEXT :
"P1313935274" "This place is strange to me."

// CROATOA_FIRBOLG_BLOCKEDBYBUILDING_ALERTED_TEXT :
"P2889641971" "What are you doing here?"
// CROATOA_FIRBOLG_BLOCKEDBYBUILDING_ALERTED_TEXT :
"P1974895604" "Why do you trap us here?"
// CROATOA_FIRBOLG_BLOCKEDBYBUILDING_ALERTED_TEXT :
"P2519052029" "What is wrong with this place?"

// CROATOA_FIRBOLG_REMEMBERINGHOWTOUSECHAIR_INACTIVE_TEXT :
"P1471798264" "I remember this!"
// CROATOA_FIRBOLG_REMEMBERINGHOWTOUSECHAIR_INACTIVE_TEXT :
"P1794851233" "Now I remember: I was human once!"
// CROATOA_FIRBOLG_REMEMBERINGHOWTOUSECHAIR_INACTIVE_TEXT :
"P1393336927" "This is called... a chair! I remember!"

// CROATOA_FIRBOLG_REMEMBERINGHOWTOUSECHAIR_ALERTED_TEXT :
"P3514208965" "I'm busy!"
// CROATOA_FIRBOLG_REMEMBERINGHOWTOUSECHAIR_ALERTED_TEXT :
"P3545723017" "No!  Don't interrupt!  Not now!"
// CROATOA_FIRBOLG_REMEMBERINGHOWTOUSECHAIR_ALERTED_TEXT :
"P3236684786" "Can't you see how important this is?"

// CROATOA_FIRBOLG_NOTUSINGCHAIRCORRECT_INACTIVE_TEXT :
"P4223594593" "Something's not right here."
// CROATOA_FIRBOLG_NOTUSINGCHAIRCORRECT_INACTIVE_TEXT :
"P1902981819" "I feel I have missed a step."
// CROATOA_FIRBOLG_NOTUSINGCHAIRCORRECT_INACTIVE_TEXT :
"P2892018225" "What am I missing?"

// CROATOA_FIRBOLG_NOTUSINGCHAIRCORRECT_ALERTED_TEXT :
"P3762518478" "Do not disturb me!"
// CROATOA_FIRBOLG_NOTUSINGCHAIRCORRECT_ALERTED_TEXT :
"P3744440131" "Leave me be!"

// CROATOA_PHONERINGING_INACTIVE_TEXT :
"P1727741863" "Riiiing! Riiiing!"

// CROATOA_FIRBOLG_CONFUSEDATPHONE1_INACTIVE_TEXT :
"P2084395008" "What magic is this?"
// CROATOA_FIRBOLG_CONFUSEDATPHONE1_INACTIVE_TEXT :
"P3255664140" "This item.  It speaks to me."
// CROATOA_FIRBOLG_CONFUSEDATPHONE1_INACTIVE_TEXT :
"P3701356782" "Is this an instrument?  It is most offensive."

// CROATOA_FIRBOLG_CONFUSEDATPHONE1_ALERTED_TEXT :
"P478236702" "I hurt no one!"
// CROATOA_FIRBOLG_CONFUSEDATPHONE1_ALERTED_TEXT :
"P623745342" "I have a right to be here!"

// CROATOA_FIRBOLG_CONFUSEDATPHONE2_INACTIVE_TEXT :
"P2764091266" "This is the strangest noise."
// CROATOA_FIRBOLG_CONFUSEDATPHONE2_INACTIVE_TEXT :
"P1208583267" "Quiet, you!"
// CROATOA_FIRBOLG_CONFUSEDATPHONE2_INACTIVE_TEXT :
"P2349324028" "The thing is enchanted."

// CROATOA_FIRBOLG_CONFUSEDATPHONE2_ALERTED_TEXT :
"P3803276193" "Why do you plague us?"
// CROATOA_FIRBOLG_CONFUSEDATPHONE2_ALERTED_TEXT :
"P2849913137" "This land will be the Fir Bolg's!"

// CROATOA_FIRBOLG_SCROUNGING_INACTIVE_TEXT :
"P3511557632" "To think, the mighty Fir Bolg are reduced to this."
// CROATOA_FIRBOLG_SCROUNGING_INACTIVE_TEXT :
"P1285769871" "These people are alarmingly wasteful."
// CROATOA_FIRBOLG_SCROUNGING_INACTIVE_TEXT :
"P3622285864" "I must find something to sustain my people."

// CROATOA_FIRBOLG_SCROUNGING_ALERTED_TEXT :
"P3298843137" "Who's there!"
// CROATOA_FIRBOLG_SCROUNGING_ALERTED_TEXT :
"P3390394781" "Can't you leave me to my misery?"
// CROATOA_FIRBOLG_SCROUNGING_ALERTED_TEXT :
"P2320808723" "I only wish to be left alone!"

// CROATOA_FIRBOLG_COERCEHOLDPIG_INACTIVE_TEXT :
"P810412217" "You will not deny us!"
// CROATOA_FIRBOLG_COERCEHOLDPIG_INACTIVE_TEXT :
"P242137470" "Do not defy me, farmer!"

// CROATOA_FIRBOLG_COERCEHOLDPIG_ALERTED_TEXT :
"P2845232354" "I will not be challenged in these lands!"
// CROATOA_FIRBOLG_COERCEHOLDPIG_ALERTED_TEXT :
"P140364168" "Who would face me?"

// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMTUGGING_INACTIVE_TEXT :
"P1451254287" "The Red Caps must not mark these lands!"
// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMTUGGING_INACTIVE_TEXT :
"P1872847352" "Remove the demon taint!"
// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMTUGGING_INACTIVE_TEXT :
"P3264772724" "The Fir Bolg are the only rulers here!"

// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMTUGGING_ALERTED_TEXT :
"P2208860316" "I must break the demons' power!"
// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMTUGGING_ALERTED_TEXT :
"P1192839236" "You interrupt important work!"
// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMTUGGING_ALERTED_TEXT :
"P2992601398" "You would support the vile ones?"

// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMDIGGINGOUT_INACTIVE_TEXT :
"P3145397267" "This ground is soiled by the Red Caps!"
// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMDIGGINGOUT_INACTIVE_TEXT :
"P3142806513" "I will not suffer this incursion!"
// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMDIGGINGOUT_INACTIVE_TEXT :
"P1465488098" "I will root out the Red Caps wherever they lurk!"

// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMDIGGINGOUT_ALERTED_TEXT :
"P1497481249" "I cannot abide intrusion!"
// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMDIGGINGOUT_ALERTED_TEXT :
"P587231834" "You are not one to challenge me!"
// CROATOA_FIRBOLG_OUTDOORMISSION4_TOTEMDIGGINGOUT_ALERTED_TEXT :
"P4087988753" "You are in league with demons!"

