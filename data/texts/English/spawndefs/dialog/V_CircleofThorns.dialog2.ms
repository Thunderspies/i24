// OAKES_MARCONEVILLE_GHOSTTRAP_FLEEINGTRAPPEDGHOST_TEXT :
"P1120608258" "One day you will walk as I do!"

// BLOODYBAY_FORESTPATROL_ATTACK_TEXT :
"P1243292211" "Any means necessary, gentlemen!"
// BLOODYBAY_FORESTPATROL_ATTACK_TEXT :
"P2195660368" "You dare to interrupt the Circle of Thorns!"
// BLOODYBAY_FORESTPATROL_ATTACK_TEXT :
"P3851595269" "Prepare for pain!"
// BLOODYBAY_FORESTPATROL_ATTACK_TEXT :
"P1231471707" "Bloody Bay's secrets will not be usurped by the likes of you!"

// OAKES_MONTROSE_ABDUCTEE_INACTIVE_TEXT :
"P2411784489" "Look, I'm not saying anything."
// OAKES_MONTROSE_ABDUCTEE_INACTIVE_TEXT :
"P2826949114" "You can't make me talk."
// OAKES_MONTROSE_ABDUCTEE_INACTIVE_TEXT :
"P1519353066" "Let...me...go..."
// OAKES_MONTROSE_ABDUCTEE_INACTIVE_TEXT :
"P625825103" "Big mistake.  BIG."

// OAKES_MONTROSE_ABDUCTEE_ATTACK_TEXT :
"P1323147403" "I can handle myself.  You saw too much!"
// OAKES_MONTROSE_ABDUCTEE_ATTACK_TEXT :
"P2448930011" "You think I can't handle Montrose?  I can."
// OAKES_MONTROSE_ABDUCTEE_ATTACK_TEXT :
"P2278505894" "Curiosity killed the cat."

// OAKES_MONTROSE_ABDUCTOR_INACTIVE_TEXT :
"P2004157094" "Silence, I will not listen to any more of your ramblings."
// OAKES_MONTROSE_ABDUCTOR_INACTIVE_TEXT :
"P1829679763" "The time is right for a little revenge."
// OAKES_MONTROSE_ABDUCTOR_INACTIVE_TEXT :
"P2818444890" "Ahhh...the cat has now become the mouse.  How delicious."

// OAKES_MONTROSE_ABDUCTOR_ATTACK_TEXT :
"P1421796327" "We will not be undermined!"
// OAKES_MONTROSE_ABDUCTOR_ATTACK_TEXT :
"P2008039565" "Montrose will never be safe for you!"

// BLOODY_RESEARCH_OBSERVE_INACTIVE_TEXT :
"P1297792363" "Keep casting, my friend.  Let them dig for us."
// BLOODY_RESEARCH_OBSERVE_INACTIVE_TEXT :
"P319804368" "So easy to manipulate.  Keep digging."
// BLOODY_RESEARCH_OBSERVE_INACTIVE_TEXT :
"P14227106" "These slaves must dig faster.  We need to learn the secrets of the ore."
// BLOODY_RESEARCH_OBSERVE_INACTIVE_TEXT :
"P534844897" "We will find the secrets of the ore."
// BLOODY_RESEARCH_OBSERVE_INACTIVE_TEXT :
"P2088033485" "Dig faster, slave."

// BLOODY_RESEARCH_OBSERVE_ATTACK_TEXT :
"P1627394192" "You will not distract us!"
// BLOODY_RESEARCH_OBSERVE_ATTACK_TEXT :
"P2216730819" "You will not interfere with our plans!"
// BLOODY_RESEARCH_OBSERVE_ATTACK_TEXT :
"P3687781080" "The secrets of the ore will be ours alone!"

// SHARKHEAD_CEREMONY_INCANTATION_INACTIVE_TEXT :
