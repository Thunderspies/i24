// KINGSROW_ALLHOODS_CASEBUILDING_LOOKOUT_INACTIVE_TEXT :
"P1210372674" "Okay, cool.  Let's move on.  I'm getting twitchy."

// KINGSROW_ALLHOODS_CASEBUILDING_LOOKOUT_ALERT_TEXT :
"P3935146118" "I told you!  Busted!"
// KINGSROW_ALLHOODS_CASEBUILDING_LOOKOUT_ALERT_TEXT :
"P1289502142" "Busted!"
// KINGSROW_ALLHOODS_CASEBUILDING_LOOKOUT_ALERT_TEXT :
