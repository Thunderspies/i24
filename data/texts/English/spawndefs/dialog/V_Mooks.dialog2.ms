// OAKES_MONTROSE_DICE_WINNER_INACTIVE_TEXT :
"P1796862027" "Yes!  I win again!"
// OAKES_MONTROSE_DICE_WINNER_INACTIVE_TEXT :
"P1288029014" "I LOVE this game!"

// OAKES_MONTROSE_DICE_WINNER_ALERT_TEXT :
"P1946488798" "Never interrupt a man when he's gambling!"
// OAKES_MONTROSE_DICE_WINNER_ALERT_TEXT :
"P2914935400" "You wanted to find some gambling action?  You got it."
// OAKES_MONTROSE_DICE_WINNER_ALERT_TEXT :
"P1476164171" "You got no reason to interrupt the Mooks, pal!"

// OAKES_MONTROSE_DICE_LOSER_INACTIVE_TEXT :
"P321883428" "I hate this game."
// OAKES_MONTROSE_DICE_LOSER_INACTIVE_TEXT :
"P1028830275" "You COULD be a bit more gracious about it."
// OAKES_MONTROSE_DICE_LOSER_INACTIVE_TEXT :
"P2344772340" "I hate dice."
// OAKES_MONTROSE_DICE_LOSER_INACTIVE_TEXT :
