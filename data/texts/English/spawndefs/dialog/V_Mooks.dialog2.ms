// OAKES_MONTROSE_LOITER_TALKER_ALERT_TEXT :
"P122340754" "You and me.  Right here.  Right now!"

// OAKES_MONTROSE_DICE_WINNER_INACTIVE_TEXT :
"P1888992384" "And I win AGAIN!"
// OAKES_MONTROSE_DICE_WINNER_INACTIVE_TEXT :
