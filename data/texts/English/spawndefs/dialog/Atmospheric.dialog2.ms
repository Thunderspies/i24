// SKYWAY_AE_IDEAGUY_NPC_SCRIBBLER_TEXT :
"P1055180521" "Wow, I'm really good at this stuff!  I should do it professionally!"
// SKYWAY_AE_IDEAGUY_NPC_SCRIBBLER_TEXT :
"P439119827" "This is fun!"
// SKYWAY_AE_IDEAGUY_NPC_SCRIBBLER_TEXT :
"P454181122" "I'm awesome at this!"

// SKYWAY_AE_IDEAGUY_NPC_WHATCHADOING_TEXT :
