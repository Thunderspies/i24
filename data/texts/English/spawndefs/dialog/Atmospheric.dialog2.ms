// FB_SWHW_GAUNTLET_BINOCULARS_INACTIVE_TEXT :
"P3800230467" "This ought to be good."
// FB_SWHW_GAUNTLET_BINOCULARS_INACTIVE_TEXT :
"P2065500714" "I got a boss view here."

// FB_SWHW_GAUNTLET_BOOKIE_INACTIVE_TEXT :
