// IMPERIAL_CONVERSATION_COLESTRUCK_B_INACTIVE_TEXT :
"P4225134282" "We are very lucky."
// IMPERIAL_CONVERSATION_COLESTRUCK_B_INACTIVE_TEXT :
"P2681931000" "So true."

// NOVA_MAGISTERIUM_NPC_SKETCH_INACTIVE_TEXT :
"P4252255444" "Every day is another opportunity to sketch this amazing city."
// NOVA_MAGISTERIUM_NPC_SKETCH_INACTIVE_TEXT :
