// IMPERIALCITY_ROADRUMBLE_WALKIETALKIE_INACTIVE_TEXT :
"P3265371241" "Stage 3!"

// IMPERIALCITY_ROADRUMBLE_WALKIETALKIE_ALERT_TEXT :
"P715578101" "Use full force!  All trespassers should have known better!"
// IMPERIALCITY_ROADRUMBLE_WALKIETALKIE_ALERT_TEXT :
"P4040759464" "Priority is to eliminate ALL threats in the shortest amount of time.  We'll sort it out later!"
// IMPERIALCITY_ROADRUMBLE_WALKIETALKIE_ALERT_TEXT :
"P3044607558" "Engage all participants!"

// IMPERIALCITY_RUMBLESYNDICATE_INACTIVE_TEXT :
