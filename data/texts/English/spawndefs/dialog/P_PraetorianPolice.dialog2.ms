// IMPERIALCITY_RUMBLESYNDICATE_INACTIVE_TEXT :
"P2952350448" "Take them out."
// IMPERIALCITY_RUMBLESYNDICATE_INACTIVE_TEXT :
"P3165017754" "We have authority to use full force!"

// IMPERIALCITY_RUMBLESYNDICATE_ALERT_TEXT :
