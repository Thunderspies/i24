// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P2029784365" "Are you sure this is untraceable?"
// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P1851333321" "I hope this is as good as promised."
// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P387268126" "I need reliable transactions."
// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P336547789" "Is this the best meeting place?"
// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P1330862175" "This is the last time for me."
// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P784345205" "Let me see what you have first.  I'm not paying you a red cent until I inspect the merchandise."
// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P2629974451" "Shh...keep it down.  Think I want to call attention to myself here?"
// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P1919662296" "You talk big.  I hope you can deliver."

// SHADYDEAL_BUYER_ATTACK_TEXT :
"P3065716945" "I didn't bargain for this."
// SHADYDEAL_BUYER_ATTACK_TEXT :
"P3716053312" "Nothing is worth this kind of trouble."
// SHADYDEAL_BUYER_ATTACK_TEXT :
"P490323139" "I want nothing to do with this!"
// SHADYDEAL_BUYER_ATTACK_TEXT :
"P3208369951" "Setup!"
// SHADYDEAL_BUYER_ATTACK_TEXT :
"P3554406224" "You set me up!"
// SHADYDEAL_BUYER_ATTACK_TEXT :
"P438673119" "No witnesses!"
// SHADYDEAL_BUYER_ATTACK_TEXT :
"P1529343334" "I can't afford witnesses!"

// MUGGING_MUGGER_INACTIVE_TEXT :
"P2411819071" "It's not worth your life.  Give it up."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P926389059" "I'll take that."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P86268267" "Trust me, you don't want a fight."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P3317524047" "Give me what I want and no one gets hurt.  Most likely."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P956843069" "Stop with the cowering and just give me what I want."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P1996374947" "I don't have all day.  Hand over your valuables."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P3946752405" "Possessions are fleeting.  I'll take yours."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P2961941493" "Think of it as doing your part for the Crey Corporation."

// MUGGING_MUGGER_ATTACK_TEXT :
"P3919042460" "You think you can compete with me?"
// MUGGING_MUGGER_ATTACK_TEXT :
"P3171729107" "You can't stop me."
// MUGGING_MUGGER_ATTACK_TEXT :
"P959440998" "You'll be sorry you interfered."
// MUGGING_MUGGER_ATTACK_TEXT :
"P282648732" "Get your own score!"
// MUGGING_MUGGER_ATTACK_TEXT :
"P1239868134" "Freakin' heroes!  Always sticking their noses in where they don't belong!"
// MUGGING_MUGGER_ATTACK_TEXT :
"P301154255" "This will only end badly for you, hero!"
// MUGGING_MUGGER_ATTACK_TEXT :
"P3500168556" "You can't touch me, I'm Crey!"

// MUGGING_VICTIM_INACTIVE_TEXT :
"P2386755701" "Please, just leave me alone!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P2072123886" "I just want to go home!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P3639562976" "I'm begging you, don't hurt me!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P1125577279" "You guys are nothing like the image you put on TV!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P3075329300" "You...you are corrupt!"

// MUGGING_VICTIM_THANKYOU_TEXT :
"P755344070" "You were amazing!"
// MUGGING_VICTIM_THANKYOU_TEXT :
"P117236818" "I'm honored to meet you!"
// MUGGING_VICTIM_THANKYOU_TEXT :
"P269822760" "You sure taught that guy a lesson!"
// MUGGING_VICTIM_THANKYOU_TEXT :
"P3274379717" "Thank you!  I had no idea Crey was so corrupt!"
// MUGGING_VICTIM_THANKYOU_TEXT :
"P1279684420" "I was so scared!"
// MUGGING_VICTIM_THANKYOU_TEXT :
"P206408547" "You saved me!   Thank you so much!"

// MUGGING_MUSCLE_ATTACK_TEXT :
"P67036502" "Get ready for a beating."
// MUGGING_MUSCLE_ATTACK_TEXT :
"P1385420415" "Say good-bye to your teeth."
// MUGGING_MUSCLE_ATTACK_TEXT :
