// STRIGA_TURKEYSHOOT_INACTIVE_TEXT :
"P2058312899" "These things stink!"
// STRIGA_TURKEYSHOOT_INACTIVE_TEXT :
"P564902613" "Ugh! Zombies!"
// STRIGA_TURKEYSHOOT_INACTIVE_TEXT :
"P3252273354" "Zombie duty. Disgusting."
// STRIGA_TURKEYSHOOT_INACTIVE_TEXT :
"P3026897460" "We have to beat them back from the perimeter!"
// STRIGA_TURKEYSHOOT_INACTIVE_TEXT :
"P2820771003" "Don't stop firing until they stop twitching!"

// STRIGA_TURKEYSHOOT_ATTACK_TEXT :
"P538158082" "Whoa! New target, twelve o'clock."
// STRIGA_TURKEYSHOOT_ATTACK_TEXT :
"P238094507" "Now here's a fight I can get behind."
// STRIGA_TURKEYSHOOT_ATTACK_TEXT :
"P2177559016" "Hero incoming!"
// STRIGA_TURKEYSHOOT_ATTACK_TEXT :
"P2711653598" "Let's dispose of this joker."
// STRIGA_TURKEYSHOOT_ATTACK_TEXT :
"P1650960318" "Let's write up a toe tag."
// STRIGA_TURKEYSHOOT_ATTACK_TEXT :
"P1126632748" "You're about to buy yourself a body bag."

// STRIGA_SHADYDEAL_SKYSELLER_INACTIVE_TEXT :
"P4247790844" "Don't worry. We're professionals."
// STRIGA_SHADYDEAL_SKYSELLER_INACTIVE_TEXT :
"P1571746864" "We can deliver."
// STRIGA_SHADYDEAL_SKYSELLER_INACTIVE_TEXT :
"P815333863" "Tell Sammy we'll get it done."
// STRIGA_SHADYDEAL_SKYSELLER_INACTIVE_TEXT :
"P754511780" "Calm down. We have experience in this sort of thing."

// STRIGA_SHADYDEAL_SKYSELLER_ATTACK_TEXT :
"P38422400" "Defensive maneuvers!"
// STRIGA_SHADYDEAL_SKYSELLER_ATTACK_TEXT :
"P1818317165" "Back, hero. Don't mess with the best."
// STRIGA_SHADYDEAL_SKYSELLER_ATTACK_TEXT :
"P520254696" "This ought to net a promotion."

// STRIGA_SHADYDEAL_FAMILYBUYER_INACTIVE_TEXT :
"P1396986296" "We want the Council taken out, see?"
// STRIGA_SHADYDEAL_FAMILYBUYER_INACTIVE_TEXT :
"P1556421647" "You think you can handle the job?"
// STRIGA_SHADYDEAL_FAMILYBUYER_INACTIVE_TEXT :
"P583978952" "The Council gets toasted, or we don't pay."
// STRIGA_SHADYDEAL_FAMILYBUYER_INACTIVE_TEXT :
"P729309250" "Sammy Snake needs this base eliminated."

// STRIGA_AIRSTRIP_PATROL_INACTIVE_TEXT :
"P2622484219" "Good fences make good neighbors."
// STRIGA_AIRSTRIP_PATROL_INACTIVE_TEXT :
"P1951893916" "The Council will only respect a strong presence."
// STRIGA_AIRSTRIP_PATROL_INACTIVE_TEXT :
"P430808319" "The Council needs to know this strip is ours."
// STRIGA_AIRSTRIP_PATROL_INACTIVE_TEXT :
"P3764335444" "This airstrip is critical."
// STRIGA_AIRSTRIP_PATROL_INACTIVE_TEXT :
"P3765285113" "Maintain a tight perimeter."
// STRIGA_AIRSTRIP_PATROL_INACTIVE_TEXT :
"P1951316031" "Don't let me catch you slacking off."
// STRIGA_AIRSTRIP_PATROL_INACTIVE_TEXT :
"P3815536268" "We have to show the Council we own this area."

// STRIGA_AIRSTRIP_PATROL_ATTACK_TEXT :
"P1717350197" "Protect the airstrip!"
// STRIGA_AIRSTRIP_PATROL_ATTACK_TEXT :
"P921658358" "Let's fight!"
// STRIGA_AIRSTRIP_PATROL_ATTACK_TEXT :
"P46499760" "We've got a situation here!!"

// STRIGA_SHADYDEAL_SKYSELLER_INACTIVE_TEXT :
"P1799646092" "I think we can provide what you're looking for."
// STRIGA_SHADYDEAL_SKYSELLER_INACTIVE_TEXT :
"P1105589652" "We'll do it, but you had better not welch out on the payment."
// STRIGA_SHADYDEAL_SKYSELLER_INACTIVE_TEXT :
"P937941616" "Sure. We can teach the Council a thing or two."

// STRIGA_SHADYDEAL_SKYSELLER_ATTACK_TEXT :
"P286233135" "Stop those heroes!"
// STRIGA_SHADYDEAL_SKYSELLER_ATTACK_TEXT :
"P1412026879" "Fire!"
// STRIGA_SHADYDEAL_SKYSELLER_ATTACK_TEXT :
"P2645225087" "We've been spotted!"
// STRIGA_SHADYDEAL_SKYSELLER_ATTACK_TEXT :
"P3768250182" "Attack!"

// STRIGA_SHADYDEAL_FAMILYBUYER_INACTIVE_TEXT :
"P3495049908" "Money won't be a problem."
// STRIGA_SHADYDEAL_FAMILYBUYER_INACTIVE_TEXT :
"P1345985372" "Just make sure they don't forget."
// STRIGA_SHADYDEAL_FAMILYBUYER_INACTIVE_TEXT :
"P1828186659" "I think we can do business."

// STRIGA_SKIFF_BEINGCHECKED_INACTIVE_TEXT :
"P1478164951" "Unit experiencing sub-optimal performance. Requesting assistance."
// STRIGA_SKIFF_BEINGCHECKED_INACTIVE_TEXT :
"P2668290565" "The pick-up is a little sluggish, you'll need to tune it again."
// STRIGA_SKIFF_BEINGCHECKED_INACTIVE_TEXT :
"P1742519248" "Roger.  Maintaining hold position while you run diagnostics."
// STRIGA_SKIFF_BEINGCHECKED_INACTIVE_TEXT :
"P4263835869" "Unit sustained moderate damage. Can servicing be completed in time for patrol duty?"
// STRIGA_SKIFF_BEINGCHECKED_INACTIVE_TEXT :
"P3402618411" "Can you hurry it up with the diagnostics?  I have patrols to run."

// STRIGA_SKIFF_BEINGCHECKED_ATTACK_TEXT :
"P1317346934" "Warning! Warning! Enemy forces detected!"
// STRIGA_SKIFF_BEINGCHECKED_ATTACK_TEXT :
"P2813882908" "Forget the diagnostics, we have hostiles!"
// STRIGA_SKIFF_BEINGCHECKED_ATTACK_TEXT :
"P3121883442" "Enemy in the hangar, take them out!"

// STRIGA_SKIFF_CHECKER_INACTIVE_TEXT :
"P1510423055" "This skiff sustained heavy damage."
// STRIGA_SKIFF_CHECKER_INACTIVE_TEXT :
"P4106792488" "We should get a few more cycles out of this one."
// STRIGA_SKIFF_CHECKER_INACTIVE_TEXT :
"P2871789917" "And that oughta do it."
// STRIGA_SKIFF_CHECKER_INACTIVE_TEXT :
"P3522528310" "All right. That should do the trick."

// STRIGA_SKIFF_CHECKER_ATTACK_TEXT :
"P3874858321" "Get out of here!"
// STRIGA_SKIFF_CHECKER_ATTACK_TEXT :
"P1513321141" "This is Sky Raider land!"
// STRIGA_SKIFF_CHECKER_ATTACK_TEXT :
"P481192337" "You don't belong here!"
// STRIGA_SKIFF_CHECKER_ATTACK_TEXT :
"P3259384855" "Now you'll get a taste of the Sky Raiders' strength!"

// STRIGA_SKIFF_FIX_WELDER_INACTIVE_TEXT :
"P1315744437" "Now, this is what I call a lot of damage."
// STRIGA_SKIFF_FIX_WELDER_INACTIVE_TEXT :
"P2363836944" "I'll see what I can do."
// STRIGA_SKIFF_FIX_WELDER_INACTIVE_TEXT :
"P3144896375" "This is going to take a while."
// STRIGA_SKIFF_FIX_WELDER_INACTIVE_TEXT :
"P2346731111" "It'll be done when it's done."
// STRIGA_SKIFF_FIX_WELDER_INACTIVE_TEXT :
"P3421494924" "What did you do?  Fly through a rock storm?"

// STRIGA_SKIFF_FIX_WELDER_ATTACK_TEXT :
"P396474416" "I'll take you down!"
// STRIGA_SKIFF_FIX_WELDER_ATTACK_TEXT :
"P3054943259" "You're in trouble now!"
// STRIGA_SKIFF_FIX_WELDER_ATTACK_TEXT :
"P3186272097" "You shouldn't be here."

// STRIGA_SKIFF_FIX_OBSERVER_INACTIVE_TEXT :
"P3746075928" "Command wants the repairs done fast."
// STRIGA_SKIFF_FIX_OBSERVER_INACTIVE_TEXT :
"P3189267212" "We can't afford to retire it."
// STRIGA_SKIFF_FIX_OBSERVER_INACTIVE_TEXT :
"P3314364397" "I can't go in there with excuses."
// STRIGA_SKIFF_FIX_OBSERVER_INACTIVE_TEXT :
"P126127453" "I've seen worse."
// STRIGA_SKIFF_FIX_OBSERVER_INACTIVE_TEXT :
"P74257398" "Command isn't going to be happy about this."

// STRIGA_SKIFF_FIX_OBSERVER_ATTACK_TEXT :
"P13881127" "Get that hero!"
// STRIGA_SKIFF_FIX_OBSERVER_ATTACK_TEXT :
"P3049103971" "Eliminate the hero!"
// STRIGA_SKIFF_FIX_OBSERVER_ATTACK_TEXT :
"P1029084281" "Lock and load!"

// FAULTLINE_OVERBROOKDAM_BEINGCHECKED_INACTIVE_TEXT :
"P751057544" "Could you hurry this up a bit?  I have to get back on patrol."
// FAULTLINE_OVERBROOKDAM_BEINGCHECKED_INACTIVE_TEXT :
"P3638479300" "This is taking too long.  How long does a quick diagnostic take?"
// FAULTLINE_OVERBROOKDAM_BEINGCHECKED_INACTIVE_TEXT :
"P3022249447" "Just a few bumps and scratches.  Patch me up and send me off."
// FAULTLINE_OVERBROOKDAM_BEINGCHECKED_INACTIVE_TEXT :
"P3762433002" "This dam isn't gonna patrol itself, would you hurry it up a little?"
// FAULTLINE_OVERBROOKDAM_BEINGCHECKED_INACTIVE_TEXT :
"P4116553898" "See?  Just a scratch here, bullet hole there.  I'm practically good as new.  Just send me on my way."

// FAULTLINE_OVERBROOKDAM_BEINGCHECKED_ALERT_TEXT :
"P3417620098" "Good enough to fight!"
// FAULTLINE_OVERBROOKDAM_BEINGCHECKED_ALERT_TEXT :
"P1482733202" "Get out of here!  I'll get this!"
// FAULTLINE_OVERBROOKDAM_BEINGCHECKED_ALERT_TEXT :
"P613950817" "Go!"

// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_LAPTOP_INACTIVE_TEXT :
"P1887942759" "Quiet.  Can't you see I'm working here?"
// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_LAPTOP_INACTIVE_TEXT :
"P3404963776" "The more you interrupt me, the longer this takes."
// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_LAPTOP_INACTIVE_TEXT :
"P1864397110" "Just a few...more...tests..."
// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_LAPTOP_INACTIVE_TEXT :
"P3047229109" "I can't concentrate if you keep yapping at me.  Now shush.  I have work to do here."
// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_LAPTOP_INACTIVE_TEXT :
"P3308743055" "You need to stop talking.  All these interruptions slows me down.  I simply can't input the data!"

// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_LAPTOP_ALERT_TEXT :
"P2824104315" "Aaaaagh!  Hostiles!  Do your thing!"
// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_LAPTOP_ALERT_TEXT :
"P3023161644" "We'll finish this up later!"
// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_LAPTOP_ALERT_TEXT :
"P3901762013" "Cover me!"

// FAULTLINE_OVERBROOKDAM_SKIFF_FIX_OBSERVER_INACTIVE_TEXT :
