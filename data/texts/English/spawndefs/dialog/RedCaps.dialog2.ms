// CROATOA_REDCAPS_BATTLELINE_CROUCHING_INACTIVE_TEXT :
"P1507330762" "Let's get this party started."
// CROATOA_REDCAPS_BATTLELINE_CROUCHING_INACTIVE_TEXT :
"P4115333542" "I want a fight. Now!"

// CROATOA_REDCAPS_BATTLELINE_CROUCHING_ALERTED_TEXT :
"P1135086628" "You want trouble?"
// CROATOA_REDCAPS_BATTLELINE_CROUCHING_ALERTED_TEXT :
"P2639022199" "You ready to battle?"
// CROATOA_REDCAPS_BATTLELINE_CROUCHING_ALERTED_TEXT :
"P921658358" "Let's fight!"

// CROATOA_REDCAPS_BATTLELINE_WEAPONCLASHING_INACTIVE_TEXT :
"P362561571" "Battle! Battle!"
// CROATOA_REDCAPS_BATTLELINE_WEAPONCLASHING_INACTIVE_TEXT :
"P3871246392" "Arrrggghh!"
// CROATOA_REDCAPS_BATTLELINE_WEAPONCLASHING_INACTIVE_TEXT :
"P2669942138" "Attack now!"

// CROATOA_REDCAPS_BATTLELINE_WEAPONCLASHING_ALERTED_TEXT :
"P123167550" "Get ready!"
// CROATOA_REDCAPS_BATTLELINE_WEAPONCLASHING_ALERTED_TEXT :
"P2262495005" "You going down!"
// CROATOA_REDCAPS_BATTLELINE_WEAPONCLASHING_ALERTED_TEXT :
"P828427994" "You my first victim!"

// CROATOA_FEY_TOTEMDESTROY_SLEDGEHAMMER_INACTIVE_TEXT :
"P1013371054" "I like to smash!"
// CROATOA_FEY_TOTEMDESTROY_SLEDGEHAMMER_INACTIVE_TEXT :
"P3331189228" "Cabal getting too powerful!"
// CROATOA_FEY_TOTEMDESTROY_SLEDGEHAMMER_INACTIVE_TEXT :
"P2665519361" "I rip this thing apart!"

// CROATOA_REDCAPS_BATTLELINE_TAUNTING_INACTIVE_TEXT :
"P3660843778" "Hah! No one can beat us!"
// CROATOA_REDCAPS_BATTLELINE_TAUNTING_INACTIVE_TEXT :
"P1098194548" "You will stay here and suffer!"
// CROATOA_REDCAPS_BATTLELINE_TAUNTING_INACTIVE_TEXT :
"P2027354370" "You in over you heads!"

// CROATOA_FEY_TOTEMDESTROY_SLEDGEHAMMER_ALERTED_TEXT :
"P3940990216" "You not one of us!"
// CROATOA_FEY_TOTEMDESTROY_SLEDGEHAMMER_ALERTED_TEXT :
"P16029515" "I pound you into dirt!"
// CROATOA_FEY_TOTEMDESTROY_SLEDGEHAMMER_ALERTED_TEXT :
"P3351616790" "I break your bones!"

// CROATOA_REDCAPS_BATTLELINE_TAUNTING_ALERTED_TEXT :
"P1930907522" "You want a part in this?"
// CROATOA_REDCAPS_BATTLELINE_TAUNTING_ALERTED_TEXT :
"P3189872849" "You want pain?"
// CROATOA_REDCAPS_BATTLELINE_TAUNTING_ALERTED_TEXT :
"P2178914821" "You dare interrupt?"

// CROATOA_FEY_TOTEMDESTROY_PICKAXE_INACTIVE_TEXT :
"P3567353504" "Choppy chop!"
// CROATOA_FEY_TOTEMDESTROY_PICKAXE_INACTIVE_TEXT :
"P2544713483" "Hack to pieces!"
// CROATOA_FEY_TOTEMDESTROY_PICKAXE_INACTIVE_TEXT :
"P3826572143" "Nothing but dust when I get through."

// CROATOA_FEY_TOTEMDESTROY_PICKAXE_ALERTED_TEXT :
"P782017768" "More stuff to chop!"
// CROATOA_FEY_TOTEMDESTROY_PICKAXE_ALERTED_TEXT :
"P4205687014" "You ready for trouble?"
// CROATOA_FEY_TOTEMDESTROY_PICKAXE_ALERTED_TEXT :
"P633965620" "You sure you should be here, human?"

// CROATOA_FEY_TOTEMDESTROY_PLANNING_INACTIVE_TEXT :
"P4050023778" "We take out all totems nearby."
// CROATOA_FEY_TOTEMDESTROY_PLANNING_INACTIVE_TEXT :
"P4009230522" "We break their power to pieces."
// CROATOA_FEY_TOTEMDESTROY_PLANNING_INACTIVE_TEXT :
"P305398085" "Cabal getting too strong. We must stop it."

// CROATOA_FEY_TOTEMDESTROY_PLANNING_ALERTED_TEXT :
"P210906708" "This serious!"
// CROATOA_FEY_TOTEMDESTROY_PLANNING_ALERTED_TEXT :
"P1693233389" "You with the Cabal?"
// CROATOA_FEY_TOTEMDESTROY_PLANNING_ALERTED_TEXT :
"P2826648727" "You like the Cabal? You die for them!"

// CROATOA_REDCAPS_BATTLELINE_TAUNTINGWITHBOW_INACTIVE_TEXT :
"P1945626794" "Could put this arrow right in your heart."
// CROATOA_REDCAPS_BATTLELINE_TAUNTINGWITHBOW_INACTIVE_TEXT :
"P2742330401" "Ready... aim... "
// CROATOA_REDCAPS_BATTLELINE_TAUNTINGWITHBOW_INACTIVE_TEXT :
"P2357545980" "I got you covered."

// CROATOA_REDCAPS_BATTLELINE_TAUNTINGWITHBOW_ALERTED_TEXT :
"P2282395555" "Hey! Who goes there?"
// CROATOA_REDCAPS_BATTLELINE_TAUNTINGWITHBOW_ALERTED_TEXT :
"P4262080108" "You come at a bad time, human."
// CROATOA_REDCAPS_BATTLELINE_TAUNTINGWITHBOW_ALERTED_TEXT :
"P3186272097" "You shouldn't be here."

// CROATOA_FEY_BAITAMBUSH_AFRAIDBAIT_INACTIVE_TEXT :
"P684055319" "Poor little me.  All alone."
// CROATOA_FEY_BAITAMBUSH_AFRAIDBAIT_INACTIVE_TEXT :
"P3141666077" "I wonder where everyone went?"
// CROATOA_FEY_BAITAMBUSH_AFRAIDBAIT_INACTIVE_TEXT :
"P3287360189" "I'm lonely."

// CROATOA_FEY_BAITAMBUSH_AFRAIDBAIT_ALERTED_TEXT :
"P3030847494" "Hah! Fool human!"
// CROATOA_FEY_BAITAMBUSH_AFRAIDBAIT_ALERTED_TEXT :
"P2507067667" "You think I'm alone? Think again!"
// CROATOA_FEY_BAITAMBUSH_AFRAIDBAIT_ALERTED_TEXT :
"P1385186023" "Hee hee hee!  Not alone!"

// CROATOA_FEY_BAITAMBUSH_WALKINGALONEBAIT_INACTIVE_TEXT :
"P943734344" "Hum de dum. Home I go."
// CROATOA_FEY_BAITAMBUSH_WALKINGALONEBAIT_INACTIVE_TEXT :
"P1741407774" "Things to do, people to hurt."
// CROATOA_FEY_BAITAMBUSH_WALKINGALONEBAIT_INACTIVE_TEXT :
"P3255144432" "Busy, busy, busy. Always busy in Croatoa."

// CROATOA_FEY_BAITAMBUSH_WALKINGALONEBAIT_ALERTED_TEXT :
"P3459719310" "This too easy!"
// CROATOA_FEY_BAITAMBUSH_WALKINGALONEBAIT_ALERTED_TEXT :
"P3250844164" "We have you now!"
// CROATOA_FEY_BAITAMBUSH_WALKINGALONEBAIT_ALERTED_TEXT :
"P562891822" "You sorry you try to pick on me now?"

// CROATOA_FEY_BAITAMBUSH_SURPRISEATTACK_INACTIVE_TEXT :
"P2100577531" "Nobody here but me.  Nope."
// CROATOA_FEY_BAITAMBUSH_SURPRISEATTACK_INACTIVE_TEXT :
"P3172703207" "All on my lonesome."
// CROATOA_FEY_BAITAMBUSH_SURPRISEATTACK_INACTIVE_TEXT :
"P3912410112" "Busy day for Red Caps."

// CROATOA_FEY_BAITAMBUSH_EGOTISTICALBAIT_INACTIVE_TEXT :
"P3849129531" "No one can defeat me!"
// CROATOA_FEY_BAITAMBUSH_EGOTISTICALBAIT_INACTIVE_TEXT :
"P1071969681" "I no need anyone else!"
// CROATOA_FEY_BAITAMBUSH_EGOTISTICALBAIT_INACTIVE_TEXT :
"P1227578045" "I can take on anyone alone!"

// CROATOA_FEY_BAITAMBUSH_EGOTISTICALBAIT_ALERTED_TEXT :
"P1664712348" "Yipes!"
// CROATOA_FEY_BAITAMBUSH_EGOTISTICALBAIT_ALERTED_TEXT :
"P3019461340" "We gotcha!"
// CROATOA_FEY_BAITAMBUSH_EGOTISTICALBAIT_ALERTED_TEXT :
"P866242559" "You in trouble!"
// CROATOA_FEY_BAITAMBUSH_EGOTISTICALBAIT_ALERTED_TEXT :
"P2124773987" "Heh.  Stupid ugly human."
// CROATOA_FEY_BAITAMBUSH_EGOTISTICALBAIT_ALERTED_TEXT :
"P1658475937" "Stupidhead, human."

// CROATOA_REDCAPS_OUTDOORMISSION5__NEARSIGILS_RISEFROMGROUNDAMBUSH_ALERTED_TEXT :
"P2167734685" "Got to get Daschle."

