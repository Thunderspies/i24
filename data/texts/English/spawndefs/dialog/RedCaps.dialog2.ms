// CROATOA_REDCAPS_OUTDOORMISSION7_SENTRYLOOKOUTS_ALERTED_TEXT :
"P2767570497" "Hah! Found you!"

// CROATOA_REDCAPS_OUTDOORMISSION7_TARGETPRACTICE_OBSERVING_INACTIVE_TEXT :
