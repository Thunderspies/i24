// CROATOA_OUTDOORMISSION7_FEY_PLACINGHENGE_ALERTED_TEXT :
"P2851073534" "You'll do!"

// CROATOA_REDCAPS_OUTDOORMISSION8_TARGETPRACTICE_OBSERVING_INACTIVE_TEXT :
