// HELLION_EXPLOSIVEBARREL_WHERETO_INACTIVE_TEXT :
"P540250117" "Where's this going?"
// HELLION_EXPLOSIVEBARREL_WHERETO_INACTIVE_TEXT :
"P3056060926" "Need some more?"

// HELLION_EXPLOSIVECRATE_WHERETO_INACTIVE_TEXT :
"P1876682446" "Fuel for the flame."
// HELLION_EXPLOSIVECRATE_WHERETO_INACTIVE_TEXT :
"P973948932" "Who wants some kindling?"
// HELLION_EXPLOSIVECRATE_WHERETO_INACTIVE_TEXT :
"P960719754" "High grade explosives, coming through."
// HELLION_EXPLOSIVECRATE_WHERETO_INACTIVE_TEXT :
"P2640362489" "Who's got free hands?"
// HELLION_EXPLOSIVECRATE_WHERETO_INACTIVE_TEXT :
"P1843534091" "I got the goods. Where to?"

// HELLION_CRATETOSS_INACTIVE_TEXT :
"P1641927217" "Pile it up!"
// HELLION_CRATETOSS_INACTIVE_TEXT :
"P3136140791" "More fuel!"
// HELLION_CRATETOSS_INACTIVE_TEXT :
"P4253524629" "Let's stoke those flames!"
// HELLION_CRATETOSS_INACTIVE_TEXT :
"P2248828722" "I need another crate!"
// HELLION_CRATETOSS_INACTIVE_TEXT :
"P3697271697" "Bonfire, baby!"
// HELLION_CRATETOSS_INACTIVE_TEXT :
"P181530375" "More! Gimme more!"

// ATLAS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P1700912222" "I don't know what I'm looking for.  Targets?"
// ATLAS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P4138852623" "Can't we just go burn down a building?  I don't want to stand here all day."
// ATLAS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P1867309352" "Look, there isn't one Skull here.  Let's go to Perez and beat some up."
// ATLAS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P2721786616" "My eyes are getting sore.  All this squinting is killing me.  Can we just go get something to eat?"
// ATLAS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P4127476671" "Hey, I think I see something.  Nevermind.  False alarm."
// ATLAS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P394555104" "Why are we all standing here again?"

// ATLAS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P424437241" "Oh!  The action came to us!"
// ATLAS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P3024148477" "Feel the burn, baby!"
// ATLAS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P1570114847" "Oh NOW we have some action!"
// ATLAS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P1677610823" "Time for some fun, Hellion style!"
// ATLAS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P1837872504" "And now the fun begins!"
// ATLAS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P3682662413" "I see some entertainment!  Let's do this!"

// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P1037661493" "That dress makes you look heavy!"
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P1790666371" "Let's go bust some heads."
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P2356815742" "I saw some fledgling heroes running out of City Hall.  Wanna go beat them up?"
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P3623293423" "Let's go burn something."
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P2881417164" "We're gonna be stealing your purse later!"
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P4240014895" "I got a can of spray paint with that wall's name on it."
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P412540341" "You hungry?  I could eat."
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P458165689" "Wanna break into some cars later?  I saw some sweet rides in a parking lot nearby."
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P3315029419" "Wanna go deface some property?"
// ATLAS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P2139704172" "Who are we waiting for?"

// ATLAS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P954683856" "Oh, you want some of this?"
// ATLAS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P68676044" "You think you're tough, hero?  Prove it!"
// ATLAS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P3702573062" "Weak!  Bring it, hero!"
// ATLAS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P311529348" "So weak, hero!  Let me show you how it's done!"
// ATLAS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P3302962126" "Oh I see how it is!  Let's go, hero!"

// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P1737321594" "No, all I'm saying is, I don't see why I can't have a girl AND a career."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P3281122884" "No, she broke up with me.  She said she didn't agree with my life of crime."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P465757330" "Let's go rough some people up."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P4023757821" "I'm bored."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P494952376" "I'm very bored."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P4159333576" "I thought you said some heroes would come by soon.  This is worse than watching paint peel.  Let's go to Perez."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P3550702441" "I'm so bored I can barely open my mouth to say how bored I am. I want to BREAK something."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P993471253" "Did you see the Freedom Corps wandering around?  Whatever.  I'm not scared of tights."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2103212479" "You see Vahzilok wandering around?  That's new."
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P811090933" "Hey, what's with Freedom Corps patrolling Atlas Park?"
// ATLAS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P4214148519" "All those heroes running around is putting a cramp in my business."

// ATLAS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P2401413704" "About time!"
// ATLAS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P3071355010" "I was getting age spots!"
// ATLAS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P934459396" "Let's crack some heads!"
// ATLAS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P4251391567" "The party has officially started!"
// ATLAS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P155451373" "Oh I have this well at hand.  WELL at hand."
// ATLAS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P2517862217" "Enough loitering, let's fight!"

// ATLAS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P3305164815" "I win!  You lose!  Ha ha!"
// ATLAS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P4023665119" "I could play this game all...day...long."
// ATLAS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P217212874" "I love dice!  This is so much more fun than cards."
// ATLAS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P384556152" "This is almost as fun as roughing people up."
// ATLAS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P3962493954" "This is SO much better than breaking into buildings."
// ATLAS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P4126647323" "How much am I up now?  Eleventy million?"

// ATLAS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P3065142152" "You can't play!"
// ATLAS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P3781296719" "You're not invited!"
// ATLAS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P3450201360" "Get your own dice!"
// ATLAS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P1578837037" "How convenient!  A hero shows up when I'm on a winning streak!"
// ATLAS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P495933563" "Unbelievable!  I was WINNING!"
// ATLAS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P999115579" "You couldn't go do your hero thing somewhere else?  Nooooo.  You had to ruin my winning streak instead!"

// ATLAS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P3363907831" "I'm not playing anymore.  I'm not.  This is a stupid game."
// ATLAS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P2344772340" "I hate dice."
// ATLAS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P2942617476" "I hate dice and I hate you more.  You are the WORST winner I have ever MET."
// ATLAS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P1787369749" "This is so not fun, losing over and over."
// ATLAS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P2801159143" "This is...this is worse than a root canal.  No...close, but no.  No...it's worse than that.  I really hate losing to you."

// ATLAS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P2963064312" "I just lost at dice twelves times in a row.  Guess who's got some aggression?"
// ATLAS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P2243663249" "Interruption!  About time!"
// ATLAS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P2306094656" "I'm done!  I'm smacking some heads around!"
// ATLAS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P1583121428" "Finally!  An interruption!"
// ATLAS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P1392365593" "About time!  Where's a hero when you need one, huh??  I've lost half my savings to this guy!"

// ATLAS_ALLHOODS_PATROL_INACTIVE_TEXT :
"P1231550659" "I dunno.  We'll just walk around until we see something to break."
// ATLAS_ALLHOODS_PATROL_INACTIVE_TEXT :
"P4252311164" "Oh quit whining, I'm sure we'll run into some Freedom Corps soon enough!"
// ATLAS_ALLHOODS_PATROL_INACTIVE_TEXT :
"P3845904511" "That building looks good for a breakin."
// ATLAS_ALLHOODS_PATROL_INACTIVE_TEXT :
"P3791132533" "Hey, we broke into that building last week. Remember that?  Good times."
// ATLAS_ALLHOODS_PATROL_INACTIVE_TEXT :
"P2037027764" "Hey, someone remember that building.  It needs spray paint."
// ATLAS_ALLHOODS_PATROL_INACTIVE_TEXT :
"P629087637" "Keep an eye out for Freedom Corps.  They patrol.  We patrol.  Then the smack gets smacked down but GOOD."

// ATLAS_ALLHOODS_PATROL_ALERT_TEXT :
"P4179059322" "Some excitement is coming our way."
// ATLAS_ALLHOODS_PATROL_ALERT_TEXT :
"P1550282752" "Let's have some fun, Hellion style!"
// ATLAS_ALLHOODS_PATROL_ALERT_TEXT :
"P2909575167" "Let's kick it!"
// ATLAS_ALLHOODS_PATROL_ALERT_TEXT :
"P1141667743" "Time to shine, boys!"

// ATLAS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P3322885487" "You know I'm going to get it.  Why do you hang on so tight?"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P3248881467" "This would be so much easier if you just handed it over, lady!"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P2952843237" "Don't fight it, you'll slip a disc!"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P822499636" "Why...must...we...do...this...every...time?"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P3469899493" "IF you're hanging on so tight there MUST be something good in there!"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P2691937342" "Lady, just give it!  You're making me look bad!  I should have had this purse ten minutes ago!"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P1219875871" "It's not a vintage car, it's a PURSE!  For the love of pete just hand it over already!"

// ATLAS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P1170384512" "Told you I was going to get it!"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P1412570320" "Ha ha ha ha ha ha!"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P3323410184" "Mine now, lady!"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P581341803" "Didn't I tell you I'd get it!?"
// ATLAS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P373168035" "I got it!  I got it!"

// ATLAS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P855347526" "Get a real job, you Hellion hooligan!"
// ATLAS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P3743292459" "There's nothing in it!  You're wasting your time!"
// ATLAS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P2500684657" "You're a blight on society!"
// ATLAS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P3616410374" "I'm taking martial arts lessons and one day VERY SOON you're going to get a big surprise!"
// ATLAS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P612651050" "Masher!"
// ATLAS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P3663533413" "Get your own purse!"

// ATLAS_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P1657668187" "I'm going to get some girlfriends and we're going to hunt you down!"
// ATLAS_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P1244276805" "You'll never get away with this!"
// ATLAS_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P2434473903" "I hope you get a cut on the clasp!  I hope it gets infected, too!"

// ATLAS_ALLHOODS_PURSERUN_HERO_INACTIVE_TEXT :
"P847187177" "And he thinks I didn't hear it! Can you believe it? No, no, he did it there in the restaurant. No, I'm totally serious."
// ATLAS_ALLHOODS_PURSERUN_HERO_INACTIVE_TEXT :
"P1220823747" "So, anyway, I just wish there was some way I could increase my visibility, you know? I need to get in on the whole merchandising thing."
// ATLAS_ALLHOODS_PURSERUN_HERO_INACTIVE_TEXT :
"P3728778968" "I'm thinking of changing names. I'm starting to think 'unknown' was a bad choice."
// ATLAS_ALLHOODS_PURSERUN_HERO_INACTIVE_TEXT :
"P312361467" "Hey, Roger? Can I get you to speak up? It's really loud where I am."
// ATLAS_ALLHOODS_PURSERUN_HERO_INACTIVE_TEXT :
"P3802858446" "My wife was telling me she bought this new purse the other day. When she told me the price I was like, why are purses so freaking expensive these days?"

// ATLAS_ALLHOODS_PURSERUN_HERO_FLEE_TEXT :
"P3986349113" "Well, time to get back to work. This cape isn't going to fly itself!"

// ATLAS_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P3884125614" "Come on, make it sporting at least!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P2353390410" "Too easy!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P429546228" "You're out of your league!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P1205147093" "Oh, come ON.  Is that all you got?  Go back to the Hot Zone!"

// ATLAS_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P4043928370" "More to the party!  Bring it, hero!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P346736396" "Oh, I'm shaking now, hero!  Let's go!  See what you got!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P3646657677" "Oooooooo...the big bad hero's gonna run me out of  here!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P2084353602" "I'm not scared of you!  My grandma's got more punch!"

// ATLAS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P3839578729" "You need a life, Hellion!  This one's not working for you!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P613036039" "You're going to end up in the Zig!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P1167967437" "Mend your ways before it's too late, Hellion!"

// ATLAS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_ALERT_TEXT :
"P2341507356" "Don't just stand there, hero!  Jump in!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_ALERT_TEXT :
"P3371782397" "Hero!  Get over here!"
// ATLAS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_ALERT_TEXT :
"P206195461" "Get in the fight, hero!  Don't just stand there!"

// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P1956396407" "I'm a genius.  This city is my canvas."
// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P1553496205" "I could paint all day.  I should have gone to art school."
// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P219942283" "I'm gifted.  I'm Michelangelo!"
// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P4123129701" "Rats.  I need more fuchsia."
// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P2893312596" "Looks like I'm gonna have to steal another can of spray paint soon."

// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P2120544588" "How can you interrupt the work of a genius?"
// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P1330040386" "You can't possibly appreciate the beauty of my work!"
// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P286237528" "You're not the boss of me!"
// ATLAS_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P1117953122" "You made me mess up!"

// ATLAS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P3633979599" "Yeah.  Great.  Can we pick it up a little?"
// ATLAS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P2725684134" "Van Gogh.  Let's move.  Corps are patrolling now.  Let's get out of here."
// ATLAS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P961865522" "Yeah, yeah.  A genius.  Super.  Pick up the pace."
// ATLAS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P1025195924" "I don't get it.  What is it?"
// ATLAS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P3544623062" "I can't read it.  What's a 'zotz'?"

// ATLAS_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P889390239" "I told you to hurry!"
// ATLAS_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P2895311156" "Hurry up!  I don't think they're gonna appreciate your talent!"
// ATLAS_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P3790016273" "Did I or did I not say 'hurry up'?  Did those words not leave my lips!  Now we're caught!"

// ATLAS_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P2223461719" "You're lame."
// ATLAS_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P4156189755" "Newb."
// ATLAS_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P618796632" "Hero schmero."
// ATLAS_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P3000926543" "Didn't you try and bust me for purse snatching last week?"

// ATLAS_ALLHOODS_MUGGING_MUGGER_INACTIVE_TEXT :
"P943885838" "I need your money.  NOW."
// ATLAS_ALLHOODS_MUGGING_MUGGER_INACTIVE_TEXT :
"P3304879224" "Just hand it over.  Nice and easy."
// ATLAS_ALLHOODS_MUGGING_MUGGER_INACTIVE_TEXT :
"P3625615450" "You're wasting my time.  Now hand it over."
// ATLAS_ALLHOODS_MUGGING_MUGGER_INACTIVE_TEXT :
"P688001521" "Quit your shaking and start handing over the cash."
// ATLAS_ALLHOODS_MUGGING_MUGGER_INACTIVE_TEXT :
"P1481515299" "I don't have all day.  Gimme everything you got."
// ATLAS_ALLHOODS_MUGGING_MUGGER_INACTIVE_TEXT :
"P2418896744" "The wallet.  Now.  Or there will be trouble."
// ATLAS_ALLHOODS_MUGGING_MUGGER_INACTIVE_TEXT :
"P4151543782" "Hand over your valuables and no one gets hurt."

// ATLAS_ALLHOODS_MUGGING_MUGGER_ATTACK_TEXT :
"P1293140042" "Don't run!"
// ATLAS_ALLHOODS_MUGGING_MUGGER_ATTACK_TEXT :
"P1935590720" "Oh it is ON."
// ATLAS_ALLHOODS_MUGGING_MUGGER_ATTACK_TEXT :
"P360949383" "You think you got what it takes to take ME on?"
// ATLAS_ALLHOODS_MUGGING_MUGGER_ATTACK_TEXT :
"P1828794093" "Let's do this!"
// ATLAS_ALLHOODS_MUGGING_MUGGER_ATTACK_TEXT :
"P2715639070" "This city ain't big enough for the both of us!"
// ATLAS_ALLHOODS_MUGGING_MUGGER_ATTACK_TEXT :
"P3318181035" "I'm gonna wipe the floor with you!"
// ATLAS_ALLHOODS_MUGGING_MUGGER_ATTACK_TEXT :
"P1681415234" "I'm gonna set an example of you!"

// ATLAS_ALLHOODS_MUGGING_VICTIM_INACTIVE_TEXT :
"P2951196943" "I'm not giving you anything!"
// ATLAS_ALLHOODS_MUGGING_VICTIM_INACTIVE_TEXT :
"P1396070994" "Help!  Help!  I'm being mugged!"
// ATLAS_ALLHOODS_MUGGING_VICTIM_INACTIVE_TEXT :
"P2497904066" "This city used to be so safe!  You're ruining this city!"
// ATLAS_ALLHOODS_MUGGING_VICTIM_INACTIVE_TEXT :
"P3403775563" "I hope they throw you in the Zig for this!"
// ATLAS_ALLHOODS_MUGGING_VICTIM_INACTIVE_TEXT :
"P277844148" "You'll never get away with this!  You guys never do!"

// ATLAS_ALLHOODS_MUGGING_MUSCLE_ATTACK_TEXT :
"P551674647" "Oh lookie!  The good guys have come to run us out here!"
// ATLAS_ALLHOODS_MUGGING_MUSCLE_ATTACK_TEXT :
"P4229294549" "Ohhhh!  Here comes the good guys!"
// ATLAS_ALLHOODS_MUGGING_MUSCLE_ATTACK_TEXT :
"P1015616651" "Here we go!  It's fightin' time!"

// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_INACTIVE_TEXT :
"P1238090600" "Would you quit foolin' around! Tights might be comin'."
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_INACTIVE_TEXT :
"P4186471137" "Just...let GO!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_INACTIVE_TEXT :
"P766799191" "You know how this works!  Now quit struggling!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_INACTIVE_TEXT :
"P1875397308" "Why you gotta be this way?  Just let go!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_INACTIVE_TEXT :
"P1490060253" "This would be so much easier if you'd just handed it over like I told you to!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_INACTIVE_TEXT :
"P3885378030" "Quit holding out!  You know I'll get it!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_INACTIVE_TEXT :
"P4166315759" "You're gonna get it if you don't hand it over!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_INACTIVE_TEXT :
"P610839215" "This is now mine."

// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_ATTACK_TEXT :
"P2017473000" "This is none of your business!  Beat it!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_ATTACK_TEXT :
"P411222735" "You made a mistake, hero!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_ATTACK_TEXT :
"P1891232034" "Oh you think you're gonna come take on the big bag purse snatcher?  Let's see it, wimp!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_ATTACK_TEXT :
"P3788007015" "How'd you like a knuckle sandwich?"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_ATTACK_TEXT :
"P3609176976" "Pain is a great motivator and I want you outta my face!"
// ATLAS_ALLHOODS_PURSESNATCH_MUGGER_ATTACK_TEXT :
"P2162931430" "You just messed up my action!  Big mistake!"

// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_INACTIVE_TEXT :
"P4181888856" "Where are the cops!"
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_INACTIVE_TEXT :
"P2131046002" "Don't, please."
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_INACTIVE_TEXT :
"P689451904" "Help!  I'm having my purse stolen!"
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_INACTIVE_TEXT :
"P795791475" "Paragon City used to be so safe!  You're ruining this city!"
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_INACTIVE_TEXT :
"P637532819" "Stop this!  Please!"
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_INACTIVE_TEXT :
"P28974380" "You're going to regret this!"
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_INACTIVE_TEXT :
"P1284971863" "You're making poor life choices!"

// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_THANKYOU_TEXT :
"P3650628303" "Thanks very much!  Every week someone is trying to steal my purse."
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_THANKYOU_TEXT :
"P3507387540" "Thank you!  You arrived just in time!"
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_THANKYOU_TEXT :
"P64704357" "Thank you so much!"
// ATLAS_ALLHOODS_PURSESNATCH_VICTIM_THANKYOU_TEXT :
"P2118888314" "Finally!  Someone with honor!"

// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_INACTIVE_TEXT :
"P2217892398" "The best in the city."
// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_INACTIVE_TEXT :
"P1335462574" "I have the best goods in all of Paragon City."
// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_INACTIVE_TEXT :
"P2507313569" "You need it, I got it.  Let's talk pricing."

// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_ATTACK_TEXT :
"P1128161929" "I'm just a businessman!"
// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_ATTACK_TEXT :
"P1415796670" "Sorry, store's closed!"
// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_ATTACK_TEXT :
"P1823870885" "Nothing happening here!  Mind your own business!"
// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_ATTACK_TEXT :
"P967376411" "Just trying to make a buck here!"
// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_ATTACK_TEXT :
"P4122902350" "Why you always gotta be interfering!?"
// ATLAS_ALLHOODS_SHADYDEAL_BAGMAN_ATTACK_TEXT :
"P905363467" "We'll talk later!  Call me!"

// ATLAS_ALLHOODS_SHADYDEAL_BUYER_INACTIVE_TEXT :
"P4108040737" "Hey, I want a little more."
// ATLAS_ALLHOODS_SHADYDEAL_BUYER_INACTIVE_TEXT :
"P4160407821" "This is it?"
// ATLAS_ALLHOODS_SHADYDEAL_BUYER_INACTIVE_TEXT :
"P2423771562" "I'm a little underimpressed here.  Thought you said you were the best in the city."
// ATLAS_ALLHOODS_SHADYDEAL_BUYER_INACTIVE_TEXT :
"P1640443058" "This is exactly what I need.  Let's work it out."
// ATLAS_ALLHOODS_SHADYDEAL_BUYER_INACTIVE_TEXT :
"P562819621" "Nice stuff.  Let's talk bulk."

// ATLAS_ALLHOODS_SHADYDEAL_BUYER_ATTACK_TEXT :
"P2756053309" "You interrupted a very important business deal!  Now it's going to cost you!"
// ATLAS_ALLHOODS_SHADYDEAL_BUYER_ATTACK_TEXT :
"P1199844860" "Let's turn up the heat!"
// ATLAS_ALLHOODS_SHADYDEAL_BUYER_ATTACK_TEXT :
"P2333545416" "We're going to have more than just words, you and me."
// ATLAS_ALLHOODS_SHADYDEAL_BUYER_ATTACK_TEXT :
"P212338541" "This just became a very painful situation for you, hero!"

// ATLAS_NAMED_INACTIVE_TEXT :
"P450749650" "Who's got the matches?"
// ATLAS_NAMED_INACTIVE_TEXT :
"P2440149846" "I'm itchin' for a fight."
// ATLAS_NAMED_INACTIVE_TEXT :
"P2811973642" "Man, this place needs to burn!"
// ATLAS_NAMED_INACTIVE_TEXT :
"P3896416632" "Is it just me or would this building look great on fire?"
// ATLAS_NAMED_INACTIVE_TEXT :
"P561851424" "Earn and burn, boys."
// ATLAS_NAMED_INACTIVE_TEXT :
"P3365050970" "It's not hot enough. Somebody get me a match."
// ATLAS_NAMED_INACTIVE_TEXT :
"P3761926208" "You boys are slackin'! Time to kick it up a notch."
// ATLAS_NAMED_INACTIVE_TEXT :
"P1396080004" "All I want to do is take your money."
// ATLAS_NAMED_INACTIVE_TEXT :
"P4271385989" "We got this block on lock down. You see any costumes, break your knuckles on 'em."

// ATLAS_NAMED_ALERT_TEXT :
"P1738979994" "Oh this is going to be fun."
// ATLAS_NAMED_ALERT_TEXT :
"P2763643622" "Got a light?"
// ATLAS_NAMED_ALERT_TEXT :
"P2662450846" "Don't look now but I'm adding assault to my rap sheet."
// ATLAS_NAMED_ALERT_TEXT :
"P2791546548" "Right on time. Let's roll."
// ATLAS_NAMED_ALERT_TEXT :
"P3923331111" "I've been lookin' forward to breakin' a face all day."
// ATLAS_NAMED_ALERT_TEXT :
"P280190250" "You're goin' down."
// ATLAS_NAMED_ALERT_TEXT :
"P4063788147" "Time to turn up the heat!"
// ATLAS_NAMED_ALERT_TEXT :
"P599411315" "Time to die, hero!"
// ATLAS_NAMED_ALERT_TEXT :
"P1703144888" "Oh look boys, it's a noob."
// ATLAS_NAMED_ALERT_TEXT :
"P1937019793" "You're gonna learn a hard lesson."
// ATLAS_NAMED_ALERT_TEXT :
"P1944349938" "I'm gonna punch that costume right off you!"

// GALAXY_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P1500041390" "Looks like it could be a good score.  We definitely gotta come back here later."
// GALAXY_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P2433746775" "I see a LOT of prospects in there.  A lot of 'em."
// GALAXY_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P2132891584" "Oh yeah.  Jackpot."
// GALAXY_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P3497526687" "Oh this place looks very promising!"
// GALAXY_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P3591387425" "My eyes hurt."
// GALAXY_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P1919620570" "When are we going to actually do something?  Standing here is great and all, but..."

// GALAXY_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P1172010799" "I wasn't doing anything!"
// GALAXY_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P673943543" "Want some trouble?"
// GALAXY_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P3707090384" "Oh look, more heroes of Galaxy City.  Sucker!"
// GALAXY_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P2944356719" "Back off, this is my score!"
// GALAXY_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P339232966" "You're lame!"
// GALAXY_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P2937384085" "And the fun has come to us!"

// GALAXY_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P1558714477" "Lame."
// GALAXY_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P510632644" "I don't like these people.  Let's hassle them."
// GALAXY_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P2264196908" "I don't like him.  Or her.  Or that one over there."
// GALAXY_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P1660041357" "I'm feeling a lot of rage right now.  Let's put it to good use and break something."
// GALAXY_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P2449350074" "Lady, I'm totally going to steal your purse later.  Count on it!"
// GALAXY_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P3034970142" "Burritos or burgers?  What do you guys feel like?"

// GALAXY_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P1257413049" "Time for fun!"
// GALAXY_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P4057130042" "Hey cool!  The party came to us!"
// GALAXY_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P2134770383" "Let's put ourselves on the evening news!"
// GALAXY_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P2362662822" "Ain't we having some fun now!"
// GALAXY_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P485708666" "You're in for it now!"

// GALAXY_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2733302707" "I think I'm just gonna tag a few buildings and then go take in a movie."
// GALAXY_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P640401376" "What's playing at the theater?  No, not to burn.  To watch.  I'm feeling like popcorn.  You?"
// GALAXY_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P1689879176" "I love Galaxy City.  Hey, wanna get some Vahzilok to chase us around later?  Maybe we can get one of those bomb guys to blow himself up near a building!"
// GALAXY_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2345002910" "I feel like we've been loitering here for hours.  What time is it?"

// GALAXY_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P4067448858" "You want trouble?  Oh, you got trouble, pal!  Galaxy City is our turf!"
// GALAXY_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P1641746390" "Private conversation and you just busted in on it!"
// GALAXY_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P3673297711" "Hellions rule Galaxy City, baby!"

// GALAXY_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P1772712965" "Now you owe me MORE influence!"
// GALAXY_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P3002537304" "You owe me so much influence it's not even funny."
// GALAXY_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P2193384108" "If I didn't know better, I'D say I was cheating!  How can I possibly WIN this much??"
// GALAXY_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P604734648" "I love love LOVE this game!"

// GALAXY_GENERIC_DICE_WINNER_ALERT_TEXT :
"P1679308718" "You're not invited to play!"
// GALAXY_GENERIC_DICE_WINNER_ALERT_TEXT :
"P4175433846" "Beat it!"

// GALAXY_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P940297286" "In case you missed it, I'm not having fun anymore."
// GALAXY_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P748484084" "That's it.  Twenty more games and I'm done.  This is ridiculous."
// GALAXY_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P897819354" "I hate dice.  Let's play three card monty."

// GALAXY_GENERIC_DICE_LOSER_ALERT_TEXT :
"P2118173992" "Finally!  An end to my torture and the beginning of yours!"
// GALAXY_GENERIC_DICE_LOSER_ALERT_TEXT :
"P661122305" "You are a perfect target for my disappointment!"
// GALAXY_GENERIC_DICE_LOSER_ALERT_TEXT :
"P949036443" "Ooo!  Can't play!  Must beat up lame hero!  Sorry!"

// GALAXY_ALLHOODS_PATROL_INACTIVE_TEXT :
"P3220785732" "We stick together and if anything goes down...fight your way out."
// GALAXY_ALLHOODS_PATROL_INACTIVE_TEXT :
"P1895521445" "They see us walking the streets, they'll know that we own Galaxy City."
// GALAXY_ALLHOODS_PATROL_INACTIVE_TEXT :
"P2187713995" "I love walking in groups.  See how those people run?"
// GALAXY_ALLHOODS_PATROL_INACTIVE_TEXT :
"P3454214083" "Oh man, did you see the way that guy just ran away?  CLASSIC!  I didn't know people could even RUN that way!"

// GALAXY_ALLHOODS_PATROL_ALERT_TEXT :
"P425463862" "Detour!"
// GALAXY_ALLHOODS_PATROL_ALERT_TEXT :
"P1950732017" "Sidetracked!"
// GALAXY_ALLHOODS_PATROL_ALERT_TEXT :
"P1048991527" "Pit stop!"

// GALAXY_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P1614001898" "Believe me, lady.  This time I'm gettin' it."
// GALAXY_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P1504788200" "I mean it.  I'm gettin' it this time!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P3805788174" "Be prepared for the loss of your purse!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P2237935133" "This is gonna be MINE in a few seconds, lady!  Deal with it!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P3531518621" "Stop pulling so hard and just give it!"

// GALAXY_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P2914279044" "You ain't catchin' me, hero!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P2622684483" "Oh I don't think so, hero!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P1483936535" "Ohhhh no you don't!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P2844904093" "Ha!  I got it!   I got it!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P512406979" "Lady, this purse is MINE now!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P3819976473" "Ha ha ha!  My purse now, lady!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P161269172" "I told you I'd get it!"
// GALAXY_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P4285085439" "Mine mine mine!"

// GALAXY_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P1641103398" "For the love of PETE, would SOMEONE help me!?  This is the fourth time this week my purse has been stolen!"
// GALAXY_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P1989523828" "Mugger!  Mugger!  Oh fine.  Fire!  Fire!"
// GALAXY_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P747366948" "Help!  Help!  My purse is being stolen...again!"

// GALAXY_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P564233437" "I'm going to the police department right now to report this!  Thanks!"
// GALAXY_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P3297182448" "I'm off to report this!  Again!"
// GALAXY_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P3010679004" "Thanks!  I'm going to go report this crime!"
// GALAXY_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P1741104654" "Galaxy City feels just a little bit safer with you here, hero!"

// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P795736719" "You're going to BURN, Corps!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P933315990" "Galaxy City ain't big enough for the both of us!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P2647284646" "That all you got!?"
// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P3295615617" "You're no match for Hellions, Corps!  Galaxy City is OURS!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P1802005513" "You think you can just waltz in here and take over?  Not gonna happen!"

// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P2747992137" "Join the fray, hero!  We'll take you down, too!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P3814164" "Show some backbone, hero!  Jump in if you're not scaaaaaaaaaaaaaared!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P3292194428" "Double your fun!  Join in, hero!  You got no chance!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P3849082007" "Oh look.  More to the party!"

// GALAXY_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P803926850" "Your presence is a blight on the good name of Galaxy City!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P665780669" "You are no match for Freedom Corps, Hellion!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P3223342290" "Let's clean this mess up, Corps!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P3268281289" "Back to your hovel, Hellions!"

// GALAXY_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_ALERT_TEXT :
"P1174692279" "Hero!  Get over here and help!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_ALERT_TEXT :
"P2593892404" "Don't just walk on by!  Get in and fight!"
// GALAXY_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_ALERT_TEXT :
"P310685267" "Move it, hero!  Get over here!"

// GALAXY_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P3885462302" "I'm...the best artist in all of Galaxy City."
// GALAXY_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P1563291581" "Sigh.  I am brilliant."
// GALAXY_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P3285522484" "I...can't breathe...I'm too good at this."
// GALAXY_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P1099595190" "It warms my heart to see my own work in action."

// GALAXY_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P452015557" "How dare you interrupt a genius!"
// GALAXY_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P3713315118" "You broke my concentration!"
// GALAXY_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P1154006297" "Aaagh!  I've been interrupted at the most important part!"
// GALAXY_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P495252037" "Great.  You made me flub it!"

// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P945576916" "Just looks like squiggly lines to me, man."
// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P2364583071" "Ok ok it's art, but does it have to take so long?"
// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P2741192101" "I don't get it."
// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P3391929620" "Is this expressionistic?  I'm not seeing uhm...anything that makes sense to me yet."
// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P4271858397" "I guess I truly don't understand the genius of your work.  It just looks like squiggly lines to me."

// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P4282125324" "I TOLD you to hurry it up."
// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P3830441741" "Great.  NOW we have company.  Nice work, Salvador!"
// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P3455724622" "Great.  Now we're busted.  Great job, Frazetta!"
// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P242125836" "I told you to move faster.  Now we're busted, Royo!"
// GALAXY_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P3897923180" "Pssst.  Company."

// GALAXY_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P102672170" "Welcome to Galaxy City.  I'll be harassing you today."
// GALAXY_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P2790567539" "Welcome to a whole lot of pain, pal."
// GALAXY_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P4038864579" "It's your lucky day.  You're gonna get beat up by me."
// GALAXY_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P3843762452" "Lame hero!"
// GALAXY_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P884151742" "Guess who just saw you, hero?"

// HOLLOWS_ALLHOODS_DOORRUN_ALERT_TEXT :
"P3476646743" "Whew that was close! Whoa!"
// HOLLOWS_ALLHOODS_DOORRUN_ALERT_TEXT :
"P482889900" "Out of the frying pan..."
// HOLLOWS_ALLHOODS_DOORRUN_ALERT_TEXT :
"P1249499981" "Man, I thought we were gonna get caugh-  <em>Hey!"

// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P547915635" "I dunno, I can't see much in there."
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P241671743" "Looks okay to me."
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P4070184700" "What am I looking for again?"
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P1414726604" "Does a metronome count as 'phat loot'?"
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P1996874841" "I see stuff that'll burn kinda nice.  <em>Could that be considered valuable?"
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P2223149015" "This all looks like junk to me.  About the only thing it'd be good for is setting on fire. <em>Wait.  I like that idea."
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P4160228964" "Stuff and more stuff.  Not great stuff.  But stuff."
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P408916982" "Why am I looking through the window?  Isn't the door open?"
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P2973740055" "We were just in here last week.  I know what's in here."
// HOLLOWS_ALLHOODS_GUARD_PEER_INACTIVE_TEXT :
"P299440106" "Oh, you think you can do a better job?  You come over here and look, then."

// HOLLOWS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P3663052253" "Oops!  The jig is up!  Cover all tracks!"
// HOLLOWS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P3745097553" "What?!  He lost his keys!"
// HOLLOWS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P3523026840" "We called dibs on this place!"
// HOLLOWS_ALLHOODS_GUARD_PEER_ALERT_TEXT :
"P3788501687" "You can't camp this building!  You don't own it, you know!"

// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P475162453" "Well, it's like I told her, 'Honey, spandex is a privilege, not a right.'  And that's when she hit me."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P1256225011" "Well...some days I just want to read a book, you know?  Ponder the universe."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P1424224591" "What?  That's too deep for me.  Let's torch something."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P3341140778" "Hey, what say after we finish up with our mayhem here, we head back over to Atlas Park and get some pizza?"
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P3178668857" "Pie or cake?  Pie.  Definitely.  No question."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P240684522" "Why did we come here, anyway?  Have you SEEN that Gulch?  That's a deathtrap."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P1161836908" "I'll tell you why we shouldn't go willy nilly storming the Police barricades.  We could get caught.  We could get wounded. <em>Let the Trolls do it.  They're dumb."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P1457703451" "Did you see the Trolls made their way into Grendel's Gulch?  You gotta be as dumb as a box of hair to go down there. <em>Wait.  I guess that makes sense, then."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P3189962744" "He sent the jackhammer right through his foot!  And kept going!  Man, those Trolls are DUMB!  Ha ha ha ha!"
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P559910598" "Well, I'm just saying, we fight great and stuff.  But how can we really make a statement?  <em>Flamethrowers."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P2598253948" "I don't get it.  The Skulls have those girls hanging around them.  We're way more fierce than they are."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P2212082354" "What have they got that we don't?  I don't want to go all the way to Port Oakes to find a decent girlfriend."
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_INACTIVE_TEXT :
"P495244647" "The Paragon City girls have no taste.  Skulls?  Please.<em>Ew.  I just threw up a bit in my mouth."

// HOLLOWS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P2989269104" "Suit up!"
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P2805600205" "Time to get to work!"
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P3178375819" "Here we go!"
// HOLLOWS_ALLHOODS_LEDGE_HECKLER_ALERT_TEXT :
"P3278569211" "We'll talk about this later!"

// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P3189623097" "Well, you have to account for that when the market takes a downturn.  You can't be unprepared."
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2254873715" "No.  That's not what I said.  What did you think I said?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P1224177029" "Peanut butter and jelly.  What sandwich did you bring?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P612163964" "Peanut butter and honey.  What sandwich did you bring?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2118215820" "Peanut butter and banana.  What sandwich did you bring?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2717760027" "She broke up with you?  Again?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2679986185" "You broke up with her?  Again?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P1430261720" "Seriously.  She said that.  What do you think that means?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P4177769651" "I think I like Perez Park  better.  Those rock things creep me out."
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2854473393" "Hey, what have you heard about those Legacy Chain  guys poking around Eastgate?  Bad news?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P1670963836" "Is it just me or are there less purses to steal here?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P3443777424" "I think we need to upgrade our game.  What do you think of flamethrowers?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P430377891" "I don't get why those Skulls punks get all the girls here.  We have a much better platform."
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2199769249" "No, I didn't call you stupid.  I said your comment was an oxymoron.   It's a rhetorical figure in which incongruous or contradictory terms are put together.  Am I the only one who reads the books we swipe around here?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P4124704837" "You're okay awesome.  But I'm plenty awesome."
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P1878423935" "No.  I'm more awesome."
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P1649352655" "No, she didn't say that.  What makes you think she said that? <em> Did she say something?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2518939159" "You know what I utterly hate about this place?  No moving cars.  How am I supposed to throw a rock at a car when there are no moving cars?"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P2034539524" "You know what we should do?  We should go back to Kings Row or Atlas Park or whatever and grab a bunch of people, drag them back here, and then just make them walk around. <em>Why?  So we can rob them, of course.  Duh!"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P1076083772" "Yeah?  How'd you like a shut up sandwich? <em>With an extra helping of can it, jerkface!"
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P3023771028" "I feel like a falafel."
// HOLLOWS_GENERIC_LOITER_TALKER_INACTIVE_TEXT :
"P3205242003" "Sometimes I feel like giving it up.  And then I realize how much legit work pays.<em>Pathetic!"

// HOLLOWS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P663947471" "Let's go down in flames!"
// HOLLOWS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P1090956434" "I feel some hero harassment coming on!"
// HOLLOWS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P769143140" "Suit up!  What?  Oh!  Well, just fight then!"

// HOLLOWS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P223039111" "You know, I never get tired of playing this game!"
// HOLLOWS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P2448865357" "This is MUCH better than darts!  You always won at those!"
// HOLLOWS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P4278104246" "Oh my gosh, I wish again!  Your car stereo is MINE!"
// HOLLOWS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P4104205372" "Really?  I win?  Again?  Ha ha ha ha!  I love this!"
// HOLLOWS_GENERIC_DICE_WINNER_INACTIVE_TEXT :
"P407259733" "This is like taking candy from a baby!"

// HOLLOWS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P4288897092" "Man, you ruined my winning streak!"
// HOLLOWS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P3828087034" "Thanks a lot, chump!  Broke my streak!"
// HOLLOWS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P69180640" "You know that's totally rude, man!"
// HOLLOWS_GENERIC_DICE_WINNER_ALERT_TEXT :
"P4144814829" "You stink!  I was winning!"

// HOLLOWS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P2615248937" "It is statistically impossible that you could win this many times in a row!  Let me see those dice!"
// HOLLOWS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P1449050772" "One more time.  You can't be this good."
// HOLLOWS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P3289898547" "Whatever. Shut up.  Just throw the dice.  I'll throw in my car stereo."
// HOLLOWS_GENERIC_DICE_LOSER_INACTIVE_TEXT :
"P1832923116" "I hate playing this game with you."

// HOLLOWS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P2163967484" "Finally!"
// HOLLOWS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P1765295365" "What took you so long, hero!?"
// HOLLOWS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P2810214369" "Took your sweet time!"
// HOLLOWS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P539805371" "Distraction!"
// HOLLOWS_GENERIC_DICE_LOSER_ALERT_TEXT :
"P3069741686" "New rules!  If we're interrupted, all tallied winnings reset!  I owe you nothing!  Thanks, hero!  Now let's rock!"

// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P2742907794" "Look!  It's my girlfriend's birthday!  I can't go to her with some Prada knockoff!  Just give it!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P296928082" "Look!  It's my sister's birthday!  I can't go to her with some Coach knockoff!  Just give it!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P1664778677" "Look!  You probably only have a pack of gum and a lame novel in there anyway!  Why you gotta fight so hard?!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P4135226845" "You know the rules!  I'm bigger and stronger!  So just give up already!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_INACTIVE_TEXT :
"P490977813" "It's NOT your purse!  It's my girlfriend's purse and you ripped it off so GIVE IT BACK!!!!"

// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P2980108093" "Ha ha ha ha ha ha ha ha!  I got it!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P3249332910" "It's mine!  All mine!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P1386362777" "Whee!  This is so much better than ripping off kitchen appliances!  My back thanks me!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P1854546358" "I TOLD you I'd get it, lady!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P1022423686" "Ha ha ha ha ha ha ha ha ha!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P3577603834" "Mine!  All mine!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P3563612078" "Whee!  This is fun!"
// HOLLOWS_ALLHOODS_PURSERUN_MUGGER_FLEE_TEXT :
"P3983426343" "Whew!  What a workout!  Thanks, lady!"

// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P176965614" "You're just going to throw it in a dumpster!  Why must you take the purse, too?  I just got it!"
// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P1979429145" "Are you kidding me with this?  I just replaced the last one you took!  How many female relatives do you HAVE?!"
// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P3058093798" "That's MINE!  Get your own!"
// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_INACTIVE_TEXT :
"P3965801322" "Let go, you lazy person!  Get a job and buy your own!"

// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P3992044166" "I should have stayed in Atlas Park!"
// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P2178079832" "I should have stayed in King's Row!"
// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P4102666647" "Where were YOU five minutes ago when he was ripping my arms out of my sockets?  Huh?"
// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P2423346457" "I know!  I know!  File a report.  I'm going!"
// HOLLOWS_ALLHOODS_PURSERUN_VICTIM_FLEE_TEXT :
"P2784248051" "I could have used your help a few minutes ago, when he pilfered my Juicy Fruit!"

// HOLLOWS_ALLHOODS_PYRO_CHEER_INACTIVE_TEXT :
"P4122768715" "Now that is some fine flame!"
// HOLLOWS_ALLHOODS_PYRO_CHEER_INACTIVE_TEXT :
"P1329147186" "Genius.  True genius!"
// HOLLOWS_ALLHOODS_PYRO_CHEER_INACTIVE_TEXT :
"P1435578382" "It's a beautiful thing."
// HOLLOWS_ALLHOODS_PYRO_CHEER_INACTIVE_TEXT :
"P754707480" "Burn baby burn!  Disco inferno!"
// HOLLOWS_ALLHOODS_PYRO_CHEER_INACTIVE_TEXT :
"P2421708098" "Beautiful."

// HOLLOWS_ALLHOODS_RANGEDRUMBLE_SKULLS_INACTIVE_TEXT :
"P356570291" "That's all you got!  Seriously??"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_SKULLS_INACTIVE_TEXT :
"P3235398747" "Poser!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_SKULLS_INACTIVE_TEXT :
"P1676068433" "Your costume stinks!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_SKULLS_INACTIVE_TEXT :
"P999782805" "You shouldn't have messed with my girlfriend, poser!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_SKULLS_INACTIVE_TEXT :
"P572867875" "You had to follow us from Perez Park?  This is our turf!  We're movin' in!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_SKULLS_INACTIVE_TEXT :
"P3434176925" "Barely scratched me, punk!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_SKULLS_INACTIVE_TEXT :
"P534025918" "Bring it!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_SKULLS_INACTIVE_TEXT :
"P1586613500" "Go back to Atlas Park! This place is too much for you!"

// HOLLOWS_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P871666487" "You got nothing!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P2391793634" "We can take you any day, any time, anywhere!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P1283987866" "Go back to Perez Park!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_HELLIONS_INACTIVE_TEXT :
"P1222269081" "Go catch a meteor in Galaxy City!"

// HOLLOWS_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P1656255666" "More the merrier, I say!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P2446936777" "Bring it on!  I'm just getting warmed up!  <em>Ha!  See how I did that?  Warmed up?  I didn't even plan that!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_HELLIONS_ALERT_TEXT :
"P4223998237" "Oh I'm shaking now!  NOT!"

// HOLLOWS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P1434252409" "Give up!  This will go much easier on you!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P1478895121" "You don't know what you're doing!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P833384640" "You are breaking the law!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_INACTIVE_TEXT :
"P1074268011" "You need to stop this! <em> Now!"

// HOLLOWS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_ALERT_TEXT :
"P810813101" "Give us a hand, hero!"
// HOLLOWS_ALLHOODS_RANGEDRUMBLE_FREEDOMCORPS_ALERT_TEXT :
"P2148442997" "Hero!  Don't just stand there!  Get over here!"

// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P4273971547" "You know, I don't even know where my brilliance comes from.  It just does."
// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P494853372" "I'm a genius.  I just am."
// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P2581659529" "I considered taking classes at the art academy. <em> You know, if the whole hooligan thing doesn't work out."
// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P4165255928" "I work as a graphic designer in my free time.  Of course it's good."
// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P3623877526" "Hm....a little more...over here.  And, perfect.  Just perfect.  Wait...over here, too."
// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P2153956161" "I'm better than that Picasso guy.  His Citrine Chapel has nothing on this."
// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_INACTIVE_TEXT :
"P2644197162" "I did NOT spell it wrong."

// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P806927010" "I wasn't done!"
// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P3454917550" "Great!  Just great!  I've lost my groove!"
// HOLLOWS_ALLHOODS_SPRAYPAINT_PAINTER_ALERT_TEXT :
"P3864681808" "What is that about?  I was busy!"

// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P1493005249" "You definitely have your own style.  Can you hurry it up a bit?"
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P4154819423" "Yes, I know.  Don't rush an artist.  Hurry up."
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P347939434" "Uh huh."
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P2196743234" "Hm..."
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P39888779" "Mmmm hm."
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P3457085073" "Whatever you say, man."
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P3471282491" "Is that right?"
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_INACTIVE_TEXT :
"P61185856" "You think?"

// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P2204923108" "Hey!"
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P3404435140" "You!"
// HOLLOWS_ALLHOODS_SPRAYPAINT_OBSERVER_ALERT_TEXT :
"P1268625828" "Are you kidding me?"

// HOLLOWS_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P3813483978" "Well your day just got worse."
// HOLLOWS_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P4118721055" "Hey, so how do you think this is going to go down?  Let me show you."
// HOLLOWS_ALLHOODS_WALL_LEAN_ALERT_TEXT :
"P876400594" "You're looking overloaded.  Let me relieve you of your wallet. <em>Oh, it's you."

