// SACRIFICE_SACRIFICER_INACTIVE_TEXT :
"P1039474893" "Lughebu! Let this soul satiate your hunger!"
// SACRIFICE_SACRIFICER_INACTIVE_TEXT :
"P1868576920" "M'Teru! We offer you the soul for your hunt!"
// SACRIFICE_SACRIFICER_INACTIVE_TEXT :
"P3302129021" "Rambetu! Receive this soul sacrifice!"
// SACRIFICE_SACRIFICER_INACTIVE_TEXT :
"P1083162667" "Ullutay! I send you a soul to toy with!"
// SACRIFICE_SACRIFICER_INACTIVE_TEXT :
"P1258971377" "Tomdala! I send you a soul to torment!"

// DARKASTORIA_SUCCESSFUL_SUMMONING_INCANTATION_INACTIVE_TEXT :
"P281598636" "It has crossed over!"
// DARKASTORIA_SUCCESSFUL_SUMMONING_INCANTATION_INACTIVE_TEXT :
"P843624825" "Our call is answered."
// DARKASTORIA_SUCCESSFUL_SUMMONING_INCANTATION_INACTIVE_TEXT :
"P4262559717" "It has crossed the bridge of worlds!"
// DARKASTORIA_SUCCESSFUL_SUMMONING_INCANTATION_INACTIVE_TEXT :
"P2609443331" "The time has come!  Success!"
// DARKASTORIA_SUCCESSFUL_SUMMONING_INCANTATION_INACTIVE_TEXT :
"P1127531946" "At last!  It has crossed over!"
// DARKASTORIA_SUCCESSFUL_SUMMONING_INCANTATION_INACTIVE_TEXT :
"P667879972" "Excellent.  We have been rewarded.  Our call has been answered!"

// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P910791710" "Moldering flesh!"
// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P4151885690" "Lughebu hungers for this body!"
// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P2081225007" "Skin! Meat! Disease!"
// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P2954567369" "Sweet rot!"
// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P473407498" "This one...this one will do.  Dig!  Dig!"
// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P4283582474" "Just a few more inches!  Dig!"
// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P3486090066" "So close!  Dig!"
// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P2028910437" "This body will suffice!"
// STRIGA_GRAVEDIGGER_INACTIVE_TEXT :
"P1054295193" "The master will be pleased with this one."

// STRIGA_GRAVEDIGGER_ATTACK_TEXT :
"P850513749" "For Lughebu!"
// STRIGA_GRAVEDIGGER_ATTACK_TEXT :
"P10813362" "Live meat!"
// STRIGA_GRAVEDIGGER_ATTACK_TEXT :
"P1934805100" "Hunger and pain..."
// STRIGA_GRAVEDIGGER_ATTACK_TEXT :
"P3067493240" "Die for M'Teru!"
// STRIGA_GRAVEDIGGER_ATTACK_TEXT :
"P3845771292" "Fresh!  Fresh!"

// STRIGA_GRAVEDIGGER_OBSERVER_INACTIVE_TEXT :
"P3808734669" "I can smell it."
// STRIGA_GRAVEDIGGER_OBSERVER_INACTIVE_TEXT :
"P3696665650" "Dig! Dig!"
// STRIGA_GRAVEDIGGER_OBSERVER_INACTIVE_TEXT :
"P2573044804" "This one died in pain."
// STRIGA_GRAVEDIGGER_OBSERVER_INACTIVE_TEXT :
"P1989866327" "Close.  Very close."
// STRIGA_GRAVEDIGGER_OBSERVER_INACTIVE_TEXT :
"P3943404033" "You are close now.  I can smell death rising from the soil."
// STRIGA_GRAVEDIGGER_OBSERVER_INACTIVE_TEXT :
"P3290942634" "Ah, the soil breathes death.  Close now."
// STRIGA_GRAVEDIGGER_OBSERVER_INACTIVE_TEXT :
"P793764285" "The scent of death bleeds through this soil.  Perfect."

// STRIGA_GRAVEDIGGER_OBSERVER_ATTACK_TEXT :
"P3328078398" "You tresspass!"
// STRIGA_GRAVEDIGGER_OBSERVER_ATTACK_TEXT :
"P651652965" "Die!"
// STRIGA_GRAVEDIGGER_OBSERVER_ATTACK_TEXT :
"P1825467668" "Bones and flesh..."
// STRIGA_GRAVEDIGGER_OBSERVER_ATTACK_TEXT :
"P726815484" "Opportunity..."
// STRIGA_GRAVEDIGGER_OBSERVER_ATTACK_TEXT :
"P78475034" "Ripe for the picking."

// STRIGA_SWAMP_INACTIVE_TEXT :
"P4261068926" "Lughebu drinks the island's suffering!"
// STRIGA_SWAMP_INACTIVE_TEXT :
"P2047640803" "The humans' cruelty feeds our masters."
// STRIGA_SWAMP_INACTIVE_TEXT :
"P143215320" "Pain drifts on the breeze."
// STRIGA_SWAMP_INACTIVE_TEXT :
"P920933002" "Death and sacrifice."
// STRIGA_SWAMP_INACTIVE_TEXT :
"P3381619025" "Pain nourishes our masters."
// STRIGA_SWAMP_INACTIVE_TEXT :
"P1159037238" "Frenzied suffering!"

// STRIGA_SWAMP_ATTACK_TEXT :
"P4241454791" "I hunger for your bones!"
// STRIGA_SWAMP_ATTACK_TEXT :
"P746691329" "Suffer and die!"
// STRIGA_SWAMP_ATTACK_TEXT :
"P1184506686" "Rot in the swamp!"
// STRIGA_SWAMP_ATTACK_TEXT :
"P2391532942" "Anguish!"
// STRIGA_SWAMP_ATTACK_TEXT :
"P1205531075" "Your death now!"

// STRIGA_SWAMPUNDER_ATTACK_ALERTED_TEXT :
"P1721836480" "Fear Lughebu!"
// STRIGA_SWAMPUNDER_ATTACK_ALERTED_TEXT :
"P8001888" "Carve you to bits!"
// STRIGA_SWAMPUNDER_ATTACK_ALERTED_TEXT :
"P2645554623" "Exquisite flesh!"
// STRIGA_SWAMPUNDER_ATTACK_ALERTED_TEXT :
"P2562813183" "Rise up!  Feed the hunger!"

// STRIGA_LOITER_ATTACK_TEXT :
"P1741233543" "I smell your fear!"
// STRIGA_LOITER_ATTACK_TEXT :
"P3197980277" "Lughebu calls you to our ranks!"
// STRIGA_LOITER_ATTACK_TEXT :
"P400042398" "Your suffering will feed my master."
// STRIGA_LOITER_ATTACK_TEXT :
"P2377780840" "Pain!"
// STRIGA_LOITER_ATTACK_TEXT :
"P3223348900" "Misery!"

// BANISHED_PANTHEON_ADAMASTOR_ATTACK_TEXT :
"P39643123" "Raaaagh! I shall destroy this mortal world!"
// BANISHED_PANTHEON_ADAMASTOR_ATTACK_TEXT :
"P1971550216" "I have awakened!"
// BANISHED_PANTHEON_ADAMASTOR_ATTACK_TEXT :
"P2104233296" "Bow to your new master!"

// BANISHED_PANTHEON_ADAMASTOR_ZOMBIES_ATTACK_TEXT :
"P2357434115" "TODO: Add Text"



// DARKASTORIA_BEATUP_REGULAR_INACTIVE_TEXT :
"P4078330704" "Pain has made you ripe, tender for consumption!"
// DARKASTORIA_BEATUP_REGULAR_INACTIVE_TEXT :
"P2099964155" "This meat sack could never have saved you, fool!"
// DARKASTORIA_BEATUP_REGULAR_INACTIVE_TEXT :
"P2196307726" "Crack and bleed, every ewer smashed upon the altar..."

// DARKASTORIA_BEATUP_CIV_INACTIVE_TEXT :
"P1450555461" "Oh please no! Stop! Leave us be!"
// DARKASTORIA_BEATUP_CIV_INACTIVE_TEXT :
"P2179717622" "NO! I can't escape alone! STOP!"
// DARKASTORIA_BEATUP_CIV_INACTIVE_TEXT :
"P147483566" "Fight! Please! Please... fight back! I need you!"

// DARKASTORIA_BEATUP_CIV_THANKYOU_TEXT :
"P2676035874" "Dead... what am I supposed to do now?"
// DARKASTORIA_BEATUP_CIV_THANKYOU_TEXT :
"P1319607304" "I... I don't know if I can keep going..."
// DARKASTORIA_BEATUP_CIV_THANKYOU_TEXT :
"P324667219" "How will I never escape this nightmare?!"

// DARKASTORIA_BEATUP_REGULAR_ALERTED_TEXT :
"P4125204265" "One vessel smashed and another overflows!"
// DARKASTORIA_BEATUP_REGULAR_ALERTED_TEXT :
"P1371688760" "This one was not capable of the pain you are about to experience!"
// DARKASTORIA_BEATUP_REGULAR_ALERTED_TEXT :
"P1368082247" "You are too late, the blood is spilled!"

// DARKASTORIA_COT_VERSUS_INACTIVE_TEXT :
"P2010901681" "There's a special torment in store for those of your circle."
// DARKASTORIA_COT_VERSUS_INACTIVE_TEXT :
"P2524937765" "Mot rejoices! One of these fools is worth ten of any other!"
// DARKASTORIA_COT_VERSUS_INACTIVE_TEXT :
"P1955749762" "Yours is a trivial power, impotent at the threshold of Mot!"
// DARKASTORIA_COT_VERSUS_INACTIVE_TEXT :
"P2375995166" "Take them carefully; an Orangeban soul must be savored!"

// DARKASTORIA_COT_DEFEND_INACTIVE_TEXT :
"P2593592214" "You cannot know what you are ending!"
// DARKASTORIA_COT_DEFEND_INACTIVE_TEXT :
"P574560643" "No one is safe! No one!"
// DARKASTORIA_COT_DEFEND_INACTIVE_TEXT :
"P2896992927" "Now that I behold Oblivion, I am not afraid!"

// DARKASTORIA_COT_DEFEND_ACTIVE_TEXT :
"P363188908" "We will not yield our eternity to you!"
// DARKASTORIA_COT_DEFEND_ACTIVE_TEXT :
"P2007181561" "We must preserve all we can!"
// DARKASTORIA_COT_DEFEND_ACTIVE_TEXT :
"P1581971552" "Death here is final, be careful!"
// DARKASTORIA_COT_DEFEND_ACTIVE_TEXT :
"P2964982312" "The line cannot end here!"

// DARKASTORIA_TSOO_INACTIVE_TEXT :
"P2381800611" "Pain makes you ripe, tender for consumption!"
// DARKASTORIA_TSOO_INACTIVE_TEXT :
"P4158763601" "Torn skin and flowing blood! Your inks cannot withstand!"

// DARKASTORIA_KOV_VERSUS_INACTIVE_TEXT :
"P1716321985" "You serve the Master ably both in life and in death... Submit!"
// DARKASTORIA_KOV_VERSUS_INACTIVE_TEXT :
"P579932510" "You have fed Him well in the past, but now He desires a greater sacrifice from you!"

// DARKASTORIA_KOV_DEFEND_INACTIVE_TEXT :
"P3135425591" "This is what we've been prepared for!"
// DARKASTORIA_KOV_DEFEND_INACTIVE_TEXT :
"P2519520989" "These savages are searching for victims, let's give them a surprise!"
// DARKASTORIA_KOV_DEFEND_INACTIVE_TEXT :
"P2870505523" "I spit on your master and I spit on you!"

// DARKASTORIA_KOV_DEFEND_ACTIVE_TEXT :
"P2501516865" "Hah! The guilty come running! Mow them ALL down!"
// DARKASTORIA_KOV_DEFEND_ACTIVE_TEXT :
"P4238434415" "In this face of death, I feel so alive!"
// DARKASTORIA_KOV_DEFEND_ACTIVE_TEXT :
"P1738740117" "The odds are in our favor, sisters!"

// DARKASTORIA_TOV_INACTIVE_TEXT :
"P2329894777" "You have always served Mot in ignorance, a lesser servant to his cause! Submit now to the wisdom!"

// DARKASTORIA_CONFRONTATION_CIV_INACTIVE_TEXT :
"P3959935664" "Stay back, you monsters! We wont go down easy!"
// DARKASTORIA_CONFRONTATION_CIV_INACTIVE_TEXT :
"P1029157845" "See this?! What do you want to bet that lead beats mumbo-jumbo?!"

// DARKASTORIA_TSOO_DEFEND_INACTIVE_TEXT :
"P2047813416" "We have slain a thousand of your kind.  We are undaunted!"
// DARKASTORIA_TSOO_DEFEND_INACTIVE_TEXT :
"P1816717875" "We will feed you to your master in our stead!"
// DARKASTORIA_TSOO_DEFEND_INACTIVE_TEXT :
"P3477176303" "No ground given! No enemy spared!"

// DARKASTORIA_TSOO_DEFEND_ACTIVE_TEXT :
"P1693124485" "Stay out of this!"
// DARKASTORIA_TSOO_DEFEND_ACTIVE_TEXT :
"P3343612598" "The glory is ours! Only we know what must be done!"
// DARKASTORIA_TSOO_DEFEND_ACTIVE_TEXT :
"P330605219" "You have interfered with a struggle beyond your comprehension!"

// DARKASTORIA_GENERIC_ATTACK_ACTIVE_TEXT :
"P2511818682" "Rip! Sunder! Shred!"
// DARKASTORIA_GENERIC_ATTACK_ACTIVE_TEXT :
"P3693262175" "Mot hungers!"
// DARKASTORIA_GENERIC_ATTACK_ACTIVE_TEXT :
"P677104218" "Die in agony!"
// DARKASTORIA_GENERIC_ATTACK_ACTIVE_TEXT :
"P3369132135" "Pain sings to the Master! Sing for Him now!"
// DARKASTORIA_GENERIC_ATTACK_ACTIVE_TEXT :
"P1002522170" "Blood upon the ground! Feed! Feed!"
// DARKASTORIA_GENERIC_ATTACK_ACTIVE_TEXT :
"P4246864126" "Scream for him! Every agony is sates!"
// DARKASTORIA_GENERIC_ATTACK_ACTIVE_TEXT :
"P3916227479" "Mot Watches! Mot Hungers!"

// DARKASTORIA_TOV_DEFEND_INACTIVE_TEXT :
"P700392745" "You stand in the way of our righteous judgment!"
// DARKASTORIA_TOV_DEFEND_INACTIVE_TEXT :
"P785928021" "The guilty have no claims upon us!"
// DARKASTORIA_TOV_DEFEND_INACTIVE_TEXT :
"P3774191314" "Your crimes are beyond even our reckoning!"
// DARKASTORIA_TOV_DEFEND_INACTIVE_TEXT :
"P1766089673" "No god can shield you from our retribution!"

// DARKASTORIA_TOV_DEFEND_ACTIVE_TEXT :
"P1510420250" "Like rats, the guilty scurry together! Destroy them all!"
// DARKASTORIA_TOV_DEFEND_ACTIVE_TEXT :
"P548668473" "Stand aside for your own judgment and do not interfere!"
// DARKASTORIA_TOV_DEFEND_ACTIVE_TEXT :
"P2956744819" "Does your soul so yearn for absolution that you rush to face judgment?"
// DARKASTORIA_TOV_DEFEND_ACTIVE_TEXT :
"P3295799887" "The desires of the guilty soul are obliged with destruction!"

// DARKASTORIA_UNASSOCIATED_INACTIVE_TEXT :
"P658387562" "The night is alive with the sounds of screams! Rejoice!"
// DARKASTORIA_UNASSOCIATED_INACTIVE_TEXT :
"P2492528689" "Another offering must be made soon..."
// DARKASTORIA_UNASSOCIATED_INACTIVE_TEXT :
"P1455632978" "The blood on my hands has gone cold. I must find another sacrifice."

// DARKASTORIA_FIGHTCLUB_INACTIVE_TEXT :
"P2846268774" "You can survive... all you have to do is win!"
// DARKASTORIA_FIGHTCLUB_INACTIVE_TEXT :
"P2114455907" "We will use you for every ounce of torment until you finally collapse, and then..."
// DARKASTORIA_FIGHTCLUB_INACTIVE_TEXT :
"P235761427" "Is escape possible? It certainly is! Try it!"

// DARKASTORIA_FIGHTCLUB_DEFEND_INACTIVE_TEXT :
"P2054307815" "Please! Stop! I can't..."
// DARKASTORIA_FIGHTCLUB_DEFEND_INACTIVE_TEXT :
"P3692282443" "They don't seem to feel anything!"
// DARKASTORIA_FIGHTCLUB_DEFEND_INACTIVE_TEXT :
"P2765627973" "We can't win!"
// DARKASTORIA_FIGHTCLUB_DEFEND_INACTIVE_TEXT :
"P2165239298" "We can't give up!"
// DARKASTORIA_FIGHTCLUB_DEFEND_INACTIVE_TEXT :
"P3214777261" "Don't back up! There's no place to go!"

// DARKASTORIA_COT_INACTIVE_TEXT :
"P3983096536" "We will not fall to you!"
// DARKASTORIA_COT_INACTIVE_TEXT :
"P978874830" "Mot's hunger cannot be sated! He will devour you as well, before the end!"

// DARKASTORIA_CEREMONY_SPECIAL_INACTIVE_TEXT :
"P312800153" "Flesh for me... Soul for Mot..."
// DARKASTORIA_CEREMONY_SPECIAL_INACTIVE_TEXT :
"P2695202919" "The heart beats so loud... So fast..."
// DARKASTORIA_CEREMONY_SPECIAL_INACTIVE_TEXT :
"P3696915461" "Crack and spill... I will lap your blood up from the earth..."

// DARKASTORIA_SPECIAL_ASSAULT :
"P1577541807" "...Consume..."
// DARKASTORIA_SPECIAL_ASSAULT :
"P1174555970" "Mot... Devours!"
// DARKASTORIA_SPECIAL_ASSAULT :
"P324202008" "Flesh... Sweet and warm!"

// DARKASTORIA_CEREMONY_CEMETERY_INACTIVE_TEXT :
"P2719448606" "You are strong to have endured this long... only a few moments more..."
// DARKASTORIA_CEREMONY_CEMETERY_INACTIVE_TEXT :
"P2811860581" "Can you feel yourself dying? Can you feel anything anymore?"
// DARKASTORIA_CEREMONY_CEMETERY_INACTIVE_TEXT :
"P2100513576" "The end for you is final and nothing will be left of you when the Master is finished."

// DARKASTORIA_WORSHIP_SPECIAL_INACTIVE_TEXT :
"P2734140648" "Our call is answered!"
// DARKASTORIA_WORSHIP_SPECIAL_INACTIVE_TEXT :
"P240566836" "All gods will be devoured! Only Mot endures!"
// DARKASTORIA_WORSHIP_SPECIAL_INACTIVE_TEXT :
"P3577224785" "We have forsaken all others! Mot! Guide us!"

// DARKASTORIA_WORSHIP_CEMETERY_INACTIVE_TEXT :
"P3644965899" "Master... Direct us..."
// DARKASTORIA_WORSHIP_CEMETERY_INACTIVE_TEXT :
"P3160477587" "Born to spill blood... Guide us!"
// DARKASTORIA_WORSHIP_CEMETERY_INACTIVE_TEXT :
"P4115703398" "We feast at your table... Master..."
// DARKASTORIA_WORSHIP_CEMETERY_INACTIVE_TEXT :
"P3558946436" "Blood... in the air... under foot..."
// DARKASTORIA_WORSHIP_CEMETERY_INACTIVE_TEXT :
"P488322610" "Nourish us... as our kills nourish you..."

// DARKASTORIA_TOV_VERSUS_INACTIVE_TEXT :
"P1056644072" "Such wickedness! We should have turned our attentions to you long before this."
// DARKASTORIA_TOV_VERSUS_INACTIVE_TEXT :
"P318933405" "Your transgressions sing in my ears!"


// DARKASTORIA_GY_SURROUND_VERSUS_INACTIVE_TEXT :
"P3835776510" "Only the choicest specimens make it this far!"
// DARKASTORIA_GY_SURROUND_VERSUS_INACTIVE_TEXT :
"P3308126037" "You should be honored! You are for Mot!"
// DARKASTORIA_GY_SURROUND_VERSUS_INACTIVE_TEXT :
"P2369658141" "We will drain your essence! You are for Mot!"
// DARKASTORIA_GY_SURROUND_VERSUS_INACTIVE_TEXT :
"P1328401071" "You have known pain and now we will complete your transformation!"

// DARKASTORIA_GY_SURROUND_VERSUS_ACTIVE_TEXT :
"P2404002973" "Destroy the apostates!"
// DARKASTORIA_GY_SURROUND_VERSUS_ACTIVE_TEXT :
"P3374114319" "More food for the feast!"
// DARKASTORIA_GY_SURROUND_VERSUS_ACTIVE_TEXT :
"P2993428987" "We kill in Mot's name!"
// DARKASTORIA_GY_SURROUND_VERSUS_ACTIVE_TEXT :
"P1745056176" "You are a fool to come here, where his glory resides!"

// DARKASTORIA_GY_COT_DEFEND_INACTIVE_TEXT :
"P4056622597" "Lament, friends! Here, our eternity ends!"
// DARKASTORIA_GY_COT_DEFEND_INACTIVE_TEXT :
"P1929088003" "Curse your master!"
// DARKASTORIA_GY_COT_DEFEND_INACTIVE_TEXT :
"P1598194478" "Fools! He will devour you when he is no longer sated!"

// DARKASTORIA_GY_COT_DEFEND_ACTIVE_TEXT :
"P3893814988" "We must not falter!"
// DARKASTORIA_GY_COT_DEFEND_ACTIVE_TEXT :
"P1688823133" "Even here, our death does not come easily!"
// DARKASTORIA_GY_COT_DEFEND_ACTIVE_TEXT :
"P3882346621" "We may yet escape!"

// DARKASTORIA_GY_TSOO_DEFEND_INACTIVE_TEXT :
"P3243985502" "Fiends! If you think we will break here, you are mistaken!"
// DARKASTORIA_GY_TSOO_DEFEND_INACTIVE_TEXT :
"P3293285238" "In us our ancestors will remain safe! We will triumph!"
// DARKASTORIA_GY_TSOO_DEFEND_INACTIVE_TEXT :
"P3426375088" "The ancestors will prevail!"

// DARKASTORIA_GY_TSOO_DEFEND_ACTIVE_TEXT :
"P59371336" "This is our moment!"
// DARKASTORIA_GY_TSOO_DEFEND_ACTIVE_TEXT :
"P4179958689" "Mot must fall! You all must be destroyed!"
// DARKASTORIA_GY_TSOO_DEFEND_ACTIVE_TEXT :
"P4163426594" "Strike! Strike now!"

// DARKASTORIA_GY_TOV_DEFEND_INACTIVE_TEXT :
"P3689334196" "Your wickedness will not go unpunished!"
// DARKASTORIA_GY_TOV_DEFEND_INACTIVE_TEXT :
"P2813634960" "Justice will follow, to sweep you all into the grave after us."
// DARKASTORIA_GY_TOV_DEFEND_INACTIVE_TEXT :
"P975078507" "You are wasting your breath - we cannot be frightened!"

// DARKASTORIA_GY_TOV_DEFEND_ACTIVE_TEXT :
"P2613249335" "More guilty to judge!"
// DARKASTORIA_GY_TOV_DEFEND_ACTIVE_TEXT :
"P3556777483" "Declare the sentence, with blade upon flesh!"
// DARKASTORIA_GY_TOV_DEFEND_ACTIVE_TEXT :
"P116021051" "Your fate is upon you now!"

// DARKASTORIA_GY_KOV_DEFEND_INACTIVE_TEXT :
"P2387392035" "We have come so far, we will not die here!"
// DARKASTORIA_GY_KOV_DEFEND_INACTIVE_TEXT :
"P3003758195" "Death touches only the weak; we stil have fight left!"
// DARKASTORIA_GY_KOV_DEFEND_INACTIVE_TEXT :
"P1355687623" "Your time draws short, so be silent and face your fate!"

// DARKASTORIA_GY_KOV_DEFEND_ACTIVE_TEXT :
"P213347430" "Sisters! It is our moment!"
// DARKASTORIA_GY_KOV_DEFEND_ACTIVE_TEXT :
"P3115381213" "Strike quickly and silence these fools!"

