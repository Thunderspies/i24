// HOLLOWS_ALLHOODS_PATROL_INACTIVE_TEXT :
"P87429317" "This way."


// HOLLOWS_CARARREST_POLICE_WRITINGTICKET_INACTIVE_TEXT :
"P2847207613" "I don't want to hear it."
// HOLLOWS_CARARREST_POLICE_WRITINGTICKET_INACTIVE_TEXT :
"P1330638108" "If I had a nickel for every time I heard that line, sir."
// HOLLOWS_CARARREST_POLICE_WRITINGTICKET_INACTIVE_TEXT :
"P1517821829" "Do you honestly expect me to believe that?"


// HOLLOWS_ALLHOODS_CARARREST_SUSPECT_INACTIVE_TEXT :
