// ----------------------------------------------------------------------------------------------
// Source File : scripts/SpawnDefs/InfoNPCs/_src/DayJob_Info_NPC.xls 	Sheet : DayJob_NPC_Mercy 
//
// Script      : Xlstospawndef.bat 
// Version     : 33 
// ----------------------------------------------------------------------------------------------

// Script Variable Greeting :
