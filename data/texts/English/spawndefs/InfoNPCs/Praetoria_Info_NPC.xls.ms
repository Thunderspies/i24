// ----------------------------------------------------------------------------------------------
// Source File : data/scripts/SpawnDefs/InfoNPCs/_src/Praetoria_Info_NPC.xls 	Sheet : P_DayJob_Both_Info 
//
// Script      : Xlstospawndef.bat 
