// ----------------------------------------------------------------------------------------------
// Source File : scripts/SpawnDefs/V_PvP_05_01/_src/V_PvP_05_01_NPCs.xls 	Sheet : Grandville_Villain_Info 
//
// Script      : Xlstospawndef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// Script Variable Greeting :
"P3703240023" "<em=lecture>Hey, {VillainName}, get over here.<em none>"
// Script Variable Greeting :
"P2532830094" "Get over here.  Now.  Recluse's Victory needs you."
// Script Variable Greeting :
"P2219314693" "<em=lecture f=a>{VillainName}?  Need your help.  Now.<em=none>"
// Script Variable RestrictedText :
"P4109938072" "I don't deal with wussy heroes."
// Script Variable InfoText :
"P3266248282" "Go to Recluse's Victory and talk to the PvP Informant to learn how to keep those wussy heroes from making us look bad.<br><br> If you want to find out about 'heavies', talk to the Heavy Informant.  He'll give you the scoop.  <br><br>This is a PvP zone so take a few bad guys with you.  I mean it.  I'm not a scientist for nothing."
// Script Variable OutLoudInfoText :
// Script Variable Leave :
// DisplayName for N_Scientist :
"P3399542967" "Arachnos Scientist"

// ************************************************************************
// ************************************************************************
// ************************************************************************

// ---------------------------------------------------------------------------------------------------
// Generated by transModule
// ---------------------------------------------------------------------------------------------------

// ----------------------------------------------------------------------------------------------
// Source File : scripts/SpawnDefs/V_PvP_05_01/_src/V_PvP_05_01_NPCs.xls 	Sheet : Peregrine_Hero_Info 
//
// Script      : Xlstospawndef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// Script Variable Greeting :
"P86377592" "<em=lecture f=a>Hey, {HeroName}!  Come here, I want to talk to you about Recluse's Victory.<em none>"
// Script Variable Greeting :
"P2126881694" "<em=wave f=a>{HeroName}, we need you.  Get over here.<em=none>"
// Script Variable Greeting :
"P3081131924" "<em=lecture f=a>You think you got what it takes to handle Recluse's Victory, {HeroName}?<em=none>"
// Script Variable RestrictedText :
"P2941530034" "I have no idea how you got to Peregrine Island and I don't care.  Scram.  I don't deal with Villains."
// Script Variable InfoText :
"P544239592" "Good.  Here's what I need you to do.  Head over to Atlas Park.  Down in the DATA room of City Hall is a portal that leads to Recluse's Victory.  <br><br>We need as many heroes as we can get to keep it under control.  You'll see what I mean when you get there.  <br><br>Make no mistake.  It's a PvP zone.  You WILL be attacked."
// Script Variable OutLoudInfoText :
// Script Variable Leave :
// DisplayName for N_Hero :
"P289249811" "Recluse's Victory PvP Recruiter"

