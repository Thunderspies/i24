// ----------------------------------------------------------------------------------------------
// Source File : scripts/SpawnDefs/V_PvP_05_01/_src/V_PvP_05_01_NPCs.xls 	Sheet : RV_Hero_Status_NPC 
//
// Script      : Xlstospawndef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// Script Variable Greeting :
"P511951958" "We are continuing to monitor events in Recluse's Victory."
// Script Variable Greeting :
"P3236111997" "Ah, {HeroName}!  We have some work to do."
// Script Variable RestrictedText :
"P429155851" "A villain?!? But how?  Guards! Guards!"
// Script Variable InfoText :
"P3638571683" "Currently, we are monitoring the battle between the forces of Longbow and Arachnos in the time stream we refer to as 'Recluse's Victory'.  Through judicious use of temporal and etherial mechanics, we have determined this location in time/space to be pivotal in the determining the future outcome of the fate of Atlas Park.  As a result, Longbow is gathering as many able-bodied heroes to support them in their struggle to maintain their lead in this temporal battle.<br><br>The map behind me is updated as we receive reports from the field, indicating how the battle is currently progressing."
// Script Variable HeroBaseText :
"P2983259486" "Heroes Base Count:"
// Script Variable VillainBaseText :
"P3859659694" "Villain Base Count:"
// Script Variable OutLoudInfoText :
"P1671549810" "<em=atease><em=>"
// HeroesTakeBase :
"P3135877760" "Longbow has captured Alpha location."
// HeroesTakeBase :
"P2439559252" "The heroes have taken point Bravo."
// HeroesTakeBase :
"P2705638872" "Point Charlie has been taken."
// HeroesTakeBase :
"P2199213423" "Longbow forces have overtaken bunker Delta."
// HeroesTakeBase :
"P3262763167" "Echo has been liberated."
// HeroesTakeBase :
"P1288379898" "<em=cellphone><em=>Our forces report victory at point Foxtrot!"
// HeroesTakeBase :
"P3884052099" "Golf has been secured."
// VillainsTakeBase :
"P2555323130" "Arachnos has occupied Alpha base."
// VillainsTakeBase :
"P97791642" "The villains have taken point Bravo."
// VillainsTakeBase :
"P635950249" "Arachnos' offensive against Charlie has succeeded."
// VillainsTakeBase :
"P3328354463" "Longbow has had to abandon Delta to Arachnos."
// VillainsTakeBase :
"P2350802029" "The villains have taken over Echo base."
// VillainsTakeBase :
"P263960010" "<em=cellphone><em=>Foxtrot has fallen to Lord Recluse's forces."
// VillainsTakeBase :
"P2380332292" "Enemy forces have overrun Golf point."
// Script Variable HeroesWin :
"P4028428773" "Longbow has taken control of Recluse's Victory!"
// Script Variable VillainsWin :
"P1361382829" "Arachnos has defeated Longbow in Recluse's Victory.  We must prepare to strike back!"
// Script Variable Leave :
// DisplayName for N_Doctor :
"P481522717" "D.A.T.A. Situation Monitor"

