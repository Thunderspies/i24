// Say String :
"P2192103467" "<scale 1.25>That's far enough!</scale>"
// Say String :
"P3614653900" "<scale 1.25>Into the web stumbles the prey!</scale>"
// Say String :
"P332615314" "<scale 1.25>And now for a 'little' surprise.</scale>"
// Say String :
"P2533902863" "<scale 1.25>Meet my greatest work...</scale>"
// Say String :
"P2071461212" "<scale 1.25>    THE ABOMINATION!   </scale>"
// Say String :
"P4059033935" "<scale 1.25>  RISE, MY PET!!   </scale>"
// Generic String :
"P2011744447" "Defeat the Abomination"
// Say String :
"P3166891040" "<scale 1.25>What? This can't be happening!</scale>"
// Say String :
"P2964182784" "<scale 1.25>Abomination! I command you! Eat them!</scale>"
// Generic String :
"P3344960315" "Dr. Kane Summons Zombies to Aid The Abomination!"
// Say String :
"P2138948141" "<scale 1.25>No! You will not destroy my pet!</scale>"
// Say String :
"P2554205338" "<scale 1.25>Kill them!</scale>"
// Say String :
"P3561476829" "<scale 1.25>Hurry, eat them!</scale>"
// Say String :
"P2360927292" "<scale 1.25>Protect the Abomination!</scale>"
// Generic String :
"P3973291631" "Victory!"
// Generic String :
"P1576429787" "You've beaten Dr. Kane and his vile minions. Claim your reward!"
// Say String :
"P2164032299" "<scale 1.25>You've ruined everything!</scale>"
// Generic String :
"P1181464510" "The Abomination is Defeated!"
// Generic String :
"P63413675" "Dr. Kane has been defeated!"
// Say String :
"P2400878179" "What have you done?"
// Say String :
"P566888758" "You meddling fools! You've destroyed my favorite pet!"
// Say String :
"P274540218" "I will rebuild him! Just you wait!"
// Say String :
"P4092732860" "Leave me to my grief!"
// Say String :
"P3718328296" "Do you know how many trick or treaters it took to make that thing?!"
