// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Julius_the_Troll 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Julius the Troll 
// -------------------------------------------------------------------------------- 
// Name :
"P177645482" "Julius the Troll"
// ProfessionString :
"P1258510573" "Disgruntled Troll"
// DescriptionString :
"P1212875153" "Julius is the smallest and most disgruntled Troll in Paragon City. Referred to as 'Runt' by many of his fellow gang members, Julius has had to find a purpose for himself that's not tied up in the drug culture of the Trolls. He's found that purpose in the reclamation of the Hollows. Julius wants to see the area restored to its natural state, and he's willing to sell out his comrades to make it happen. Heroes have occasionally reported seeing a faint glimmer of intelligence buried within Julius' Superadine-addled mind. If a cure for the Trolls' mutations could be found, it's possible that Julius would have a lot of potential to live up to."
// HelloString :
"P3870602461" "<A HREF=CONTACTLINK_MISSIONS>Got work, hero. You ready?</a>"
// HelloString :
"P1233411558" "<A HREF=CONTACTLINK_MISSIONS>Me need some help today.</a>"
// HelloString :
"P2341861375" "<A HREF=CONTACTLINK_MISSIONS>You want help me out?</a>"
// IDontKnowYouString :
"P2219262669" "You no friend of mine. Go see {LastContactName}."
// FirstVisitString :
"P63217270" "You, me, we team up. We do some good for the Hollows."
// NoTasksRemainingString :
"P1516018366" "Out of jobs here. Check with other contacts?"
// PlayerBusyString :
"P3135258539" "You too busy to handle more work."
// ComeBackLaterString :
"P3357192702" "No way, Jose. Nothing for you until Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P1008969051" "You a true friend, {HeroName}.  Need <A HREF=CONTACTLINK_GOTOSTORE>Enhancements,</a> you call Julius. All right?"
// RelationshipChangeString_ToConfidant :
"P2395892663" "You and me, {HeroName}. We make a good team. You need <A HREF=CONTACTLINK_GOTOSTORE>Enhancements?</a> I can hook you up."
// FailsafeLevelString :
"P135445453" "We did good. But you got to look beyond Julius now."
// LocationString :
// IntroString :
"P87821668" "I'd like you to meet a little fellow we call Julius the Troll. He's a Troll, all right, but he's not like the rest of them. He's determined to see the Hollows returned to its natural state. He can give you good tips about Troll activities, and a few hints about those strange Magmite creatures. Julius can usually get his hands on Magic and Natural Enhancements."
// IntroAcceptString :
"P2433423263" "Choose Julius the Troll"
// IntroSendoffString :
"P509774826" "You'll have to look past Julius' appearance if you're going to deal with him. Deep down, I'm convinced he's one of the good ones."
// IntroduceOneContact :
"P3483759335" "You got to meet this <A HREF=CONTACTLINK_INTRODUCE>guy</a>."
// IntroduceTwoContacts :
"P1213239043" "I want introduce some <A HREF=CONTACTLINK_INTRODUCE>fellas</a> to you."
// -------------------------------------------------------------------------------- 


