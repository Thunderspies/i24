// -------------------------------------------------------------------------------- 
// Contact Name : Azuria 
// -------------------------------------------------------------------------------- 
// Name :
"P1136324020" "Azuria"
// ProfessionString :
"P4103257269" "Magic Hero Liaison"
// DescriptionString :
"P397256803" "Azuria is a seer who works with MAGI, the Modern Arcane Guild of Investigation.  This section of the Federal Bureau of Super-powered Affairs assists young magic Heroes in finding the right path.  Some call Azuria a charlatan, but those in the mystical know believe she has great insight and wisdom.  Recently she has been troubled by many grave visions about the nefarious Hellions who plague Atlas Park."
// HelloString :
"P1459370915" "<A HREF=CONTACTLINK_MISSIONS>I have a quest for you, {HeroName}.</a>"
// HelloString :
"P3022237529" "<A HREF=CONTACTLINK_MISSIONS>You seek guidance.  I seek a helping hand.</a>"
// HelloString :
"P3376902338" "<A HREF=CONTACTLINK_MISSIONS>I sense a soul in search of a mission.</a>"
// IDontKnowYouString :
"P2150557827" "I am not part of your destiny, {HeroName}.  Seek out another contact instead."
// FirstVisitString :
"P2651142780" "It is my belief that you are destined for greatness, {HeroName}."
// NoTasksRemainingString :
"P1108365223" "Nothing more I can say will help you on your journey.  Perhaps your other contacts can assist you."
// PlayerBusyString :
"P306109819" "You are overburdened, {HeroName}.  I cannot in good conscience add to your load."
// ComeBackLaterString :
"P3423233969" "Before I can give you more tasks, you must attain Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P2865808251" "My friend, you will need <A HREF=CONTACTLINK_GOTOSTORE>more than good karma</a> on your journey.   Call, and I shall answer."
// RelationshipChangeString_ToConfidant :
"P1288712870" "You have revealed a great deal to me about your character.  My secrets are yours, {HeroName}, and so are my <A HREF=CONTACTLINK_GOTOSTORE>most powerful charms.</a>"
// FailsafeLevelString :
"P3127619298" "Your destiny awaits elsewhere, {HeroName}."
// LocationString :
// IntroString :
// IntroduceOneContact :
"P1702967965" "Our paths must soon diverge, but first let me introduce you to a <A HREF=CONTACTLINK_INTRODUCE>new contact</A> who can help you on your journey."
// -------------------------------------------------------------------------------- 


