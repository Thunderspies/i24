"P1958155056" "devices to destroy"
// SingularDescription :
"P3233041901" "Destroy the last device!"
// InteractBeginString :
"P968414195" "You begin to destroy the device."
// InteractCompleteString :
"P2166712721" "You have destroyed the device."
