// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Allison_King 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Allison King 
// -------------------------------------------------------------------------------- 
// Name :
"P1046715422" "Allison King"
// ProfessionString :
"P305365164" "Psychic"
// DescriptionString :
"P2721367483" "Allison King is a memory archeologist. Instead of excavating ancient burials, she digs through the collective unconsciousness, using hypnotism and her limited psychic abilities. For years, she's been using this ability to help her clients recover from traumatic events or recapture their suppressed memories. Recently, though, she's started using her skills to fight crime. Her memory excavations turn up important details that eyewitnesses don't consciously remember. She's also an excellent interrogator, since she always knows when someone is lying. None of her assertions are admissible in court, of course, but she can at least set heroes on the right path."
// HelloString :
"P1951641570" "<A HREF=CONTACTLINK_MISSIONS>I have seen terrible things this day.</A> "
// HelloString :
"P1327509623" "<A HREF=CONTACTLINK_MISSIONS>My mind is plagued by the dangers to our city.</A> "
// IDontKnowYouString :
"P297154759" "I am afraid you must speak to {LastContactName}."
// FirstVisitString :
"P3201485594" "I pray that the visions I share with you will help bring wrongdoers to justice."
// NoTasksRemainingString :
"P4181904928" "You have freed me from the troubled visions within my mind. I tell you with joy and regret that I have nothing more for you."
// PlayerBusyString :
"P1727546926" "Within your mind I see many uncompleted tasks. Sorry, but I can't give you another."
// ComeBackLaterString :
"P3541897141" "I'd like to give you this mission, but I can't unless you get to Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P4166575195" "From the moment I saw you, I knew we would be great friends. Take a look at the new <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</A> I have uncovered. I hope you will call me if you ever need a friend."
// RelationshipChangeString_ToConfidant :
"P4048913798" "I am pleased to say that I sense a good heart within you. Please take a look at these new <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</A>"
// FailsafeLevelString :
"P2972259640" "The time has come for us to part ways, {HeroName}."
// LocationString :
"P1230199062" "Brickstown"
// IntroString :
"P873426500" "Allison King is psychic; she's quite adept at gathering information from people's minds. She has a great deal of knowledge about the Circle of Thorns and the Council. She works primarily with magic heroes, and has access to Relic and Focus Enhancements."
// IntroAcceptString :
"P3606295015" "Choose Allison King"
// IntroSendoffString :
"P4247321833" "Allison is kind, and caring. Take good care of her, {HeroName}."
// IntroduceOneContact :
"P1659421136" "I have sensed that there is <A HREF=CONTACTLINK_INTRODUCE>one</A> who would wish to meet you."
// IntroduceTwoContacts :
"P12158447" "Some<A HREF=CONTACTLINK_INTRODUCE>friends of mine</A> want to get to know you better."
// -------------------------------------------------------------------------------- 


