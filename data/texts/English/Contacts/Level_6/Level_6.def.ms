// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Phillipa_Meraux 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Phillipa Meraux 
// -------------------------------------------------------------------------------- 
// Name :
"P1882368750" "Phillipa Meraux"
// ProfessionString :
"P2865711911" "Counter Terrorism Specialist"
// DescriptionString :
"P3861581331" "Phillipa Meraux used to be a hero herself. Known as Clandestine, she specialized in infiltrating terrorist cells and other covert groups. But during the Rikti War, all that changed. Phillipa was caught in some crossfire between the alien invaders and the Circle of Thorns; though she survived the blasts, her powers never returned. She retains many of her contacts from her days as a hero, along with all the expertise and knowledge she acquired on the streets of Paragon City. Today she uses that expertise to help other heroes continue her crusade."
// HelloString :
"P2453424481" "<A HREF=CONTACTLINK_MISSIONS>There's a lot to do. I hope you're prepared.</A> "
// HelloString :
"P58987184" "<A HREF=CONTACTLINK_MISSIONS>I have information for you.</A> "
// HelloString :
"P1274792091" "<A HREF=CONTACTLINK_MISSIONS>A lot is happening today, {HeroName}.</A> "
// IDontKnowYouString :
"P2498669401" "Go see {LastContactName}. You are not my problem."
// FirstVisitString :
"P3531293167" "I've heard good things about you, {HeroName}. I'm counting on you to use my information to do the things I can't. Don't let me down."
// NoTasksRemainingString :
"P3316260241" "You have completed all the tasks I had lined up for you. Good luck out there."
// PlayerBusyString :
"P4248482757" "You're already overworked."
// ComeBackLaterString :
"P1830401786" "I've got a really dangerous assignment for you. You should get to Security Level {Level} before we talk about it."
// RelationshipChangeString_ToFriend :
"P48415562" "In a different time, I would consider you a friend. For now, you'll have to be content with the new <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</A> I have to offer. I'd like you to call me if you're ever in need."
// RelationshipChangeString_ToConfidant :
"P4276457742" "I trust you as much as I trust anyone, {HeroName}. Here are some more <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</A> to look over."
// FailsafeLevelString :
"P182687424" "You have moved past my level of expertise."
