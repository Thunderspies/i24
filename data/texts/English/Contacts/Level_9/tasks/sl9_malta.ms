// Script Variable HOSTAGE_NAME :
"P588233582" "C'Kelkah"
// Script Variable CAPTOR_INACTIVE_DIALOG :
"P483992299" "I can't wait to shoot this thing!"
// Script Variable BOSS_DISPLAYNAME :
"P1710302564" "Alpha Orange Canary"
// Script Variable BOSS_ATTACK_DIALOG :
"P1155443762" "MHI! Secure the hostage!"
// Script Variable SayOnRescue :
"P1911994338" "To you: My thanks. Understand: All humans: Not similar: These humans. Negotiations: Re-commence."
// Script Variable SayOnArrival :
"P3989490195" "Lasting peace: My wish. Realization: Your wish as well."
// Script Variable SayOnRecapture :
"P2275483348" "Help: Needed! Speed: Essential!"
// Script Variable SayOnRerescue :
"P3906624812" "Your assistance: Most welcome."
// Script Variable SayOnStranded :
"P3894933683" "Your speed: Unmatched. Request: Wait."
