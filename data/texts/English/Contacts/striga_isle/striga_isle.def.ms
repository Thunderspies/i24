// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Lars_Hansen 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Lars Hansen 
// -------------------------------------------------------------------------------- 
// Name :
"P3260039758" "Lars Hansen"
// ProfessionString :
"P573978715" "Light Keeper"
// DescriptionString :
"P202397562" "Lars Hansen has been the light keeper on Striga Isle for longer than most of his neighbors have been alive. He remembers what the island used to be like before the Council moved in: a little seedy, perhaps, but lively and full of hope. Nowadays, no one ventures near the lighthouse that is Lars' home, and he gets a little lonely from time to time. To stave away his sorrows, Lars bides his time by keeping a watch on Council activities. No one on Striga Isle knows more about their activities."
// HelloString :
"P4183975520" "<A HREF=CONTACTLINK_MISSIONS>We have much to do.</a>"
// HelloString :
"P530514702" "<A HREF=CONTACTLINK_MISSIONS>There are great dangers ahead.</a>"
// HelloString :
"P1045802878" "<A HREF=CONTACTLINK_MISSIONS>The Council grows bolder every day.</a>"
// IDontKnowYouString :
"P832112475" "I believe you want {LastContactName}."
// FirstVisitString :
"P1168463384" "My brother tells me you can do some good for Striga Isle. I hope he's right."
// NoTasksRemainingString :
"P2790843058" "You've run me out of leads, {HeroName}. You'll have to look elsewhere if you want to continue your fight against the Council."
// PlayerBusyString :
"P2905343545" "You're too busy to take on one of my leads."
// ComeBackLaterString :
"P4294480997" "You're brave, but I can't give you this task until you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P3314215682" "You may just have what it takes to bring the Council down, {HeroName}. I'd be proud to call you a friend. If I can offer you any <A HREF=CONTACTLINK_GOTOSTORE>assistance,</a> please don't hesitate to call."
// RelationshipChangeString_ToConfidant :
"P252633074" "{HeroName}, I'm impressed. I hope I can help you with these new <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</a>"
// FailsafeLevelString :
"P4121034990" "You have moved beyond me. But I hope you'll never stop battling the Council."
// LocationString :
// IntroString :
"P1568083226" "I'd like you to meet my brother, Lars Hansen. If you want someone with the inside dirt on the Council, that's him. He can get you access to Science and Mutation Enhancements."
// IntroAcceptString :
"P2195681542" "Choose Lars Hansen"
// IntroSendoffString :
"P2963753371" "Lars is dedicated to his battle against the Council. Please keep him safe for me."
// IntroduceOneContact :
"P3368336308" "Perhaps you should see what this Ernesto Hess can offer you. Just don't trust him too far, {HeroName}. I know of <A HREF=CONTACTLINK_INTRODUCE>another</a> you could help."
// IntroduceTwoContacts :
"P2569893013" "Perhaps you should see what this Ernesto Hess can offer you. Just don't trust him too far, {HeroName}. I know of <A HREF=CONTACTLINK_INTRODUCE>others</a> you could help."
// -------------------------------------------------------------------------------- 


