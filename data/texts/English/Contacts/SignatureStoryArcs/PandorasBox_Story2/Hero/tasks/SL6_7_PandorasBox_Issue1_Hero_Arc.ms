// -------------------------------------------------------------------------------- 
// CutScene 
// -------------------------------------------------------------------------------- 
// 4 Actor1 :
"P3611891253" "<color gold><bordercolor gold><bgcolor darkgreen>Atta... strong. Feel... different."
// 6 Actor1 :
"P2928034070" "<color gold><bordercolor gold><bgcolor darkgreen>I am... becoming stronger. Much stronger."
// 6 Actor1 :
"P532711621" "<color gold><bordercolor gold><bgcolor darkgreen>It is as though strength itself calls to me. I can feel it."
// 2 Actor1 :
"P3248814664" "<color gold><bordercolor gold><bgcolor darkgreen>I..."
// 5 Actor1 :
"P3731191225" "<color gold><bordercolor gold><bgcolor darkgreen><em tarzan><color gold><bordercolor gold><bgcolor darkgreen>I want MORE!"
// Script Variable ACTOR_1_NAME :
"P2148964386" "Atta"
// Script Variable BOSS_1STBLOOD_DIALOG :
"P2551652926" "<color gold><bordercolor gold><bgcolor darkgreen>{HeroName}, you come to test my strength?"
// Script Variable BOSS_75HEALTH_DIALOG :
"P915231080" "<color gold><bordercolor gold><bgcolor darkgreen>I have been chosen for something greater! You do not understand!"
// Script Variable BOSS_50HEALTH_DIALOG :
"P7676522" "<color gold><bordercolor gold><bgcolor darkgreen>This... this is not right. You... are winning?"
// Script Variable BOSS_25HEALTH_DIALOG :
"P439375006" "<color gold><bordercolor gold><bgcolor darkgreen>No... Atta not want... to go back..."
// Script Variable BOSS_DEAD_DIALOG :
"P3048145301" "<color gold><bordercolor gold><bgcolor darkgreen>Atta... had something... good..."
// Script Variable ACTOR_2_NAME :
"P534853849" "NAME"
// Script Variable SaysList :
"P3731237859" "Alright {HeroName}, we can clean this up if we kill Washington!"
// Script Variable Greeting :
"P1127431811" "Hello, {HeroName}."

