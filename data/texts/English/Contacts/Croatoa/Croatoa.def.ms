// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Kelly_Nemmers 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Kelly Nemmers 
// -------------------------------------------------------------------------------- 
// Name :
"P2941827741" "Kelly Nemmers"
// ProfessionString :
"P3583000025" "Ghost"
// DescriptionString :
"P2828724494" "Kelly Nemmers had all the makings of a Magic Origin hero.  Talent, spirit, a willingness to learn, and an inherent ability to communicate with those in other planes of existence.  Sadly, her training was just beginning when Salamanca became the physical nexus for all of Croatoa's mystical power.  Kelly tried to fight the dark forces closing in around her town, but she was killed in the process.  Her ability to communicate with those in other planes kept her in contact with the real world, preventing her from becoming a malevolent spirit like so many of her fellow villagers.  Now, Kelly works to free herself and her fellow spirits from Croatoa's hold."
// HelloString :
"P3701908332" "We have work to do."
// HelloString :
"P1732310218" "I have all the time in the world, but you must move quickly."
// HelloString :
"P1126410884" "Help me, {HeroName}."
// IDontKnowYouString :
"P3260886079" "I don't remember you, though I have the feeling {LastContactName} is looking for you."
// FirstVisitString :
"P1645068328" "I've come to terms with my death, {HeroName}, so I'll ask you not to mourn for me.  If you want to do something for me, you can help me unravel the many traps of this strange land."
// NoTasksRemainingString :
"P4185047950" "There's nothing more I can ask of you.  Perhaps one of your other contacts could use your assistance."
// PlayerBusyString :
"P2452885343" "You already have duties to attend to."
// ComeBackLaterString :
"P258822131" "You'll get hurt if you try to venture further into Croatoa before reaching Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P1184714611" "I wish I had known you when I was alive, {HeroName}.  I have the feeling we would have been friends.  Perhaps these <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</a> can help you; I have little use for them now.  You may call on me whenever you are in need."
// RelationshipChangeString_ToConfidant :
"P563597090" "I did not think I would become this close to you, {HeroName}.  You have earned my trust, and all the Enhancements you wish."
// FailsafeLevelString :
"P2512700936" "There's nothing more you can do for me, {HeroName}, but I will carry the memory of you beyond my grave."
// LocationString :
// IntroString :
"P772238703" "I never met Kelly Nemmers.  Not while she was alive, that is.  But she's got what you might call an 'insider's scoop' on Croatoa.  She can get you Magic and Natural Enhancements."
// IntroAcceptString :
"P2925197505" "Choose Kelly Nemmers"
// IntroSendoffString :
"P708002436" "Kelly's a good girl.  Er, ghost.  She'll help you in whatever way she can."
// IntroduceOneContact :
"P3671040001" "I know of <A HREF=CONTACTLINK_INTRODUCE>someone</a> who could use your help."
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


