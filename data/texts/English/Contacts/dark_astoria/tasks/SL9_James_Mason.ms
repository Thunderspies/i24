"P1221477764" "<t=6 caption x= 0.2 y=0.3 d=6><scale 1.75><color white><bgcolor DimGray>She is doomed! You will become one with the Knives of Vengeance, {HeroName}, to spread our justice!"
// Script Variable Greeting :
"P1127431811" "Hello, {HeroName}."
