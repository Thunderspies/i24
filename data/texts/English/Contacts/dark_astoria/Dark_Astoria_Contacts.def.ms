// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Taskmaster Gabriel 
// -------------------------------------------------------------------------------- 
// Name :
"P4168228201" "Taskmaster Gabriel"
// ProfessionString :
// InteractionRequiresText :
// LocationString :
"P2719657162" "Dark Astoria"
// CallTextOverride :
"P4185290661" "Contact"
// AskAboutTextOverride :
"P1117716953" "Prove your might"
// HelloString :
"P1961324497" "Are you ready to show your power, {HeroName}?"
// IDontKnowYouString :
"P1529508643" "You are brave, {HeroName}, but your strength is lacking. Return to me when you have reached security level 50, then we shall talk."
// FirstVisitString :
"P2069088468" "Hail, {HeroName}. I am Taskmaster Gabriel. I have arrived here within Dark Astoria to witness this contest of strength between the darkness here and the powers that inhabit Primal Earth.<br><br>My goal here is to simple observe and reward those who have proven their strength against powerful foes.<br><br><color orange>Taskmaster Gabriel will reward players who are security level 50 two Empyrean merits for weekly completions of all the Dark Astoria story arcs. Accepting Taskmaster Gabriel's mission may reveal spoilers for Dark Astoria content.</color>"
// PlayerBusyString :
"P4117214453" "You have many things to tend to, {HeroName}."
// ComeBackLaterString :
"P1416868701" "You are brave, {HeroName}, but not brave enough. Return to me when you have reached security level 50, then we shall talk."
// -------------------------------------------------------------------------------- 


