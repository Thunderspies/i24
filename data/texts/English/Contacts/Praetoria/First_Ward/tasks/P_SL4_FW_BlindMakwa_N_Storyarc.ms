// Task - Compound1_Part1 
// -------------------------------------------------------------------------------- 

// -------------------------------------------------------------------------------- 
// Task Header Items 
// -------------------------------------------------------------------------------- 
// ActiveTaskString :
"P2238882090" "Gather the dirt from seven graves"
// YoureStillBusyString :
"P3435414649" "Do not let the spirits in the Cemetery discourage you. The dead have no need of dirt, and remember, seven handfuls from seven graves, the number is very important."
// zowiedisplayname :
"P1594799725" "Grave Dirt"
// zowiedescription :
"P2804511093" "Recover the dirt from {remain} more graves"
// zowiesingulardescription :
"P4211837538" "Recover the dirt from one last grave"
// interactbeginstring :
"P900149254" "You begin scooping up handfuls of dirt, grass, and twigs and filling one of the bags Blind Makwa gave you."
// interactinterruptedstring :
"P826846204" "You have been interrupted"
// interactcompletestring :
"P2342730061" "You've filled the bag with seven handfuls of dirt as directed by Blind Makwa."
// interactactionstring :
"P543531892" "Gathering Dirt..."

