// Script Variable ChatMessage :
"P2506662174" "IDF RECOVERY TEAM HAS ARRIVED"
// Script Variable BOSS_DISPLAYNAME :
"P1056665421" "ACU"
// Script Variable BOSS_ATTACK_DIALOG :
"P2122002366" "<shout>CLEANSE AND DISINFECT!<t 0.01>"
// Script Variable BOSS_25HEALTH_DIALOG :
"P2887057259" "<shout>CRITICAL SYSTEMS RUPTURE!<t 0.01>"
// Script Variable BOSS_KILLEDHERO_DIALOG :
"P4085934119" "<shout>THREAT TO EMPIRE NEUTRALIZED!"
// Script Variable BOSS_DISPLAYNAME :
"P2597913344" "Colonel Duray"
// Script Variable BOSS_ATTACK_DIALOG :
"P4263593543" "<shout>Look sharp and let's get this done!"
// Script Variable BOSS_1STBLOOD_DIALOG :
"P1242851902" "<shout>Do you understand how ANNOYING it is for me to even be here?!<t 0.01>"
// Script Variable BOSS_75HEALTH_DIALOG :
"P1724921808" "<shout>I've got better things to do than clean up Tilman's mess!<t 3>Like, say, invading a WHOLE DIMENSION!"
// Script Variable BOSS_50HEALTH_DIALOG :
"P202239347" "<shout>Come on, people, we've got a timetable to keep!<t 0.01>"
// Script Variable BOSS_DEAD_DIALOG :
"P1201898156" "<shout>Mission aborted! I'm 'porting out!<t 0.01>"
