// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Daniel_Jones 
//
// Script      : Xlstocontactdef.bat 
// Version     : 33 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Daniel Jones 
// -------------------------------------------------------------------------------- 
// Name :
"P3615257519" "Daniel Jones"
// ProfessionString :
"P1101822360" "Confused Ghost"
// DescriptionString :
// LocationString :
// HelloString :
"P371877483" "Hi!  Do I know you?  All I know is that there's something I have to do.  But I can't remember what it was."
// IDontKnowYouString :
"P3910219870" "Wow... I'm going to be so late for work.  Why can't I get there?  It doesn't make sense, man."
// FirstVisitString :
"P1875002295" "I'm going to be late for work.  Man, I hate to be late.  I need to get there.  Or call them.  Or, um, something.  Man, I'm going to be so late."
// NoTasksRemainingString :
"P2605480046" "You have helped me more than you can possibly imagine, HeroName.  I am in no need of anything more.  Ever.  Thank you."
// PlayerBusyString :
"P595754829" "I know you've got things other things to do, but you're the only who will talk with me.  Could you, um, you know, finish up your other tasks and then help me out?"
// ComeBackLaterString :
"P1626391858" "Hey, {HeroName}!  Could you do me a favor?  I need you to do... um... I need you to do... something.  AW MAN!  I forgot what I was going to ask you.  Again.  Um, could you come back later?  Maybe I might remember then."
// RelationshipChangeString_ToFriend :
"P2910395250" "Thank you for being a friend, {HeroName}.  That was your name, right?  I can't remember."
// RelationshipChangeString_ToConfidant :
"P4283661834" "Thank you, {HeroName}.  Though my time is done, if it wasn't for you, I would have been trapped in this in-between world.  I owe you much, friend.  I now make preparations to go to where I belong.  We will meet again."
// WrongAllianceString :
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
