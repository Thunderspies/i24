// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : P_Repeatable_V_Caldoun 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Mr. Caldoun 
// -------------------------------------------------------------------------------- 
// Name :
"P3534130996" "Mr. Caldoun"
// ProfessionString :
"P1167279344" "Business Man"
// DescriptionString :
"P3080293196" "Mr. Caldoun takes advantage of any situation he finds himself in, a mindset which some say got him sent to First Ward in the first place. Caldoun makes sure that he stays well-informed of the comings and goings in First Ward so that if an advantageous situation arises, he can take it."
// InteractionRequiresText :
// LocationString :
// HelloString :
"P3171055983" "Lookin' to make a quick buck, bucko?"
// HelloString :
"P3907524325" "I got work if you're interested."
// IDontKnowYouString :
"P3239355137" "Move along, I don't got work for you."
// FirstVisitString :
"P3982723028" "So, you're {HeroName}, huh? I heard about you, ear to the grapevine and all. I think you and I are going to do very well for ourselves, if we stick together and don't stray to the knives-in-each-other's-backs part of this business."
// NoTasksRemainingString :
"P1145784520" "I'm tapped outta jobs. This city is ours."
// PlayerBusyString :
"P4146929417" "You're way too high profile right now, runnin' more jobs than you can count on one hand. Finish your work and then come see me."
// ComeBackLaterString :
"P2202017554" "You can't be serious! I'm doing serious work here, dangerous work. I send you out there then you'll get killed, or worse, you'll get captured and squeal. Come back when you can prove you are a stone cold killer."
// RelationshipChangeString_ToFriend :
"P555020763" "We work well together, let's keep it that way."
// RelationshipChangeString_ToConfidant :
"P116618234" "You and I are destined for great things, {HeroName}. Well, as great as they can get here in the gumbo."
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
