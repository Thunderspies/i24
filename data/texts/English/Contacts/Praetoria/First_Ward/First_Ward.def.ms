// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : P_Repeatable_R_Roadflare 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Roadflare 
// -------------------------------------------------------------------------------- 
// Name :
"P58990774" "Roadflare"
// ProfessionString :
"P2157378442" "Resistance Fighter"
// DescriptionString :
"P172602764" "Roadflare volunteered to serve in First Ward, where his unique blend of charisma and crazy would do well to recruit combatants for the Resistance. He's liked by a lot of the Last Worders because he stands up for them against the Dregs and D.U.S.T. He's best known for his catchy 'hate anthems', which are popular amongst First Ward's denizens due to their anti-Cole nature."
// InteractionRequiresText :
// LocationString :
// HelloString :
"P1644160877" "I've got my slickers if you've got the sand, crumbcakes."
// HelloString :
"P2497376372" "I'm lookin' forward to some crunchy groove salad, chomper."
// IDontKnowYouString :
"P966861034" "Scamp away, G-man. I don’t jaw with badgers."
// FirstVisitString :
"P1598840774" "Hey there slammer-man, get your wisdom from a can, hear me clap, slap your clothes, everybody knows.<br><br>The name's Roadflare, chomper. I've got the singsongs for your canals and the treats for your feets. All I desire is to light a fire, and burn that black hearted Cole to warm all the sheeple. Then, they can drop their wool and live free.<br><br>Ha ha! But we're gonna need a lot of feet to fill those shoes, hear what I'm clappin'?"
// NoTasksRemainingString :
"P1053059164" "No more shoes, sockman. Ditch the covers and bask for awhile."
// PlayerBusyString :
"P2696573446" "Too much honey, busy bee. You're gonna drown in all that glory. Stir it, don't shake it. Once you've achieved the calm, then come rattle at me. I got a lot to chomp and can't afford to choke 'cause my teeth ain't done with their chewin'. Can you clap it?"
// ComeBackLaterString :
"P4163816843" "No dice, fuzzy bunny. I need a chomper, not a chompie."
// RelationshipChangeString_ToFriend :
"P3556688427" "I like your style, slammer. You keep it shiny."
// RelationshipChangeString_ToConfidant :
"P1469828117" "Never thought I'd be jawin' raw with a slammer like you, {HeroName}. You're chrome and pickles...<br><br>...<br><br> That means you're cool."
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


