// ---------------------------------------------------------------------------------------------------

// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : P_Repeatable_L_AngelaHu 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Angela Hu 
// -------------------------------------------------------------------------------- 
// Name :
"P57889173" "Angela Hu"
// ProfessionString :
"P3647125214" "Trader"
// DescriptionString :
"P2354303104" "Angela Hu deals in junk. Scavengers from all around the gumbo come to her to sell trinkets, parts, bits of metal, and information. She has her fingers on the pulse of First Ward, and for something shiny, she might sell you a useful tip or two - if she thinks you are worth a damn."
// InteractionRequiresText :
// LocationString :
// HelloString :
"P1122917832" "Let's drop the fake names and accents and get straight to business."
// HelloString :
"P1283505304" "Ready to prove your loyalty?"
// IDontKnowYouString :
"P2687942392" "I no deal with you. Go away. You bad for business."
// FirstVisitString :
"P1478558950" "Don't let my appearance fool you, {HeroName}. Call me Angela in public, but from here on out, you call me by my code name; Anaconda. The Emperor needs loyal eyes and ears here in First Ward to keep tabs on recent events; the vortex, return of the Hamidon's seeds, and the Carnival of Light's efforts here. For some reason, he's most concerned with the Carnival, and since you're in their good graces, I'm going to tap you to get the job done."
// NoTasksRemainingString :
"P3194118840" "I have what I need here. If I need your help in the future I'll call upon you. Until then, don't try to contact me and forget I ever existed."
// PlayerBusyString :
"P2001853727" "I know you Powers Division {hero.gender=male guys|girls} are all about doing things your own way, but if you want to assist in this operation then you're going to need to be a little less conspicuous. You got too many folks keeping tabs on your efforts right now. Finish some of thier tasks and then come see me."
// ComeBackLaterString :
"P2840873791" "I'm not authorized to enlist the aid of any Powers Division personnel below Security Level 20."
// RelationshipChangeString_ToFriend :
"P3967723288" "A lot of people come down hard on Powers Division, but you're alright, {HeroName}."
// RelationshipChangeString_ToConfidant :
"P3161139661" "Superb work. Your efforts will be noted in my report. I hope to be assigned to work with you again in the future."
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


