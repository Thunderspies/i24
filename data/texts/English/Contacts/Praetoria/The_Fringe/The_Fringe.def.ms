// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : David_Hill 
//
// Script      : Xlstocontactdef.bat 
// Version     : 33 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : David Hill 
// -------------------------------------------------------------------------------- 
// Name :
"P2375819399" "David Hill"
// ProfessionString :
"P3875029624" "Mysterious Dealer of Odds and Ends"
// DescriptionString :
// LocationString :
// HelloString :
"P244495690" "You came here to do some business, so let's get down to it!"
// IDontKnowYouString :
"P2452674555" "Look, kiddo.  I don't know you, and I'm not in the habit of talking with people I don't know.  So why don't you go chat with one of yer friends, got it?"
// FirstVisitString :
"P2479355745" "Do you know who you're talking to, kid?  You're talking to someone who's capable of beating you seven ways to Sunday without breakin' a sweat.  Afterwards, I'll make lunchmeat outta ya and feed you to my dogs.  Come to think of it, that's a fun idea.  Put up yer dukes, kid!<br> <br>HAHAHA!!!  I'm just yanking yer chain!  You shoulda seen the look on yer face, kid!  Nah, I ain't gonna beat ya, 'less you're one of Cole's men coming here lookin' fer trouble.  The name's Hill... now.  So why'd you come looking for old Odysseus?"
// NoTasksRemainingString :
"P2295904015" "I got nothing for you right now, kiddo.  From hereon, we just gotta keep an eye on Cole and see to it that he doesn't get his hands on all of these artifacts."
// PlayerBusyString :
"P2730467470" "You've got too much on your hands right now, kiddo!  Take care of you what you've gotta take care of, then head back my way, got it?"
// ComeBackLaterString :
"P1724422145" "What I've got for you is way out of your league, kiddo.  I might consider asking you for some hand if you were Security Level {Level}.  Check back with me then, got it?"
// RelationshipChangeString_ToFriend :
"P819981484" "I like your style, you know that, kiddo?  Take down my numbers and gimme a call when you want."
// RelationshipChangeString_ToConfidant :
"P1058597344" "You've done a lot to help me, kiddo.  I remember things like this, you know?  I never forget a debt, you remember that, got it?"
// WrongAllianceString :
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
