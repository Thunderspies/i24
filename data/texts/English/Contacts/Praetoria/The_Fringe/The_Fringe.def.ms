// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Diablolique 
//
// Script      : Xlstocontactdef.bat 
// Version     : 33 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Diablolique 
// -------------------------------------------------------------------------------- 
// Name :
"P1825138114" "Diablolique"
// ProfessionString :
"P4018326757" "Soul Binder"
// DescriptionString :
// LocationString :
// HelloString :
"P3427452847" "The Emperor has decreed that the Talons of Vengeance are a threat to Praetoria.  I am tasked to stop them, as are you now."
// IDontKnowYouString :
"P4096975128" "Do not seek out the sweet embrace of death unless you truly desire to irrevocably pass from this mortal coil.  Come seek me when it is your time, {HeroName}."
// FirstVisitString :
"P1533442925" "What you see before you is a vision of retribution. Your ability to carry out the will of the Emperor will be what decides your fate.  Will you stand proud or will the rights to your soul be revoked?<br> <br>I am Diabolique, {HeroName}, and for the near duration you will be assisting me in my tasks.  If you value your soul, you will listen closely to my following tasks I now charge you with."
// NoTasksRemainingString :
"P151457023" "The Talons now understand their audacity.  They no longer reach for my precious souls.  The screams of their sisters' souls will be a persistent reminder to them."
// PlayerBusyString :
"P2452629134" "You are distracted with too many other tasks, HeroName. Return to me when you can dedicate yourself to the will of the Emperor."
// ComeBackLaterString :
"P3605877982" "Your spirit is lacking in strength.  Return to me when you have fortified the weaknesses within your soul."
// RelationshipChangeString_ToFriend :
"P2619053789" "You are proving valuable to me.  For now, I shall allow you control of your own soul.  Call out to me when you need, {HeroName}, for I shall hear you."
// RelationshipChangeString_ToConfidant :
"P763596675" "I see no reason to separate you from this mortal coil, {HeroName}.  You have fulfilled your duties to me, and thus to the Emperor.  He is more forgiving than I am, therefore you have been granted some more time on this plane.  Cherish it while you can."
// WrongAllianceString :
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
