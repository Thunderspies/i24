// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Detective_Friday 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Detective Freitag 
// -------------------------------------------------------------------------------- 
// Name :
"P31164660" "Detective Freitag"
// ProfessionString :
// DescriptionString :
"P2094779243" "Detective Freitag is a straight-talking no-nonsense kind of cop who sticks to just the facts. Though he's assigned in Kings Row, he lives with his wife Connie in Atlas Park."
// HelloString :
"P206026071" "Just the facts, {HeroName}."
// IDontKnowYouString :
"P3221091629" "Sorry, {HeroName}, I'm a little busy with my current investigation. Perhaps you should speak with Detective Becktrees. I'm sure he'll be happy to help you."
// FirstVisitString :
"P3308672279" "Good to meet you, {HeroName}. I'm Detective Freitag. My partner is Detective Becktrees. We're cops. We're here to help, but we can't handle everything, and sometimes we have to call on the post-human residents of this fair city for additional aid. You do right, we might even have some special work to contact you about."
// NoTasksRemainingString :
"P915599114" "Things are quiet, {HeroName}. That's not something to complain about. Maybe it's time you helped out in some other parts of this fine city."
// PlayerBusyString :
"P1623958350" "I think you're already busy, {HeroName}. Stick to one thing at a time. Or two to three things, I suppose."
// ComeBackLaterString :
"P3404947036" "I appreciate that you want to help, but I can't accept help unless I can be sure you'll be able to do the job. Check back when you're at least security level 5"
// RelationshipChangeString_ToFriend :
"P3917120062" "I've heard lots of good things about your work. I respect that."
// RelationshipChangeString_ToConfidant :
"P4198830384" "You're putting a real squeeze on the criminal element. And anything that makes the lives of the honest citizens of Paragon City safer is A-Okay in my book."
// FailsafeLevelString :
"P105566136" "There's not much going on. It's almost like the crooks are scared of heroes like you. Good work, but there's bigger things you could take care of out there."
// LocationString :
"P1937455418" "Kings Row"
// IntroString :
"P2093410798" "Detective Freitag is a real straight-arrow. He won't lead you wrong."
// IntroAcceptString :
"P4120974794" "Choose Detective Freitag"
// IntroSendoffString :
"P970572472" "Detective Freitag will help you. That's what he does."
// IntroduceOneContact :
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


