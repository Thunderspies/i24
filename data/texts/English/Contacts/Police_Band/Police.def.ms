// ComeBackLaterString :
// RelationshipChangeString_ToFriend :
// RelationshipChangeString_ToConfidant :
// FailsafeLevelString :
// LocationString :
"P2752802251" "Atlas Park"
// IntroString :
"P565822275" "Officer Friday is a real straight-arrow. He won't lead you wrong."
// IntroAcceptString :
"P3953734454" "Choose Officer Friday"
// IntroSendoffString :
"P3163503251" "Officer Friday will help you. That's what he does."
