// NEUTROPOLIS_ALLHOODS_RES_SHADYDEAL_BUYER_ALERTED_TEXT :
"P896782384" "Aw man... my mom's gonna be ticked!"



// IMPERIALCITY_RES_MEET_SYN_INACTIVE :
