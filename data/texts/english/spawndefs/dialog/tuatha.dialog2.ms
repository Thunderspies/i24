// CROATOA_TUATHA_TERRITORYCEREMONY_BOWING_INACTIVE_TEXT :
"P2565388034" "Bless this land for Dannan."
// CROATOA_TUATHA_TERRITORYCEREMONY_BOWING_INACTIVE_TEXT :
"P1172905802" "The Tuatha will rule this world forever."
// CROATOA_TUATHA_TERRITORYCEREMONY_BOWING_INACTIVE_TEXT :
"P3223323932" "This earth is beloved of Dannan."

// CROATOA_TUATHA_TERRITORYCEREMONY_BOWING_ALERTED_TEXT :
"P2562788356" "Who disrupts us here?"
// CROATOA_TUATHA_TERRITORYCEREMONY_BOWING_ALERTED_TEXT :
"P1578405201" "Who invades?"
// CROATOA_TUATHA_TERRITORYCEREMONY_BOWING_ALERTED_TEXT :
"P2328939808" "Begone, or feel Dannan's wrath!"

// CROATOA_TUATHA_TERRITORYCEREMONY_CHEERING_INACTIVE_TEXT :
"P3223326197" "Yes! Yes!"
// CROATOA_TUATHA_TERRITORYCEREMONY_CHEERING_INACTIVE_TEXT :
"P10423965" "Will we triumph over the Fir Bolg!"
// CROATOA_TUATHA_TERRITORYCEREMONY_CHEERING_INACTIVE_TEXT :
"P971775045" "We will crush all enemies!"

// CROATOA_TUATHA_TERRITORYCEREMONY_CHEERING_ALERTED_TEXT :
"P2320442750" "You oppose the Tuatha?"
// CROATOA_TUATHA_TERRITORYCEREMONY_CHEERING_ALERTED_TEXT :
"P3412503843" "You will die for this intrusion!"
// CROATOA_TUATHA_TERRITORYCEREMONY_CHEERING_ALERTED_TEXT :
"P3118071794" "This ceremony is sacred!"

// CROATOA_TUATHA_TERRITORYCEREMONY_CHANTING_INACTIVE_TEXT :
"P2023060032" "Let the land be purged of the Fir Bolg!"
// CROATOA_TUATHA_TERRITORYCEREMONY_CHANTING_INACTIVE_TEXT :
"P921994642" "Let the Tuatha reign here forever!"
// CROATOA_TUATHA_TERRITORYCEREMONY_CHANTING_INACTIVE_TEXT :
"P1355213108" "The all enemies by slain!"

// CROATOA_TUATHA_TERRITORYCEREMONY_CHANTING_ALERTED_TEXT :
"P2659116068" "You dare?"
// CROATOA_TUATHA_TERRITORYCEREMONY_CHANTING_ALERTED_TEXT :
"P691560481" "No one must disrupt our ceremony!"
// CROATOA_TUATHA_TERRITORYCEREMONY_CHANTING_ALERTED_TEXT :
"P1024004506" "You dishonor Dannan!"

// CROATOA_TUATHA_TERRITORYCEREMONY_PRAYING_INACTIVE_TEXT :
"P2939032242" "Dannan, strengthen us!"
// CROATOA_TUATHA_TERRITORYCEREMONY_PRAYING_INACTIVE_TEXT :
"P576591519" "Dannan, hear our words!"
// CROATOA_TUATHA_TERRITORYCEREMONY_PRAYING_INACTIVE_TEXT :
"P2888582344" "Dannan, give us your power!"

// CROATOA_TUATHA_TERRITORYCEREMONY_PRAYING_ALERTED_TEXT :
"P3874858321" "Get out of here!"
// CROATOA_TUATHA_TERRITORYCEREMONY_PRAYING_ALERTED_TEXT :
"P2501089417" "Go away!"
// CROATOA_TUATHA_TERRITORYCEREMONY_PRAYING_ALERTED_TEXT :
"P3393566177" "No human must hear these words!"

// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALDANCE_INACTIVE_TEXT :
"P3437096242" "Sing to the skies!"
// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALDANCE_INACTIVE_TEXT :
"P1201101276" "Lift your voices high!"
// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALDANCE_INACTIVE_TEXT :
"P2708028018" "Let your words ring out!"

// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALDANCE_ALERTED_TEXT :
"P2190130178" "You are not one of us!"
// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALDANCE_ALERTED_TEXT :
"P504675415" "You do not belong!"
// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALDANCE_ALERTED_TEXT :
"P2510177923" "Intruder!"

// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALHOWL_INACTIVE_TEXT :
"P3256574194" "Ayoooaaahh!"
// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALHOWL_INACTIVE_TEXT :
"P3509261632" "Daaannnaaaaan!"
// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALHOWL_INACTIVE_TEXT :
"P143445732" "Waaaoooohh!"

// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALHOWL_ALERTED_TEXT :
"P613950817" "Go!"
// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALHOWL_ALERTED_TEXT :
"P1572807740" "Leave us!"
// CROATOA_TUATHA_TERRITORYCEREMONY_TRIBALHOWL_ALERTED_TEXT :
"P2666915644" "Away with you!"

// CROATOA_TUATHA_NIGHT_INCURSION_ALERTED_TEXT :
"P1611443812" "I have you in my grasp!"
// CROATOA_TUATHA_NIGHT_INCURSION_ALERTED_TEXT :
"P3509935738" "I will crush you!"
// CROATOA_TUATHA_NIGHT_INCURSION_ALERTED_TEXT :
"P1837226707" "You meet your destiny tonight!"

// CROATOA_TUATHA_FORESTCLEARING_PIPETHROWER_INACTIVE_TEXT :
"P2804399339" "This filth pollutes Dannan's world."
// CROATOA_TUATHA_FORESTCLEARING_PIPETHROWER_INACTIVE_TEXT :
"P854429544" "I cannot tolerate such much."
// CROATOA_TUATHA_FORESTCLEARING_PIPETHROWER_INACTIVE_TEXT :
"P1651044608" "This corruption pains me."

// CROATOA_TUATHA_FORESTCLEARING_ROCKTHROWER_INACTIVE_TEXT :
"P3995849156" "We must clear the land."
// CROATOA_TUATHA_FORESTCLEARING_ROCKTHROWER_INACTIVE_TEXT :
"P4254885682" "We must make the earth pure."
// CROATOA_TUATHA_FORESTCLEARING_ROCKTHROWER_INACTIVE_TEXT :
"P4005243945" "We must not allow our land to be befouled."

// CROATOA_TUATHA_FORESTCLEARING_SPOTDIGGING_INACTIVE_TEXT :
"P1004258307" "Dig, dig, dig!"
// CROATOA_TUATHA_FORESTCLEARING_SPOTDIGGING_INACTIVE_TEXT :
"P922459649" "Unburden the land!"
// CROATOA_TUATHA_FORESTCLEARING_SPOTDIGGING_INACTIVE_TEXT :
"P638543057" "Purify this space!"

// CROATOA_TUATHA_RUMBLE_INACTIVE_DIALOG :
"P931180412" "Stupid Fir Bolg!"
// CROATOA_TUATHA_RUMBLE_INACTIVE_DIALOG :
"P2955248901" "We will wipe out your race!"
// CROATOA_TUATHA_RUMBLE_INACTIVE_DIALOG :
"P2630386135" "You are too pathetic to stand against us!"

// CROATOA_TUATHA_RUMBLE_ALERTED_DIALOG :
"P15406091" "Do not interfere!"
// CROATOA_TUATHA_RUMBLE_ALERTED_DIALOG :
"P2129793340" "You cannot stay our just wrath!"
// CROATOA_TUATHA_RUMBLE_ALERTED_DIALOG :
"P500875081" "You would be wise to leave these fools to their fate!"

// CROATOA_FIRBOLG_CHEERING_INACTIVE_DIALOG :
"P867726246" "Beat them, brothers!"
// CROATOA_FIRBOLG_CHEERING_INACTIVE_DIALOG :
"P1715603273" "Punish the interlopers!"
// CROATOA_FIRBOLG_CHEERING_INACTIVE_DIALOG :
"P965532732" "Show them our might!"

// CROATOA_TUATHA_FORESTCLEARING_HOWLING_INACTIVE_TEXT :
"P580945745" "For Dannan!"
// CROATOA_TUATHA_FORESTCLEARING_HOWLING_INACTIVE_TEXT :
"P4269452808" "For the Tuatha!"
// CROATOA_TUATHA_FORESTCLEARING_HOWLING_INACTIVE_TEXT :
"P3488174644" "For the earth!"

// CROATOA_FIRBOLG_CHEERING_ALERTED_DIALOG :
"P1376363720" "We can win this!"
// CROATOA_FIRBOLG_CHEERING_ALERTED_DIALOG :
"P449039526" "This is our battle!"
// CROATOA_FIRBOLG_CHEERING_ALERTED_DIALOG :
"P1072186942" "Don't interfere!"

// CROATOA_FIRBOLG_RUMBLE_INACTIVE_DIALOG :
"P3462593587" "Hah! The Fir Bolg have grown strong!"
// CROATOA_FIRBOLG_RUMBLE_INACTIVE_DIALOG :
"P4110329169" "We are more than match for you!"
// CROATOA_FIRBOLG_RUMBLE_INACTIVE_DIALOG :
"P99134573" "You assume too much, Tuatha!"

// CROATOA_FIRBOLG_RUMBLE_ALERTED_DIALOG :
"P571388538" "Stand back, human!"
// CROATOA_FIRBOLG_RUMBLE_ALERTED_DIALOG :
"P3154811883" "We have a job to do here!"
// CROATOA_FIRBOLG_RUMBLE_ALERTED_DIALOG :
"P2758672736" "Are you in league with these oppressors?"

// CROATOA_TUATHA_DANCING_INACTIVE_TEXT :
"P2192167968" "The air here feels so good!"
// CROATOA_TUATHA_DANCING_INACTIVE_TEXT :
"P129697046" "I could dance all day!"
// CROATOA_TUATHA_DANCING_INACTIVE_TEXT :
"P1731682536" "This land is truly ours for the taking!"

// CROATOA_TUATHA_CHEERING_INACTIVE_DIALOG :
"P4191634551" "We will take it all!"
// CROATOA_TUATHA_CHEERING_INACTIVE_DIALOG :
"P2368963160" "We will build a new legacy!"
// CROATOA_TUATHA_CHEERING_INACTIVE_DIALOG :
"P1620403623" "We will spread across this earth!"

// CROATOA_TUATHA_DANCING_ALERTED_TEXT :
"P2889641971" "What are you doing here?"
// CROATOA_TUATHA_DANCING_ALERTED_TEXT :
"P983874462" "Back away, human, or suffer our wrath!"

// CROATOA_TUATHA_DANCEOBSERVE_INACTIVE_TEXT :
"P3757429251" "It is glorious!"
// CROATOA_TUATHA_DANCEOBSERVE_INACTIVE_TEXT :
"P343674194" "Sing out, brothers!"
// CROATOA_TUATHA_DANCEOBSERVE_INACTIVE_TEXT :
"P657715066" "Let your spirit sing!"

// CROATOA_TUATHA_CHEERING_ALERTED_DIALOG :
"P1004750513" "Get back!"
// CROATOA_TUATHA_CHEERING_ALERTED_DIALOG :
"P1097008854" "What is your purpose here?"
// CROATOA_TUATHA_CHEERING_ALERTED_DIALOG :
"P1095530649" "A spy for the Fir Bolg!"

// CROATOA_TUATHA_DANCEOBSERVE_ALERTED_TEXT :
"P2957680809" "Brothers, beware!"
// CROATOA_TUATHA_DANCEOBSERVE_ALERTED_TEXT :
"P367562021" "An outsider approaches!"
// CROATOA_TUATHA_DANCEOBSERVE_ALERTED_TEXT :
"P915065148" "Guard yourselves. It is a stranger."

// CROATOA_TUATHA_DANCELOITER_INACTIVE_TEXT :
"P19197715" "I will keep you safe, brothers."
// CROATOA_TUATHA_DANCELOITER_INACTIVE_TEXT :
"P746018805" "None will disrupt us here."
// CROATOA_TUATHA_DANCELOITER_INACTIVE_TEXT :
"P1259895636" "I will allow no trespassers."

// CROATOA_TUATHA_DANCELOITER_ALERTED_TEXT :
"P3742006679" "Leave us be!"
// CROATOA_TUATHA_DANCELOITER_ALERTED_TEXT :
"P4246769959" "This is our land!"
// CROATOA_TUATHA_DANCELOITER_ALERTED_TEXT :
"P3434459722" "How dare you disturb our dance?"

// CROATOA_TUATHA_DANCEMENACE_INACTIVE_TEXT :
"P1702530994" "Yes! Dance for Dannan!"
// CROATOA_TUATHA_DANCEMENACE_INACTIVE_TEXT :
"P2926862123" "Dance for joy!"
// CROATOA_TUATHA_DANCEMENACE_INACTIVE_TEXT :
"P1652791865" "Let the world know our glory!"

// CROATOA_TUATHA_DANCEMENACE_ALERTED_TEXT :
"P578314378" "Who goes there?"
// CROATOA_TUATHA_DANCEMENACE_ALERTED_TEXT :
"P1204011084" "Our dance is ruined!"
// CROATOA_TUATHA_DANCEMENACE_ALERTED_TEXT :
"P1340973621" "Stranger, you have roused my wrath."

// CROATOA_TUATHA_DANCEHOWL_INACTIVE_TEXT :
"P3970008015" "Ayoooaaahhh!"
// CROATOA_TUATHA_DANCEHOWL_INACTIVE_TEXT :
"P561215731" "Wooaaahhh!"
// CROATOA_TUATHA_DANCEHOWL_INACTIVE_TEXT :
"P2736295628" "Dannnaaaan!"

// CROATOA_TUATHA_DANCEHOWL_ALERTED_TEXT :
"P3681587147" "Grrraaarrr!"
// CROATOA_TUATHA_DANCEHOWL_ALERTED_TEXT :
"P2236717186" "Grooooowwr!"
// CROATOA_TUATHA_DANCEHOWL_ALERTED_TEXT :
"P2719805437" "Stranger!"

// CROATOA_TUATHA_INVASIONPREPARATION_LEADER_INACTIVE_TEXT :
"P936453119" "Remember: we must move quickly, but silently."
// CROATOA_TUATHA_INVASIONPREPARATION_LEADER_INACTIVE_TEXT :
"P692899537" "We will likely meet with Fir Bolg resistance."
// CROATOA_TUATHA_INVASIONPREPARATION_LEADER_INACTIVE_TEXT :
"P2642023507" "Do not be afraid to use your full strength against the vile Fir Bolg."

// CROATOA_TUATHA_INVASIONPREPARATION_LEADER_ALERTED_TEXT :
"P590768001" "The time for battle has come!"
// CROATOA_TUATHA_INVASIONPREPARATION_LEADER_ALERTED_TEXT :
"P2358394286" "Get ready to fight!"
// CROATOA_TUATHA_INVASIONPREPARATION_LEADER_ALERTED_TEXT :
"P4035261115" "Prove your valor!"
// CROATOA_TUATHA_INVASIONPREPARATION_LEADER_ALERTED_TEXT :
"P1166898802" "We will scatter the Fir Bolg like autumn leaves!"

// CROATOA_TUATHA_INVASIONPREPARATION_HOWLINGCHEER_INACTIVE_TEXT :
"P2169625673" "We will take Salamanca by force!"
// CROATOA_TUATHA_INVASIONPREPARATION_HOWLINGCHEER_INACTIVE_TEXT :
"P3617037247" "We will root out the rabble!"
// CROATOA_TUATHA_INVASIONPREPARATION_HOWLINGCHEER_INACTIVE_TEXT :
"P3754017550" "We will triumph easily!"
// CROATOA_TUATHA_INVASIONPREPARATION_HOWLINGCHEER_INACTIVE_TEXT :
"P788437931" "We will drag them to the lake and drown out all memory of them!"

// CROATOA_TUATHA_INVASIONPREPARATION_HOWLINGCHEER_ALERTED_TEXT :
"P1645050492" "Invaders!"
// CROATOA_TUATHA_INVASIONPREPARATION_HOWLINGCHEER_ALERTED_TEXT :
"P276174204" "We are discovered!"
// CROATOA_TUATHA_INVASIONPREPARATION_HOWLINGCHEER_ALERTED_TEXT :
"P560140591" "We must eliminate these spies!"

// CROATOA_TUATHA_INVASIONPREPARATION_MENACE_INACTIVE_TEXT :
"P918280216" "Let's do some damage!"
// CROATOA_TUATHA_INVASIONPREPARATION_MENACE_INACTIVE_TEXT :
"P1211711001" "Let's stomp Salamanca into dust!"
// CROATOA_TUATHA_INVASIONPREPARATION_MENACE_INACTIVE_TEXT :
"P2540045788" "We will massacre any opposition!"
// CROATOA_TUATHA_INVASIONPREPARATION_MENACE_INACTIVE_TEXT :
"P342607465" "Make them pay for their impertinence!"

// CROATOA_TUATHA_INVASIONPREPARATION_MENACE_ALERTED_TEXT :
"P724254599" "I will crush your throat!"
// CROATOA_TUATHA_INVASIONPREPARATION_MENACE_ALERTED_TEXT :
"P436904014" "How dare you spy on us?"
// CROATOA_TUATHA_INVASIONPREPARATION_MENACE_ALERTED_TEXT :
"P1598304964" "We will begin the carnage here!"

// CROATOA_TUATHA_INVASIONPREPARATION_CHEERING_INACTIVE_TEXT :
"P38769565" "For our people!"
// CROATOA_TUATHA_INVASIONPREPARATION_CHEERING_INACTIVE_TEXT :
"P1506503733" "We must be victorious!"
// CROATOA_TUATHA_INVASIONPREPARATION_CHEERING_INACTIVE_TEXT :
"P2153574943" "We must rule over all!"
// CROATOA_TUATHA_INVASIONPREPARATION_CHEERING_INACTIVE_TEXT :
"P3860905674" "This night we will feast on pumpkin, my brothers!"

// CROATOA_TUATHA_INVASIONPREPARATION_CHEERING_ALERTED_TEXT :
"P348545480" "Raise your weapons!"
// CROATOA_TUATHA_INVASIONPREPARATION_CHEERING_ALERTED_TEXT :
"P1882675550" "Charge!"
// CROATOA_TUATHA_INVASIONPREPARATION_CHEERING_ALERTED_TEXT :
"P783507810" "Destroy this stranger!"
// CROATOA_TUATHA_INVASIONPREPARATION_CHEERING_ALERTED_TEXT :
"P3023411822" "Show neither fear nor mercy!"

// PL_TUATHA_HEADINGTOINVASIONPOINT_INACTIVE_TEXT :
"P2474051755" "We need to get to the meeting place."
// PL_TUATHA_HEADINGTOINVASIONPOINT_INACTIVE_TEXT :
"P3095513314" "The invasion can't start without us!"
// PL_TUATHA_HEADINGTOINVASIONPOINT_INACTIVE_TEXT :
"P2578742182" "I don't want to miss the rally."
// PL_TUATHA_HEADINGTOINVASIONPOINT_INACTIVE_TEXT :
"P1904530652" "We should not expect a quick battle. Our enemies' hatred of us will fuel their strength."

// PL_TUATHA_HEADINGTOINVASIONPOINT_ALERTED_TEXT :
"P524201458" "We can't be delayed!"
// PL_TUATHA_HEADINGTOINVASIONPOINT_ALERTED_TEXT :
"P3857521193" "Out of our way!"
// PL_TUATHA_HEADINGTOINVASIONPOINT_ALERTED_TEXT :
"P65248738" "We have important business to conduct!"

// CROATOA_TUATHA_INVASIONPREP_GETTINGIMPATIENT_INACTIVE_TEXT :
"P3511758203" "I'm ready to fight!"
// CROATOA_TUATHA_INVASIONPREP_GETTINGIMPATIENT_INACTIVE_TEXT :
"P3841414227" "I need some action."
// CROATOA_TUATHA_INVASIONPREP_GETTINGIMPATIENT_INACTIVE_TEXT :
"P3120432230" "Let's go!"

// CROATOA_TUATHA_TOTEMPLACER_INACTIVE_TEXT :
"P2184820354" "This stone will mark our land."
// CROATOA_TUATHA_TOTEMPLACER_INACTIVE_TEXT :
"P1665388704" "Our dominance must be known."
// CROATOA_TUATHA_TOTEMPLACER_INACTIVE_TEXT :
"P3139961962" "We will own this world."

// CROATOA_TUATHA_INVASIONPREP_GETTINGIMPATIENT_ALERTED_TEXT :
"P332675550" "At last! Battle!"
// CROATOA_TUATHA_INVASIONPREP_GETTINGIMPATIENT_ALERTED_TEXT :
"P832423465" "I'm eager to test my strength."
// CROATOA_TUATHA_INVASIONPREP_GETTINGIMPATIENT_ALERTED_TEXT :
"P1023279389" "Finally! It begins!"

// CROATOA_TUATHA_TOTEMPLACER_ALERTED_TEXT :
"P2153886829" "Who disrupts my work?"
// CROATOA_TUATHA_TOTEMPLACER_ALERTED_TEXT :
"P852564833" "I will not be stopped!"

// CROATOA_TUATHA_INVASIONPREP_LOITER_INACTIVE_TEXT :
"P404701970" "Are we almost ready?"
// CROATOA_TUATHA_INVASIONPREP_LOITER_INACTIVE_TEXT :
"P1444068680" "Let's move soon."
// CROATOA_TUATHA_INVASIONPREP_LOITER_INACTIVE_TEXT :
"P307357980" "I'm getting nervous standing around here."
// CROATOA_TUATHA_INVASIONPREP_LOITER_INACTIVE_TEXT :
"P1198660312" "Should we believe the rumors of an alliance between the Fir Bolg and the Cabal?"

// CROATOA_TUATHA_TOTEMCHEERING_INACTIVE_TEXT :
"P3332232815" "Hurry! We must place more!"
// CROATOA_TUATHA_TOTEMCHEERING_INACTIVE_TEXT :
"P3913962101" "Our enemies will shudder!"
// CROATOA_TUATHA_TOTEMCHEERING_INACTIVE_TEXT :
"P2325961188" "Everyone will fear us!"
// CROATOA_TUATHA_TOTEMCHEERING_INACTIVE_TEXT :
"P3311723453" "The Fir Bolg will fight fiercely, my brothers. There is that much courage in them."

// CROATOA_TUATHA_INVASIONPREP_LOITER_ALERTED_TEXT :
"P1998419807" "Silence this one!"
// CROATOA_TUATHA_INVASIONPREP_LOITER_ALERTED_TEXT :
"P502872868" "We've got trouble!"
// CROATOA_TUATHA_INVASIONPREP_LOITER_ALERTED_TEXT :
"P779462392" "We're not ready!"

// CROATOA_TUATHA_TOTEMCHEERING_ALERTED_TEXT :
"P3559298437" "I will protect the stone!"
// CROATOA_TUATHA_TOTEMCHEERING_ALERTED_TEXT :
"P3247257048" "You will not break it!"
// CROATOA_TUATHA_TOTEMCHEERING_ALERTED_TEXT :
"P2614653792" "This stone is sacred!"

// CROATOA_TUATHA_INVASIONPREP_SPOTTINGINTRUDERS_ALERTED_TEXT :
"P2234834543" "I see someone!"
// CROATOA_TUATHA_INVASIONPREP_SPOTTINGINTRUDERS_ALERTED_TEXT :
"P39312721" "Alert! Alert!"
// CROATOA_TUATHA_INVASIONPREP_SPOTTINGINTRUDERS_ALERTED_TEXT :
"P2051020361" "Watch out! We've been discovered!"

// CROATOA_TUATHA_TOTEM_OBSERVER_INACTIVE_TEXT :
"P566482455" "Yes. Let everyone see."
// CROATOA_TUATHA_TOTEM_OBSERVER_INACTIVE_TEXT :
"P228838233" "Sow the fear of the Tuatha."
// CROATOA_TUATHA_TOTEM_OBSERVER_INACTIVE_TEXT :
"P3835064261" "Show our might."

// CROATOA_TUATHA_TOTEM_OBSERVER_ALERTED_TEXT :
"P1916899487" "Get away!"
// CROATOA_TUATHA_TOTEM_OBSERVER_ALERTED_TEXT :
"P3580235856" "Save the marker!"

// CROATOA_TUATHA_INVASIONPREP_PLANNING_INACTIVE_TEXT :
"P1941945640" "All right. We come in from the north."
// CROATOA_TUATHA_INVASIONPREP_PLANNING_INACTIVE_TEXT :
"P1852566381" "Be prepared for light casualties."
// CROATOA_TUATHA_INVASIONPREP_PLANNING_INACTIVE_TEXT :
"P3913717379" "The Fir Bolg will never know what hit them!"
// CROATOA_TUATHA_INVASIONPREP_PLANNING_INACTIVE_TEXT :
"P2525226528" "Do not be afraid. The Cabal has not power enough to stop our plan."

// CROATOA_TUATHA_INVASIONPREP_PLANNING_ALERTED_TEXT :
"P2382432625" "Our plans must be carried out!"
// CROATOA_TUATHA_INVASIONPREP_PLANNING_ALERTED_TEXT :
"P2050116763" "We cannot allow this one to ruin our plans!"
// CROATOA_TUATHA_INVASIONPREP_PLANNING_ALERTED_TEXT :
"P4287757993" "This human must die!"

// CROATOA_TUATHA_TOTEMPLACE_INACTIVE_TEXT :
"P4028516911" "More stones! More stones!"
// CROATOA_TUATHA_TOTEMPLACE_INACTIVE_TEXT :
"P557530035" "This will show our worth!"
// CROATOA_TUATHA_TOTEMPLACE_INACTIVE_TEXT :
"P3891378406" "I need some help."

// CROATOA_TUATHA_TOTEMPLACE_ALERTED_TEXT :
"P2302984870" "Help me save it!"
// CROATOA_TUATHA_TOTEMPLACE_ALERTED_TEXT :
"P1271549277" "Don't let them uproot it!"
// CROATOA_TUATHA_TOTEMPLACE_ALERTED_TEXT :
"P1535434734" "Get rid of that human!"

// CROATOA_TUATHA_TOTEMSUPERVISE_INACTIVE_TEXT :
"P1766603782" "We need to place more of these."
// CROATOA_TUATHA_TOTEMSUPERVISE_INACTIVE_TEXT :
"P3598470977" "We have lots more work to do."
// CROATOA_TUATHA_TOTEMSUPERVISE_INACTIVE_TEXT :
"P1144466310" "Keep it straight."

// CROATOA_TUATHA_TOTEMSUPERVISE_ALERTED_TEXT :
"P2362264380" "Careful, brothers."
// CROATOA_TUATHA_TOTEMSUPERVISE_ALERTED_TEXT :
"P1041566383" "We have trouble!"
// CROATOA_TUATHA_TOTEMSUPERVISE_ALERTED_TEXT :
"P290485806" "You are not of the Tuatha!"

// CROATOA_TUATHA_3WAYRUMBLE_INACTIVE_TEXT :
"P3940659183" "The Tuatha will rule this land!"
// CROATOA_TUATHA_3WAYRUMBLE_INACTIVE_TEXT :
"P1674895496" "Croatoa is yours no longer!"

// CROATOA_FIR_3WAYRUMBLE_INACTIVE_TEXT :
"P1342368944" "Villains! You are all villains!"
// CROATOA_FIR_3WAYRUMBLE_INACTIVE_TEXT :
"P3617195940" "We will never surrender!"
// CROATOA_FIR_3WAYRUMBLE_INACTIVE_TEXT :
"P2190294637" "The cause of the Fir Bolg is just!"

// CROATOA_CABAL_3WAYRUMBLE_INACTIVE_TEXT :
"P1142241687" "Foolish beasts! Your petty war distracts you from the real enemy!"
// CROATOA_CABAL_3WAYRUMBLE_INACTIVE_TEXT :
"P3175463552" "We have studied long and hard: we have the might to beat you!"
// CROATOA_CABAL_3WAYRUMBLE_INACTIVE_TEXT :
"P1044081743" "We will learn from you what we need, then destroy you!"

// CROATOA_TUATHA_RISE_FROM_WATER_INACTIVE_TEXT :
"P2559422815" "I arise!"
// CROATOA_TUATHA_RISE_FROM_WATER_INACTIVE_TEXT :
"P387562194" "This land will feel the strength of the Tuatha!"
// CROATOA_TUATHA_RISE_FROM_WATER_INACTIVE_TEXT :
"P2395992587" "I claim this earth for Dannan!"

// CROATOA_TUATHA_RISE_FROM_WATER_ALERTED_TEXT :
"P1937934152" "Who challenges the Tuatha?"
// CROATOA_TUATHA_RISE_FROM_WATER_ALERTED_TEXT :
"P1104606757" "You will not stop us!"
// CROATOA_TUATHA_RISE_FROM_WATER_ALERTED_TEXT :
"P2361365814" "We are strong enough to take this land from you!"

// PL_TUATHA_PATROLLINGNEWCONNAUGHTBORDER_INACTIVE_TEXT :
"P674677182" "We must defend against all enemies."
// PL_TUATHA_PATROLLINGNEWCONNAUGHTBORDER_INACTIVE_TEXT :
"P2513286092" "These borders must be secured."
// PL_TUATHA_PATROLLINGNEWCONNAUGHTBORDER_INACTIVE_TEXT :
"P962337697" "We cannot tolerate incursions!"

// PL_TUATHA_PATROLLINGNEWCONNAUGHTBORDER_ALERTED_TEXT :
"P1985730154" "You invade our lands!"
// PL_TUATHA_PATROLLINGNEWCONNAUGHTBORDER_ALERTED_TEXT :
"P4227799024" "You are not Tuatha!"

// CROATOA_TUATHA_JACKWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P3478786799" "The creature will free us from our enemies!"
// CROATOA_TUATHA_JACKWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P1142920184" "The hideous giant can crush the Fir Bolg beneath his boot."
// CROATOA_TUATHA_JACKWORSHIP_EOCHAISTORYTELLER_INACTIVE_TEXT :
"P1739746642" "We have nothing to fear from Jack in Irons!"

// CROATOA_TUATHA_JACKWORSHIP_EOCHAISTORYTELLER_ALERTED_TEXT :
"P302471075" "Who is it?"
// CROATOA_TUATHA_JACKWORSHIP_EOCHAISTORYTELLER_ALERTED_TEXT :
"P3389305280" "This is a private time."
// CROATOA_TUATHA_JACKWORSHIP_EOCHAISTORYTELLER_ALERTED_TEXT :
"P1406278277" "You are most unwelcome."

// CROATOA_TUATHA_JACKWORSHIP_CHEERING_INACTIVE_TEXT :
"P2608644055" "Yes! Let him crush the Fir Bolg!"
// CROATOA_TUATHA_JACKWORSHIP_CHEERING_INACTIVE_TEXT :
"P2471942127" "Let him bring them to ruin!"
// CROATOA_TUATHA_JACKWORSHIP_CHEERING_INACTIVE_TEXT :
"P2412111970" "Let the Fir Bolg feel the giant's wrath!"

// CROATOA_TUATHA_JACKWORSHIP_CHEERING_ALERTED_TEXT :
"P899161318" "We will not be accosted here!"
// CROATOA_TUATHA_JACKWORSHIP_CHEERING_ALERTED_TEXT :
"P1222026019" "These are our lands!"
// CROATOA_TUATHA_JACKWORSHIP_CHEERING_ALERTED_TEXT :
"P4025347408" "You cannot stop the giant!"

// CROATOA_TUATHA_JACKWORSHIP_SITTING_INACTIVE_TEXT :
"P470972643" "If you say so, I will believe it."
// CROATOA_TUATHA_JACKWORSHIP_SITTING_INACTIVE_TEXT :
"P4028867687" "I cannot help but fear the giant."
// CROATOA_TUATHA_JACKWORSHIP_SITTING_INACTIVE_TEXT :
"P2360372622" "I hope you are right."

// CROATOA_TUATHA_JACKWORSHIP_SITTING_ALERTED_TEXT :
"P1896830620" "Danger!"
// CROATOA_TUATHA_JACKWORSHIP_SITTING_ALERTED_TEXT :
"P2463023754" "Who lurks there?"
// CROATOA_TUATHA_JACKWORSHIP_SITTING_ALERTED_TEXT :
"P480751328" "There are enemies all around!"

// CROATOA_TUATHA_JACKWORSHIP_PRAYER_INACTIVE_TEXT :
"P466464857" "I wish only the death of the Fir Bolg."
// CROATOA_TUATHA_JACKWORSHIP_PRAYER_INACTIVE_TEXT :
"P138529215" "Let the Tuatha's reign return."
// CROATOA_TUATHA_JACKWORSHIP_PRAYER_INACTIVE_TEXT :
"P388651676" "Oh, Dannan! Let us triumph over our enemies."

// CROATOA_TUATHA_JACKWORSHIP_PRAYER_ALERTED_TEXT :
"P2054096595" "You will not hurt my brothers!"
// CROATOA_TUATHA_JACKWORSHIP_PRAYER_ALERTED_TEXT :
"P2116149418" "This is our place!"
// CROATOA_TUATHA_JACKWORSHIP_PRAYER_ALERTED_TEXT :
"P763890856" "How dare you trespass here?"

// CROATOA_TUATHA_JACKWORSHIP_BOWING_INACTIVE_TEXT :
"P2534445368" "Yes! Destruction!"
// CROATOA_TUATHA_JACKWORSHIP_BOWING_INACTIVE_TEXT :
"P2108786033" "To the glory of the Tuatha!"
// CROATOA_TUATHA_JACKWORSHIP_BOWING_INACTIVE_TEXT :
"P1101526282" "Yes! We will be supreme!"

// CROATOA_TUATHA_JACKWORSHIP_BOWING_ALERTED_TEXT :
"P2098303096" "Stop!"
// CROATOA_TUATHA_JACKWORSHIP_BOWING_ALERTED_TEXT :
"P3452831754" "Do not anger me!"
// CROATOA_TUATHA_JACKWORSHIP_BOWING_ALERTED_TEXT :
"P1744064332" "You know not where you step."

// CROATOA_TUATHA_GUARDING_SLOWDAYLOOKOUT_INACTIVE_TEXT :
"P2126175356" "Nothing's happening. We should go home."
// CROATOA_TUATHA_GUARDING_SLOWDAYLOOKOUT_INACTIVE_TEXT :
"P3992851470" "I'm tired of all this conflict, I tell you."
// CROATOA_TUATHA_GUARDING_SLOWDAYLOOKOUT_INACTIVE_TEXT :
"P1706247890" "I just want to sleep and forget all this war."

// CROATOA_TUATHA_GUARDING_SLOWDAYLOOKOUT_ALERTED_TEXT :
"P2774815385" "An enemy!"
// CROATOA_TUATHA_GUARDING_SLOWDAYLOOKOUT_ALERTED_TEXT :
"P1299068204" "An attack!"
// CROATOA_TUATHA_GUARDING_SLOWDAYLOOKOUT_ALERTED_TEXT :
"P2922943842" "Why do you meddle with us?"

