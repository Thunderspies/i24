// CROATOA_SPIRITS_HAUNTING_INACTIVE_TEXT :
"P1223573788" "I hate... this world!"
// CROATOA_SPIRITS_HAUNTING_INACTIVE_TEXT :
"P338611399" "This village... must join me... in death!"
// CROATOA_SPIRITS_HAUNTING_INACTIVE_TEXT :
"P3847886482" "I will tear... Salamanca... apart!"

// CROATOA_SPIRITS_HAUNTING_ALERTED_TEXT :
"P692991380" "You... will be the first... to die!"
// CROATOA_SPIRITS_HAUNTING_ALERTED_TEXT :
"P2015440464" "You... will be my first... victim!"
// CROATOA_SPIRITS_HAUNTING_ALERTED_TEXT :
"P3797363318" "Slaughter! Massacre!"
// CROATOA_SPIRITS_HAUNTING_ALERTED_TEXT :
"P857956430" "You are not... welcome... here!"

// CROATOA_SPIRITS_SEARCHING_INACTIVE_TEXT :
"P881794293" "Where... is it?"
// CROATOA_SPIRITS_SEARCHING_INACTIVE_TEXT :
"P1083981806" "Where is... my body?"
// CROATOA_SPIRITS_SEARCHING_INACTIVE_TEXT :
"P2932772765" "I can't find... my... home!"
// CROATOA_SPIRITS_SEARCHING_INACTIVE_TEXT :
"P541063162" "My... daughter! Where... is she?"

// CROATOA_SPIRITS_SEARCHING_ALERTED_TEXT :
"P870076420" "You've stolen... this life... from me!"
// CROATOA_SPIRITS_SEARCHING_ALERTED_TEXT :
"P1937453726" "I can't... stand it... anymore!"
// CROATOA_SPIRITS_SEARCHING_ALERTED_TEXT :
"P1140235911" "You... will suffer... with me!"

// CROATOA_GHOSTS_HAUNTINGHOUSE_INACTIVE_TEXT :
"P3956685100" "No peace... for those... who enter here."
// CROATOA_GHOSTS_HAUNTINGHOUSE_INACTIVE_TEXT :
"P2477214454" "This home... will know... only suffering!"
// CROATOA_GHOSTS_HAUNTINGHOUSE_INACTIVE_TEXT :
"P376282701" "I claim this home... as mine! All others must... depart!"

// CROATOA_GHOSTS_HAUNTINGHOUSE_ALERTED_TEXT :
"P2748419770" "Stop there!"
// CROATOA_GHOSTS_HAUNTINGHOUSE_ALERTED_TEXT :
"P177415712" "You will not move me... from this place!"
// CROATOA_GHOSTS_HAUNTINGHOUSE_ALERTED_TEXT :
