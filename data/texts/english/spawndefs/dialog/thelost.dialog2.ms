// RIKTI_ATTACK_TEXT :
"P3207419419" "You will bow to my strength!"
// RIKTI_ATTACK_TEXT :
"P3415663780" "You are nothing to me!"
// RIKTI_ATTACK_TEXT :
"P4265565886" "You think I'm beneath you?"

// RIKTI_DEALING_DEAL_TEXT :
"P571882286" "I got the good stuff."
// RIKTI_DEALING_DEAL_TEXT :
"P952542239" "Prime ooze, right here."
// RIKTI_DEALING_DEAL_TEXT :
"P3764216236" "Want to feel like a million bucks?"

// RIKTI_DEALING_ATTACK_TEXT :
"P2649821522" "You just want it for yourself!"
// RIKTI_DEALING_ATTACK_TEXT :
"P342580173" "You think you know what's best for us?"
// RIKTI_DEALING_ATTACK_TEXT :
"P2269853649" "You heroes, always around when you're not wanted!"
// RIKTI_DEALING_ATTACK_TEXT :
"P1569462323" "You are not welcome!"

