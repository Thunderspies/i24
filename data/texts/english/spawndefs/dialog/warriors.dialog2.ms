// SHADYDEAL_BAGMAN_INACTIVE_TEXT :
"P3055271508" "Make a decision."
// SHADYDEAL_BAGMAN_INACTIVE_TEXT :
"P1022938238" "Looking for something special?"

// SHADYDEAL_BUYER_INACTIVE_TEXT :
"P402882765" "Your price is steep."
// SHADYDEAL_BUYER_INACTIVE_TEXT :
