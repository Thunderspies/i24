// VANDALISM_VANDAL_INACTIVE_TEXT :
"P2264096818" "I will own this town."
// VANDALISM_VANDAL_INACTIVE_TEXT :
"P3297812525" "Time for destruction."
// VANDALISM_VANDAL_INACTIVE_TEXT :
"P1229839065" "This is my arena."
