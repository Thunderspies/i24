// MUGGING_VICTIM_INACTIVE_TEXT :
"P3562234103" "I need a hero!"

// MUGGING_MUSCLE_ATTACK_TEXT :
"P3597335551" "The enemy approaches."
// MUGGING_MUSCLE_ATTACK_TEXT :
"P3800233810" "Watch out."
// MUGGING_MUSCLE_ATTACK_TEXT :
"P3205608437" "Trouble is upon us."
// MUGGING_MUSCLE_ATTACK_TEXT :
