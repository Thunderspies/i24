// BREAKIN_PICKER_INACTIVE_TEXT :
"P74009805" "Cease your prattling!"
// BREAKIN_PICKER_INACTIVE_TEXT :
"P1308447618" "You will soon arouse suspiscion."
// BREAKIN_PICKER_INACTIVE_TEXT :
"P949331176" "I will conquer this lock."
// BREAKIN_PICKER_INACTIVE_TEXT :
"P641250413" "You truly are a blowhard."

// BREAKIN_WATCHER_INACTIVE_TEXT :
"P1194082517" "Hurry!"
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P3167043424" "Spped is of the essence."
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P2462673427" "Do you know what you're doing?"
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P1624021570" "We will be discovered if you don't hurry."
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P1395880380" "Your abilities seem questionable."
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P2956464593" "How much longer will thi take?"
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P4110316274" "May I assist?"
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P110628186" "Could you possibly go any slower?"
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P947406699" "You are trying my patience."
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P3712884241" "This wait is intolerable."
// BREAKIN_WATCHER_INACTIVE_TEXT :
"P4015568111" "I don't intend to wait all day."

// BREAKIN_WATCHER_ATTACK_TEXT :
"P3141471353" "We are caught!"
// BREAKIN_WATCHER_ATTACK_TEXT :
"P2795328021" "The city's pathetic defenders have arrived."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P2394067016" "We have been spotted. Now, we must fight."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P3474202600" "Be attentive. The enemy is near."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P1598191317" "Battle is nigh."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P1654862875" "Fool! Your incompetence has cost us."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P4165030246" "Our combat skills are about to be tested."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P2289634126" "Justice descends."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P1211958809" "I will not be imprisoned."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P2537045635" "fight for your freedom!"
// BREAKIN_WATCHER_ATTACK_TEXT :
"P2022002092" "The heroes surround us."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P2672423925" "If you want a battle, I can provide it."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P1746521675" "These odds don't favor us."
// BREAKIN_WATCHER_ATTACK_TEXT :
"P1726256666" "We are in danger."

// MUGGING_MUGGER_INACTIVE_TEXT :
"P650958516" "Relinquish the money."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P4131759442" "Is that worth dying for? I think not."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P942539073" "Stop resisting. Your money will be mine."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P2620370026" "Your bravery is admirable, if foolhardy."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P3854421191" "Obey me, or regret your insolence."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P1923773082" "I will give you one more opportunity to give up."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P1377840129" "This encounter has a certain end.."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P3600599969" "I have no wish to hurt you, but I will."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P3753263036" "Cease your resistence, or I will make an example of you."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P1353596466" "Tell me: is that money worth your life?"
// MUGGING_MUGGER_INACTIVE_TEXT :
"P1532362569" "Hand over your valuables."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P142165907" "You are too weak to pose a threat."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P3118021896" "Allow me to make your wallet lighter."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P186811776" "No one has to die here."
// MUGGING_MUGGER_INACTIVE_TEXT :
"P141127038" "I will resort to violence if I must."

// MUGGING_VICTIM_INACTIVE_TEXT :
"P497384158" "Help! Someone, help!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P1685875453" "I'm being robbed!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P1062775966" "I'm not giving you anything."
// MUGGING_VICTIM_INACTIVE_TEXT :
"P2798586382" "Leave me alone."
// MUGGING_VICTIM_INACTIVE_TEXT :
"P4248138240" "Get away from me."
// MUGGING_VICTIM_INACTIVE_TEXT :
"P631915100" "Why me?"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P4251648856" "Where's a costume when you need one?"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P1863953117" "Cease and desist you ruffian."
// MUGGING_VICTIM_INACTIVE_TEXT :
"P2433024189" "You're going to regret this."
// MUGGING_VICTIM_INACTIVE_TEXT :
"P2872902157" "Save me!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P453840256" "I need assistance!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P4035074803" "Don't hurt me!"
// MUGGING_VICTIM_INACTIVE_TEXT :
"P718371534" "I don't want to die!"
// MUGGING_VICTIM_INACTIVE_TEXT :
