// SHADYDEAL_BAGMAN_INACTIVE_TEXT :
"P1888683465" "I need an answer."
// SHADYDEAL_BAGMAN_INACTIVE_TEXT :
"P2313403883" "Are you a coward?"
// SHADYDEAL_BAGMAN_INACTIVE_TEXT :
