// ATLAS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P1384347342" "You can't send me back!  Nooooo!"
// ATLAS_GENERIC_LOITER_TALKER_ALERT_TEXT :
"P1462670826" "They followed us from Mercy!"

