// DARKASTORIA_KOA_VERSUS_INACTIVE_TEXT :
"P1327198001" "Submit to us, Sisters!"
// DARKASTORIA_KOA_VERSUS_INACTIVE_TEXT :
"P498090148" "There is another way.  We will show you!"
// DARKASTORIA_KOA_VERSUS_INACTIVE_TEXT :
"P19304544" "You are broken and incomplete..."
// DARKASTORIA_KOA_VERSUS_INACTIVE_TEXT :
"P815859866" "There is meaning... it was all for this end!"

// DARKASTORIA_KOA_VERSUS_ACTIVE_TEXT :
"P15406091" "Do not interfere!"
// DARKASTORIA_KOA_VERSUS_ACTIVE_TEXT :
"P3049489987" "The time has passed! Kill them all!"
// DARKASTORIA_KOA_VERSUS_ACTIVE_TEXT :
"P724165425" "You have squandered everything!"
// DARKASTORIA_KOA_VERSUS_ACTIVE_TEXT :
"P4041838588" "You will die! Your life was meaningless!"

// DARKASTORIA_KOA_DEFEND_INACTIVE_TEXT :
"P70853364" "No! Lies! You have betrayed everything!"
// DARKASTORIA_KOA_DEFEND_INACTIVE_TEXT :
"P1310234301" "You... you have fallen so far!"
// DARKASTORIA_KOA_DEFEND_INACTIVE_TEXT :
"P1250399914" "You have become monsters!"
// DARKASTORIA_KOA_DEFEND_INACTIVE_TEXT :
"P2302417239" "We were sisters once... now you are abominations!"

// DARKASTORIA_KOA_DEFEND_ACTIVE_TEXT :
"P3200332411" "This matter is our own!"
// DARKASTORIA_KOA_DEFEND_ACTIVE_TEXT :
"P4146294348" "You shall be purged!"
// DARKASTORIA_KOA_DEFEND_ACTIVE_TEXT :
"P2477703750" "Enemies! Abominations! Kill them all!"

// DARKASTORIA_KOA_IMPRESS_INACTIVE :
"P3401065801" "Behold sisters! Another child has come home!"
// DARKASTORIA_KOA_IMPRESS_INACTIVE :
"P361476142" "This is a glorious fate!"
// DARKASTORIA_KOA_IMPRESS_INACTIVE :
"P1133789888" "From the moment you were chosen, this has always been your fate!"
// DARKASTORIA_KOA_IMPRESS_INACTIVE :
"P2327766960" "Fortunately, the process does not demand you be willing..."

// DARKASTORIA_KOA_IMPRESS_ACTIVE :
"P1232800189" "No! You'll ruin everything!"
// DARKASTORIA_KOA_IMPRESS_ACTIVE :
"P355258383" "How dare you interfere?!"
// DARKASTORIA_KOA_IMPRESS_ACTIVE :
"P1257296689" "This is ruined! Slay them all!"

// DARKASTORIA_IMPRESS_INACTIVE_TEXT :
"P740084705" "No! I don't want to be like you!"
// DARKASTORIA_IMPRESS_INACTIVE_TEXT :
"P1452320976" "What have you become?!"
// DARKASTORIA_IMPRESS_INACTIVE_TEXT :
"P3207151954" "How can you do this?! Please stop!"

// DARKASTORIA_IMPRESS_ACTIVE_TEXT :
"P2223417555" "I will not be thrall to anyone!"
// DARKASTORIA_IMPRESS_ACTIVE_TEXT :
"P3002664638" "Beasts! Monsters! Abominations! Everywhere!"

// DARKASTORIA_JUDGED_INACTIVE_TEXT :
"P569843038" "I... I don't know what you're talking about!"
// DARKASTORIA_JUDGED_INACTIVE_TEXT :
"P3314032443" "Why are you doing this?!"
// DARKASTORIA_JUDGED_INACTIVE_TEXT :
"P804684666" "Please, let me go!"
// DARKASTORIA_JUDGED_INACTIVE_TEXT :
"P2028570002" "Whatever it is you think I've done... I'm sorry! Please!"

// DARKASTORIA_JUDGE_ACTIVE_TEXT :
"P1359469159" "These things are crazy!"
// DARKASTORIA_JUDGE_ACTIVE_TEXT :
"P3427812054" "Screw this! Everyone here is insane!"
// DARKASTORIA_JUDGE_ACTIVE_TEXT :
"P1478782743" "This wont end well..."

// DARKASTORIA_JUDGMENT_INACTIVE_TEXT :
"P1367895798" "You have been tried and sentenced... Prepare yourself!"
// DARKASTORIA_JUDGMENT_INACTIVE_TEXT :
"P3231463396" "We have seen enough! We need no other proof of your wickedness!"
// DARKASTORIA_JUDGMENT_INACTIVE_TEXT :
"P2067889742" "Just by being here, you prove your guilt!"
// DARKASTORIA_JUDGMENT_INACTIVE_TEXT :
"P1942043919" "Death! Death to the guilty!"

// DARKASTORIA_JUDGEMENT_ACTIVE_TEXT :
"P3494671883" "Do not stand in the way of our retribution!"
// DARKASTORIA_JUDGEMENT_ACTIVE_TEXT :
"P3613935112" "More wickedness! Slay them all!"
// DARKASTORIA_JUDGEMENT_ACTIVE_TEXT :
"P686650593" "Your conspirators have arrived! Take them!"
// DARKASTORIA_JUDGEMENT_ACTIVE_TEXT :
"P3948551280" "There can be no rescue for the guilty!"

