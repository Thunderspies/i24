// SHAKEDOWN_STORE_THREATENER_INACTIVE_TEXT :
"P3201610103" "It's such a pleasant establishment.  It would be shame to lose."

// SHAKEDOWN_STORE_THREATENER_ATTACK_TEXT :
"P2387783702" "Your interference will lead to a confrontation."
// SHAKEDOWN_STORE_THREATENER_ATTACK_TEXT :
"P3660581149" "Don't tell us how to run our neighborhood!"
// SHAKEDOWN_STORE_THREATENER_ATTACK_TEXT :
"P1406278277" "You are most unwelcome."
// SHAKEDOWN_STORE_THREATENER_ATTACK_TEXT :
"P4146376404" "We will not be stopped!"

// SHAKEDOWN_STORE_VICTIM_INACTIVE_TEXT :
"P2700026574" "Stop these guys from strong-arming me!"
// SHAKEDOWN_STORE_VICTIM_INACTIVE_TEXT :
