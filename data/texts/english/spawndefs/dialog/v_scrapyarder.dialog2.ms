// SHARKHEAD_PORTRECLUSE_PICKETMARCH_ALERT_TEXT :
"P4251577344" "You're a distant memory!"


// SHARKHEAD_ALLHOODS_STEALING_OUTOFDOOR_ALERT_TEXT :
"P1888232565" "Now's not the time for chit chat!  RUN!"
// SHARKHEAD_ALLHOODS_STEALING_OUTOFDOOR_ALERT_TEXT :
