// SHARKHEAD_ALLHOODS_WELDER_ALERT_TEXT :
"P51668374" "Now I gotta hurt you."

// SHARKHEAD_ALLHOODS_TAUNTED_FIGHTERA_INACTIVE_TEXT :
"P4183058370" "Oh, you've pushed me too far now!"
// SHARKHEAD_ALLHOODS_TAUNTED_FIGHTERA_INACTIVE_TEXT :
