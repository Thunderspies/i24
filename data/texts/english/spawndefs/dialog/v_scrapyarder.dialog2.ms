// SHARKHEAD_ALLHOODS_JACKHAMMERING_ALERT_TEXt :
"P2003918949" "Stand still so I can use this on you!"
// SHARKHEAD_ALLHOODS_JACKHAMMERING_ALERT_TEXt :
