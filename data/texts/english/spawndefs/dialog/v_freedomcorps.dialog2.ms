// BLOODYBAY_HEROBASE_GUARDDOOR_ATTACK_TEXT :
"P401351497" "You will not get through!"
// BLOODYBAY_HEROBASE_GUARDDOOR_ATTACK_TEXT :
"P2149390667" "Breach!  Protect the base!"
// BLOODYBAY_HEROBASE_GUARDDOOR_ATTACK_TEXT :
"P2619461398" "Maintain your post!  Defend the base!"

// BLOODYBAY_HEROBASE_WALKIETALKIE_INACTIVE_TEXT :
"P3157257100" "Keep a vigilant watch, heroes.  This is priority one."
// BLOODYBAY_HEROBASE_WALKIETALKIE_INACTIVE_TEXT :
"P775593000" "Yes, sir, we're clear here."
// BLOODYBAY_HEROBASE_WALKIETALKIE_INACTIVE_TEXT :
"P3839249710" "We're on it, sir."
// BLOODYBAY_HEROBASE_WALKIETALKIE_INACTIVE_TEXT :
"P1237732965" "Yes, sir, we'll keep it secure."

// BLOODYBAY_HEROBASE_WALKIETALKIE_ATTACK_TEXT :
"P2510177923" "Intruder!"
// BLOODYBAY_HEROBASE_WALKIETALKIE_ATTACK_TEXT :
"P3019564000" "You know what to do!"
// BLOODYBAY_HEROBASE_WALKIETALKIE_ATTACK_TEXT :
"P1192947324" "We have intruders!  Out."

// BLOODYBAY_HEROBASE_ORDERS_LEADER_INACTIVE_TEXT :
"P2216582013" "This base's security rests securely on our shoulders.  We cannot fail."
// BLOODYBAY_HEROBASE_ORDERS_LEADER_INACTIVE_TEXT :
"P2810828100" "There is no option for failure, team.  We must keep this base secure."
// BLOODYBAY_HEROBASE_ORDERS_LEADER_INACTIVE_TEXT :
"P2903919821" "It is our duty and privilege to keep this base secure."
// BLOODYBAY_HEROBASE_ORDERS_LEADER_INACTIVE_TEXT :
"P2177000949" "We cannot fail our brothers and sisters.  This base must remain secure."
// BLOODYBAY_HEROBASE_ORDERS_LEADER_INACTIVE_TEXT :
"P803623314" "After the briefing you'll be splitting up into patrols and base watches."
// BLOODYBAY_HEROBASE_ORDERS_LEADER_INACTIVE_TEXT :
"P4086108138" "The base is our primary objective.  Keeping heroes safe is our duty."
// BLOODYBAY_HEROBASE_ORDERS_LEADER_INACTIVE_TEXT :
"P2599983977" "Higher ranking heroes will stay behind for recon orders."
// BLOODYBAY_HEROBASE_ORDERS_LEADER_INACTIVE_TEXT :
"P1096364655" "Recon teams have identified their base as heavily fortified."

// BLOODYBAY_HEROBASE_ORDERS_LEADER_ATTACK_TEXT :
"P1153891823" "Dismissed!  Take care of the intruders!"
// BLOODYBAY_HEROBASE_ORDERS_LEADER_ATTACK_TEXT :
"P2286571358" "This is what we've trained for, heroes!"
// BLOODYBAY_HEROBASE_ORDERS_LEADER_ATTACK_TEXT :
"P3414235059" "Failure is not an option!"

// BLOODYBAY_HEROBASE_PATROL_INACTIVE_TEXT :
"P1217176841" "The safety of this facility is our main objective.  Keep a good watch, heroes."
// BLOODYBAY_HEROBASE_PATROL_INACTIVE_TEXT :
"P887049166" "Be vigilant, heroes.  Never let your guard down."
// BLOODYBAY_HEROBASE_PATROL_INACTIVE_TEXT :
"P1982642523" "Don't let your guard down."
// BLOODYBAY_HEROBASE_PATROL_INACTIVE_TEXT :
"P2373507734" "Keep a watchful eye, heroes."

// BLOODYBAY_HEROBASE_PATROL_ATTACK_TEXT :
"P3846354935" "Patrol!  We have intruders!"
// BLOODYBAY_HEROBASE_PATROL_ATTACK_TEXT :
"P1931571658" "Sir, villains have entered the base!"
// BLOODYBAY_HEROBASE_PATROL_ATTACK_TEXT :
"P1007470389" "We have company!"
// BLOODYBAY_HEROBASE_PATROL_ATTACK_TEXT :
"P2688626409" "The base has been breached!"

// BLOODYBAY_RECON_WALKIETALKIE_INACTIVE_TEXT :
"P568175629" "...the base is heavily guarded...over."
// BLOODYBAY_RECON_WALKIETALKIE_INACTIVE_TEXT :
"P3201241792" "We're going to need more men for this."
// BLOODYBAY_RECON_WALKIETALKIE_INACTIVE_TEXT :
"P3352861922" "Heavily fortified.  Over."
// BLOODYBAY_RECON_WALKIETALKIE_INACTIVE_TEXT :
"P1603147609" "Sir, the enemy's base is very heavily protected."
// BLOODYBAY_RECON_WALKIETALKIE_INACTIVE_TEXT :
"P3275757731" "It's pretty dark, but I can see a lot of firepower."
// BLOODYBAY_RECON_WALKIETALKIE_INACTIVE_TEXT :
"P697467267" "Stealth missions will be next to impossible."

// BLOODYBAY_RECON_WALKIETALKIE_ATTACK_TEXT :
"P1318460847" "I've been discovered!  Over and out!"
// BLOODYBAY_RECON_WALKIETALKIE_ATTACK_TEXT :
"P1692043986" "Detected!  Over and out!"
// BLOODYBAY_RECON_WALKIETALKIE_ATTACK_TEXT :
"P2005484863" "Bad luck for me.  Let's do this!"

// BLOODYBAY_RECON_BINOCULARS_INACTIVE_TEXT :
"P3102333853" "Pass this on:  the base is heavily fortified."
// BLOODYBAY_RECON_BINOCULARS_INACTIVE_TEXT :
"P2803098409" "Wow, they have some serious firepower here."
// BLOODYBAY_RECON_BINOCULARS_INACTIVE_TEXT :
"P3506457146" "Oh man, this place is locked down tight."
// BLOODYBAY_RECON_BINOCULARS_INACTIVE_TEXT :
"P3245179615" "I can't even count how many turrets they have."
// BLOODYBAY_RECON_BINOCULARS_INACTIVE_TEXT :
"P3422260734" "A few patrols.  Lots of lookout.  This'll be interesting."
// BLOODYBAY_RECON_BINOCULARS_INACTIVE_TEXT :
"P1800130929" "Pretty hard to see through these things at night."

// BLOODYBAY_RECON_BINOCULARS_ATTACK_TEXT :
"P297138413" "Incoming!"
// BLOODYBAY_RECON_BINOCULARS_ATTACK_TEXT :
"P2904038148" "We're not alone!"
// BLOODYBAY_RECON_BINOCULARS_ATTACK_TEXT :
"P534836926" "We've got company!"

// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_INACTIVE_TEXT :
"P3904243086" "I wasn't doing a THING.  You got the wrong guy."
// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_INACTIVE_TEXT :
"P2648532346" "I'm not talking.  Give it up."
// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_INACTIVE_TEXT :
"P294556170" "Whatever.  You're not getting anything out of me."
// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_INACTIVE_TEXT :
"P1290821395" "Warriors don't squeal on each other."
// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_INACTIVE_TEXT :
"P3887963517" "I want my lawyer."
// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_INACTIVE_TEXT :
"P1689726134" "Whatever it was, I didn't do it."
// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_INACTIVE_TEXT :
"P1100399839" "I wasn't there.  Wasn't me."

// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_ALERT_TEXT :
"P2536979577" "Hey, thanks for the diversion, dork!"
// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_ALERT_TEXT :
"P1816234769" "Sweet distraction!"
// SIRENSCALL_BUILDVILLE_APPREHEND_AGAINSTWALL_ALERT_TEXT :
"P3930165315" "Cool!  More mayhem, half the work!"

// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_INACTIVE_TEXT :
"P3303166178" "Keep your hands against the wall."
// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_INACTIVE_TEXT :
"P1102825604" "You thought we wouldn't get you?"
// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_INACTIVE_TEXT :
"P2890175278" "There is a crossbow pointed at your back.  Mouthing off wouldn't be smart."
// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_INACTIVE_TEXT :
"P2011524570" "My arms are tired and my finger is twitchy.  You might want to start talking."
// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_INACTIVE_TEXT :
"P3696508418" "You Warriors never learn.  Your hands are covered in spray paint."
// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_INACTIVE_TEXT :
"P1452755755" "You had the handbag on you."
// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_INACTIVE_TEXT :
"P3817763367" "You Warriors keep trying to mess up Buildville.  I want to know why."

// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_ALERT_TEXT :
"P2725911560" "Head's up!  We have company!"
// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_ALERT_TEXT :
"P4041932799" "Look alive, Corps, we have company!"
// SIRENSCALL_BUILDVILLE_APPREHEND_CROSSBOW_ALERT_TEXT :
"P1916660419" "Watch out!"

// SIRENSCALL_BUILDVILLE_APPREHEND_WALKIETALKIE_INACTIVE_TEXT :
"P2220687433" "Let's take them in for further questioning."
// SIRENSCALL_BUILDVILLE_APPREHEND_WALKIETALKIE_INACTIVE_TEXT :
"P3513589954" "Yes, sir.  We got them.  We'll bring them in shortly."
// SIRENSCALL_BUILDVILLE_APPREHEND_WALKIETALKIE_INACTIVE_TEXT :
"P2858364155" "Yes, sir.  Just a few minutes ago.  Thank you."
// SIRENSCALL_BUILDVILLE_APPREHEND_WALKIETALKIE_INACTIVE_TEXT :
"P978338110" "Yes, sir.  They're in custody."
// SIRENSCALL_BUILDVILLE_APPREHEND_WALKIETALKIE_INACTIVE_TEXT :
"P872591428" "Some Warriors were acting up in Talos Park.  We'll be right in."

// SIRENSCALL_BUILDVILLE_BLOCKADE_ARMSCROSSED_INACTIVE_TEXT :
"P1597505124" "Protect Buildville.  No one gets past this blockade."
// SIRENSCALL_BUILDVILLE_BLOCKADE_ARMSCROSSED_INACTIVE_TEXT :
"P1489004453" "Shoulder to shoulder, no one gets through without ID."
// SIRENSCALL_BUILDVILLE_BLOCKADE_ARMSCROSSED_INACTIVE_TEXT :
"P2066233344" "Too much chaos.  We need to block the area.  Keep it safe."

// SIRENSCALL_BUILDVILLE_BLOCKADE_ARMSCROSSED_ALERT_TEXT :
"P3568500458" "We have incoming!"
// SIRENSCALL_BUILDVILLE_BLOCKADE_ARMSCROSSED_ALERT_TEXT :
"P3813457828" "Bad guys incoming!"
// SIRENSCALL_BUILDVILLE_BLOCKADE_ARMSCROSSED_ALERT_TEXT :
"P291546725" "Show them who's in control!"

// SIRENSCALL_TALOSPARK_CAUGHT_INTERROGATOR_INACTIVE_TEXT :
"P1206506262" "Just tell me what I want to know, then we'll talk terms."
// SIRENSCALL_TALOSPARK_CAUGHT_INTERROGATOR_INACTIVE_TEXT :
"P3090962217" "What were you thinking?"
// SIRENSCALL_TALOSPARK_CAUGHT_INTERROGATOR_INACTIVE_TEXT :
"P3221052035" "Did you seriously think you wouldn't get caught?"
// SIRENSCALL_TALOSPARK_CAUGHT_INTERROGATOR_INACTIVE_TEXT :
"P3309387378" "For a smart mouth you're pretty dumb."

// SIRENSCALL_TALOSPARK_CAUGHT_INTERROGATOR_ALERT_TEXT :
"P2913747503" "Interrogate him later, we have bad guys!"

// SIRENSCALL_TALOSPARK_CAUGHT_WARRIORS_INACTIVE_TEXT :
"P875650696" "I have nothing to say."
// SIRENSCALL_TALOSPARK_CAUGHT_WARRIORS_INACTIVE_TEXT :
"P2808284533" "You can't keep me here like this."
// SIRENSCALL_TALOSPARK_CAUGHT_WARRIORS_INACTIVE_TEXT :
"P3501878027" "I already know you won't torture me, so I got nothing to say."
// SIRENSCALL_TALOSPARK_CAUGHT_WARRIORS_INACTIVE_TEXT :
"P767465309" "You don't have the guts to get anything out of me."

// SIRENSCALL_TALOSPARK_CAUGHT_WARRIORS_ALERT_TEXT :
"P2602945758" "Thanks for the diversion, meat!"
// SIRENSCALL_TALOSPARK_CAUGHT_WARRIORS_ALERT_TEXT :
"P162250322" "Nice going, meat!"
// SIRENSCALL_TALOSPARK_CAUGHT_WARRIORS_ALERT_TEXT :
"P1728110425" "Should I stay or should I go now?  Oh, I'll stay!"

// SIRENSCALL_TALOSPARK_CAUGHT_WALKIETALKIE_INACTIVE_TEXT :
"P3221874928" "In custody, sir.  What are your orders?"
// SIRENSCALL_TALOSPARK_CAUGHT_WALKIETALKIE_INACTIVE_TEXT :
"P11979409" "Of course, sir.  I'll come in as soon we're done here."
// SIRENSCALL_TALOSPARK_CAUGHT_WALKIETALKIE_INACTIVE_TEXT :
"P168162431" "Yes, sir, I caught him here in Talos Park."

// SIRENSCALL_TALOSPARK_CAUGHT_TSOO_INACTIVE_TEXT :
"P2378498974" "I will not speak to you."
// SIRENSCALL_TALOSPARK_CAUGHT_TSOO_INACTIVE_TEXT :
"P155375904" "You have no authority over me."
// SIRENSCALL_TALOSPARK_CAUGHT_TSOO_INACTIVE_TEXT :
"P1345276997" "You will regret this."
// SIRENSCALL_TALOSPARK_CAUGHT_TSOO_INACTIVE_TEXT :
"P302576643" "You will pay for this."

// SIRENSCALL_TALOSPARK_CAUGHT_TSOO_ALERT_TEXT :
"P2684868233" "You were foolish to think you could keep me!"
// SIRENSCALL_TALOSPARK_CAUGHT_TSOO_ALERT_TEXT :
"P210112018" "And now, the hunted becomes the hunter!"
// SIRENSCALL_TALOSPARK_CAUGHT_TSOO_ALERT_TEXT :
"P2449406727" "Tsoo will make their displeasure at this interrogation felt!"

// SIRENSCALL_ALLHOODS_GUARDDOOR_ALERT_TEXT :
"P250494982" "No one gets past!"
// SIRENSCALL_ALLHOODS_GUARDDOOR_ALERT_TEXT :
"P593815365" "You should have stayed away!"
// SIRENSCALL_ALLHOODS_GUARDDOOR_ALERT_TEXT :
"P43713711" "I won't let you pass!"

// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CITIZENCHATTER_INACTIVE_TEXT :
"P2372683655" "Can I have your picture?"
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CITIZENCHATTER_INACTIVE_TEXT :
"P4220177080" "Ohmigosh, this is great.  How long have you been in Longbow?"
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CITIZENCHATTER_INACTIVE_TEXT :
"P1887425418" "Have you ever been hurt?"
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CITIZENCHATTER_INACTIVE_TEXT :
"P394038834" "Do you always patrol Siren's Call or do you travel around?"
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CITIZENCHATTER_INACTIVE_TEXT :
"P3761662076" "I'm new from Steel Canyon!  Day trip, can you believe it?"
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CITIZENCHATTER_INACTIVE_TEXT :
"P3698033095" "What are you going to do about the wall?"

// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CORPSCHATTER_INACTIVE_TEXT :
"P3262379184" "All in a day's work."
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CORPSCHATTER_INACTIVE_TEXT :
"P1778214017" "We just want to keep citizens safe."
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CORPSCHATTER_INACTIVE_TEXT :
"P2462249202" "The job is an honor for all Longbow members."

// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CORPSCHATTER_ALERT_TEXT :
"P4246604505" "Take cover, citizen!  Quick!  We need to take care of this!"
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CORPSCHATTER_ALERT_TEXT :
"P3673612468" "Go!  Now!  We'll take care of this!"
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CORPSCHATTER_ALERT_TEXT :
"P3397590736" "Chat time is over!"
// SIRENSCALL_BUILDVILLE_FREEDOMCHAT_CORPSCHATTER_ALERT_TEXT :
"P782888844" "Please excuse me!  Duty calls!"

// SIRENSCALL_BUILDVILLE_PATROL_INACTIVE_TEXT :
"P3905848202" "I noticed a larger Warrior presence here in Buildville last week."
// SIRENSCALL_BUILDVILLE_PATROL_INACTIVE_TEXT :
"P278022265" "We'll make a few more circuits then swap patrols with the Talos Park crew."
// SIRENSCALL_BUILDVILLE_PATROL_INACTIVE_TEXT :
"P267784828" "Maintain a vigil watch.  The streets are thick with bad guys today."

// SIRENSCALL_BUILDVILLE_PATROL_ALERT_TEXT :
"P3178375819" "Here we go!"
// SIRENSCALL_BUILDVILLE_PATROL_ALERT_TEXT :
"P791978600" "Okay, Corps, you know what to do!"
// SIRENSCALL_BUILDVILLE_PATROL_ALERT_TEXT :
"P2210405481" "Keep Buildville secure!"

// SIRENSCALL_TALOSPARK_PATROL_INACTIVE_TEXT :
"P515346035" "This place never sleeps.  Neither should we.  March on."
// SIRENSCALL_TALOSPARK_PATROL_INACTIVE_TEXT :
"P893914054" "Wait up."
// SIRENSCALL_TALOSPARK_PATROL_INACTIVE_TEXT :
"P2523877299" "A few more circuits and then we'll switch patrols with the Buildville crew."
// SIRENSCALL_TALOSPARK_PATROL_INACTIVE_TEXT :
"P2522611640" "Eyes peeled, Longbow."
// SIRENSCALL_TALOSPARK_PATROL_INACTIVE_TEXT :
"P2474922948" "Talos Park does not sleep.  Neither do we.  March on."

// SIRENSCALL_TALOSPARK_PATROL_ALERT_TEXT :
"P3049496690" "Keep Talos Park secure!"
// SIRENSCALL_TALOSPARK_PATROL_ALERT_TEXT :
"P1908113444" "This is not a drill!  Keep Talos Park secure!"

// NERVA_AGINCOURT_AERIALSEARCHNIGHT_INACTIVE_TEXT :
"P1084401840" "Lot of activity down there, sir."
// NERVA_AGINCOURT_AERIALSEARCHNIGHT_INACTIVE_TEXT :
"P3083152354" "They never learn.  Sir, we got some activity down there."
// NERVA_AGINCOURT_AERIALSEARCHNIGHT_INACTIVE_TEXT :
"P4232555258" "Scanning now, sir.  I'm on it."
// NERVA_AGINCOURT_AERIALSEARCHNIGHT_INACTIVE_TEXT :
"P2242946337" "Agincourt's a hotbed of activity."
// NERVA_AGINCOURT_AERIALSEARCHNIGHT_INACTIVE_TEXT :
"P1920140974" "Sheez.  The roaches really do come out at night."

// NERVA_AGINCOURT_AERIALSEARCHNIGHT_ALERT_TEXT :
"P2908465699" "I got some heat, sir.  Over and out!"
// NERVA_AGINCOURT_AERIALSEARCHNIGHT_ALERT_TEXT :
"P3527206246" "Hold on a sec, sir, I got something here."

// NERVA_CRIMSON_CRUZ_AERIALSEARCHNIGHT_INACTIVE_TEXT :
"P820577494" "Crimson really is a hotbed of activity."


// NERVA_AGINCOURT_AIRPATROL_INACTIVE_TEXT :
"P544798140" "See that?  Let's fly over there to check it out."
// NERVA_AGINCOURT_AIRPATROL_INACTIVE_TEXT :
"P1310794695" "Right behind you, sir."
// NERVA_AGINCOURT_AIRPATROL_INACTIVE_TEXT :
"P1995486967" "Hold up a sec."
// NERVA_AGINCOURT_AIRPATROL_INACTIVE_TEXT :
"P1867123961" "When we finish the Agincourt patrol, let's head over to Crimson."

// NERVA_AGINCOURT_AIRPATROL_ALERT_TEXT :
"P1946914470" "Stay together, guys!"
// NERVA_AGINCOURT_AIRPATROL_ALERT_TEXT :
"P4053825360" "Watch yourself!  I see some heat."
// NERVA_AGINCOURT_AIRPATROL_ALERT_TEXT :
"P1933803763" "I see something!"

// NERVA_PRIMEVA_AIRPATROL_INACTIVE_TEXT :
"P2480478747" "I saw some Crey on the beach in an earlier patrol."
// NERVA_PRIMEVA_AIRPATROL_INACTIVE_TEXT :
"P195410425" "I'm going to need to refuel soon.  One more trip around?"
// NERVA_PRIMEVA_AIRPATROL_INACTIVE_TEXT :
"P807538764" "Let's finish this patrol, then I need to get back to base."


// NERVA_CRIMSON_AIRPATROL_INACTIVE_TEXT :
"P2461846521" "Stay up here.  We'll radio guys on the ground if we see something."
// NERVA_CRIMSON_AIRPATROL_INACTIVE_TEXT :
"P278669876" "I'm going to need to refuel soon, guys."
// NERVA_CRIMSON_AIRPATROL_INACTIVE_TEXT :
"P981877794" "One more pass then we head back to base."
// NERVA_CRIMSON_AIRPATROL_INACTIVE_TEXT :
"P1667552956" "You're a bit sluggish.  Everything okay?"


// NERVA_CRIMSON_COLLABORATE_FC_INACTIVE_TEXT :
