// ----------------------------------------------------------------------------------------------
// Source File : data/scripts/SpawnDefs/ZoneEvents/Halloween2011Trial/_src/Halloween_11_trial.xls 	Sheet : ZE_Halloween_2011_NPCTallman 
//
// Script      : Xlstospawndef.bat 
