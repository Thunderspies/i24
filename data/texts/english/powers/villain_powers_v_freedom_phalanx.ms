// -------------------------------------------------------------------------------- 
// Power : Psionic Blast 
// -------------------------------------------------------------------------------- 
// Display Name :
"P4043578058" "Psionic Blast"
// Power Mouse-Over Text :
"P4176814676" "Ranged, High DMG (Psionic), -Rech(Foe)"
// Power Help Text :
"P840867967" "You fire a psionic burst at the target, causing damage and increasing recharge time."
// DisplayTargetShortHelp :
"P3721528132" "-Rech"
// DisplayTargetHelp :
"P479275776" "Your recharge rate has been reduced!"
// Effect VictimHit Message :
"P836607518" "{PlayerSource} hits you with a {PowerName} for {Damage} points of psionic damage and lowers your recharge rate!"

// -------------------------------------------------------------------------------- 
// Power : Psionic Crush 
// -------------------------------------------------------------------------------- 
// Display Name :
"P1938572341" "Psionic Crush"
// Power Mouse-Over Text :
"P1385854695" "Ranged, DoT (Psionic), -Endurance(Foe), Hold(Foe)"
// Power Help Text :
"P587756611" "You imprison your target in a field of collapsing psionic energy. They are held in place and suffer continuous damage and endurance loss."
// DisplayTargetShortHelp :
"P2221929303" "DoT (Psionic), -Endurance"
// DisplayTargetHelp :
"P3396203752" "You are suffering psionic damage over time and losing endurance!"
// Effect VictimHit Message :
"P2883455073" "{PlayerSource} holds you with her {PowerName}."
// Effect VictimHit Message :
"P2657413938" "{PlayerSource}'s {PowerName} causes {Damage} points of psionic damage and drains your endurance!"
// Effect VictimHit Message :
"P4281441417" "{PlayerSource}'s {PowerName} strikes you for a final burst, causing {Damage} points of psionic damage."

// -------------------------------------------------------------------------------- 
// Power : Psionic Torment 
// -------------------------------------------------------------------------------- 
// Display Name :
"P692062634" "Psionic Torment"
// Power Mouse-Over Text :
"P2892763903" "Ranged, High DMG (Psionic), DoT(Lethal), -End(Foe), -Regen(Foe), -Rec(Foe), -Rech(Foe)"
// Power Help Text :
"P3617882692" "You create painful visions within the mind of your target, and these visions manifest as bleeding wounds. When the visions end, the targets suffer reduced regeneration, recovery and recharge rate."
// DisplayTargetShortHelp :
"P1469938864" "DoT(Lethal), -End, -Regen, -Rec, -Rech"
// DisplayTargetHelp :
"P293206814" "You are suffering lethal damage and endurance loss over time. Additionally, your regeneration, recovery and recharge rate have been reduced."
// Effect VictimHit Message :
"P2406693638" "{PlayerSource} creates unrelenting torment within your mind, causing {Damage} points of psionic damage."
// Effect VictimHit Message :
"P265833478" "Your mind makes the pain of {PlayerSource}'s {PowerName} real, causing {Damage} points of lethal damage and draining your endurance."

// -------------------------------------------------------------------------------- 
// Power : Psionic Drift 
// -------------------------------------------------------------------------------- 
// Display Name :
"P4146362474" "Psionic Drift"
// Power Mouse-Over Text :
"P3148822177" "PBAoE, High DMG (Psionic), Minor DoT (Psionic), Stun/Fear/Confuse(Foe)"
// Power Help Text :
"P1327586528" "You induce a dream state in all nearby targets around you while also dealing continuous psionic damage. These dreams can manifest as nightmares, lucid dreams or deep sleep, which manifest as fear, confusion or stun."
// DisplayTargetShortHelp :
"P211773159" "DoT (Psionic), Special"
// DisplayTargetHelp :
"P4091344101" "You are suffering psionic damage over time and are either feared, confused or stunned."
// Effect VictimHit Message :
"P2146801776" "{PlayerSource} causes your mind to be affected by {PowerName}, inducing weakness and causing {Damage} points of psionic damage!"
// Effect VictimHit Message :
"P2834630215" "You continue to suffer {Damage} points of psionic damage while your mind is trapped in {PowerName}."

// -------------------------------------------------------------------------------- 
// Power : Psionic Pulse 
// -------------------------------------------------------------------------------- 
// Display Name :
"P2757588380" "Psionic Pulse"
// Power Mouse-Over Text :
"P2494817372" "PBAoE, Moderate DMG (Psionic, Smashing), Knockup(Foe)"
// Power Help Text :
"P226875044" "You unleash a powerful psionic shockwave that ripples through the air around you, dealing Psionic and Smashing damage to any hit by the wave. The shockwave also has a chance to knockback its targets."
// DisplayTargetShortHelp :
"P2644570344" "Knockup"
// DisplayTargetHelp :
"P1353582034" "You are knocked off your feet!"
// Effect VictimHit Message :
"P1759764591" "{PlayerSource} hits you with a {PowerName} for {Damage} points of psionic damage!"
// Effect VictimHit Message :
"P2166676930" "{PlayerSource} hits you with a {PowerName} for {Damage} points of smashing damage!"
// Effect VictimHit Message :
"P3368937999" "You are knocked of your feet by the {PowerName}!"

// -------------------------------------------------------------------------------- 
// Power : Psionic Blade 
// -------------------------------------------------------------------------------- 
// Display Name :
"P2654453422" "Psionic Blade"
// Power Mouse-Over Text :
"P4270877096" "Melee, Moderate DMG(Psionic), Moderate DoT (Lethal), -Def(Foe, All)"
// Power Help Text :
"P1661657711" "You create a blade of crystalline psionic energy around your hand and use it to stab your target with a quick attack. The target suffers psionic damage, followed by a bleeding wound and reduced defense."
// DisplayTargetShortHelp :
"P661514070" "-Def(All)"
// DisplayTargetHelp :
"P919969351" "Your defenses have been reduced."
// Effect VictimHit Message :
"P1501589382" "{PlayerSource} slashes you with her blade for {Damage} points of psionic damage and reduces your defense!"
// Effect VictimHit Message :
"P3029157703" "Your bleeding wounds from {PlayerSource}'s {PowerName} cause {Damage} points of lethal damage."

// -------------------------------------------------------------------------------- 
// Power : Psionic Thrust 
// -------------------------------------------------------------------------------- 
// Display Name :
"P3611631710" "Psionic Thrust"
// Power Mouse-Over Text :
"P2957459055" "Melee, High DMG (Psionic), Moderate DoT (Lethal), -Res(Foe, Psionic)"
// Power Help Text :
"P3914973950" "You create a blade of crystalline psionic energy around your hand and viciously stab your target. The target suffers psionic damage, followed by a bleeding wound and reduced resistance to further psionic damage."
// DisplayTargetShortHelp :
"P2443421899" "DoT(Lethal), -Res(Psionic)"
// DisplayTargetHelp :
"P2196353411" "You are bleeding and suffering from reduced resistance to psionic damage."
// Effect VictimHit Message :
"P2404923382" "{PlayerSource} cuts you with her {PowerName} for {Damage} points of psionic damage and reduces your resistance to psionic damage!"

// -------------------------------------------------------------------------------- 
// Power : Psionic Nexus 
// -------------------------------------------------------------------------------- 
// Display Name :
"P2452951707" "Psionic Nexus"
// Power Mouse-Over Text :
"P3418814687" "Summon"
// Power Help Text :
"P4164180957" "You create a a nexus of psionic energy at your location."
// Effect VictimHit Message :
"P1984608796" "{PlayerSource} creates a deadly {PowerName} to assist her in battle."

