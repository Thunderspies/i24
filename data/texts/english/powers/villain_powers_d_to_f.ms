// -------------------------------------------------------------------------------- 
// Display Name :
"P2220715012" "Stealth"
// Power Mouse-Over Text :
// Power Help Text :

// -------------------------------------------------------------------------------- 
// Power : Teleport 
// -------------------------------------------------------------------------------- 
// Display Name :
// Power Help Text :
"P1846118305" "Manticore has hacked into Paragon Cities Emergency Teleportation system and can use it to travel."

// -------------------------------------------------------------------------------- 
// Power : Maneuvers 
// -------------------------------------------------------------------------------- 
// Display Name :
"P3009043276" "Maneuvers"
// Power Mouse-Over Text :
"P1371705735" "PBAoE, Team +DEF(All), +DMG, Res(Taunt, Placate), +ACC, Res(Confuse, Fear), +Perception"
// Power Help Text :
"P569848964" "Good leaders are rare. These powers can grant bonuses to your and your teammates."
// DisplayPowerDefenseFloat :
"P2514521623" "Dodged"
