// Power Set : Tech_Damage_Field 
// -------------------------------------------------------------------------------- 
// DisplayName :
"P512038008" "Tech_Damage_Field"
// DisplayHelp :
"P1931455975" "This causes damage to all enemies in its radius."

// -------------------------------------------------------------------------------- 
