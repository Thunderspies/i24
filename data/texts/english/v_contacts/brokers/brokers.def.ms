// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Mickey_the_Filch 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Mickey the Filch 
// -------------------------------------------------------------------------------- 
// Name :
"P822914882" "Mickey the Filch"
// ProfessionString :
// DescriptionString :
"P3007315323" "Mickey used to be a bookkeeper for the Cage Consortium. How he got thrown out and didn't wind up in Potter's Field is a subject of some debate. Most think he got caught embezzling but had enough evidence hidden around to keep him from getting whacked."
// HelloString :
"P244828735" "I'm afraid my sources haven't reported any opportunities at the moment. Come back after you've completed a few more of your schemes and maybe I'll have something for you."
// IDontKnowYouString :
"P1194803623" "I'm afraid I don't know you. Perhaps you are looking for Kara the Scorpion."
// FirstVisitString :
"P1462068282" "Hello. I'm Mickey. I'm called the 'Filch,' but I think that's an unfair characterization. At any rate, I now have you in my files. I suggest you carry out your own business around here and I'll contact you as I hear about jobs that suit your particular abilities. <br><br><b>You're playing with serious business here in Sharkhead, {VillainName}, and if you want to earn my trust you'll have to work harder than you're used to. Pull five jobs, then we'll see about a heist.</b>"
// NoTasksRemainingString :
"P899918354" "My sources are quiet for the moment. Check back later and I'll let you know if anything's happening."
// PlayerBusyString :
"P25384732" "You're not ready for me right now. When you've finished some of your own schemes I might have something for you though."
// ComeBackLaterString :
"P136788597" "I'm afraid you're not quite ready for what I have in mind. Come back when you're Threat Level {Level}."
// RelationshipChangeString_ToFriend :
"P1780333750" "You're doing well, {VillainName}."
// RelationshipChangeString_ToConfidant :
"P2518502840" "You're doing well, {VillainName}, though I'm personally uncomfortable attracting so much attention."
// LocationString :
// IntroString :
"P2230824172" "Mickey isn't the most personable man, but he cooks the books for a lot of people and winds up with a lot of information."
// IntroAcceptString :
"P1071769565" "Choose Mickey the Filch"
// IntroSendoffString :
"P883515016" "Mickey isn't the most exciting guy around, but he's ruthlessly efficient."
// IntroduceOneContact :
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


