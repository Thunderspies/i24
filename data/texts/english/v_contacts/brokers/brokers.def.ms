// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Isabel_the_Knife 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Isabel the Knife 
// -------------------------------------------------------------------------------- 
// Name :
"P524292427" "Isabel the Knife"
// ProfessionString :
// DescriptionString :
"P1630660681" "Isabel runs a high-dollar escort service in Babylon. Her girls find out a million secrets, and Isabel sells each one for twice that. She's wired into just about everyone and everything going on in St. Martial. Just don't cross her. Those who do have often been surprised by her sultry agents."
// HelloString :
"P1732972599" "If you're looking for a good crime call {VillainName}. That's what I always say."
// IDontKnowYouString :
"P1781332905" "You're hot, sweetness, but I think you're looking for Ian the Shark instead."
// FirstVisitString :
"P1070444480" "Hi darling. It's simply grand to meet you. I'm Isabel the Knife. I run an escort service that caters only to the high-rollers around here. My people tell me what they hear, and I pass it on to people like you who can get things done quietly. Honor your bargains with me and I anticipate a long and lucrative friendship."
// NoTasksRemainingString :
"P3317172161" "I'm waiting on my girls to report in. Come back later and I might have something for you."
// PlayerBusyString :
"P3966010549" "You're far too busy right now, darling. Try back after you've finished some of your other business."
// ComeBackLaterString :
"P1311639460" "I prefer high-rollers, darling. Nothing personal. Come back when you're Threat Level {Level} and we'll talk more.."
// RelationshipChangeString_ToFriend :
"P1507642377" "There's a lot of pillow talk about you lately, {VillainName}. That means you're making an impression. Keep it up, tiger. Grrrowl!"
// RelationshipChangeString_ToConfidant :
"P1693471413" "You're so hot you're on fire, {VillainName}. Keep it up."
// LocationString :
// IntroString :
"P2810460132" "Isabel is as sweet as sugar, and as deadly as poison."
// IntroAcceptString :
"P1175655367" "Choose Isabel the Knife"
// IntroSendoffString :
"P637563202" "You'll enjoy Isabel's company. Just watch your back if things get rough. Her nickname is well-earned."
// IntroduceOneContact :
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


