// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Ian_the_Shark 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Ian the Shark 
// -------------------------------------------------------------------------------- 
// Name :
"P3025822895" "Ian the Shark"
// ProfessionString :
// DescriptionString :
"P76953377" "Ian is a professional gambler whose luck ran a little too good in Babylon. Most of the casinos banned the Irishman, so he took up fixing instead."
// HelloString :
"P2150047766" "Top o' the hour to you, {VillainName}. I'll send you a message as soon as I hear something ye'd be interested in."
// IDontKnowYouString :
"P587148214" "Are ye sure you're looking for me? Maybe you want Isabel the Knife instead."
// FirstVisitString :
"P3804757816" "Faith and begorrah, a fellow blackheart. Pleased to meet you, {VillainName}. I'm Ian the Shark. It's a fair name, I'd wager, as I've won more than me fair share o' games in me life, and not a one of them fairly. That's why they banned me from the Giza, they did. 'Tis fair enough though. I've got a new gig helping scoundrels like you break into the local banks and casinos. Split the profits with me and I promise I'll never cheat you."
// NoTasksRemainingString :
"P1954446657" "Sorry, mate. I've got nothin' for ye now."
// PlayerBusyString :
"P3441392199" "Ye've got enough goin' on now, boyo. Give me a whistle when you've finished some of your own schemes."
// ComeBackLaterString :
"P723917216" "Sorry, my friend. I deal only with the big ones. Threat Level {Level} and higher. I'd have to sail back to Ireland with me hat in me hands if I stooped any lower."
// RelationshipChangeString_ToFriend :
"P1455324106" "Your pot o' gold is right around the corner, my friend. You're doing well!"
// RelationshipChangeString_ToConfidant :
"P1129306445" "All I hear these days is how {VillainName} is tearing up the town. That's a sign you're movin' up, my friend."
// LocationString :
"P3437209096" "St. Martial"
// IntroString :
"P2860123665" "Ian the Shark met a lot of people in his gambling days. Now he bets on your ability to pull off a successful heist and split the loot with him."
// IntroAcceptString :
"P1721150367" "Choose Ian the Shark"
// IntroSendoffString :
"P2844465079" "Ian's a former gambler and a sure bet for finding the best heists in St. Martial."
// IntroduceOneContact :
"P706259802" "<A HREF=CONTACTLINK_INTRODUCE>I hear a friend of mine </a> is looking to meet you."
// IntroduceTwoContacts :
"P3428775255" "I hear some of my other  <A HREF=CONTACTLINK_INTRODUCE>friends</a> would like to meet you."
// -------------------------------------------------------------------------------- 


