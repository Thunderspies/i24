// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Warzone_Agent_Eckman 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Warzone Agent Eckman 
// -------------------------------------------------------------------------------- 
// Name :
"P3542170728" "Warzone Agent Eckman"
// ProfessionString :
"P3995015561" "Longbow Warzone Agent"
// DescriptionString :
"P2190039014" "Agent Eckman coordinates hero activities in the Bloody Bay warzone. Speak with Agent Eckman if you are willing to help with Longbow efforts in the area.<br><br><color red>All missions received from Agent Eckman will bring you into conflict with other players!</color>"
// HelloString :
"P2812261884" "<A HREF=CONTACTLINK_MISSIONS>Good to see you, {HeroName}!</a>"
// HelloString :
"P226519230" "<A HREF=CONTACTLINK_MISSIONS>Ready to fight the good fight?</a>"
// HelloString :
"P2745111831" "<A HREF=CONTACTLINK_MISSIONS>At ease, {HeroName}!</a>"
// IDontKnowYouString :
"P903895184" "We've got the situation covered, {HeroName}."
// FirstVisitString :
"P3713904608" "Greetings, {HeroName}! I've been expecting you! We've got a bit of a situation here. To be blunt, Bloody Bay is a bloody mess. There's all kinds of heroes and villains fighting each other here over the meteors scattered around the area. Worse yet, Arachnos Operatives are trying to sabotage Longbow's efforts to put things in order! If you're up for it, I'll set you up with some missions on behalf of Longbow. I'll warn you now though: Arachnos has been recruiting villains from the Rogue Islands to do their dirty work as well, so this'll be no cakewalk!"
// NoTasksRemainingString :
"P1789248399" "On behalf of Longbow, I'd like to thank you for your assistance in Bloody Bay!"
// PlayerBusyString :
"P858749162" "I'll need your undivided attention for the tasks at hand, {HeroName}."
// ComeBackLaterString :
"P223502298" "I have some combat missions for you {HeroName}, but it's classified beyond your current Security Level."
// RelationshipChangeString_ToFriend :
"P4232748363" "Good work, {HeroName}! I want you to take this communication device, so you can get in touch with me more easily."
// RelationshipChangeString_ToConfidant :
"P3408374614" "You're a real trooper, {HeroName}!"
// FailsafeLevelString :
"P3158708952" "You've done some great work for Longbow, {HeroName}, but there are other battles to be fought. I wish you well!"
// LocationString :
"P2175898299" "Bloody Bay"
// IntroString :
"P135747477" "Have you heard of Bloody Bay? It's a contested territory in the Rogue Isles where these strange but valuable meteors crashed. There's all kinds of conflict going on between heroes and villains there, but if you're interested in fighting the good fight, talk to Warzone Agent Eckman there. He can get you Science and Technology Enhancements."
// IntroAcceptString :
"P933778949" "Choose Warzone Operative Eckman"
// IntroSendoffString :
"P3662986869" "Bloody Bay is a nasty place full of all manner of villains. Be careful!"
// IntroduceOneContact :
"P1025659584" "I know <A HREF=CONTACTLINK_INTRODUCE>someone</A> who might have some work for you."
// IntroduceTwoContacts :
"P480858950" "I know some <A HREF=CONTACTLINK_INTRODUCE>people</A> who might give you some leads."
// PVPPATROL :
"P361172781" "Patrol Bloody Bay"
// PVPMISSION1 :
"P2950633201" "Defuse bombs to debuff villain damage"
// PVPMISSION2 :
"P948871786" "Rescue officer to debuff villain resistance"
// PVPMISSION3 :
"P2065548754" "Defend listening post to buff hero damage"
// PVPMISSION4 :
"P3149018681" "Recover technology to buff hero resistance"
// -------------------------------------------------------------------------------- 


