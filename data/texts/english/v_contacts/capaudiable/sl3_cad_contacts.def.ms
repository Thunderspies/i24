// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Golden_Roller 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Golden Roller 
// -------------------------------------------------------------------------------- 
// Name :
"P3342758254" "Golden Roller"
// ProfessionString :
"P677863237" "Goldbricker Troubleshooter"
// DescriptionString :
"P3878414411" "No one knows who the Golden Roller really is, only that he gets his name from the sleek gold luxury car he drives around Cap Au Diable. The word on the street is he's a troubleshooter for the Goldbrickers, the high-tech thieves that plague the island."
// HelloString :
"P2155496620" "<A HREF=CONTACTLINK_MISSIONS>Let's get down to business, shall we?</A>"
// HelloString :
"P2335366288" "<A HREF=CONTACTLINK_MISSIONS>I have a proposition for you.</A>"
// HelloString :
"P4062148549" "<A HREF=CONTACTLINK_MISSIONS>This could be mutually beneficial.</A>"
// IDontKnowYouString :
"P1432257656" "I don't know you. Step away from the vehicle. You want an introduction, I suggest you talk to Dmitri Krylov. He's one smart cookie."
// FirstVisitString :
"P2856482407" "Hello {VillainName}. Pardon me if I don't leave the vehicle, but I prefer to keep my business dealings anonymous. You can understand, yes?"
// NoTasksRemainingString :
"P38412548" "I believe our business dealings have come to an end. I bid you good day."
// PlayerBusyString :
"P2648195088" "You've got enough going on. Talk to me when you get rid of your current load."
// ComeBackLaterString :
"P2844550802" "You're not buff enough to shine my hubcaps. Come talk to me when you're at least Threat Level {Level}."
// RelationshipChangeString_ToFriend :
"P175330747" "Satisfactory work, {VillainName}. I think I can work with you. You should call me regularly. And check out my <A HREF=CONTACTLINK_GOTOSTORE>store!</A>"
// RelationshipChangeString_ToConfidant :
"P1676201957" "Pure gold! I appreciate your hard work, {VillainName}. Here, take a look at my <A HREF=CONTACTLINK_GOTOSTORE>store.</A>"
// FailsafeLevelString :
"P884431391" "Time for you to keep on rolling on. Nice working with you, {VillainName}."
// LocationString :
"P2938395047" "Cap Au Diable"
// IntroString :
"P2398929564" "You know man calls himself the Golden Roller? Smart, this one. Always looking for talent. Is high profile troubleshooter for a high-tech gang called the Goldbrickers. He might have some profitable jobs for you.<br><br>Oh, yes -- he doesn't like being seen in person, but you can find him in his car. You want Science, Technology Enhancements? He set you up."
// IntroAcceptString :
"P2324053420" "Choose Golden Roller"
// IntroSendoffString :
"P2796509283" "Golden Roller is high-class operator. Dosvidanya!"
// IntroduceOneContact :
"P1372154291" "I have <A HREF=CONTACTLINK_INTRODUCE>someone</A> that can provide you with some work."
// IntroduceTwoContacts :
"P2174845600" "I know some <A HREF=CONTACTLINK_INTRODUCE>people</A> who know people."
// -------------------------------------------------------------------------------- 


