// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Operative_Wellman 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Operative Wellman 
// -------------------------------------------------------------------------------- 
// Name :
"P956960615" "Operative Wellman"
// ProfessionString :
"P871174980" "Arachnos Operative"
// DescriptionString :
"P3121717996" "Wellman is an efficient Arachnos Operative. Rumor has it he was once a beat cop in Paragon City, but got tired of the heroes taking the spotlight. Other people say that he was a cop on the take, but Wellman is quick to quash those whispers."
// HelloString :
"P2684749210" "<A HREF=CONTACTLINK_MISSIONS>I'm looking for someone who is reliable and ruthless.</A>"
// HelloString :
"P3356975820" "<A HREF=CONTACTLINK_MISSIONS>I'm looking for a few bad men.</A>"
// HelloString :
"P3586867833" "<A HREF=CONTACTLINK_MISSIONS>Ready to do your duty for Lord Recluse?</A>"
// IDontKnowYouString :
"P2858136168" "Move along, {VillainName}. Unless you have spoken to Marshal Brass, I have no use for you."
// FirstVisitString :
"P831004953" "Hello {VillainName}. I've read your file, and it seems you have potential. Do your job and you might earn a position of power within the Rogue Isles."
// NoTasksRemainingString :
"P986730333" "I don't have anything more for you, perhaps your other contacts have something?"
// PlayerBusyString :
"P3668928724" "You have too much going on to focus on my tasks, {VillainName}."
// ComeBackLaterString :
"P4075210895" "You are of insufficient Threat Level to do service for Arachnos. Come back when you're {Level}."
// RelationshipChangeString_ToFriend :
"P193886743" "Sufficient progress. You're improving, {VillainName}. A few new <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</A> wouldn't do you any harm, though. I want you to take this communication device. I'd like to keep tabs on you."
// RelationshipChangeString_ToConfidant :
"P1111860125" "Well done! You might have a future in Arachnos yet. If you want to make it far, though, you'll need the very best <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</A>"
// FailsafeLevelString :
"P147208637" "You've advanced sufficiently in your Threat Level. Thank you for your service to Arachnos."
// LocationString :
// IntroString :
"P3626422821" "I know someone within Arachnos that is recruiting free agents. He is known as Operative Wellman, an ex-cop from Paragon City who despises vigilantes. He has a lot of connections, and can get you Mutant and Science Enhancements."
// IntroAcceptString :
"P2627667635" "Choose Operative Wellman"
// IntroSendoffString :
"P2657213263" "Wellman is efficient and ruthless, but do your job well and you'll get good ratings within Arachnos."
// IntroduceOneContact :
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


