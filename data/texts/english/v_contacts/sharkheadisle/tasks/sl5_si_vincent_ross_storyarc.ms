// -------------------------------------------------------------------------------- 
// Reward - Objective 
// -------------------------------------------------------------------------------- 
// Dialog :
"P3613640173" "You found some research by the Coralax!"
// Script Variable BOSS_DISPLAYNAME :
"P2110811445" "Coralax Shaper"
// Script Variable BOSS_INACTIVE_DIALOG :
"P1244677930" "The Blood Coral will be ours. The Leviathan's power will allow us to create a new society!"
// Script Variable BOSS_ATTACK_DIALOG :
"P823328307" "We've heard of you, {HeroName}. You have the treasure we seek!"

