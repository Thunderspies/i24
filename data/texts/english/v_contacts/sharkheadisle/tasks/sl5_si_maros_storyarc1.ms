// ModelDisplayName :
"P1980427635" "Forbidden Tomes"
// InteractBeginString :
"P3517556095" "Haversham begins to look for information on Calystix"
// InteractInterruptedString :
"P244628908" "You've been interrupted!"
// InteractCompleteString :
"P2476748435" "Haversham presents you with the information he's found"
