// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Archmage_Tarixus 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Archmage Tarixus 
// -------------------------------------------------------------------------------- 
// Name :
"P2374891464" "Archmage Tarixus"
// ProfessionString :
"P4285125199" "Ancient Sorcerer"
// DescriptionString :
"P947158882" "Archmage Tarixus is an ancient sorcerer who has always existed on what is now known as Potter's Field. His mortal body has long since passed on, leaving only his ghostly spirit. It's said that the Circle of Thorns tried acquiring power over him at one time, but Tarixus quickly put them in their place."
// HelloString :
"P148300818" "<A HREF=CONTACTLINK_MISSIONS>I acknowledge your presence, {VillainName}.</a>"
// HelloString :
"P2954355759" "<A HREF=CONTACTLINK_MISSIONS>Who disturbs Tarixus?</a>"
// HelloString :
"P1554453398" "<A HREF=CONTACTLINK_MISSIONS>You may speak.</a>"
// IDontKnowYouString :
"P475603532" "You are beneath my attention."
// FirstVisitString :
"P3951418454" "I am Tarixus, and I am an old soul. You come to me not by chance, but by fate. There are grand designs at work, {VillainName}, machinations beyond your wildest dreams. You seek power. I can provide you with that power - if you do my bidding. Submit to my will and you have much to gain. Refuse, and you can wallow in your shallow existence from here until time's end. The choice is yours."
// NoTasksRemainingString :
"P3548382859" "Your usefulness to me has ended. Begone, {VillainName}."
// PlayerBusyString :
"P1828210873" "Resolve some of your other issues before speaking with me again, {VillainName}."
// ComeBackLaterString :
"P317383540" "I sense your strength, but it is not enough for the task I have for you. Converse with me when you consolidate your potential at Threat Level {Level}."
// BadgeNeededString :
"P3291888689" "I am the survivor of an ancient Eldritch War which raged over centuries. Learn of my plight if you wish to earn my respect! Seek out the histories of this war on Mercy Island, Port Oakes, Cap Au Diable, and here on Sharkhead Isle."
// BadgeFirstTick :
"P856364347" ""
// RelationshipChangeString_ToFriend :
"P1448640110" "You are proven yourself worthy, {VillainName}. I have <A HREF=CONTACTLINK_GOTOSTORE>treasures</a> to pile upon you. You may contact me at any time."
// RelationshipChangeString_ToConfidant :
"P1253701776" "Your power has become impressive, {VillainName}. But you will need greater <A HREF=CONTACTLINK_GOTOSTORE>power</a> yet if you are to survive."
// FailsafeLevelString :
"P779414623" "Your destiny lies elsewhere, {VillainName}. Leave me."
// LocationString :
"P607884113" "Sharkhead Isle"
// IntroString :
"P2891126736" "Archmage Tarixus is an ancient sorcerer who used his magic to live on as a ghost after death. He's kinda creepy, but it's obvious that he knows a great deal and holds a lot of power. He can get you Natural and Magic Enhancements."
// IntroAcceptString :
"P842009787" "Choose Archmage Tarixus"
// IntroSendoffString :
"P3229040225" "He's your typical arcane scholar: pompous and cryptic with a bit of crazy thrown in for good measure."
// IntroduceOneContact :
"P2606782532" "I would like to <A HREF=CONTACTLINK_INTRODUCE>introduce you</A> to an individual I know."
// IntroduceTwoContacts :
"P2316257069" "There are a <A HREF=CONTACTLINK_INTRODUCE>couple of people</A> you should meet."
// -------------------------------------------------------------------------------- 


