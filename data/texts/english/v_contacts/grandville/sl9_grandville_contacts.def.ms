// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Abyss 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Abyss 
// -------------------------------------------------------------------------------- 
// Name :
"P2762006528" "Abyss"
// ProfessionString :
"P309534848" "Hero Bounty Hunter"
// DescriptionString :
"P2088588294" "Who Abyss really is remains a mystery. She showed up recently with costume pieces and gadgets belonging to several heroes who recently went missing. Heroes that Arachnos had put bounties out on. Impressed with her tenacity and obvious skill, Lord Recluse has let her run free in Grandville, doing whatever she pleases. Abyss gets results, and expects the same of you."
// HelloString :
"P2547518051" "Hmm?"
// HelloString :
"P2583768783" "<color deepskyblue>Abyss just stares at you, waiting for you to start the conversation</color>"
// HelloString :
"P4160567279" "Yeah?"
// IDontKnowYouString :
"P2001676682" "Beat it."
// IDontKnowYouString :
"P3570554836" "<color deepskyblue>She doesn't even make eye contact with you</color>"
// FirstVisitString :
"P3029490539" "You here to pick up the slack? I've got some contracts that are beneath me. You can deal with them if you'd like."
// NoTasksRemainingString :
"P331387827" "All the contracts I have left I want to handle personally."
// PlayerBusyString :
"P1531818771" "I can't trust you to get the job done when you can't even finish the jobs you have."
// ComeBackLaterString :
"P4094681496" "Come back when you have some more experience. You should be at least Theat Level {Level}."
// ComeBackLaterString :
"P1666932618" "<color deepskyblue>Abyss sizes you up, then promptly ignores you. Come back when you're Theat Level {Level}. </color>"
// RelationshipChangeString_ToFriend :
"P3028008698" "Hmph."
// RelationshipChangeString_ToConfidant :
"P1217128656" "Color me impressed."
// FailsafeLevelString :
"P26582731" "Yeah, right."
// LocationString :
"P3340683840" "Grandville"
// IntroString :
"P1020452446" "A new hero bounty hunter calling herself Abyss has arrived in Grandville. Supposedly she has taken out a couple of pesky heroes, and now Lord Reluse lets her do whatever it is she does. She's put the word out that she is looking for a few villains to pick up some of the lesser bounties she's been offered. Seems everyone wants someone taken out for some reason or another, and one bounty hunter alone can't do the job."
// IntroAcceptString :
"P1571682265" "Choose Abyss as your Contact"
// IntroSendoffString :
"P244893600" "She's terse and to the point... and she can probably kill you before your brain registered you were in danger. Watch your step with this one."
// IntroduceOneContact :
"P2327240584" "I know <A HREF=CONTACTLINK_INTRODUCE>someone</a> you should meet."
// IntroduceTwoContacts :
"P2992244229" "There are some <A HREF=CONTACTLINK_INTRODUCE>people</a> who would like to meet you."
// -------------------------------------------------------------------------------- 


