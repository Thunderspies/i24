// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Operative_Grillo 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Operative Grillo 
// -------------------------------------------------------------------------------- 
// Name :
"P515731670" "Operative Grillo"
// ProfessionString :
"P2164754512" "Arachnos SciTech Operative"
// DescriptionString :
"P3630609857" "Operative Grillo is a scientist dedicated to developments in science and technology to further the cause of Arachnos. He acts as the official Arachnos liaison with Dr. Aeon in Cap Au Diable through his proxies, and is involved with a number of secret Arachnos projects. He is a fervant supporter of Lord Recluse's vision - a technocratic world led by its greatest thinkers."
// HelloString :
"P585058961" "For Lord Recluse!"
// HelloString :
"P1448423660" "For the greater glory of Arachnos!"
// HelloString :
"P2752773176" "Strength through undying loyalty!"
// IDontKnowYouString :
"P2362597480" "{VillainName}? I'm sorry, but I don't have an appointment scheduled with you."
// FirstVisitString :
"P1914406495" "Ah, {VillainName} is it? Yes, I've been expecting you. I am Operative Grillo, the lead Arachnos developer for science and technology. I have need of assistance dealing with some matters vital to the security of Arachnos, and you've been identified as one of Lord Recluse's more capable lieutenants. Serve me well and you will serve Arachnos well, and what greater glory is there than that!"
// NoTasksRemainingString :
"P3754252833" "Thank you for your assistance, {VillainName}. You've been of great value to Arachnos."
// PlayerBusyString :
"P3019123323" "Arachnos and I require your focused attention. Please tend to your other matters first."
// ComeBackLaterString :
"P3936585682" "According to your Threat Profile, you are not ready for what I have for you. Please return to me when you are Threat Level {Level}."
// RelationshipChangeString_ToFriend :
"P620298970" "You are doing well, {VillainName}. Arachnos appreciates loyalty!"
// RelationshipChangeString_ToConfidant :
"P1793574542" "Excellent, {VillainName}. You a true soldier of Arachnos!"
// FailsafeLevelString :
"P2657011327" "You have excelled in your work, {VillainName}! I no longer have need of your services."
// LocationString :
// IntroString :
"P3036893445" "Have you met Operative Grillo? He's a rather driven man, coordinating SciTech projects for Arachnos. I know he's looking for a few Arachnos loyalists to aid him."
// IntroAcceptString :
"P3366715743" "Choose Operative Grillo"
// IntroSendoffString :
"P74475004" "Operative Grillo is a true product of Arachnos propoganda, believing in Lord Recluse's utopian future."
// IntroduceOneContact :
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


