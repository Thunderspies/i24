"P782013652" "Destruction Monument"

// -------------------------------------------------------------------------------- 
// Villain Def - Rularuu_Shadow_Shard_Portal 
// -------------------------------------------------------------------------------- 
// DisplayDescription :
"P316056525" "This extra dimensional portal has opened up a gateway to another world.  Strange and Dangerous creatures are coming through it.  It must be destroyed!"
// DisplayClassName :
"P2936123098" "Object"
// GroupDescription :
"P2294482310" "Rularuu"
// DisplayNames :
"P201496262" "Portal"

