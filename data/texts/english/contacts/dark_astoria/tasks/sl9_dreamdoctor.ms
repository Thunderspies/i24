// Script Variable PET_ACTIVE_DIALOG :
"P1969915968" "{HeroName}...!"
// Script Variable SayOnRescue :
"P4262316662" "<t=5 d=5>I thank you, {HeroName}. You must do what I could not... I am too battered, too weak now to be of much help.<t=5 d=5>Please... You must rescue Ice Mistral from Mot, you must do what I find myself too limited to do."
// Script Variable SayOnStranded :
"P1164421489" "<shout>Hey! {HeroName}!"
// Script Variable RescueObjectiveText :
"P4163513916" "Rescue Scirocco"
// Script Variable BOSS_INACTIVE_DIALOG :
"P1686208916" "You attacked many of us, Scirocco. But you can not defeat us all. We will thrive on your pain before you're taken by Mot."
// Script Variable BOSS_ATTACK_DIALOG :
"P2181806950" "{HeroName}. You will not prevent us from taking Scirocco!"
// Script Variable WaveShout :
"P1936714319" "<shout>Stop {HeroName}!"
// Script Variable Greeting :
"P3609192693" "{HeroName}, it's you."
// Script Variable SaysList :
"P2409989984" "Now we fight"
// Script Variable SaysList :
"P892451606" "I die!"

// -------------------------------------------------------------------------------- 
