// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Consultant_Chesterfield 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Consultant Chesterfield 
// -------------------------------------------------------------------------------- 
// Name :
"P3841547737" "Consultant Chesterfield"
// ProfessionString :
"P3834892855" "Cultural Direction and Education Center Sharing Mentor"
// DescriptionString :
"P1688898753" "Consultant Marlena Chesterfield is a large proponent of the tenets of sharing. She believes that in giving, we receive much more than just emotional reward, we receive information that can provide a tangible outlet for our goodness to be revealed. She is eager and excited to be able to mentor apprentices with this valuable knowledge."
// LocationString :
"P553041384" "Imperial City"
// IDontKnowYouString :
"P4021527457" "I don't think I've had the pleasure, Citizen.  If you're here for the Inventions program, I'm afraid you've approached the mentors in reverse!  I am the Sharing mentor.  You need to speak to Verna Arcola.  She is the Relations Expert here at the Cultural Direction and Education Center and she can get you started on the program right away!"
// NoTasksRemainingString :
"P3679129843" "It has been a pleasure getting to know you, {HeroName}.  You have reached the pinnacle of your enlightenment for the time being here at the Cultural Direction and Education Center.  I wish you the best of luck in your future endeavors."
// PlayerBusyString :
"P264480138" "{HeroName}, let's be frank with each other, shall we?  You need to make a few changes in your priorities and then come back to talk to me."
// RelationshipChangeString_ToFriend :
"P856364347" ""
// FailsafeLevelString :
"P722876366" "You should not be seeing this."
// IntroString :
"P1139888870" "For your final enlightenment exercise, you should go speak with <color DeepSkyBlue>Consultant Marlena Chesterfield</color>.  She will help you wrap up your studies here at the Center and will give you some insight as to what comes next.<br><br>Consultant Chesterfield is located on the first floor."
// IntroAcceptString :
"P1874753966" "Link to click on to accept as new contact."
// IntroSendoffString :
"P893940547" "Now that you have completed all of your enrichment exercises, Consultant Chesterfield will be your Sharing Mentor and will help you with suggestions on how to use your newfound skills."

// -------------------------------------------------------------------------------- 
// Dialog - FirstVisitString 
// -------------------------------------------------------------------------------- 
// Page LicRequiresCheck Text :
"P3850192039" "Emperor Cole requires that all citizens have qualified for their Invention Licenses before continuing.  Please speak to me again once you've obtained your license.<br><br><color orange>Only VIP subscribers and accounts with monthly Invention Licenses can complete the Invention Tutorial.</color>"
// Answer Text :
"P63996380" "Ok"
// Page TokenCheck Text :
"P1082917990" "Good to see you {HeroName}.  I'm afraid you've learned everything that I can teach you.  Good luck!"
// Answer Text :
"P2254280480" "Goodbye"
// Page MissionAccept Text :
"P725368892" "My name is Marlena Chesterfield and I am the Sharing mentor here at the CDEC.<br><br> I'll be here to help you wrap up your final enlightenment exercises and teach you a little about the wonderful world of sharing your items and enhancements."
// Answer Text :
"P3737846196" "Ask about available missions."

// -------------------------------------------------------------------------------- 
// Dialog - HelloString 
// -------------------------------------------------------------------------------- 
// Page MissionAccept Text :
"P277188358" "I am most pleased to see you on this glorious day, {HeroName}."
// -------------------------------------------------------------------------------- 


