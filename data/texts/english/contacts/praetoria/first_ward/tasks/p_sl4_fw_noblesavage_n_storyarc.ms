"P3278854496" "Comm Channel Override"
// Description :
"P3036789403" "Override communications channel"
// InteractBeginString :
"P3288388946" "You begin to override the comm channel lockdown."
// InteractInterruptedString :
"P535631865" "You have been interrupted."
