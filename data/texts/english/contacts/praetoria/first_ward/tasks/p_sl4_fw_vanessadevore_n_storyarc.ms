// ModelDisplayName :
"P3445974701" "Reactor Door Control"
// Description :
"P138798904" "Unlock the Reactor Door"
// InteractBeginString :
"P1169553929" "You access the computer"
// InteractInterruptedString :
"P826846204" "You have been interrupted"
// InteractCompleteString :
"P4099928398" "You finish accessing the computer"
// InteractActionString :
"P2096386660" "Accessing..."

// -------------------------------------------------------------------------------- 
// Reward - Objective 
