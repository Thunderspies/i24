// MissionDef 
// -------------------------------------------------------------------------------- 
// EntryString :
"P2277432225" "The Forlorn attack on the PPD HQ has cleared out the otherwise well guarded lobby of Cole's Tower. While there is still time you will need to find Diabolique's Talisman and get out quickly."
// Script Variable ObjectiveUIText :
"P3970952137" "Breach the PPD HQ (Team Noble)"
// Script Variable ObjectiveUIText :
"P125257204" "Disable Main Power (Team Noble)"
// Script Variable ObjectiveUIText :
"P1441832677" "Free Prisoners (Team Noble)"
// Script Variable ObjectiveUIText :
"P4026266844" "Raid PPD Armory (Team Noble)"
// Script Variable ObjectiveUIText :
"P2229038308" "Plant Explosives (Team Noble)"
// Script Variable ObjectiveUIText :
"P2538555452" "Hold out for as long as possible (Team Noble)"
// Script Variable ObjectiveUIText :
"P2825814595" "Deal with Dominatrix"
// Script Variable ChatMessage :
"P2787684371" "Marauder is coming! Survive until Midnight teleports you to safety!"
// Script Variable FloaterMessage :
"P3941600368" "Marauder is coming!"
// Script Variable BOSS_DISPLAYNAME :
"P551730851" "Marauder"
// Script Variable BOSS_INACTIVE_DIALOG :
"P1390564204" "<shout>I'll find you, you little maggot!<em>Even if I have to tear down this entire damn tower to do it!"
// Script Variable SaysList :
"P3793214176" "I'm dead!"
// Script Variable INACTIVE_DIALOG_MINION1 :
"P1927609281" "<shout>Go!"
// Script Variable ATTACK_DIALOG_MINION1 :
"P2669107149" "<shout><t 3><t 3>Attack!"
// Script Variable ATTACK_DIALOG_MINION2 :
"P2636653587" "<shout>Engaging!"
// Script Variable INACTIVE_DIALOG_MINION1 :
"P3065076863" "<shout>Nobody escapes!"
// Script Variable ATTACK_DIALOG_MINION1 :
"P2268739641" "<shout><t 3><t 3>Targeting!"
// Script Variable ATTACK_DIALOG_MINION2 :
"P878965851" "<shout>Enemy spotted!"
// Script Variable INACTIVE_DIALOG_MINION1 :
"P587015047" "<shout>We have visual!"
// Script Variable ATTACK_DIALOG_MINION1 :
"P3845736948" "<shout><t 3><t 3>Fire at will!"
// Script Variable ATTACK_DIALOG_MINION2 :
"P3300731085" "<shout>Stop {hero.gender=male him|her}!"
// Script Variable INACTIVE_DIALOG_MINION1 :
"P3632554756" "<shout>Tower One-One, this is Tower Two-Six, we're starting our sweep.<t 4><em>I'm sure of it..."
// Script Variable ATTACK_DIALOG_MINION1 :
"P3488889173" "<shout><t 3><t 3>We have contact, all units move on our position!"
// Script Variable INACTIVE_DIALOG_MINION2 :
"P1143738579" "<shout><t 4><t 4>Think the attack on HQ is a diversion?"
// Script Variable ATTACK_DIALOG_MINION2 :
"P2879908902" "<shout>Target's spotted!"
// Script Variable INACTIVE_DIALOG_MINION1 :
"P1454714890" "<shout>Nobody leaves the tower. NOBODY."
// Script Variable ATTACK_DIALOG_MINION1 :
"P997325527" "<shout>Destroy them!"

