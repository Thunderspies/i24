// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Provost_Marchand 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Provost Marchand 
// -------------------------------------------------------------------------------- 
// Name :
"P187874537" "Provost Marchand"
// ProfessionString :
"P2221464535" "Provost General of Praetoria"
// DescriptionString :
"P514382150" "Provost Marchand owes his life to the regime of Emperor Cole. His current power armor suit is what keeps Marchand alive - without it, he would live for only a few minutes before his entire body shut down. Marchand's main goal is to ensure the peace and prosperity of Praetoria and is willing to get his hands dirty to do so."
// LocationString :
// HelloString :
"P3654628377" "Hello, {HeroName}. Let's make this conversation short."
// HelloString :
"P1825199206" "{HeroName}, what can I do for you?"
// IDontKnowYouString :
"P2932898689" "I'd love to speak with you, but I have many more things that I need to get done."
// WrongUniverseString :
"P4105776105" "I can only assume that the reason I have no clue who you are is because you failed to fill out the necessary paperwork which validates that you are not a super powered renegade and enemy of the Praetorian Empire. If I were you, I would ensure that my papers were in perfect, flawless order."
// FirstVisitString :
"P1459925349" "Nice to talk with you, {HeroName}. My name is Marchand, Provost Marchand. You may have heard of me - I am one of the oldest members of the regime, having been around for all of the Hamidon Wars and even before.<br><br>The one thing I seek, above all else, is the safety of Praetoria. Sometimes that means rather... extreme measures. Other times it means ensuring the members of Powers Division get what they need to continue their work.<br><br>What exactly do you need?"
// NoTasksRemainingString :
"P2235893706" "I don't have anything for you now, {HeroName}. But I believe I will in the future. I'll contact you directly when something comes up."
// PlayerBusyString :
"P1789357977" "You seem to have many tasks on your plate, {HeroName}. Speak to me when you're a little less busy."
// ComeBackLaterString :
"P3015987057" "At the moment, I have nothing for you. But perhaps more will develop in the future."
// RelationshipChangeString_ToFriend :
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
