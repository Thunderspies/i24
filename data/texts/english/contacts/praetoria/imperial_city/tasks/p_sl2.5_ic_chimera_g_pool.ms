// -------------------------------------------------------------------------------- 
// ModelDisplayName :
"P2128965225" "Dirty Nuke"
// SingularDescription :
"P3989418268" "Resistance Dirty Nuke"
// InteractBeginString :
"P1318332673" "You begin disarming the bomb"
// InteractInterruptedString :
