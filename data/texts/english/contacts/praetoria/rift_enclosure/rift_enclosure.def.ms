// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : General_Tremaine 
//
// Script      : Xlstocontactdef.bat 
// Version     : 33 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : General Tremaine 
// -------------------------------------------------------------------------------- 
// Name :
"P2602868612" "General Tremaine"
// ProfessionString :
"P416390176" "5-Star Praetorian General"
// DescriptionString :
// LocationString :
// HelloString :
"P3547956000" "I am in no mood to listen to some namby-pamby conversation.  I'll give you three seconds - exactly three flippin' seconds - for you to brief me on why you're here."
// IDontKnowYouString :
"P1589323197" "I don't know what kind of back-water town you came from, soldier, but you will NOT address someone well above your rank unless you have orders to do so!"
// FirstVisitString :
"P3424574633" "I don't care a whit about your flippin' opinion, soldier!  And yes, if you're going to be standing in this battlefield, you are either a soldier of mine or you are a casualty of war, take your pick.  <br><br>Good choice, soldier!"
// NoTasksRemainingString :
"P1398257479" "We've got everything wrapped up here for the time being.  Take some leave time, but be ready to be called back to service at any moment."
// PlayerBusyString :
"P1213079915" "I will not tolerate a smart-aleck, soldier!  I don't know if you think you're being funny, but I find nothing humorous about you having too many other tasks when I have orders for you!"
// ComeBackLaterString :
"P980989710" "My orders are for someone who is at Security Level Level, soldier!  Do not speak with me unless you've gained rank, got it?!"
// RelationshipChangeString_ToFriend :
"P2756002528" "It seems you're able to follow orders, soldier.  From hereon we're going to be in direct contact, understood?"
// RelationshipChangeString_ToConfidant :
"P406326243" "I don't say this too often, but you've done a good job, soldier!  If I had more men and women like you, we would have pushed back the Devouring Earth a long time ago!"
// WrongAllianceString :
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
