// Version     : 33 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Major Dawson 
// -------------------------------------------------------------------------------- 
// Name :
"P4164890536" "Major Dawson"
// ProfessionString :
"P567756648" "Special Ops"
// DescriptionString :
// LocationString :
// HelloString :
"P2150383914" "When I tell you that I want something done, the words out of your mouth will be 'sir, yes, sir?"
// IDontKnowYouString :
"P1860950728" "You are jumping the chain of command, soldier!  Unless you have been assigned to my division, you have no need to talk to me, UNDERSTOOD!?"
// FirstVisitString :
"P2533327508" "Our mission here in the Rift can NOT fail, and I will not let green recruits like these men here mess it all up.  You are being enlisted as a temporary member of my Black Ops unit, understood?  DO YOU UNDERSTAND ME, SOLDIER!?<br><br>We are preparing for an attack by insurgents and these freaks of Nature at every moment, so we need to keep our eyes peeled.  You are going to be my eyes from hereon, soldier."
// NoTasksRemainingString :
"P4213712413" "I have no special tasks for you right now, soldier.  You'll know it if I do."
// PlayerBusyString :
"P4227654044" "Are you being a smart-alec, soldier?  Do not volunteer for assignments if you are unavailable to take them.  I am this close to locking you up in the brig, soldier!"
// ComeBackLaterString :
"P4182867399" "You are way too green, soldier.  Once you're at Security Level {Level} then I can use you, runt."
// RelationshipChangeString_ToFriend :
"P940909523" "Don't think you're out of the fire just yet, soldier.  Just because you've done good work so far doesn't mean you're getting a medal, got it?"
// RelationshipChangeString_ToConfidant :
"P3357519880" "You've done some fine work, soldier.  If I had a whole battalion of you, we'd have those subversives running for their Mommies!"
// WrongAllianceString :
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
