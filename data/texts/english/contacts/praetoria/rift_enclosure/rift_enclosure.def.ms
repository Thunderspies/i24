// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Resistance General Ido 
// -------------------------------------------------------------------------------- 
// Name :
"P174484915" "Resistance General Ido"
// ProfessionString :
"P2720058566" "Resistance General"
// DescriptionString :
// LocationString :
// HelloString :
"P1806784135" "We must keep a vigilant eye upon Tyrant's oppression or he will crush us all beneath his boot."
// IDontKnowYouString :
"P170651245" "I do not know who you are or how you have found yourself in this place.  If you value your life, you will want to leave as soon as possible."
// FirstVisitString :
"P3763497890" "You have come to me with high honors, {HeroName}.  You have done many great things so far, but this will be amongst the greatest.  Tyrant is marshalling his forces to strike us down once and for all.  When he makes his killing blow, he will find we are not there.  And that is when we will strike him from behind, bringing him down once and for all."
// NoTasksRemainingString :
"P4129683762" "I have no more tasks for you, {HeroName}.  For now, we wait and watch.  As we bide our time, Tyrant will show his weak spots to us."
// PlayerBusyString :
"P3432577148" "You have too many tasks you are distracted by.  When you can focus, return to me."
// ComeBackLaterString :
"P1390674212" "My honor prevents me from sending you on a kamikaze mission.  Return to me when you are Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P2043252591" "You have done an honorable job, {HeroName}.  There is more to do, so I will keep you in close contact with me from here out."
// RelationshipChangeString_ToConfidant :
"P3938382581" "Your bravery in the face of tyranny will be spoken of generations to come, {HeroName}.  It is an honor to have fought beside you."
// WrongAllianceString :
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
