// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Agent_Mannings 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Agent Mannings 
// -------------------------------------------------------------------------------- 
// Name :
"P3724477967" "Agent Mannings"
// ProfessionString :
"P1294642326" "Assistant to Administrator Chenr"
// DescriptionString :
// LocationString :
// HelloString :
"P3283049490" "Hello there, {HeroName}.  I hope you're not too worn out from defending our fair city today. There's always something popping up here and there, so we really need people like you to be at the top of your game."
// IDontKnowYouString :
"P192520366" "Hello there.  Sorry, but I'm waiting for some extra muscle right now, so I don't have time to chat.  Maybe you can talk with {LastContactName}?"
// WrongUniverseString :
"P3517273192" "I'm afraid I haven't been assigned to work with you."
// FirstVisitString :
"P3793324453" "How are you doing there, {HeroName}?  I'm Mannings and I report to Administrator Chen.  It's a pretty difficult job at times, what with the Syndicate sowing terror coupled with lunatic extremists causing as much if not more harm.  But you know what they say - 'When the going gets tough, the tough get goin'.  Have any extra time on your hands that you can help out the force?"
// NoTasksRemainingString :
"P2806625744" "Looks like we have the situation under control right now, {HeroName}.  Thanks for stopping by!"
// PlayerBusyString :
"P1735676925" "Thanks for offering, {HeroName}, but it looks like you're helping out too many other people right now."
// ComeBackLaterString :
"P2403506441" "I'd sure like to use you on an upcoming assignment, {HeroName}, but you'll need to be Security Level {Level} before I can consider asking you."
// RelationshipChangeString_ToFriend :
"P2427756515" "{HeroName}, you sure do manage to make my job a lot easier.  Here's my number if you want to give me a call at anytime."
// RelationshipChangeString_ToConfidant :
"P748932420" "By golly, you sure have helped out a whole lot.  If there were more people like you in the city, and less of those extremists, we'd be able to sleep a lot easier.  Thanks again!"
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
