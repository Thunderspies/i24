// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : P_Dark_Watcher 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Dark Watcher 
// -------------------------------------------------------------------------------- 
// Name :
"P3964152796" "Dark Watcher"
// ProfessionString :
"P120334523" "Mysterious Man in Black"
// DescriptionString :
"P1110611418" "No one in Praetoria knows exactly who Dark Watcher is or what his goals are in this place. He simply appeared one day to Calvin Scott and offered his advice and guidance."
// LocationString :
"P2011343611" "???"
// HelloString :
"P1405377199" "We stand on the brink of destruction, {HeroName}."
// HelloString :
"P292861332" "Our actions today will help more people than you can imagine, {HeroName}."
// IDontKnowYouString :
// WrongUniverseString :
"P468008402" "{HeroName}. Be cautious. If the Praetorians catch wind of more Primal Earthlings here then Tyrant will have all the ammunition he needs to validate an invasion of Primal Earth. Don't make us look to be the aggressors here, for if the people support Tyrant, then we have no moral ground to stand on here."
// FirstVisitString :
"P2749419560" "Hello, {HeroName}. We both have little time, so I will be brief. My name is Dark Watcher, and I am here to help turn the tide of this war with the Resistance. When you and I have finished, I believe the future will look much brighter for us all."
// NoTasksRemainingString :
"P1937761164" "We've done everything we can, {HeroName}. Now, we must wait."
// PlayerBusyString :
"P222149720" "You've too much to do as it is, {HeroName}. Speak with me again when you have more time."
// IntroString :
"P4012118089" "Not many on Praetoria know that the Dark Watcher exists, let alone what his true purpose is here. If he wants to meet with you, it can only mean that there is important matters to settle."
// IntroAcceptString :
// IntroSendoffString :
"P925061337" "<color Plum><font outline=2>Good luck with the Magician, Rusty! Mother's coming now, I think I'm going to go see some more of my Playtime Friends now!</color></font>"
// IntroduceOneContact :
// IntroduceTwoContacts :
