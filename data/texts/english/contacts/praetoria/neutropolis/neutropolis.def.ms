// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Dr._Hetzfeld 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Dr. Hetzfeld 
// -------------------------------------------------------------------------------- 
// Name :
"P4000988495" "Dr. Hetzfeld"
// ProfessionString :
"P4003410802" "Mad Scientist"
// DescriptionString :
"P2149428440" "Dr. Hetzfeld is a brilliant, albeit mad scientist. Such is his disdain of Neuron's position as Praetor of the Sciences the Hetzfeld has taken to modifying his own mind and body to put him on a more even footing when it comes to physical capability. He still believes himself to be the superior scientist, and will stop at nothing to prove that to the world."
// InteractionRequiresText :
"P3531491982" "<color orange>You know all too well that Hetzfeld will not answer.</color>"
// LocationString :
// HelloString :
"P3824958114" "Science!"
// HelloString :
"P2660148141" "Ah! {HeroName}, how good to see you."
// HelloString :
"P2984277718" "Mwa... Mwahaha!"
// HelloString :
"P2458044109" "Brilliant!"
// IDontKnowYouString :
"P2017870456" "No. No no no! You will not do. You need more references, a body of work, something of worth so I may make an intelligent, informed, and completely logical decision. I have no interest in working with you at this time."
// WrongUniverseString :
"P3539007478" "Bah! This stupid dimensional anomaly detector is still not working properly. It just goes off for <i>no</i> reason!"
// FirstVisitString :
"P2952041245" "For too long has the fraud, Neuron, twitched upon the Praetorship of the Sciences. His <i>luck</i>, is soon to run out. I, the <i>Great Doctor Hetzfeld</i> shall show him for the fool he is and take my rightful place at Cole's side.<br><br>And you! You, {HeroName}. I <i>know</i> that your aspirations match my own. I have <i>seen</i> your work!<br><br>Together, what a team we shall make!"
// NoTasksRemainingString :
"P154437337" "I am still running bio-rhythm analysis on these experiments. I'm afraid your skills wouldn't be of much help at this time."
// PlayerBusyString :
"P640338159" "No! Do not act the part of that fool, Neuron, thinking you can accomplish in one day what would take a deity six!<br><br>Go! Come back to me when you have learned to focus on the task at hand."
// ComeBackLaterString :
"P579392833" "Are you Security Level {SecurityLevel}? No? Then I cannot use you! <i>If</i> you manage to achieve such a rating, then we can talk."
// RelationshipChangeString_ToFriend :
"P3306021218" "We need to increase our efficiency. Here is the 10-digit code necessary to transmit data directly to me. This is a large responsibility, {HeroName}, I trust you not to abuse it."
// RelationshipChangeString_ToConfidant :
"P1776980083" "Mwahahahaha! Can you see it, {HeroName}? Our bronze statues glowing as the dawn of a new day in Praetoria catches our <i>regal</i> countenances? You and I, {HeroName}, our destinies are just over the horizon!"
// WrongAllianceString :
"P680618256" "Science! But for me. Not for you. Not now, that is!"
// FailsafeLevelString :
// IntroString :
// IntroAcceptString :
// IntroSendoffString :
// IntroduceOneContact :
// IntroduceTwoContacts :
// -------------------------------------------------------------------------------- 


