// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : P_Penelope_Yin 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Penelope Yin 
// -------------------------------------------------------------------------------- 
// Name :
"P3268873349" "Penelope Yin"
// ProfessionString :
"P345270352" "Hospital Patient"
// DescriptionString :
"P3156214966" "Penelope Yin, daughter of Wu Yin, was 'enrolled' in the Mother of Mercy Psychiatric Hospital some time ago. This has caused Wu Yin to embark on a crusade to get his daughter back. Some PPD who stand guard in the hospital whisper rumors that Penelope Yin may be the most powerful psychic within the hospital; even more powerful than Praetor Tilman, though Yin's time in the hospital has possibly driven her mad."
// LocationString :
// HelloString :
"P1537269192" "<color Plum><font outline=2>Come on, Rusty, we have a kingdom to save!</color></font>"
// HelloString :
"P9153450" "<color Plum><font outline=2>You're the brightest Star I know, Rusty!</color></font>"
// IDontKnowYouString :
"P3033578782" "Someone's thoughts become your own, 'You I have no memory of, so my thoughts they will not flow. Through face and voice you recognize, return to those you know'."
// WrongUniverseString :
"P704666776" "<color orange>A young woman's voice sing songs into your thoughts</color><br><br><color Plum><font outline=2>Rusty? Wait... you aren't Rusty... you're... oh dear! Things just got very complicated. Oh no! I have to go, Mother is coming!</color></font>"
// FirstVisitString :
"P1893545611" "<color orange>You hear the voice of a young woman in your head, her tone kind and light-hearted.</color><br><br><color Plum><font outline=2>Rusty! It's been so long since I've seen you, there's so much to say. I see all the Stars in the Mirror Kingdom. Some of them glow brighter than the others! Mother tells me I need to be careful about looking at the Stars, or else my brain will go poof! But you're a special Star, Rusty, because you're my Star! And because you're the Star that's going to save us all.<br><br>Today, Rusty, we're going to go on a quest to save all the people and teddy bears in Mirror Kingdom!</color></font>"
// NoTasksRemainingString :
"P1454153617" "<color Plum><font outline=2>We've closed our book, Rusty. We stopped the evil Glowball and his Black Knights. But it's up to you to travel across the streams to help defeat the Shadowlord!</color></font>"
// PlayerBusyString :
"P426973375" "<color Plum><font outline=2>Rusty, you're too busy playing in other people's imaginations!</color></font>"
// ComeBackLaterString :
// FailsafeLevelString :
// IntroString :
"P217847595" "Penelope Yin is one of Praetor Tilman's patients in her hospital. The daughter of Wu Yin has caused much controversy, due to whispers that she may be the most powerful psychic in the world; even more powerful than Praetor Tilman."
// IntroAcceptString :
// IntroSendoffString :
"P1708498007" "This chick is annoying me to no end. Mind getting her off of my mind?"
// IntroduceOneContact :
"P3387056932" "<color Plum><font outline=2>I know just how you can contact the Magician, Rusty!</color></font>"
// IntroduceTwoContacts :
