"P1238247318" "Resistance Representative"
// Script Variable BOSS_INACTIVE_DIALOG :
"P1772198369" "Come speak to me, {HeroName}."
// Script Variable BOSS_DISPLAYNAME :
"P867447974" "Jessica Flores"
// Script Variable BOSS_INACTIVE_DIALOG :
"P1215353708" "Goodbye {HeroName}! I'll write ALL about you!"
// Script Variable BOSS_DISPLAYNAME :
"P1187939463" "Robert Flores"
