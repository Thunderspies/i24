// -------------------------------------------------------------------------------- 
// Contact Name : Calvin Scott 
// -------------------------------------------------------------------------------- 
// Name :
"P4278277396" "Calvin Scott"
// LocationString :
"P3013477751" "Praetoria"
// ProfessionString :
"P3744612848" "Resistance Member"
// DescriptionString :
"P1473990098" "Calvin Scott is a high ranking member of the Resistance, a small force determined to remove Emperor Cole from power no matter the cost."
// WrongAllianceString :
// IDontKnowYouString :
"P1658622802" "Funny thing is, I'm an auto-issue contact, so you should probably never see this."
// TaskDeclineOverride :
// AskAboutTextOverride :
"P502653053" "I'm trying to find my way out of here."
// NoTasksRemainingString :
"P695273163" "I've got nothing. (NoTasksRemainingString)"
// PlayerBusyString :
"P2962124958" "You need to get back to doing those missions."
// ComeBackLaterString :
"P1512060303" "Go away."
// RelationshipChangeString_ToFriend :
// FailsafeLevelString :
"P4198709500" "I don't think it's possible for you to ever see this, unless we raise the level cap or something."
// IntroString :
"P1040925904" "You need to meet the Mission Giver."
// IntroAcceptString :
"P2618060254" "Meet Mission Giver."
// IntroSendoffString :
"P3273445465" "Now that you can met her, all is right with the world."
// IntroduceOneContact :
"P4020465395" "I really don't do introductions."

// -------------------------------------------------------------------------------- 
// Dialog - DialogTree 
// -------------------------------------------------------------------------------- 
// Page HelloPage Text :
"P2510892732" "<color deepskyblue>Welcome to Praetoria</color><br><br>I might be able to help you with that."
// Answer Text :
"P2467471439" "Great, what's the plan?"
// Answer Text :
"P405491381" "Who are you?"
// Answer Text :
"P3656569470" "What's going on here?"
// Page WhoAreYou Text :
"P2860496409" "<color deepskyblue>Welcome to Praetoria</color><br><br>My name is Calvin Scott. I'm a simple businessman who was going for a walk when all of this happened."
// Answer Text :
"P2239558373" "Great, I'm {HeroName}. Can we get out of here."
// Page WhatsGoingOn Text :
"P3311249264" "<color deepskyblue>Welcome to Praetoria</color><br><br>The Clockwork are sweeping the park looking for people they believe to be <color orange>subversives</color> to Emeperor Cole's rule. The Praetorian Police Department have the place surrounded. You need to get out of here."
// Answer Text :
"P876257656" "Sounds like a plan."
// Page IDontKnowYou Text :
// Answer Text :
// Page NoTaskRemaining Text :
// Page PlayerBusy Text :
