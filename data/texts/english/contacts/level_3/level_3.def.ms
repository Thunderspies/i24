// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Olivia_Chung 
//
// Script      : Xlstocontactdef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Olivia Chung 
// -------------------------------------------------------------------------------- 
// Name :
"P3007144735" "Olivia Chung"
// ProfessionString :
"P2179026501" "Publisher"
// DescriptionString :
"P1637049120" "Olivia Chung was born in Taiwan and moved to the United States with her family when she was ten years old. Ever since, she has lived a life carefully balanced between two cultures, embracing American ways while retaining her Chinese roots. An accomplished entrepreneur and author of several books, it was a natural step for her to start publishing a weekly paper aimed at Asian-Americans and immigrants living in Paragon City. Called the Asian Paragon, this paper is a valuable resource to tens of thousands of readers each week. Publishing the paper has put Olivia in touch with all the strata of the immigrant community in Paragon City. She is especially troubled by the growing power of the Vahzilok, and she's always eager to help police and heroes by telling them whatever she hears through her web of contacts."
// WrongAllianceString :
// HelloString :
"P1942690547" "<A HREF=CONTACTLINK_MISSIONS>Oh, hello! I have much to tell you.</A>"
// HelloString :
"P3385141385" "<A HREF=CONTACTLINK_MISSIONS>I want to thank you in advance for helping with these problems.</A>"
// IDontKnowYouString :
"P766256572" "I'm so sorry, but I'm on deadline. Try talking to {LastContactName} if you need a lead."
// FirstVisitString :
"P3025714057" "I try to help as much as I can, but I am glad you are here. Your strength and skill are needed."
// NoTasksRemainingString :
"P3782792922" "I don't have any leads for you; {HeroName}. Check with your other contacts."
// PlayerBusyString :
"P99463782" "You're overworked as it is."
// ComeBackLaterString :
"P515642747" "I'd like to give you a job, but I'd rather wait until you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P3479447001" "You are a friend, {HeroName}. I have some <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements</A> in my store, if you would care to look. I am always happy to help such a devoted person. I will give you my private number, if you will promise to use it."
// RelationshipChangeString_ToConfidant :
"P2088032465" "This community, and this city, are lucky to have you. Please peruse my store's <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements.</A>"
// FailsafeLevelString :
"P1803028527" "I have nothing that would interest you."
// LocationString :
// IntroString :
"P3236043853" "Did you ever see that weekly paper, the Asian Paragon? Well, its publisher, Olivia Chung, is a great woman. She knows all about what's going on in the immigrant community and has helped more than one hero sort out a jam involving the Vahzilok or the Outcasts. Olivia has her offices in Steel Canyon."
// IntroAcceptString :
"P2709118862" "Choose Olivia Chung"
// IntroSendoffString :
"P3432119688" "You won't meet many people as good-hearted as Olivia."
// IntroduceOneContact :
"P3440215463" "You should meet a <A HREF=CONTACTLINK_INTRODUCE>friend</A> of mine."
// IntroduceTwoContacts :
"P1517363816" "Two of my <A HREF=CONTACTLINK_INTRODUCE>friends</A> want to meet you."
// -------------------------------------------------------------------------------- 


