// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Cadao_Kestrel 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Cadao Kestrel 
// -------------------------------------------------------------------------------- 
// Name :
"P1470177606" "Cadao Kestrel"
// ProfessionString :
"P3682553980" "Voodoo Master"
// DescriptionString :
"P2298572163" "There's no doubt that Cadao Kestrel is the foremost expert on voodoo in Paragon City. There's also no doubt that everybody knows it. People tend to steer clear of Cadao when he's walking down the streets, and restaurants often close up shop when they see him coming. Several newspaper articles have alleged that he is a broker of dark magics, selling revenge rituals and potions of power for the right price. In fact, Cadao's much more interested in using his knowledge to take on the Circle of Thorns than to make a few dollars. He knows many ways of forecasting the future, and whenever he learns something interesting, he passes it on to a helpful hero."
// HelloString :
"P1167793051" "<A HREF=CONTACTLINK_MISSIONS>You need to see what I have seen, {HeroName}.</A>"
// HelloString :
"P1884469639" "<A HREF=CONTACTLINK_MISSIONS>I see trouble ahead.</A>"
// HelloString :
"P1950835050" "<A HREF=CONTACTLINK_MISSIONS>These are dark days.</A>"
// IDontKnowYouString :
"P3422994757" "I think you want {LastContactName}."
// FirstVisitString :
"P3313879286" "The Circle of Thorns is a dark cloud, threatening to throw our city into shadow. I will gladly help you stop them."
// NoTasksRemainingString :
"P2571166664" "I have no more tasks for you. Go in peace."
// PlayerBusyString :
"P2461911003" "You are already quite busy."
// ComeBackLaterString :
"P3090910248" "You must attain Security Level {Level} before I give you more assignments, {HeroName}. I would not want to risk your life."
// RelationshipChangeString_ToFriend :
"P4140692290" "You have done well so far, my friend. I think you are worthy of some of my more powerful <A HREF=CONTACTLINK_GOTOSTORE>Enhancements.</A> You should call on me if you are ever in need."
// RelationshipChangeString_ToConfidant :
"P749399860" "You have my full confidence. My most potent <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</A> are now available to you."
// FailsafeLevelString :
"P821762414" "I cannot lead one with power such as yours. Go, and continue our fight for Paragon City."
// LocationString :
// IntroString :
"P2380898163" "Don't listen to the rumors about Cadao Kestrel. He would never use his mastery of voodoo for any dark purpose, and he has excellent information on the Circle of Thorns. He loves to work with magic heroes and can provide Relic and Focus Enhancements."
// IntroAcceptString :
"P3215133190" "Choose Cadao Kestrel"
// IntroSendoffString :
"P2231104064" "Kestrel is a man of peace, {HeroName}. He will help you fight the Circle of Thorns menace."
// IntroduceOneContact :
"P2282598688" "I would like you to introduce yourself to a dear <A HREF=CONTACTLINK_INTRODUCE>friend</A> of mine."
// IntroduceTwoContacts :
"P2619983814" "There are <A HREF=CONTACTLINK_INTRODUCE>some people</A> in need of your assistance."
// -------------------------------------------------------------------------------- 


