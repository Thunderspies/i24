// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Fake_Tina_Macintyre 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Tina Macintyre 
// -------------------------------------------------------------------------------- 
// Name :
"P1720285133" "Tina Macintyre"
// ProfessionString :
"P2638361939" "Portal Corporation Research Scientist"
// DescriptionString :
"P1773725550" "Tina Macintyre is one of the leading researchers in the growing field of dimensional portal technology. After losing most of her team into the first wild portal ever created, she has focused her energy on assisting heroes to deal with the negative side effects of the portals. Tina is equally motivated by her love of science and the guilt she carries for her part in the loss of her team."
// HelloString :
"P3195772960" "Things are pretty chaotic, {HeroName}."
// HelloString :
"P1209006860" "We have to get things under control."
// HelloString :
"P207990568" "Am I glad to see you, {HeroName}."
// IDontKnowYouString :
"P3014564817" "You should be speaking to {LastContactName}."
// FirstVisitString :
"P1453736584" "I am convinced that dimensional portals will be an important part of our future, {HeroName}. I am counting on you to help me stabilize the current situation so that we can make that dream a reality."
// NoTasksRemainingString :
"P2731469752" "I have nothing more. Try some of your other contacts."
// PlayerBusyString :
"P903020561" "You need to finish some of the things you are already working on, {HeroName}."
// ComeBackLaterString :
"P1080615424" "What I have is for Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P94013834" "Thank you for your help, my friend. Here are some new <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</A> for you. Things here on Peregrine are tense, {HeroName}. It's important that you stay in touch."
// RelationshipChangeString_ToConfidant :
"P939136035" "You are one of the few people I trust completely, {HeroName}. I want you to have the best <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</A> available."
// FailsafeLevelString :
"P789378961" "We have made a lot of progress on the portal problem but for now you need to focus your energy elsewhere, {HeroName}."
// LocationString :
"P891522995" "Peregrine Island"
// IntroString :
"P1017404266" "Tina Macintyre works for the Portal Corporation. She has the most current information on the trouble out on Peregrine Island caused by unstable dimensional technology. She can offer Gadget and Relic Enhancements."
// IntroAcceptString :
"P3576597250" "Choose Tina Macintyre"
// IntroSendoffString :
"P3252609985" "The dimensional instabilities on Peregrine Island are getting worse by the day, {HeroName}. Be ready for anything."
// IntroduceOneContact :
"P4119286404" "I have a <A HREF=CONTACTLINK_INTRODUCE>buddy</A> I'd like you to meet."
// IntroduceTwoContacts :
"P3706455638" "You should meet some of my other <A HREF=CONTACTLINK_INTRODUCE>contacts.</A>"
// -------------------------------------------------------------------------------- 


