// ModelDisplayName :
"P62098310" "Nemesis supplies"
// InteractBeginString :
"P1701550816" "You begin to destroy Nemesis' stockpiled supplies."
// InteractCompleteString :
"P3357510363" "You have destroyed Nemesis' stockpiled supplies."

