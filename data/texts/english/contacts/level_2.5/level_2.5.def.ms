// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Wes_Schnabel 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Wes Schnabel 
// -------------------------------------------------------------------------------- 
// Name :
"P3123652689" "Wes Schnabel"
// ProfessionString :
"P407600204" "Private Detective"
// DescriptionString :
"P3265020075" "Wes Schnabel knows better than most that being a private eye isn't much like it is in the movies. That is, unless you work in Paragon City. With so many kidnappings and hostage takings going on in the city, there's always someone looking for a missing loved one. Wes is a recently retired cop who is just getting his practice started. He deals a lot with gang-related crimes and missing persons cases. Wes works closely with heroes whenever he can. As a retired cop, he knows that's the best way to get things done in this city."
// HelloString :
"P3453155471" "<A HREF=CONTACTLINK_MISSIONS>Got some rough ones for you.</a>"
// HelloString :
"P184102873" "<A HREF=CONTACTLINK_MISSIONS>I want you to look into some things for me.</a>"
// IDontKnowYouString :
"P3592537847" "Buzz off, I'm in the middle of something. Better yet, go see {LastContactName}."
// FirstVisitString :
"P4211273613" "It's a tough town, {HeroName}. I hope you have what it takes."
// NoTasksRemainingString :
"P130462476" "You solved all my cases, {HeroName}. You should help out somebody else."
// PlayerBusyString :
"P280494817" "Clear out some of those cases, {HeroName}. Then we'll talk about a new job."
// ComeBackLaterString :
"P889853015" "I'd like to talk to you when you reach Security Level {Level}. I think you might be able to help with something then."
// RelationshipChangeString_ToFriend :
"P3223593314" "I am starting to think you've got what it takes, my friend. I've got a number of <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements</a> for you to look at in my store. Call me if you need a clue."
// RelationshipChangeString_ToConfidant :
"P1452662683" "You're as good as anyone I've seen, {HeroName}. I followed my nose to some <A HREF=CONTACTLINK_GOTOSTORE>new, powerful Enhancements</a> I think might interest you."
// FailsafeLevelString :
"P2200810740" "Night has fallen like an inky curtain on our partnership, {HeroName}."
// LocationString :
// IntroString :
"P1525040363" "I know a private eye named Wes Schnabel who wants to talk to you about the Council. He's always looking for new contacts and good heroes to work with. He usually takes cases in Steel Canyon."
// IntroAcceptString :
"P806658386" "Choose Wes Schnabel"
// IntroSendoffString :
"P3834684635" "Schnabel is a good, old-fashioned gumshoe."
// IntroduceOneContact :
"P345281340" "I want you to talk to a <A HREF=CONTACTLINK_INTRODUCE>friend</A> of mine."
// IntroduceTwoContacts :
"P157703503" "It's time you meet some more of my <A HREF=CONTACTLINK_INTRODUCE>friends.</A>"
// -------------------------------------------------------------------------------- 


