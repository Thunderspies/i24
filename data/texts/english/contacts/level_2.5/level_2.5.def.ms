// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Wilson_Zucco 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Wilson Zucco 
// -------------------------------------------------------------------------------- 
// Name :
"P951775286" "Wilson Zucco"
// ProfessionString :
"P2267322390" "Former Gang Member"
// DescriptionString :
"P2349158747" "Most old gangsters are either dead or in prison, but Wilson Zucco is one of the lucky few who survived and managed to turn his life around. Now he works as a youth outreach administrator, teaching kids about gang awareness and sometimes acting as a liaison between law enforcement and the gangs. He's liked and admired by both sides of the law, which gives him access to an unusual mix of information. Wilson is happy to work with heroes, especially since they can handle gangs in ways the police can't."
// HelloString :
"P1372265511" "<A HREF=CONTACTLINK_MISSIONS>We got problems, serious problems.</a>"
// HelloString :
"P2260048667" "<A HREF=CONTACTLINK_MISSIONS>I've heard a lot of crazy stuff from the kids today.</a>"
// IDontKnowYouString :
"P3568310052" "Sorry, I'm crazy busy right now. Seen {LastContactName} recently? Maybe you should."
// FirstVisitString :
"P353295882" "The Skulls are pulling a lot of good kids into a bad situation. I want you to help me stop that."
// NoTasksRemainingString :
"P164770963" "I have the gang situation in hand, {HeroName}, but I'm sure one of your other contacts can really use your help."
// PlayerBusyString :
"P1312382159" "You've got too much to do as it is, {HeroName}."
// ComeBackLaterString :
"P1210649870" "Come see me when you reach Security Level {Level}. I just might have a job for you."
// RelationshipChangeString_ToFriend :
"P471424250" "You're doin' a good job, {HeroName}. The kids tipped me off to a stash of <A HREF=CONTACTLINK_GOTOSTORE>powerful Enhancements.</a> In your hands, I know they'll do some good. If there's some way I can help you, call."
// RelationshipChangeString_ToConfidant :
"P1642527655" "You got your head, and your heart, in the right places, {HeroName}. Don't ask me how I got my hands on the <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements</a> in my store. Just take them, and use them well."
// FailsafeLevelString :
"P96335549" "You need to find a new source."
// LocationString :
// IntroString :
"P3722936225" "I suggest you meet Wilson Zucco. He's an ex-gang member who's turned his life around, and he knows the Lost and the Skulls better than anyone. He also has a great deal of information on the Vahzilok. Wilson keeps an eye on the Lost from within Steel Canyon."
// IntroAcceptString :
"P3812671601" "Choose Wilson Zucco"
// IntroSendoffString :
"P2165821204" "Wilson is one of the only people in the city who bridges the gap between the law and the streets."
// IntroduceOneContact :
"P132466718" "I got <A HREF=CONTACTLINK_INTRODUCE>someone</A> I want you to meet."
// IntroduceTwoContacts :
"P1244286418" "A <A HREF=CONTACTLINK_INTRODUCE>couple people</A> I know want to meet you, {HeroName}."
// -------------------------------------------------------------------------------- 

