// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Lorenzo_DiCosta 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Lorenzo DiCosta 
// -------------------------------------------------------------------------------- 
// Name :
"P3041938747" "Lorenzo DiCosta"
// ProfessionString :
"P2256254327" "Confidential Informant"
// DescriptionString :
"P3604989455" "As the cops say about Lorenzo DiCosta, he's got a rap sheet as long as your arm. He's been in and out of jail since he was 13, and he's decided he likes out better than in. He's a small time crook and hustler, but he knows who most of the big players are. They, on the other hand, scarcely notice him, making him the perfect confidential informant. For a few bucks he'll tell a hero anything he wants to know. Or he'll do it in exchange for a favor down the line, say, a get out of jail free card on a minor charge. Lorenzo is a pretty personable fellow, and has made friends with a number of different heroes, despite his less than savory line of work."
// HelloString :
"P2914777108" "<A HREF=CONTACTLINK_MISSIONS>You aren't going to believe some of the stuff going on.</a>"
// HelloString :
"P3198579431" "<A HREF=CONTACTLINK_MISSIONS>Check this out, {HeroName}.</a>"
// IDontKnowYouString :
"P176289774" "Nah, nothin' goin' on here. {LastContactName} has all the hot tips."
// FirstVisitString :
"P3532064700" "How goes it, {HeroName}? I have primo information for you."
// NoTasksRemainingString :
"P54624858" "I've got no more leads for you, {HeroName}. Ask your other contacts."
// PlayerBusyString :
"P3710853855" "You've got a lot to do already."
// ComeBackLaterString :
"P1619972321" "I think I can use your help when you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P3388919691" "I think this is the beginning of a beautiful friendship. I got my hands on some nifty <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements.</a> Take a look. I want you to know you can call on me."
// RelationshipChangeString_ToConfidant :
"P1354814194" "You are a good {Hero.gender=male joe|gal}, {HeroName}. How about you check out my <A HREF=CONTACTLINK_GOTOSTORE>new finds</a> in the store?"
// FailsafeLevelString :
"P963984775" "I got nothin' for ya."
// IntroString :
"P4251124172" "I know a confidential informant named Lorenzo DiCosta. He can provide you with some solid leads on current Council activity. Lorenzo can be found on the streets of Skyway City."
// IntroAcceptString :
"P3697002720" "Choose Lorenzo DiCosta"
// IntroSendoffString :
"P3535551310" "Lorenzo is well placed to provide information; please don't judge him too harshly, {HeroName}."
// LocationString :
// IntroduceOneContact :
"P2765142784" "I know a <A HREF=CONTACTLINK_INTRODUCE>person</A> you should talk to."
// IntroduceTwoContacts :
"P3978404926" "I got a couple ideas for good <A HREF=CONTACTLINK_INTRODUCE>contacts.</A>"
// -------------------------------------------------------------------------------- 


