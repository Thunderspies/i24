// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Dr_Trevor_Seaborn 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Dr. Trevor Seaborn 
// -------------------------------------------------------------------------------- 
// Name :
"P395938382" "Dr. Trevor Seaborn"
// ProfessionString :
"P1424156179" "Abnormal Psychiatrist"
// DescriptionString :
"P3877287865" "Dr. Trevor Seaborn is one of Paragon City's many doctors to specialize in abnormal psychiatry. With such a large population of criminals with severe pathologies, there is always work to be done. Dr. Seaborn focuses his research on trying to understand the criminal mind, and he often works with police to create profiles of wanted criminals. He also has a good working relationship with many of the city's heroes, offering them advice about how to better confront the insane villains who threaten Paragon City every day."
// HelloString :
"P1053463728" "<A HREF=CONTACTLINK_MISSIONS>Things are crazy today. Help me out.</a>"
// HelloString :
"P4175758273" "<A HREF=CONTACTLINK_MISSIONS>I believe there are some matters that you can assist me with.</a>"
// IDontKnowYouString :
"P3159890695" "I'm terribly sorry, but I just can't spare a moment right now. Go see {LastContactName} if you need some information."
// FirstVisitString :
"P1043170011" "It is troubling that we have to focus so much of our energy on the symptoms, but I hope you can assist me in getting to a place where we might be able to address the disease itself."
// NoTasksRemainingString :
"P1946194977" "I've got no more cases for you, {HeroName}. See one of your other contacts instead."
// PlayerBusyString :
"P1991382743" "You should clear out your caseload before looking for more work."
// ComeBackLaterString :
"P2132999283" "You'll have to reach Security Level {Level} before I can give you more work."
// RelationshipChangeString_ToFriend :
"P2777480928" "You have proven a valuable asset so far, my friend. Let's take a look at the <A HREF=CONTACTLINK_GOTOSTORE>newest meds</a> in my store. Call me if you need some professional help."
// RelationshipChangeString_ToConfidant :
"P2940198326" "The time has come for us to fully trust each other in this endeavor. <A HREF=CONTACTLINK_GOTOSTORE>My best Enhancements</a> are available to you."
// FailsafeLevelString :
"P3765862142" "Sorry to lose you, {HeroName}, but the time has come for our relationship to end."
// LocationString :
// IntroString :
"P1080129070" "Dr. Trevor Seaborn expressed an interest in meeting you when I told him about your good work. He's a psychiatrist specializing in criminal behavior, and an expert on the Hellions and the Circle of Thorns. Dr. Seaborn is in Steel Canyon."
// IntroAcceptString :
"P299090107" "Choose Dr. Seaborn"
// IntroSendoffString :
"P4191408689" "Trevor has a brilliant mind, and his insights on criminal behavior are invaluable."
// IntroduceOneContact :
// IntroduceTwoContacts :
"P1927172582" "I have several <A HREF=CONTACTLINK_INTRODUCE>colleagues</A> I want to introduce you to."
// -------------------------------------------------------------------------------- 


