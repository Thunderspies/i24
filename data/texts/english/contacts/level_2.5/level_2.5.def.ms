// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Athena_Currie 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Athena Currie 
// -------------------------------------------------------------------------------- 
// Name :
"P1979533708" "Athena Currie"
// ProfessionString :
"P1170405666" "Lawyer"
// DescriptionString :
"P1127562835" "Athena Currie is a young, driven attorney who devotes her time to providing low-cost legal aid to the poor. She's only been out of law school for a few years, but already she's earned herself quite a reputation. Most recently, she won a major lawsuit against a housing company that provided low income housing that failed to meet even the most basic safety standards. These days she's particularly active in anti-gang youth work, helping people extricate themselves from street gangs and remain legally protected in the process. Not surprisingly, this has made her some dangerous enemies. Fortunately, the personable young lawyer has a number of super-powered friends who're happy to lend her a helping hand when she needs it."
// HelloString :
"P3084793744" "<A HREF=CONTACTLINK_MISSIONS>Lots of people need help right now.</a>"
// HelloString :
"P3437112970" "<A HREF=CONTACTLINK_MISSIONS>Time to make some more enemies, {HeroName}.</a>"
// IDontKnowYouString :
"P1993759942" "Not now, I'm late for court. You should see what {LastContactName} is up to."
// FirstVisitString :
"P3995448618" "The people of this city need heroes to help defend them, {HeroName}. I can help you be one of the best and brightest."
// NoTasksRemainingString :
"P2283744647" "If you want a tough case, you should ask your other contacts. I've got nothing for you."
// PlayerBusyString :
"P2400763553" "Looks like you're already buried in work. I'm not adding to your troubles."
// ComeBackLaterString :
"P3900094697" "See me when you reach Security Level {Level}. I just might have a case for you then."
// RelationshipChangeString_ToFriend :
"P4246003000" "It is truly an honor working with you, my good friend. Some of my clients pay me in trade, so I have quite a few <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</a> you should look at. I hope you will always keep in touch."
// RelationshipChangeString_ToConfidant :
"P3991214443" "We are making a huge difference together, {HeroName}. I've recently picked up a few <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements</a> you might like to try out."
// FailsafeLevelString :
"P317019510" "This court is no longer in session for you. Good luck."
// LocationString :
// IntroString :
"P4194102100" "There's a talented young lawyer named Athena Currie who you should talk to. She's a big community activist and has had some serious run-ins with the Clockwork. Miss Currie practices law in Steel Canyon."
// IntroAcceptString :
"P3291512256" "Choose Athena Currie"
// IntroSendoffString :
"P1718277515" "Athena can really use the help of a hero like you."
// IntroduceOneContact :
"P1038106187" "I want you to meet an <A HREF=CONTACTLINK_INTRODUCE>associate</A> of mine."
// IntroduceTwoContacts :
"P4149509670" "More of my <A HREF=CONTACTLINK_INTRODUCE>associates</A> want to meet you."
// -------------------------------------------------------------------------------- 


