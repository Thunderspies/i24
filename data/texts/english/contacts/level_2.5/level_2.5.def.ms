// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Haley_Philips 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Haley Philips 
// -------------------------------------------------------------------------------- 
// Name :
"P284059880" "Haley Philips"
// ProfessionString :
"P1075672432" "Health Department Inspector"
// DescriptionString :
"P3072202260" "As an inspector for the Health Department, Haley investigates health hazards associated with super-powered, supernatural, and alien events. Her group is dedicated to making sure the city's residents live in safety, and that their homes protect them from Paragon City's exotic threats. For example, most cities don't require radiation shielding for private residences. Nor do most building codes call for walls strong enough to withstand the impact of a flying hero. Haley specializes in identifying new threats and liaising with heroes who can help her find more information."
// HelloString :
"P1750970906" "<A HREF=CONTACTLINK_MISSIONS>Help me keep our citizens safe.</a>"
// HelloString :
"P4101291948" "<A HREF=CONTACTLINK_MISSIONS>I can sure use your help!</a>"
// IDontKnowYouString :
"P2030989150" "I've got a meeting I'm late for. Why not schedule some time with {LastContactName}?"
// FirstVisitString :
"P3663998510" "Nothing matters more to me than the safety of Paragon City."
// NoTasksRemainingString :
"P2964107720" "There's nothing else I can use your help with, but you should ask your other contacts if they need a hand."
// PlayerBusyString :
"P884194349" "I don't think you need any more work, {HeroName}."
// ComeBackLaterString :
"P2676386505" "You should talk to me again when you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P825346975" "Your concern for the citizens of Paragon City has made you a worthy friend. I got my hands on some <A HREF=CONTACTLINK_GOTOSTORE>interesting Enhancements</a> recently. I think I can trust you to use them well. If I can help you, just call."
// RelationshipChangeString_ToConfidant :
"P188808910" "I can see you share my belief that safety is paramount. I trust you completely. I'd like to supply you with all the <A HREF=CONTACTLINK_GOTOSTORE>equipment</a> you need."
// FailsafeLevelString :
"P401714275" "The time has come for you to move on to bigger challenges, {HeroName}. I'll always be grateful for the lives you've helped me save."
// LocationString :
// IntroString :
"P442768854" "You should talk to Haley Philips over at the Health Department. She specializes in identifying and dealing with health threats posed by the Hellions and the Circle of Thorns. She's always looking for more help from the city's heroes. She can be found in Skyway City."
// IntroAcceptString :
"P2391460768" "Choose Haley Philips"
// IntroSendoffString :
"P3512175205" "Haley has very strong beliefs about safety."
// IntroduceOneContact :
"P4036217020" "I have a <A HREF=CONTACTLINK_INTRODUCE>friend</A> who could use your help."
// IntroduceTwoContacts :
"P1686634562" "There are some other <A HREF=CONTACTLINK_INTRODUCE>people</A> who I want you to meet."
// -------------------------------------------------------------------------------- 


