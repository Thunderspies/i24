// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Carla_Brunelli 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Carla Brunelli 
// -------------------------------------------------------------------------------- 
// Name :
"P3437021089" "Carla Brunelli"
// ProfessionString :
"P3065082694" "Gun Dealer"
// DescriptionString :
"P795069244" "A staunch defender of the second amendment, Carla Brunelli believes that force must be met with force. In a place as dangerous as Paragon City, she does good business selling weapons, but Carla is no cold-hearted profiteer. She goes above and beyond the call of duty when it comes to background checks, using her police contacts to make sure she's not selling firearms to criminals. A major leader in her neighborhood watch program, Carla's greatest concern is keeping the city's streets safe."
// HelloString :
"P289091863" "<A HREF=CONTACTLINK_MISSIONS>I've got a sticky situation here.</a>"
// HelloString :
"P781295944" "<A HREF=CONTACTLINK_MISSIONS>Trouble's brewing.</a>"
// IDontKnowYouString :
"P1097921428" "Sorry, I got a shipment coming in any second. Maybe you should see what {LastContactName} has brewing."
// FirstVisitString :
"P297838622" "Always happy to meet one of Paragon City's heroes."
// NoTasksRemainingString :
"P1946883628" "Things are pretty quiet around here lately. Maybe you can help one of your other contacts."
// PlayerBusyString :
"P510835469" "You've got too much on your plate today, {HeroName}."
// ComeBackLaterString :
"P1731192073" "I'm afraid you'll need to attain Security Level {Level} before you can tackle my next job."
// RelationshipChangeString_ToFriend :
"P1031857890" "I think you are the kind of hero I can call a friend. Don't spread it around, but I just got my hands on some <A HREF=CONTACTLINK_GOTOSTORE>heavy artillery</a> for my store. You got my number, kid. Use it."
// RelationshipChangeString_ToConfidant :
"P591488689" "You have put yourself on the line often enough to earn my full trust. It's time to show you the <A HREF=CONTACTLINK_GOTOSTORE>big guns.</a>"
// FailsafeLevelString :
"P1408464541" "Time for you to upgrade, {HeroName}. I'm too small time for you."
// LocationString :
"P970836190" "Skyway City"
// IntroString :
"P1313753481" "There's a gun dealer named Carla Brunelli who would like to meet you. She's a very responsible, proactive woman who's helped a number of heroes in her time. She is deeply troubled by the Clockwork. Their presence in Skyway City means that she can usually be found there."
// IntroAcceptString :
"P2441147329" "Choose Carla Brunelli"
// IntroSendoffString :
"P1707371809" "Carla is tough but fair."
// IntroduceOneContact :
"P783458578" "I got <A HREF=CONTACTLINK_INTRODUCE>someone</A> I want you to talk to."
// IntroduceTwoContacts :
"P2036633772" "I got a couple <A HREF=CONTACTLINK_INTRODUCE>people</A> you should talk to."
// -------------------------------------------------------------------------------- 


