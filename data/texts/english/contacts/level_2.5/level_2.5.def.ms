// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Sanjay_Chandra 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Sanjay Chandra 
// -------------------------------------------------------------------------------- 
// Name :
"P930252862" "Sanjay Chandra"
// ProfessionString :
"P7218859" "Newsstand Owner"
// DescriptionString :
"P831416718" "Sanjay Chandra was born in Paragon City, one of four sons raised by immigrant parents. Since his teens he has worked in the newspaper business, as a purveyor rather than a reporter. His commitment to civic well-being is what sets Sanjay apart from most of the city's newsstand operators. He has a profound sense of responsibility, and he goes out of his way to help heroes and law enforcement as much as possible. He even earned a bit of a reputation as a crime fighter when he single-handedly captured a small time costumed villain by hitting him over the head with a stack of Sunday edition papers."
// HelloString :
"P3970524995" "<A HREF=CONTACTLINK_MISSIONS>If we move quickly, we can do much good.</a>"
// HelloString :
"P2729659963" "<A HREF=CONTACTLINK_MISSIONS>There are matters that require your attention.</a>"
// IDontKnowYouString :
"P936352150" "I'm sorry, but I have nothing for you right now. Why not ask {LastContactName} for a tip?"
// FirstVisitString :
"P2588576573" "It is a pleasure to meet you, {HeroName}. I look forward to working together."
// NoTasksRemainingString :
"P1307658758" "It's a pleasure to tell you that things have been quiet on my corner. Perhaps one of your other contacts needs assistance?"
// PlayerBusyString :
"P412040621" "I appreciate your ambition, but you already have much to do."
// ComeBackLaterString :
"P464932739" "I have a job, but it's classified Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P38234556" "It is good to be working with you, my friend. I have the latest news and the <A HREF=CONTACTLINK_GOTOSTORE>latest Enhancements.</a> Please peruse my store. I hope you will call if you are ever in need of assistance."
// RelationshipChangeString_ToConfidant :
"P2762250950" "I am pleased to say that you are one of my closest associates. It's not often I meet someone I can trust with the <A HREF=CONTACTLINK_GOTOSTORE>most powerful Enhancements</a> in my store."
// FailsafeLevelString :
"P3777219589" "I do not believe I am the correct person for you to speak with any longer."
// LocationString :
// IntroString :
"P315184058" "Have you ever stopped by Sanjay's News? The owner, Sanjay Chandra, is a great guy - real civic minded. He's always looking for ways to help heroes with the Lost and the Skulls. Sanjay's got the scoop over in Skyway City."
// IntroAcceptString :
"P4056666971" "Choose Sanjay Chandra"
// IntroSendoffString :
"P3715852217" "Sanjay is one of the most polite people in all of Paragon City."
// IntroduceOneContact :
"P438523136" "There is <A HREF=CONTACTLINK_INTRODUCE>someone</A> whom I very much wish you to meet."
// IntroduceTwoContacts :
"P3606181002" "Some good <A HREF=CONTACTLINK_INTRODUCE>friends</A> of mine have a desire to meet you."
// -------------------------------------------------------------------------------- 


