// Script Variable Greeting :
"P2275253406" "Hello there son"
// Script Variable SaysList :
"P3793214176" "I'm dead!"
// Script Variable NPC_DIALOG_NAME :
"P2531141809" "Praetor Sinclair"
// Script Variable SaysList :
"P1494717310" "<em CatchBreath>"
// Script Variable SaysList :
"P1839474907" "<t=5 caption x= 0.7 y=0.3 d=5><scale 1.75><color White><bgcolor Black>Flier pilots reporting in, we've got a visual on Tyrant. Moving in."
// Script Variable SaysList :
"P1337757452" "<t=10 caption x= 0.3 y=0.3 d=10><scale 1.75><color Yellow><bgcolor DarkRed>'Praetoria was a PEACEFUL PLACE!' Cole yelled, 'before all of you ruined it! Richter, you will feel my full FURY!"
// Script Variable SaysList :
"P710568064" "<t=5 caption x= 0.3 y=0.3 d=5><scale 1.75><color Yellow><bgcolor DarkRed>'There will be no mercy...'<t=5 caption x= 0.3 y=0.3 d=5><scale 1.75><color Yellow><bgcolor DarkRed>'No forgiveness...'<t=3 caption x= 0.3 y=0.3 d=5><scale 1.75><color Yellow><bgcolor DarkRed>'No SURRENDER!'"
// Script Variable SaysList :
"P2606205276" "<t=10 caption x= 0.3 y=0.3 d=10><scale 1.75><color Yellow><bgcolor DarkRed>'I stand for LAW! For ORDER! You, Richter, you and all that follow you have no place in my world, no place in your world!'<t=10 caption x= 0.3 y=0.3 d=10><scale 1.75><color Yellow><bgcolor DarkRed>'I will hunt every... single... one... of you down after this and ensure that you do NOT SCAR THIS OR ANY OTHER WORLD ANY LONGER!"
// Script Variable SaysList :
"P823178202" "<t=10 caption x= 0.3 y=0.3 d=10><scale 1.75><color Yellow><bgcolor DarkRed>'Is that the best your forces can do, Richter?! You hide behind your words, behind your technology, but neither can save you now!'"
// Script Variable SaysList :
"P1922183565" "<t=10 caption x= 0.3 y=0.3 d=10><scale 1.75><color Yellow><bgcolor DarkRed>'Retreating,' Cole sighed to himself, 'how predictable. More Primals march on the Magisterium... I shall let the others handle them, for now. I must ensure one last measure is taken...'"
// Script Variable Greeting :
"P1127431811" "Hello, {HeroName}."
// Script Variable NPC_DIALOG_NAME :
"P3205587882" "Black Swan"
// Script Variable SaysList :
"P807351326" "<em StanceVillain1>"
