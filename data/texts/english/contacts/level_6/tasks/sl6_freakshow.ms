// -------------------------------------------------------------------------------- 
// SACRIFICE_SACRIFICER_INACTIVE_TEXT :
"P3343215732" "Triumpants!...No, wait, Triumphantes!"

// -------------------------------------------------------------------------------- 
// Variable - SACRIFICE_VICTIM_INACTIVE_TEXT 
// -------------------------------------------------------------------------------- 
// SACRIFICE_VICTIM_INACTIVE_TEXT :
"P1084458942" "What is wrong with you people!"

