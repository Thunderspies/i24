// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Tyler_French 
//
// Script      : Xlstocontactdef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Tyler French 
// -------------------------------------------------------------------------------- 
// Name :
"P607858373" "Tyler French"
// ProfessionString :
"P2774697683" "Youth Director"
// DescriptionString :
"P385746353" "Tyler French works for the rather beleaguered Paragon City Parks and Recreation Department. With so much of the city still in need of repair, there is little money for things like after school programs and youth sports leagues. Tyler French has made it his mission to ensure that none of these things disappear. A low-paid Parks Department employee, he uses fundraisers to augment his non-existent budget and counts numerous prominent heroes among his donors. He uses the money to develop programs that keep kids involved in productive, healthy pursuits. Tyler often heads out into the rougher neighborhoods to recruit teens he thinks might benefit from his programs. His activities put him in touch with many different criminal elements, and the kids he works with know that they can always tell him when they're in trouble. Tyler passes that information on to the heroes he works with, happy to make a difference when and where he can."
// WrongAllianceString :
// HelloString :
"P4236225636" "<A HREF=CONTACTLINK_MISSIONS>This town is too much, sometimes.</A>"
// HelloString :
"P1002413782" "<A HREF=CONTACTLINK_MISSIONS>I'm glad you're ready to help, {HeroName}.</A>"
// IDontKnowYouString :
"P1734381985" "I'm sorry, but I gotta ref a game in a few minutes. Go talk to {LastContactName}, ok?"
// FirstVisitString :
"P2032190648" "The kids of this city don't get the breaks they need nearly as often as they should. If you help me clean up some of these 'recruiting agencies,' we can change that."
// NoTasksRemainingString :
"P3975706501" "I'd like to help, {HeroName}, but I'm fresh out of leads. Ask your other contacts."
// PlayerBusyString :
"P3974801618" "I admire your dedication, but you shouldn't take on quite so much work."
// ComeBackLaterString :
"P3208490970" "You ought to get to Security Level {Level}, {HeroName}. I've got a big case coming up, and I want you to be ready."
// RelationshipChangeString_ToFriend :
"P3668962739" "You are starting to make a difference around here, friend. I'd be more than happy to show you the <A HREF=CONTACTLINK_GOTOSTORE>newest Enhancements</A> in my store. Anything to help a hero like you. If you need anything, please call on me."
// RelationshipChangeString_ToConfidant :
"P266217381" "You have done more than I had hoped for, {HeroName}. Maybe there's a way I can return the favor. Take a look at the <A HREF=CONTACTLINK_GOTOSTORE>latest Enhancements</A> available in my store."
// FailsafeLevelString :
"P3397595713" "I'll always be grateful for your help, but I don't need it anymore."
// LocationString :
// IntroString :
"P4066021461" "There's an amazing guy named Tyler French who runs a youth sports program; it keeps troubled teens off the streets. He hears a lot and likes to help heroes out, especially with the Tsoo and the Warriors. Tyler has access to Training Enhancements."
// IntroAcceptString :
"P3353928201" "Choose Tyler French"
// IntroSendoffString :
"P2452239504" "Tyler is really great for the kids, {HeroName}. Help him out however you can."
// IntroduceOneContact :
"P3935311376" "I want to introduce you to a <A HREF=CONTACTLINK_INTRODUCE>friend</A> who could really use your help."
// IntroduceTwoContacts :
"P2042911440" "I have some more <A HREF=CONTACTLINK_INTRODUCE>friends</A> I want you to meet."
// -------------------------------------------------------------------------------- 


