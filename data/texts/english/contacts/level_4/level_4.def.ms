// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Lt_Col_Hugh_McDougal 
//
// Script      : Xlstocontactdef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Lt. Col. Hugh McDougal 
// -------------------------------------------------------------------------------- 
// Name :
"P2270420742" "Lt. Col. Hugh McDougal"
// ProfessionString :
"P3166257186" "Army Super-powered Relations Officer"
// DescriptionString :
"P270090047" "The United States military has had a long relationship with heroes. Many serve as active soldiers, though most prefer to operate on their own. Lt. Colonel Hugh McDougal is one of many soldiers tasked with maintaining good relations between these freelancers and the military. McDougal likes his post a great deal, and he frequently goes above and beyond the normal call of duty. He often informs heroes about possible crimes and gives them other valuable, non-classified information. All the while, he keeps careful records, so that the government will have an accurate database of available assets should a catastrophe like the Rikti Invasion ever happen again."
// WrongAllianceString :
// HelloString :
"P3502501685" "<A HREF=CONTACTLINK_MISSIONS>I have some assignments for you.</A>"
// HelloString :
"P4025623126" "<A HREF=CONTACTLINK_MISSIONS>I hope you are ready for action, soldier.</A>"
// IDontKnowYouString :
"P1887199600" "I'm afraid I don't have a spare moment just now. Report to {LastContactName}."
// FirstVisitString :
"P3123017441" "Hello, {HeroName}. I have been fully briefed on your abilities and look forward to working together."
// NoTasksRemainingString :
"P3233838569" "I don't have any more ops for you. Check with your other contacts."
// PlayerBusyString :
"P246084867" "You've got several jobs to do, soldier. I suggest you get started."
// ComeBackLaterString :
"P1568175741" "I'd like to see you reach Security Level {Level}. If you do, I'll have more work for you."
// RelationshipChangeString_ToFriend :
"P1921279635" "You are doing your country proud, my friend. Let me outfit you with some of our <A HREF=CONTACTLINK_GOTOSTORE>latest tech.</A> It's sure to tip the scales in your favor. If you need anything, call."
// RelationshipChangeString_ToConfidant :
"P3423052493" "You are fully deserving of your Security Level, {HeroName}. You may consider me your <A HREF=CONTACTLINK_GOTOSTORE>supply sergeant.</A>"
// FailsafeLevelString :
"P4133507189" "We have nothing more to discuss."
// LocationString :
// IntroString :
"P3759470861" "I've been asked to tell you that Lt. Colonel Hugh McDougal of the Pentagon's Hero Outreach Program would like to meet with you about the Freakshow and the Family. His military connections give him access to Training Enhancements."
// IntroAcceptString :
"P248909600" "Choose Lt. Colonel McDougal"
// IntroSendoffString :
"P953895854" "This could provide excellent connections for you in the future, {HeroName}."
// IntroduceOneContact :
"P936981925" "I have <A HREF=CONTACTLINK_INTRODUCE>someone</A> I want you to meet with."
// IntroduceTwoContacts :
"P2030242731" "I want you to speak to some <A HREF=CONTACTLINK_INTRODUCE>people</A> for me."
// -------------------------------------------------------------------------------- 


