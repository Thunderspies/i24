// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Jake_Kim 
//
// Script      : Xlstocontactdef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Jake Kim 
// -------------------------------------------------------------------------------- 
// Name :
"P2560508333" "Jake Kim"
// ProfessionString :
"P3385337015" "Weapons Proliferation Expert"
// DescriptionString :
"P851908259" "The rapid and rampant spread of high-powered weaponry throughout Paragon City is a cause of some concern to government and civic groups alike. Jake Kim is one of the world's foremost experts on weapons proliferation, and he recently came to Paragon City to study the phenomenon up close. With so many criminal and paramilitary groups using high-powered weaponry, it is surprisingly easy for deadly weapons to fall into the wrong hands. Jake does what he can to advise both law enforcement officials and heroes about the best ways to combat this growing menace. He provides valuable information about possible arms proliferation sites and works closely with the defense industry to improve their internal security systems. He has already been credited with keeping hundreds of powerful weapons off the street, and as his network of contacts and helpful heroes grows, he is becoming even more effective."
// WrongAllianceString :
// HelloString :
"P774704038" "<A HREF=CONTACTLINK_MISSIONS>We have a lot to do!</A>"
// HelloString :
"P2389435852" "<A HREF=CONTACTLINK_MISSIONS>Let's get it done, {HeroName}.</A>"
// IDontKnowYouString :
"P2494283462" "I'm sorry, but I've got a prior engagement. Hey, aren't you the hero {LastContactName} was looking for?"
// FirstVisitString :
"P3251301806" "Too many unregistered weapons are out there on the streets. I want your help tracking them down."
// NoTasksRemainingString :
"P3894949298" "I've got things covered around here. You should help somebody else."
// PlayerBusyString :
"P2382355151" "You're already swamped."
// ComeBackLaterString :
"P1476118139" "Ok, I've got something. Let's talk about it after you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P2133436339" "We are finally starting to make a difference together, my friend. My sources have come through with some <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements</A> for my store. I want you to have the first look. If there's anything I can do for you, {HeroName}, all you have to do is call."
// RelationshipChangeString_ToConfidant :
"P893374896" "You are the most dedicated hero it has even been my pleasure to work with. Please take a look at the <A HREF=CONTACTLINK_GOTOSTORE>latest Enhancements</A> available in my store."
// FailsafeLevelString :
"P3449276442" "It looks like I will have to find the weapons I'm after on my own from now on."
// LocationString :
// IntroString :
"P4133905788" "There's a noted weapons expert named Jake Kim who's in town trying to stop the spread of illegal weaponry. He is focusing his efforts on the Freakshow and the Family. Jake has access to Training Enhancements."
// IntroAcceptString :
"P1042627877" "Choose Jake Kim"
// IntroSendoffString :
"P575530245" "Jake has a very specific agenda, but he can still help you clean up Paragon City."
// IntroduceOneContact :
"P384837192" "One of my <A HREF=CONTACTLINK_INTRODUCE>friends</A> asked me for your help, {HeroName}."
// IntroduceTwoContacts :
"P3956480109" "There are a couple <A HREF=CONTACTLINK_INTRODUCE>friends</A> of mine who I want you to help out, if you are willing."
// -------------------------------------------------------------------------------- 


