// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Joesef_Keller 
//
// Script      : Xlstocontactdef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Josef Keller 
// -------------------------------------------------------------------------------- 
// Name :
"P317679183" "Josef Keller"
// ProfessionString :
"P2035604401" "Professor of Folklore"
// DescriptionString :
"P1920257669" "Josef Keller is one of the most radical and inventive academics in Paragon City. While his expertise and training is in traditional Irish folklore, he has recently made a name for himself in the study of modern, urban folklore. He has published several papers on the links between ancient myths and modern heroics, and he's especially interested in those groups that transcend both eras. The Banished Pantheon fascinates him, as it comes from an ancient time when gods still openly walked the Earth, and continues to operate in the modern world, where many no longer believe in any kind of divinity at all. Professor Keller works with heroes on a regular basis, providing information and direction about criminal cases that involve any kind of folklore or mythological angle."
// WrongAllianceString :
// HelloString :
"P2886835082" "<A HREF=CONTACTLINK_MISSIONS>Have I got a quest for you!</A>"
// HelloString :
"P3622528252" "<A HREF=CONTACTLINK_MISSIONS>It's time to be continuing our 'Wild Hunt,' {HeroName}.</A>"
// IDontKnowYouString :
"P3324122103" "I'm afraid I don't know you, mate. Why not see what tidbits {LastContactName} has for you?"
// FirstVisitString :
"P1041414580" "It's good to be meeting you, {HeroName}. I've been wanting to gather more data on {HeroOrigin} {HeroClass} heroes for my book."
// NoTasksRemainingString :
"P2097033404" "My research hasn't turned up anything interesting. Why not ask one of your other friends?"
// PlayerBusyString :
"P578332821" "It seems you're already buried in your work, {HeroName}."
// ComeBackLaterString :
"P4149982549" "You ought to work toward Security Level {Level}. I've got a task here that requires a hero of mythic proportions."
// RelationshipChangeString_ToFriend :
"P1041919878" "You've shown me courage and wisdom akin to Cormac Mac Art, my friend. I believe a few of my <A HREF=CONTACTLINK_GOTOSTORE>Enhancements</A> may interest you. Call on me at any time."
// RelationshipChangeString_ToConfidant :
"P351806369" "I'll wrap you to my heart like Brigid would a blacksmith good, {HeroName}. Every good adventurer needs the proper <A HREF=CONTACTLINK_GOTOSTORE>trappings,</A> so take a look at my store."
// FailsafeLevelString :
"P1509639460" "Time for you to be journeying elsewhere, {HeroName}, much like Bran."
// LocationString :
// IntroString :
"P2011171678" "Although he is a bit eccentric, Josef Keller has a great deal of knowledge. He can greatly aid anyone who wishes to go up against the Banished Pantheon or the Circle of Thorns. Professor Keller has access to Training Enhancements."
// IntroAcceptString :
"P3400752255" "Choose Josef Keller"
// IntroSendoffString :
"P1487837300" "I have no doubt you will enjoy working with Professor Keller."
// IntroduceOneContact :
"P4125124875" "I want you to meet a <A HREF=CONTACTLINK_INTRODUCE>friend</A> of mine."
// IntroduceTwoContacts :
"P3817091068" "There are some other <A HREF=CONTACTLINK_INTRODUCE>folks</A> I want to introduce you to."
// -------------------------------------------------------------------------------- 


