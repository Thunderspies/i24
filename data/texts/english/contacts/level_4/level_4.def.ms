// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Kevin_Cordell 
//
// Script      : Xlstocontactdef.bat 
// Version     : 31 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Kevin Cordell 
// -------------------------------------------------------------------------------- 
// Name :
"P3409247611" "Kevin Cordell"
// ProfessionString :
"P2823019929" "Private Security Specialist"
// DescriptionString :
"P719042460" "Security is definitely a booming business in Paragon City, and numerous small and large companies have burst onto the scene to offer protection by the hour. Kevin Cordell runs one such business. Like many entrepreneurs in the security business, Kevin has a background in law enforcement, though he wasn't a cop, an FBI agent, or even a bounty hunter. Kevin Cordell was a hero. He lost his powers to Rikti experimentation during the war, but he's sprung back, and he continues to use his contacts and expertise to help those who can't protect themselves. He still maintains his relationships with his former comrades, and he cultivates new friendships with up-and-coming heroes as well."
// WrongAllianceString :
// HelloString :
"P168638911" "<A HREF=CONTACTLINK_MISSIONS>Lots of trouble to take care of, {HeroName}.</A>"
// HelloString :
"P3879067753" "<A HREF=CONTACTLINK_MISSIONS>It's time for you to do what comes naturally.</A>"
// IDontKnowYouString :
"P4160829541" "Can't talk just now. You should look up {LastContactName}."
// FirstVisitString :
"P3814453473" "I've known a lot of great heroes in this city, {HeroName}. Here's hoping you'll be one of them."
// NoTasksRemainingString :
"P521657711" "I don't have anything that requires your skill. Maybe one of your other contacts does."
// PlayerBusyString :
"P449002841" "A great hero always finishes what he starts. You should work on some of your old cases."
// ComeBackLaterString :
"P3888159688" "I think you ought to get to Security Level {Level}. I don't want to send you into a battle you can't handle."
// RelationshipChangeString_ToFriend :
"P1933147852" "You are every bit as good as I ever was, my friend. I've got some <A HREF=CONTACTLINK_GOTOSTORE>old equipment</A> that I think you could put to good use. Take my phone number, too."
// RelationshipChangeString_ToConfidant :
"P3994154978" "I am proud to know you, {HeroName}. I want you to have all my very <A HREF=CONTACTLINK_GOTOSTORE>best Enhancements.</A>"
// FailsafeLevelString :
"P3643786896" "You need to keep looking forward, to bigger and tougher opponents."
// LocationString :
// IntroString :
"P1546890031" "I know a guy named Kevin Cordell who runs a small security consulting business. He's heard about you and would like to talk sometime about the Sky Raiders and the Lost. Kevin used to be a hero, and he still has access to Training Enhancements."
// IntroAcceptString :
"P3881292747" "Choose Kevin Cordell"
// IntroSendoffString :
"P2312126133" "Kevin is not easily impressed, but I think you will do just fine with him, {HeroName}."
// IntroduceOneContact :
"P3792422492" "I want you to meet <A HREF=CONTACTLINK_INTRODUCE>someone</A>, {HeroName}."
// IntroduceTwoContacts :
"P876832399" "There are some more <A HREF=CONTACTLINK_INTRODUCE>people</A> I want to introduce you to."
// -------------------------------------------------------------------------------- 


