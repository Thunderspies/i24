// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Ron_Hughes 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Ron Hughes 
// -------------------------------------------------------------------------------- 
// Name :
"P887617179" "Ron Hughes"
// ProfessionString :
"P4293336390" "Science Reporter"
// DescriptionString :
"P3249925160" "Science has had more advances in the past year than it has in the past 100, due in great part to the massive knowledge researchers continue to glean from recovered Rikti technology. It is Ron Hughes' greatest pleasure to report on these developments as a writer for The Paragon Science Journal, especially since he knows that not all those making advances have Paragon City's best interests at heart. Ron knows just the right questions to ask, and his contacts in the scientific community often tip him off to research taking place under shady circumstances. He finds such experiments morally appalling, and he's helped more than a few heroes bust illegal labs."
// HelloString :
"P563613309" "<A HREF=CONTACTLINK_MISSIONS>You want to make the cover?</a>"
// HelloString :
"P3097410343" "<A HREF=CONTACTLINK_MISSIONS>I have some great stories brewing.</a>"
// IDontKnowYouString :
"P3161774694" "I'm sorry, but I've got an interview in a few minutes. You should have a discussion with {LastContactName} instead."
// FirstVisitString :
"P3072723738" "I am looking forward to working with you, {HeroName}. Through science and knowledge, we will help this city together."
// NoTasksRemainingString :
"P2600454646" "I don't have any more leads for you, {HeroName}. Ask one of your other contacts."
// PlayerBusyString :
"P710264399" "Looks like you already have a full plate, {HeroName}."
// ComeBackLaterString :
"P371018432" "This next job is a little bit tricky. Maybe when you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P1506587387" "I am grateful to have a hero like you as a friend, {HeroName}. I have access to some <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements</A> you should take a look at. You should feel free to call me anytime."
// RelationshipChangeString_ToConfidant :
"P84108281" "If we trust each other fully, we can keep science in the right hands. Check out the <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements</A>my sources have provided."
// FailsafeLevelString :
"P1717754364" "You should find some new sources of information. I'm counting on you, {HeroName}."
// LocationString :
// IntroString :
"P2397890511" "I'd like you to meet Ron Hughes. He's a reporter, and lately he's been interested in the Skulls. Ron's magazine is located in Kings Row, so that's where he can be found."
// IntroAcceptString :
"P2050291279" "Choose Ron Hughes"
// IntroSendoffString :
"P1401808623" "Ron believes that science should be used for the good of all."
// IntroduceOneContact :
"P3551550813" "I want to introduce you to one of my <A HREF=CONTACTLINK_INTRODUCE>informants.</A>"
// IntroduceTwoContacts :
"P3987745426" "I know some <A HREF=CONTACTLINK_INTRODUCE>people</A> who can help you."
// -------------------------------------------------------------------------------- 


