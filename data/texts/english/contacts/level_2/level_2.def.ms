// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Rachel_Torres 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Rachel Torres 
// -------------------------------------------------------------------------------- 
// Name :
"P1273420241" "Rachel Torres"
// ProfessionString :
"P455197787" "Gang Unit Detective"
// DescriptionString :
"P488984094" "Detective Rachel Torres has only been a cop for a few years, but police in Paragon City have plenty of opportunities to advance quickly. Torres has done just that. She's now part of the Gang Unit, a tough assignment with high turnover, since everyone either gets promoted or put in the hospital. So far the detective has avoided both, but she has managed to put some big time gang bosses behind bars. She also has more than a passing interest in the Lost. Her vendetta against that villain group dates back to her first week on the job, when they crippled her partner and almost killed her."
// HelloString :
"P994565309" "<A HREF=CONTACTLINK_MISSIONS>Good day to catch bad guys.</a>"
// HelloString :
"P3527360624" "<A HREF=CONTACTLINK_MISSIONS>I need your help on some cases.</a>"
// IDontKnowYouString :
"P522139719" "I'm way too busy right now. But {LastContactName} has a real tough case."
// FirstVisitString :
"P4050916148" "The Lost are spreading, too far and too fast. I want you to help me bring 'em down."
// NoTasksRemainingString :
"P3133543590" "I've got no more cases for you to dig into. Check with your other contacts."
// PlayerBusyString :
"P3271529259" "{HeroName}, you need to finish some of the work you've started."
// ComeBackLaterString :
"P2268184404" "I need utmost security on my next case. See me when you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P3930581265" "I am glad to be working with you, {HeroName}. I have access to some <A HREF=CONTACTLINK_GOTOSTORE>new Enhancements</a> that I think you might be able to use. Radio in if you get into trouble."
// RelationshipChangeString_ToConfidant :
"P1005471933" "I wish I could have you assigned to my unit permanently, {HeroName}. Let me suit you up with all the <A HREF=CONTACTLINK_GOTOSTORE>supplies</a> you'll need. "
// FailsafeLevelString :
"P3127986483" "We have this end of things covered, {HeroName}. Thanks for all your help."
// LocationString :
// IntroString :
"P419817526" "There's a detective who you should meet. Rachel Torres knows all about the the happenings on the streets, and can probably give you good leads on the Lost. She can be located in Atlas Park."
// IntroAcceptString :
"P3520351001" "Choose Rachel Torres"
// IntroSendoffString :
"P2206152650" "Detective Torres is tough and efficient; you might learn a thing or two from her."
// IntroduceOneContact :
"P1906204645" "I want to introduce you to <A HREF=CONTACTLINK_INTRODUCE>someone</A>, {HeroName}."
// IntroduceTwoContacts :
"P1254297403" "I have some <A HREF=CONTACTLINK_INTRODUCE>people</A> I want to meet you."
// -------------------------------------------------------------------------------- 


