// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Vic_Johansson 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Vic Johansson 
// -------------------------------------------------------------------------------- 
// Name :
"P3982345677" "Vic Johansson"
// ProfessionString :
"P2357942939" "Beat Cop"
// DescriptionString :
"P3518540301" "Vic Johansson grew up in one of Paragon City's poorer neighborhoods as the son of a shopkeeper and a bus driver. After a few years in boring office jobs, he joined the police force. He has since become a distinguished officer, although promotions have been few and far between. Vic knows full well that it's the heroes, not the cops, who end up fighting most of the crime in Paragon City, and his comfort with this fact may explain why he hasn't moved up the ranks quickly. Most cops have an inferiority complex about costumed crime fighters, and they like to solve cases without them. Vic, on the other hand, is famously friendly with the super-powered crowd. He's also a firm believer in neighborhood-based policing, and he keeps heroes apprised of the slightest signs of evil on his beat."
// HelloString :
"P726512178" "<A HREF=CONTACTLINK_MISSIONS>Hello. Keeping safe, I hope. It's looking to be an interesting day.</a>"
// HelloString :
"P3096984195" "<A HREF=CONTACTLINK_MISSIONS>I can use your help, {HeroName}.</a>"
// IDontKnowYouString :
"P266244927" "All's quiet right now; check with {LastContactName} instead."
// FirstVisitString :
"P950330983" "This city needs heroes, and I aim to help them any way I can."
// NoTasksRemainingString :
"P939347438" "There's nothing going on that I can't handle. But maybe someone else could use your help."
// PlayerBusyString :
"P442885980" "Settle down, {HeroName}. You've got too much work to go looking for more."
// ComeBackLaterString :
"P779301843" "I might have a job for you when you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P1351709788" "I am starting to believe you are one of the truly good ones, friend. The department just made some <A HREF=CONTACTLINK_GOTOSTORE>new equipment</a> available to me.  Call me if there's anything you need."
// RelationshipChangeString_ToConfidant :
"P3487702503" "You have exceeded my hopes, {HeroName}. You'll need the <A HREF=CONTACTLINK_GOTOSTORE>best Enhancements</a> if you're going to keep up this pace."
// FailsafeLevelString :
"P1472184306" "Thanks for everything, {HeroName}. Good luck on your next beat."
// LocationString :
// IntroString :
"P3799529997" "Vic Johansson's good police. He'll steer you towards some interesting opportunities involving the Lost, and help smooth things over with law enforcement. His beat is Kings Row."
// IntroAcceptString :
"P3312692298" "Choose Vic Johansson"
// IntroSendoffString :
"P3944975560" "Vic is good people, {HeroName}. You will enjoy working with him."
// IntroduceOneContact :
"P2268359620" "I want you to meet <A HREF=CONTACTLINK_INTRODUCE>someone</A> for me, {HeroName}."
// IntroduceTwoContacts :
"P1002140915" "I can steer you to a couple new <A HREF=CONTACTLINK_INTRODUCE>contacts</A>, {HeroName}."
// -------------------------------------------------------------------------------- 

