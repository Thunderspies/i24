// ----------------------------------------------------------------------------------------------
// Source File : texts/Working 	Sheet : Jose_Brogan 
//
// Script      : Xlstocontactdef.bat 
// Version     : 35 
// ----------------------------------------------------------------------------------------------

// -------------------------------------------------------------------------------- 
// Contact Name : Detective Jose Brogan 
// -------------------------------------------------------------------------------- 
// Name :
"P2214658106" "Detective Jose Brogan"
// ProfessionString :
"P1268408948" "Police Detective"
// DescriptionString :
"P980670790" "Detective Jose Brogan is one of many policemen who volunteered to transfer to Paragon City after the Rikti War. So many officers had died during the invasion that the police department faced a serious resource crisis, one it is still recovering from. Originally from Philadelphia, Brogan has already begun to make a name for himself in Paragon City, and he's become especially adept at dealing with the city's stranger homicides. He is also part of an informal alliance of officers dedicated to taking down the Lost."
// HelloString :
"P920559072" "<A HREF=CONTACTLINK_MISSIONS>Got something for you, hero.</a>"
// HelloString :
"P3062707062" "<A HREF=CONTACTLINK_MISSIONS>This case is a tough nut to crack.</a>"
// HelloString :
"P2248359967" "<A HREF=CONTACTLINK_MISSIONS>Let's talk about the word on the street.</a>"
// IDontKnowYouString :
"P1164244998" "Later; I'm in the middle of a case. You ought to see if {LastContactName} can use your help."
// FirstVisitString :
"P4121050127" "Looking forward to busting bad guys with you."
// NoTasksRemainingString :
"P888083752" "Check with your other contacts. I don't have any work for you."
// PlayerBusyString :
"P655880155" "There are already enough cases that need your attention."
// ComeBackLaterString :
"P2338473386" "My cases require a delicate touch. Maybe when you reach Security Level {Level}."
// RelationshipChangeString_ToFriend :
"P2622166070" "Nice work out on the street, friend. Let's dig deeper into some of my case files. You'll need the <A HREF=CONTACTLINK_GOTOSTORE>best gear</a> if you're going to crack these. And don't forget to stay in touch."
// RelationshipChangeString_ToConfidant :
"P1448095207" "I think it's time I open up all my files to you. I want you to take a look at the <A HREF=CONTACTLINK_GOTOSTORE>latest tech</a> from division."
// FailsafeLevelString :
"P1737607793" "Time for you to move off my simple homicide beat, hero."
// LocationString :
// IntroString :
"P1704040194" "You should think about talking to Detective Jose Brogan. He's pretty intense, but he's a great cop and a good person to know if you are looking for information on the Lost. His beat is Atlas Park."
// IntroAcceptString :
"P3417096698" "Choose Jose Brogan"
// IntroSendoffString :
"P2762930182" "Detective Brogan will let you in on some interesting cases."
// IntroduceOneContact :
"P3092325608" "Lemme introduce you to one of my <A HREF=CONTACTLINK_INTRODUCE>informants</A>."
// IntroduceTwoContacts :
"P959070017" "I got a couple <A HREF=CONTACTLINK_INTRODUCE>contacts</A> to suggest to you."
// -------------------------------------------------------------------------------- 


