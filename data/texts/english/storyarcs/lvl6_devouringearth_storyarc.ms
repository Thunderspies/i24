"P2946825973" "Devoured"
// Script Variable BOSS_INACTIVE_DIALOG :
"P3920305863" "Gulwahh!"
// Script Variable BOSS_ATTACK_DIALOG :
"P4077968588" "You will not stop Unity!"
// Script Variable BOSS_INACTIVE_DIALOG :
"P2912587116" "Gwah-ho-ho-ho!"
// Script Variable BOSS_ATTACK_DIALOG :
"P4062195804" "Unity cannot be stopped!"

